# 沙箱隔离.light —— 对标 dsh packages/sandbox 的「沙箱策略裁决」
#
# 能力：资源 / 命令 / 路径 / 网络 风险分级（高 / 中 / 低）+ 白名单 / 黑名单裁决
#       （命中黑名单 → 拒绝并说明；否则放行并记录风险）+ 可组合策略（组合裁决）
#       + 命令分词（引号整体 / 管道 / 重定向 / 后台分段）+ 路径规范化（不越根）
#       + 审计日志（自增序号代替真实时间）。
#
# 设计取舍：**纯逻辑裁决**，策略表与判定都作为数据/函数注入，不碰真实进程/磁盘。
#   风险分级按类别 + 关键词启发式；黑白名单由调用方传入（宿主可接真实策略源），
#   单测用注入式 词表 + 假请求，零网络、零计时 flaky。
#   真实 OS 隔离（chroot / namespace / seccomp）由宿主执行器负责，本模块只做策略与判定层。
#
# 光明限制遵守（沿用既定踩坑，勿删）：
#   L-044   含「文本」的标识符会被词法拆名 → 本模块命名避开「文本」（用 内容/正文）。
#   L-047   字典/列表字面量不可直接作函数实参 → 一律先赋变量再传。
#   L-003   字符串花括号会触发插值 → 描述文本不出现花括号。
#   只用本仓已验证的 stdlib：长 / 子串位置(导入) / 分割字符串 / 连接字符串 /
#                            替换字符串 / 字符串() / 包含? → 统一用 子串位置 判包含。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置

# ---------- 模块级审计状态（列表元素追加无需『全局』；清空时重新绑定才需）----------
设 审计表 为 []
设 审计号 为 0

# ---------- 命中任一关键词（手写 contains，避开未验证的 含于）----------
段落 命中任一(内容, 词表):
  遍历 词 之 词表:
    如果 子串位置(内容, 词) >= 0:
      返回 真
  返回 假

# ---------- 风险等级排序 ----------
段落 风险序(等级):
  如果 等级 == "高":
    返回 3
  如果 等级 == "中":
    返回 2
  如果 等级 == "低":
    返回 1
  返回 0

段落 放行结果(放行):
  如果 放行 == 真:
    返回 "放行"
  返回 "拒绝"

# ---------- 风险分级（按类别 + 关键词启发式）----------
段落 评估风险(类别, 内容):
  设 风险 为 "低"
  如果 类别 == "命令":
    设 高危 为 ["sudo", "rm -rf", "format", "mkfs", "shutdown", "dd if="]
    设 中危 为 ["curl", "wget", "pip", "npm", "bash", "chmod"]
    如果 命中任一(内容, 高危) == 真:
      风险 为 "高"
    否则 如果 命中任一(内容, 中危) == 真:
      风险 为 "中"
  否则 如果 类别 == "网络":
    设 高危 为 ["内网", "0.0.0.0", "127.0.0.1", "localhost", "数据库", "凭证"]
    设 中危 为 ["http", "https", "socket", "端口"]
    如果 命中任一(内容, 高危) == 真:
      风险 为 "高"
    否则 如果 命中任一(内容, 中危) == 真:
      风险 为 "中"
  否则 如果 类别 == "路径":
    设 高危 为 ["/etc", "/sys", "/proc", "/Windows", "System32"]
    设 中危 为 ["/home", "/Users", "项目", "凭据"]
    如果 命中任一(内容, 高危) == 真:
      风险 为 "高"
    否则 如果 命中任一(内容, 中危) == 真:
      风险 为 "中"
  否则 如果 类别 == "资源":
    设 高危 为 ["无限制", "全部", "root", "特权"]
    设 中危 为 ["大内存", "高CPU", "长时间"]
    如果 命中任一(内容, 高危) == 真:
      风险 为 "高"
    否则 如果 命中任一(内容, 中危) == 真:
      风险 为 "中"
  返回 风险

# ---------- 单条裁决 ----------
# 返回 {裁决, 风险, 原因, 类别, 内容}
段落 沙箱裁决(类别, 内容, 黑名单表, 白名单表):
  设 裁决 为 "放行"
  设 原因 为 ""
  如果 黑名单表 != 空:
    如果 命中任一(内容, 黑名单表) == 真:
      裁决 为 "拒绝"
      原因 为 "命中黑名单: " + 内容
  设 风险 为 评估风险(类别, 内容)
  如果 裁决 == "放行" 且 白名单表 != 空:
    如果 命中任一(内容, 白名单表) == 真:
      风险 为 "低"
      原因 为 "命中白名单，按低风险放行"
  如果 裁决 == "放行" 且 原因 == "":
    原因 为 "放行，风险等级=" + 风险
  返回 ["裁决": 裁决, "风险": 风险, "原因": 原因, "类别": 类别, "内容": 内容]

# ---------- 可组合策略：批量裁决 ----------
# 兼容签名：组合裁决(请求表) 走「批量裁决」；组合裁决(请求, 策略表) 走「多策略顺序裁决」。
# 后者：任一策略拒绝即短路拒绝；全通过则放行并取最高风险等级；每次裁决写审计。
段落 组合裁决(请求, 策略表=空):
  如果 策略表 == 空 且 type(请求) == list:
    设 结果表 为 []
    遍历 项 之 请求:
      设 黑 为 []
      如果 项.包含("黑名单"):
        黑 为 项["黑名单"]
      设 白 为 []
      如果 项.包含("白名单"):
        白 为 项["白名单"]
      设 r 为 沙箱裁决(项["类别"], 项["内容"], 黑, 白)
      结果表.追加(r)
    记审计("批量", "批量请求表", "批量完成", "低", "批量裁决 " + 字符串(长(结果表)) + " 条")
    返回 结果表
  # ---- 多策略顺序裁决 ----
  如果 策略表 == 空 或 type(策略表) != list:
    策略表 为 []
  设 类别 为 ""
  如果 请求.包含("类别"):
    类别 为 请求["类别"]
  设 内容 为 ""
  如果 请求.包含("内容"):
    内容 为 请求["内容"]
  设 放行 为 真
  设 等级 为 "低"
  设 原因 为 "无策略，默认放行"
  设 命中 为 ""
  遍历 策略 之 策略表:
    如果 放行 == 真:
      设 策略类别 为 类别
      如果 策略.包含("类别"):
        策略类别 为 策略["类别"]
      设 名 为 ""
      如果 策略.包含("名"):
        名 为 策略["名"]
      设 黑 为 []
      如果 策略.包含("黑名单"):
        黑 为 策略["黑名单"]
      设 白 为 []
      如果 策略.包含("白名单"):
        白 为 策略["白名单"]
      设 r 为 沙箱裁决(策略类别, 内容, 黑, 白)
      如果 r["裁决"] == "拒绝":
        放行 为 假
        等级 为 r["风险"]
        原因 为 r["原因"]
        命中 为 名
      否则:
        如果 风险序(r["风险"]) > 风险序(等级):
          等级 为 r["风险"]
          命中 为 名
          原因 为 "策略[" + 名 + "]放行，等级升至 " + r["风险"]
  如果 放行 == 真 且 长(策略表) > 0 且 原因 == "无策略，默认放行":
    原因 为 "全部策略放行，最高等级=" + 等级
  记审计(类别, 内容, 放行结果(放行), 等级, 原因)
  返回 ["放行": 放行, "等级": 等级, "原因": 原因, "命中策略": 命中]

# ---------- 命令分词：按空格切词，保留引号整体，按 | > >> & 分段 ----------
# 返回「段列表」：每段是一个词列表。例："echo 'a b' | grep x" -> [["echo","a b"],["grep","x"]]
段落 分词(命令串):
  设 段们 为 []
  设 当前段 为 []
  设 当前词 为 ""
  设 引号 为 ""
  设 位置 为 0
  设 总长 为 长(命令串)
  当 位置 < 总长:
    设 字符 为 字符串获取(命令串, 位置)
    如果 引号 != "":
      如果 字符 == 引号:
        引号 为 ""
      否则:
        当前词 为 当前词 + 字符
    否则:
      如果 字符 == "'" 或 字符 == "\"":
        引号 为 字符
      否则 如果 字符 == " ":
        如果 当前词 != "":
          当前段.追加(当前词)
          当前词 为 ""
      否则 如果 字符 == "|" 或 字符 == "&":
        如果 当前词 != "":
          当前段.追加(当前词)
          当前词 为 ""
        如果 长(当前段) > 0:
          段们.追加(当前段)
          当前段 为 []
      否则 如果 字符 == ">":
        如果 当前词 != "":
          当前段.追加(当前词)
          当前词 为 ""
        如果 长(当前段) > 0:
          段们.追加(当前段)
          当前段 为 []
        如果 位置 + 1 < 总长 且 字符串获取(命令串, 位置 + 1) == ">":
          位置 为 位置 + 1
      否则:
        当前词 为 当前词 + 字符
    位置 为 位置 + 1
  如果 当前词 != "":
    当前段.追加(当前词)
  如果 长(当前段) > 0:
    段们.追加(当前段)
  返回 段们

# ---------- 路径规范化 ----------
# 去 "." 段、合并 ".."（不越根：栈空时丢弃）、统一分隔符、去尾部斜杠（保留根 "/"）。
段落 规范路径(路径):
  如果 路径 == "":
    返回 ""
  设 规范 为 替换字符串(路径, "\\", "/")
  设 是否绝对 为 假
  如果 规范[0:1] == "/":
    是否绝对 为 真
  设 段们 为 分割字符串(规范, "/")
  设 栈 为 []
  遍历 段 之 段们:
    如果 段 == "..":
      如果 长(栈) > 0:
        栈.弹出()
    否则:
      如果 段 != "" 且 段 != ".":
        栈.追加(段)
  设 结果 为 连接字符串(栈, "/")
  如果 是否绝对 == 真:
    结果 为 "/" + 结果
  返回 结果

# ---------- 审计日志（序号代替真实时间，零计时依赖）----------
段落 记审计(类别, 内容, 裁决, 风险, 原因):
  全局 审计号。
  审计号 为 审计号 + 1
  设 记录 为 ["序号": 审计号, "类别": 类别, "内容": 内容, "裁决": 裁决, "风险": 风险, "原因": 原因]
  审计表.追加(记录)
  返回 审计号

段落 取审计(数量=0):
  设 全部 为 长(审计表)
  如果 数量 <= 0 或 数量 > 全部:
    数量 为 全部
  设 起 为 全部 - 数量
  返回 审计表[起:全部]

段落 清空审计():
  全局 审计表。
  全局 审计号。
  审计表 为 []
  审计号 为 0
  返回 真

# ---------- 模型可见工具 ----------
段落 沙箱裁决模式():
  返回 ["type": "object",
        "properties": ["类别": ["type": "string", "description": "受裁决类别：命令 / 网络 / 路径 / 资源"],
                        "内容": ["type": "string", "description": "待裁决的具体内容（命令串 / 地址 / 路径 / 资源配置）"],
                        "黑名单": ["type": "array", "items": ["type": "string"], "description": "命中即拒绝的关键词表（可选）"],
                        "白名单": ["type": "array", "items": ["type": "string"], "description": "命中即按低风险放行的关键词表（可选）"]],
        "required": ["类别", "内容"]]

段落 沙箱裁决处理(参数):
  设 黑 为 []
  如果 参数.包含("黑名单"):
    黑 为 参数["黑名单"]
  设 白 为 []
  如果 参数.包含("白名单"):
    白 为 参数["白名单"]
  设 结果 为 沙箱裁决(参数["类别"], 参数["内容"], 黑, 白)
  记审计(参数["类别"], 参数["内容"], 结果["裁决"], 结果["风险"], 结果["原因"])
  设 内容 为 "裁决=" + 结果["裁决"] + " 风险=" + 结果["风险"] + " 原因=" + 结果["原因"]
  返回 造工具结果(内容, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("沙箱裁决", "对命令/网络/路径/资源做风险分级与黑白名单裁决", 沙箱裁决模式(), 沙箱裁决处理))
  返回 真

导出 命中任一
导出 评估风险
导出 沙箱裁决
导出 组合裁决
导出 风险序
导出 放行结果
导出 分词
导出 规范路径
导出 记审计
导出 取审计
导出 清空审计
导出 挂载
