# 运行检视器.light —— 对标 dsh packages/experimental/inspector（P5-1）
#
# 能力：运行时**观测登记** + 结构化**快照** + **差异高亮** + 导出。
#
# 设计取舍：dsh inspector 是 Chrome DevTools 检查器（CDP / WebSocket / 浏览器 realm）。
# 本复刻版只复刻「观测 → 快照 → 差异」的**纯逻辑核心**：
#   - 节点表（上下文树）+ 观测记录表，都由本模块持有与计算；
#   - 真实运行时采集由宿主注入「采集器」，本模块不碰 CDP、不碰浏览器。
# 这样单测零网络、零浏览器依赖。
#
# 光明限制遵守：
#   L-047  字典/列表字面量不可直接作实参 → 先赋变量。
#   L-044  含「文本」的标识符会被拆名 → 命名避开（用 载荷/内容/说明）。
#   LP-D-002：stdlib 模块函数必须显式导入（字符串处理 / 内置核心字典）。
#   LP-D-006：禁止行尾「+」续行 —— 多行一律分步 `设 X 为 X + ...`。
#   可变状态放**模块级字典/列表**（元素赋值天然共享，无需『全局』）。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置
从 内置核心字典 导入 字典键列表

# 节点表：每项 = ["名字": 串, "父": 串, "属性": 字典]
设 节点表 为 []
# 观测记录：每项 = ["序号": n, "主题": 串, "载荷": 任意]
设 观测 为 []
# 模块级标量统一放字典（元素赋值天然共享，避开「全局」与局部遮蔽）
设 状态量 为 ["版本": 0, "基线": 空, "采集器": 空]

# ---------- 内部 ----------
段落 查节点(名字):
  设 序号 为 0
  遍历 项 之 节点表:
    如果 项["名字"] == 名字:
      返回 序号
    序号 为 序号 + 1
  返回 -1

段落 含于(表, 值):
  遍历 项 之 表:
    如果 项 == 值:
      返回 真
  返回 假

# ---------- 节点登记 ----------
段落 登记上下文(名字, 父="根"):
  如果 查节点(名字) >= 0:
    返回 假
  节点表.追加(["名字": 名字, "父": 父, "属性": {}])
  返回 真

段落 设属性(名字, 键, 值):
  设 序号 为 查节点(名字)
  如果 序号 < 0:
    返回 假
  设 项 为 节点表[序号]
  设 属性表 为 项["属性"]
  属性表[键] 为 值
  返回 真

# ---------- 观测 ----------
段落 发布(主题, 载荷):
  状态量["版本"] 为 状态量["版本"] + 1
  观测.追加(["序号": 状态量["版本"], "主题": 主题, "载荷": 载荷])
  返回 状态量["版本"]

段落 观测数():
  返回 长(观测)

# ---------- 快照 ----------
段落 取快照():
  设 副本 为 []
  遍历 项 之 节点表:
    设 属性副本 为 {}
    遍历 键值 之 字典键列表(项["属性"]):
      属性副本[键值] 为 项["属性"][键值]
    副本.追加(["名字": 项["名字"], "父": 项["父"], "属性": 属性副本])
  返回 ["版本": 状态量["版本"], "节点": 副本, "观测数": 长(观测)]

# ---------- 差异 ----------
段落 取节点属性(快照, 名字):
  设 表 为 []
  遍历 项 之 快照["节点"]:
    如果 项["名字"] == 名字:
      设 键表 为 字典键列表(项["属性"])
      遍历 键值 之 键表:
        表.追加(键值)
        表.追加(项["属性"][键值])
  返回 表

段落 取差异(旧快照):
  设 旧名 为 []
  遍历 项 之 旧快照["节点"]:
    旧名.追加(项["名字"])
  设 新快照 为 取快照()
  设 新名 为 []
  遍历 项 之 新快照["节点"]:
    新名.追加(项["名字"])
  设 新增 为 []
  遍历 名 之 新名:
    如果 含于(旧名, 名) == 假:
      新增.追加(名)
  设 移除 为 []
  遍历 名 之 旧名:
    如果 含于(新名, 名) == 假:
      移除.追加(名)
  设 变化 为 []
  遍历 名 之 新名:
    如果 含于(新增, 名) == 假:
      设 旧属性 为 取节点属性(旧快照, 名)
      设 新属性 为 取节点属性(新快照, 名)
      如果 旧属性 != 新属性:
        变化.追加(名)
  返回 ["新增": 新增, "移除": 移除, "变化": 变化,
         "旧版本": 旧快照["版本"], "新版本": 新快照["版本"]]

段落 取与基线差异():
  如果 状态量["基线"] == 空:
    返回 空
  返回 取差异(状态量["基线"])

段落 存基线():
  状态量["基线"] 为 取快照()
  返回 状态量["基线"]

# ---------- 导出 ----------
段落 导出(快照):
  # 返回结构化快照，供宿主序列化为 JSON 用于传输/落盘
  返回 快照

# ---------- 模型可见工具 ----------
段落 运行检视模式():
  返回 ["type": "object",
        "properties": ["动作": ["type": "string", "description": "登记上下文/设属性/发布/取快照/取与基线差异/导出"],
                       "主题": ["type": "string", "description": "可选；发布动作的主题"],
                       "载荷": ["type": "string", "description": "可选；发布动作的载荷描述"],
                       "名字": ["type": "string", "description": "可选；节点名"],
                       "键": ["type": "string", "description": "可选；属性键"],
                       "值": ["type": "string", "description": "可选；属性值"]],
        "required": ["动作"]]

段落 运行检视处理(参数):
  设 动作 为 参数["动作"]
  如果 动作 == "登记上下文":
    如果 参数.包含("名字") == 假:
      返回 造工具结果("登记上下文需要 名字", 真)
    设 父 为 "根"
    如果 参数.包含("父"):
      设 父 为 参数["父"]
    如果 登记上下文(参数["名字"], 父) == 假:
      返回 造工具结果("上下文已存在", 真)
    返回 造工具结果("已登记 " + 参数["名字"], 假)
  如果 动作 == "设属性":
    如果 设属性(参数["名字"], 参数["键"], 参数["值"]) == 假:
      返回 造工具结果("上下文不存在: " + 参数["名字"], 真)
    返回 造工具结果("已设属性", 假)
  如果 动作 == "发布":
    设 序号 为 发布(参数["主题"], 参数["载荷"])
    返回 造工具结果("已发布 序号=" + 字符串(序号), 假)
  如果 动作 == "取快照":
    设 快照 为 取快照()
    返回 造工具结果("版本=" + 字符串(快照["版本"]) + " 节点数=" + 字符串(长(快照["节点"])), 假)
  如果 动作 == "取与基线差异":
    设 差 为 取与基线差异()
    如果 差 == 空:
      返回 造工具结果("尚未存基线", 真)
    返回 造工具结果("新增=" + 字符串(长(差["新增"])) + " 移除=" + 字符串(长(差["移除"])) +
                    " 变化=" + 字符串(长(差["变化"])), 假)
  如果 动作 == "导出":
    返回 造工具结果("已导出快照（结构见返回值）", 假)
  返回 造工具结果("未知动作: " + 动作, 真)

段落 挂载(注册表, 采集器=空):
  如果 采集器 != 空:
    状态量["采集器"] 为 采集器
  注册表.注册(造工具定义("运行检视", "运行时观测登记与快照检视", 运行检视模式(), 运行检视处理))
  返回 真

导出 登记上下文
导出 设属性
导出 发布
导出 观测数
导出 取快照
导出 取差异
导出 存基线
导出 取与基线差异
导出 导出
导出 挂载
