# 测试_运行检视器.light —— P5-1 运行检视器 的正例与反例

从 运行检视器 导入 登记上下文, 设属性, 发布, 观测数, 取快照, 取差异, 存基线, 取与基线差异, 导出, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# 列表包含辅助（避免依赖未验证的 列表.包含）
段落 含于_helper(表, 值):
  遍历 项 之 表:
    如果 项 == 值:
      返回 真
  返回 假

段落 主:
  # ---- 1. 登记上下文 ----
  断言为真(登记上下文("宿主", "根"), "根上下文应登记成功")
  断言为真(登记上下文("客户端甲", "宿主"), "子上下文应登记成功")
  断言为假(登记上下文("宿主", "根"), "重复登记应失败")

  # ---- 2. 设属性 ----
  断言为真(设属性("宿主", "状态", "运行中"), "宿主设属性成功")
  断言为真(设属性("宿主", "端口", "9230"), "宿主设第二属性成功")
  断言为假(设属性("不存在", "状态", "x"), "不存在上下文设属性应失败")

  # ---- 3. 发布观测 ----
  设 序1 为 发布("console", "hello")
  设 序2 为 发布("network", "GET /x")
  断言相等(序1, 1, "第一个观测序号应为 1")
  断言相等(序2, 2, "第二个观测序号应为 2")
  断言相等(观测数(), 2, "观测数应为 2")

  # ---- 4. 快照 ----
  设 快照 为 取快照()
  断言相等(长(快照["节点"]), 2, "快照应有 2 个节点")
  断言相等(快照["版本"], 2, "快照版本应为 2")
  断言相等(快照["观测数"], 2, "快照观测数应为 2")

  # ---- 5. 与基线差异：新增 ----
  存基线()
  断言为真(登记上下文("客户端乙", "宿主"), "新增一个上下文")
  设 差1 为 取与基线差异()
  断言为真(含于_helper(差1["新增"], "客户端乙"), "新增应包含 客户端乙")
  断言相等(长(差1["移除"]), 0, "不应有移除")

  # ---- 6. 与基线差异：变化 ----
  设属性("宿主", "状态", "已停止")
  设 差2 为 取与基线差异()
  断言为真(含于_helper(差2["变化"], "宿主"), "宿主属性变化应被记录")

  # ---- 7. 显式旧快照差异：新增/移除方向 ----
  # 旧快照只有 宿主/客户端甲；当前状态已含 客户端乙（第 52 行登记）。
  # 所以 客户端乙 落在「新增」（新有旧无）；旧快照是当前子集，「移除」应为空。
  设 旧 为 ["版本": 0, "节点": [["名字": "宿主", "父": "根", "属性": {}],
                            ["名字": "客户端甲", "父": "宿主", "属性": {}]], "观测数": 0]
  设 差3 为 取差异(旧)
  断言为真(含于_helper(差3["新增"], "客户端乙"), "新增应包含 客户端乙（当前有、旧快照无）")
  断言相等(长(差3["移除"]), 0, "旧快照是当前的子集，不应有移除")

  # ---- 8. 导出 ----
  设 导出物 为 导出(快照)
  断言相等(导出物["版本"], 2, "导出物应含版本")

  # ---- 9. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("运行检视"), "运行检视应注册")
  设 定义 为 注册表.登记表["运行检视"]
  设 参 为 ["动作": "取快照"]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "取快照不应报错")
  断言为真(子串位置(产出["content"], "节点数=3") >= 0, "快照应含 3 个节点（含新增的客户端乙）")
  设 参坏 为 ["动作": "瞎搞"]
  断言为真(定义["execute"](参坏)["isError"], "未知动作应报错")

  打印 "测试_运行检视器 全部通过"

主()
