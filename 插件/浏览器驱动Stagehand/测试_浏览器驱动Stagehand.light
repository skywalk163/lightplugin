# 测试_浏览器驱动Stagehand.light —— P6-2 浏览器驱动Stagehand 的正例与反例

从 浏览器驱动Stagehand 导入 翻译动作, 翻译序列, 渲染计划, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言True_含(串, 子, 标签):
  如果 子串位置(串, 子) < 0:
    抛出 新建 错误("包含断言失败 [" + 标签 + "]: 未找到 " + 子)

段落 主:
  # ---- 1. 各动作翻译（翻译动作返回 Stagehand 调用）----
  设 计划1 为 翻译动作(["类型": "打开", "url": "https://x.com"])
  断言True_含(计划1["工具"], "stagehand.act", "打开应翻译为 stagehand.act")
  断言True_含(计划1["参数"]["instruction"], "https://x.com", "goto instruction 应含 url")

  设 计划2 为 翻译动作(["类型": "点击", "选择器": "#btn"])
  断言True_含(计划2["参数"]["action"], "click", "点击 action 应为 click")
  断言True_含(计划2["参数"]["instruction"], "#btn", "点击 instruction 应含选择器")

  设 计划3 为 翻译动作(["类型": "填表", "选择器": "#inp", "文本": "hi"])
  断言True_含(计划3["参数"]["action"], "fill", "填表 action 应为 fill")
  断言True_含(计划3["参数"]["instruction"], "hi", "填表 instruction 应含文本")

  设 计划4 为 翻译动作(["类型": "抽取", "选择器": ".title"])
  断言True_含(计划4["工具"], "stagehand.extract", "抽取应翻译为 stagehand.extract")

  设 计划5 为 翻译动作(["类型": "截图"])
  断言True_含(计划5["参数"]["action"], "screenshot", "截图 action 应为 screenshot")

  设 计划6 为 翻译动作(["类型": "滚动", "量": 200])
  断言True_含(计划6["参数"]["instruction"], "200", "滚动 instruction 应含像素量")

  设 计划7 为 翻译动作(["类型": "瞎搞"])
  断言为真(计划7["跳过"] == 真, "未知动作应标跳过")

  # ---- 2. 翻译序列 ----
  设 序列 为 翻译序列([["类型": "打开", "url": "https://x.com"],
                      ["类型": "点击", "选择器": "#btn"],
                      ["类型": "瞎搞"]])
  断言相等(长(序列), 3, "序列应含 3 条")
  断言为真(序列[2]["跳过"] == 真, "序列末条为跳过的未知动作")

  # ---- 3. 渲染计划 ----
  设 渲染 为 渲染计划(序列)
  断言相等(长(渲染), 3, "渲染应 3 行")

  # ---- 4. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("浏览器驱动Stagehand"), "浏览器驱动Stagehand 应注册")
  设 定义 为 注册表.登记表["浏览器驱动Stagehand"]
  设 产出 为 定义["execute"](["动作": "翻译", "序列": [["类型": "打开", "url": "https://x.com"], ["类型": "点击", "选择器": "#btn"]]])
  断言为假(产出["isError"], "翻译不应报错")
  设 参坏 为 ["动作": "瞎搞"]
  断言为真(定义["execute"](参坏)["isError"], "未知动作应报错")

  打印 "测试_浏览器驱动Stagehand 全部通过"

主()
