# 文件系统抽象.light —— 对标 dsh packages/fs 的「路径层 + 变更事件订阅」能力
#
# 设计边界：不重造 读/写/搜索文件（lightharness 已有）。只做两件事：
#   1) 路径层：规范化（去 "./"、合并 "../" 上限）、拼接（基 + 相对）。
#   2) 变更事件订阅：路径模式 → 监听回调表；emit 时按模式匹配触发。
#   存在性判定 与 文件事件源 均注入式（宿主接真实文件系统/监听，测试注入确定性 fake），
#   因此单测零真实磁盘、零真实 inotify。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作函数实参 → 一律先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块命名避开「文本」（用 路径/模式/内容）。
#   L-165/166 段落内写模块级标量须先写『全局 X。』（存在判定/事件源）。
#   L-持续   无 continue 关键字 → 用 跳过 标志模拟。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置

设 存在判定 为 空
设 事件源 为 空
设 订阅表 为 {}

# ---------- 注入式依赖 ----------
段落 设定存在判定(函数):
  全局 存在判定。
  设 存在判定 为 函数

段落 设定事件源(函数):
  全局 事件源。
  设 事件源 为 函数

# ---------- 列表尾部弹出（光明无 list.pop，手写）----------
段落 列表弹出尾(列表):
  设 新 为 []
  设 i 为 0
  当 i < 长(列表) - 1:
    新.追加(列表[i])
    设 i 为 i + 1
  返回 新

# ---------- 路径规范化 ----------
段落 规范化路径(路径):
  设 是绝对 为 假
  如果 长(路径) > 0 且 子串位置(路径, "/") == 0:
    设 是绝对 为 真
  设 段们 为 分割字符串(路径, "/")
  设 栈 为 []
  遍历 段 之 段们:
    设 跳过 为 假
    如果 段 == "":
      设 跳过 为 真
    如果 跳过 == 假 且 段 == ".":
      设 跳过 为 真
    如果 跳过 == 假:
      如果 段 == "..":
        如果 长(栈) > 0:
          设 顶 为 栈[长(栈) - 1]
          如果 顶 == "..":
            栈.追加("..")
          否则:
            设 栈 为 列表弹出尾(栈)
        否则:
          如果 是绝对 == 假:
            栈.追加("..")
        # 绝对路径到达根：丢弃（上限，不越界）
      否则:
        栈.追加(段)
  如果 长(栈) == 0:
    如果 是绝对:
      返回 "/"
    返回 "."
  设 结果 为 连接字符串(栈, "/")
  如果 是绝对:
    设 结果 为 "/" + 结果
  返回 结果

# ---------- 路径拼接（基 + 相对，再规范化消除 ./ ..）----------
段落 拼接路径(基, 相对):
  如果 长(基) == 0:
    返回 规范化路径(相对)
  设 部件 为 分割字符串(基, "/")
  设 末件 为 部件[长(部件) - 1]
  设 出 为 基
  如果 末件 != "":
    设 出 为 基 + "/"
  设 出 为 出 + 相对
  返回 规范化路径(出)

# ---------- 存在性（注入式判定）----------
段落 路径存在(路径):
  全局 存在判定。
  如果 存在判定 == 空:
    返回 假
  返回 存在判定(路径)

# ---------- 变更事件订阅 ----------
# 模式支持单个 "*" 通配：前缀 + 后缀匹配（前缀须开头、后缀须结尾）。
段落 模式匹配(模式, 路径):
  如果 模式 == 路径:
    返回 真
  如果 子串位置(模式, "*") < 0:
    返回 假
  设 部 为 分割字符串(模式, "*")
  设 前缀 为 部[0]
  设 后缀 为 连接字符串(部[1:长(部)], "*")
  设 前缀过 为 真
  如果 前缀 != "":
    如果 子串位置(路径, 前缀) != 0:
      设 前缀过 为 假
  设 后缀过 为 真
  如果 后缀 != "":
    设 位 为 子串位置(路径, 后缀)
    如果 位 < 0:
      设 后缀过 为 假
    否则:
      如果 位 + 长(后缀) != 长(路径):
        设 后缀过 为 假
  返回 前缀过 且 后缀过

段落 订阅变更(模式, 回调):
  如果 订阅表.包含(模式) == 假:
    订阅表[模式] 为 []
  订阅表[模式].追加(回调)
  返回 真

段落 退订变更(模式):
  如果 订阅表.包含(模式):
    订阅表.弹出(模式)
  返回 真

# emit：按模式匹配触发对应回调（回调签名 (路径, 事件)）
段落 发出变更(路径, 事件):
  遍历 模式 之 订阅表:
    如果 模式匹配(模式, 路径) == 真:
      设 回调们 为 订阅表[模式]
      遍历 回调 之 回调们:
        设 占位 为 回调(路径, 事件)
  返回 真

# ---------- 模型可见工具 ----------
段落 规范化路径模式():
  返回 ["type": "object",
        "properties": ["路径": ["type": "string", "description": "待规范化的路径"]],
        "required": ["路径"]]

段落 规范化路径处理(参数):
  设 结果 为 规范化路径(参数["路径"])
  返回 造工具结果(结果, 假)

段落 订阅文件变更模式():
  返回 ["type": "object",
        "properties": ["模式": ["type": "string", "description": "路径匹配模式，支持 * 通配，如 src/*.py"],
                        "标签": ["type": "string", "description": "可选：监听标识"]],
        "required": ["模式"]]

段落 订阅文件变更处理(参数):
  设 模式 为 参数["模式"]
  设 内容 为 "已登记订阅: " + 模式
  返回 造工具结果(内容, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("规范化路径", "规范化文件路径（去 ./ 与合并 ../ 上限）", 规范化路径模式(), 规范化路径处理))
  注册表.注册(造工具定义("订阅文件变更", "登记一个文件变更监听模式", 订阅文件变更模式(), 订阅文件变更处理))
  返回 真

