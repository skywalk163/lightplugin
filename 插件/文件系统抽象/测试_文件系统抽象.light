# 测试_文件系统抽象.light —— 文件系统抽象 的正例与反例
#
# 与宿主一致的断言惯用法：失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。
# 存在性判定与文件事件源注入确定性 fake，零真实磁盘、零真实 inotify。

从 文件系统抽象 导入 规范化路径, 拼接路径, 路径存在, 模式匹配, 订阅变更, 退订变更, 发出变更, 设定存在判定, 设定事件源, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 注入式存在性判定 ----
段落 假存在(路径):
  如果 路径 == "/a.txt":
    返回 真
  如果 路径 == "/src/main.py":
    返回 真
  返回 假

# ---- 注入式回调：收集触发的 (路径, 事件) ----
设 收到 为 []

段落 收件(路径, 事件):
  全局 收到。
  收到.追加(["路径": 路径, "事件": 事件])

段落 主:
  全局 收到。
  # ---- 1. 路径规范化 ----
  断言相等(规范化路径("/a/b/./c"), "/a/b/c", "去除 ./")
  断言相等(规范化路径("/a/b/../c"), "/a/c", "合并 ../")
  断言相等(规范化路径("/a/../../c"), "/c", "合并 ../ 上限不越根")
  断言相等(规范化路径("a/b/../c"), "a/c", "相对路径合并 ../")
  断言相等(规范化路径("a/../../c"), "../c", "相对路径 ../ 越界保留")
  断言相等(规范化路径("."), ".", "单点返回 .")
  断言相等(规范化路径("/"), "/", "根返回 /")
  断言相等(规范化路径(""), ".", "空路径返回 .")

  # ---- 2. 路径拼接 ----
  断言相等(拼接路径("/a/b", "c"), "/a/b/c", "基+相对")
  断言相等(拼接路径("/a/b/", "c"), "/a/b/c", "基尾部斜杠")
  断言相等(拼接路径("/a/b", "../c"), "/a/c", "拼接后消除 ../")
  断言相等(拼接路径("", "c/d"), "c/d", "空基直接规范化")

  # ---- 3. 端到端注册校验 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("规范化路径"), "规范化路径应已注册")
  断言为真(注册表.登记表.包含("订阅文件变更"), "订阅文件变更应已注册")
  设 规范化定义 为 注册表.登记表["规范化路径"]
  设 规范产出 为 规范化定义["execute"](["路径": "/x/y/../z"])
  断言为假(规范产出["isError"], "规范化不应报错")
  断言相等(规范产出["content"], "/x/z", "规范化工具输出应正确")

  # ---- 4. 存在性判定（注入式）----
  设定存在判定(假存在)
  断言为真(路径存在("/a.txt"), "/a.txt 应存在")
  断言为假(路径存在("/nope"), "/nope 应不存在")
  设定存在判定(空)
  断言为假(路径存在("/any"), "未注入判定应返回不存在")

  # ---- 5. 订阅匹配 + emit 触发对应回调 ----
  设 收到 为 []
  订阅变更("src/*.py", 收件)
  订阅变更("/a/*.txt", 收件)
  发出变更("src/main.py", "写入")
  发出变更("src/util.py", "写入")
  发出变更("/a/b.txt", "删除")
  发出变更("/a/c.log", "写入")   # 不匹配 *.txt
  发出变更("other/x.py", "写入") # 不匹配 src/*
  断言相等(长(收到), 3, "应触发 3 次匹配回调")
  断言相等(收到[0]["路径"], "src/main.py", "首个匹配为 src/main.py")
  断言相等(收到[2]["路径"], "/a/b.txt", "第三个匹配为 /a/b.txt")

  # ---- 6. 精确模式匹配 ----
  断言为真(模式匹配("/exact/x", "/exact/x"), "精确模式应匹配")
  断言为假(模式匹配("/exact/x", "/exact/y"), "精确模式不应匹配")
  断言为真(模式匹配("*.log", "foo.log"), "后缀通配应匹配")
  断言为假(模式匹配("*.log", "foo.txt"), "后缀通配不应匹配")

  # ---- 7. 退订后不再触发 ----
  退订变更("src/*.py")
  设 收到 为 []
  发出变更("src/again.py", "写入")
  断言相等(长(收到), 0, "退订后不应触发")

  打印 "测试_文件系统抽象 全部通过"

主()
