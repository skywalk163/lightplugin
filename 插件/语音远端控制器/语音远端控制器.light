# 语音远端控制器.light —— R101 任务线 A：新插件 #75
#
# 对标 dsh packages/experimental/api-speech-to-text（上游锚点 e5b5ccbfcb，0.2.0-rc.1）
#   src/index.ts（110 行）/ src/types.ts
#
# 【背景纠偏（相对 #13 语音转文字 的旧认知）】api-speech-to-text 不是第三种 ASR 后端：
#   它是挂在 Web Remote 上的服务端控制器 SpeechController，把浏览器录音转一次
#   临时转写（不进 Session 事件、不存附件）。它依赖 speech-to-text 的 ctx.speechToText
#   （即 #13 已复刻的识别器契约），自己只做「入站校验 + 限流 + 错误码包装」。
#
# 上游 → 光明对照表（纯逻辑面）：
#   Config (z.object)                      → 配置形状默认(覆盖)
#   validateWave（speech-to-text/wave.ts） → 校验WAV(字节, 最大秒数)
#   transcribe(request, signal)            → 转写请求(请求, 配置, 信号被中止, 识别转写)
#   catalog()                              → 目录快照(识别器快照, 配置)
#   follow / configure / prepare / cancelPreparation → 同名段落（薄转发，注入字典承接）
#   服务装配                               → 挂载(注册表, 识别器通道)（绳构造注册）
#   Buffer.from(b64) / buf.toString('b64') → 音频解码(编码) / 音频编码(字节)（纯 base64 编解码）
#   RemoteError                            → 错误消息前缀 speech/invalid-audio / speech/transcription-failed
#   AbortSignal.throwIfAborted             → 注入 信号被中止() -> 真假（入口先抛不包装；包装前再查，中止则透抛）
#   ctx.speechToText.resolve + transcribe  → 注入 识别转写(音频字节, 提供者, 语言) -> 稿本
#   ctx.speechToText.snapshot              → 注入 识别器快照() -> 字典
#
# 宿主绑定投影（不移植）：Cordis Remote 装饰器 / typert 协议 / AbortSignal / Buffer / zod。
# 字节表示：整数列表（0..255），零文件 IO、零网络、零真实音频。
#
# 语言坑规避（勿删）：
#   L-047  字典/列表字面量不可直接作函数实参 → 一律先赋变量再传。
#   L-044  含「文本」的标识符会被词法拆名 → 命名避开「文本」二字。
#   标识符避用中文数字与保留字（错误/定义/类型/…）；可变状态放模块级字典（元素赋值天然共享）。

从 字符串处理 导入 列表到字符串
从 toolcordis 导入 绳构造注册

# base64 字母表（RFC 4648 标准，含 + /，padding 用 =）
设 编码字母表 为 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# 模块级状态：挂载时绑定的识别器通道（对应 dsh static inject = ['speechToText', 'typert']）
设 状态 为 ["通道": 空]

# =====================================================================
# §0 整除工具（正整数域）
# =====================================================================

# JS Math.floor(a / b)：先转浮点确保浮点除再下取整
段落 向下整除(a, b):
  返回 转整数(向下取整(转浮点(a) / 转浮点(b)))

# 正整数向上取整：floor((a + b - 1) / b)
段落 上取整(a, b):
  返回 向下整除(a + b - 1, b)

# =====================================================================
# §1 base64 编解码（投影 Buffer.from(encoded, 'base64') / audio.toString('base64')）
#   解码宽松：跳过字母表与 = 之外的字符（对齐 Buffer 的空白容忍），
#   配合「解码后重编码必须逐字相等」的 canonical 检查即可拦下一切非规范编码。
# =====================================================================

# 查字符在字母表中的 6 位值；不在表内返回 -1
段落 字母表查位(字符):
  设 位 为 0
  当 位 < 64:
    如果 编码字母表[位] == 字符:
      返回 位
    设 位 为 位 + 1
  返回 -1

# base64 串 → 字节列表（整数 0..255）
段落 音频解码(编码):
  设 输出表 为 []
  设 累积 为 0
  设 位计 为 0
  设 二幂 为 [1, 2, 4, 8, 16, 32, 64, 128]
  设 i 为 0
  设 总长 为 字符串长度(编码)
  当 i < 总长:
    设 字符 为 编码[i]
    如果 字符 != "=":
      设 值 为 字母表查位(字符)
      如果 值 >= 0:
        设 累积 为 累积 * 64 + 值
        设 位计 为 位计 + 6
        如果 位计 >= 8:
          设 位计 为 位计 - 8
          设 幂 为 二幂[位计]
          输出表.追加(向下整除(累积, 幂))
          设 累积 为 累积 % 幂
    设 i 为 i + 1
  返回 输出表

# 字节列表 → 规范 base64 串（严格补 =，与 Buffer 的 canonical 编码一致）
段落 音频编码(字节):
  设 输出表 为 []
  设 总长 为 列表长度(字节)
  设 i 为 0
  当 i + 2 < 总长:
    设 三元 为 字节[i] * 65536 + 字节[i + 1] * 256 + 字节[i + 2]
    输出表.追加(编码字母表[向下整除(三元, 262144)])
    输出表.追加(编码字母表[向下整除(三元 % 262144, 4096)])
    输出表.追加(编码字母表[向下整除(三元 % 4096, 64)])
    输出表.追加(编码字母表[三元 % 64])
    设 i 为 i + 3
  设 余 为 总长 % 3
  如果 余 == 1:
    设 末值 为 字节[i]
    输出表.追加(编码字母表[向下整除(末值, 4)])
    输出表.追加(编码字母表[(末值 % 4) * 16])
    输出表.追加("=")
    输出表.追加("=")
  如果 余 == 2:
    设 末对 为 字节[i] * 256 + 字节[i + 1]
    输出表.追加(编码字母表[向下整除(末对, 1024)])
    输出表.追加(编码字母表[向下整除(末对 % 1024, 16)])
    输出表.追加(编码字母表[(末对 % 16) * 4])
    输出表.追加("=")
  返回 列表到字符串(输出表, "")

# =====================================================================
# §2 WAV 校验（speech-to-text/src/wave.ts validateWave 逐段投影）
#   上游一次大条件式抛同一个错；这里保持同一文案，逐段判定。
#   头部布局：0-3 RIFF / 4-7 块长 / 8-11 WAVE / 12-15 fmt /
#             16-35 fmt 体（16/PCM/单声道/16000/32000/2/16）/ 36-39 data / 40-43 data 块长。
# =====================================================================

# 小端读整数：宽 2 或 4
段落 读小端(表, 偏移, 宽):
  设 值 为 0
  设 倍 为 1
  设 位 为 0
  当 位 < 宽:
    设 值 为 值 + 表[偏移 + 位] * 倍
    设 倍 为 倍 * 256
    设 位 为 位 + 1
  返回 值

# 校验 WAV 头并按时长限流；合法返回 空，非法抛中文错
段落 校验WAV(字节, 最大秒数):
  设 总长 为 列表长度(字节)
  设 规范 为 "音频必须是规范的 16kHz 单声道 PCM16 WAV 录音"
  # 最短合法：44 字节头 + 2 字节数据（data 块长非零且偶对齐）
  如果 总长 < 46:
    抛出 新建 错误(规范)
  # 块名：RIFF / WAVE / fmt / data
  如果 字节[0] != 82 或 字节[1] != 73 或 字节[2] != 70 或 字节[3] != 70:
    抛出 新建 错误(规范)
  如果 字节[8] != 87 或 字节[9] != 65 或 字节[10] != 86 或 字节[11] != 69:
    抛出 新建 错误(规范)
  如果 字节[12] != 102 或 字节[13] != 109 或 字节[14] != 116 或 字节[15] != 32:
    抛出 新建 错误(规范)
  如果 字节[36] != 100 或 字节[37] != 97 或 字节[38] != 116 或 字节[39] != 97:
    抛出 新建 错误(规范)
  # fmt 体：fmt 块长 16 / PCM 格式 1 / 单声道 1
  如果 读小端(字节, 16, 4) != 16 或 读小端(字节, 20, 2) != 1 或 读小端(字节, 22, 2) != 1:
    抛出 新建 错误(规范)
  # 采样率 16000 / 字节率 32000 / 块对齐 2 / 位深 16
  如果 读小端(字节, 24, 4) != 16000 或 读小端(字节, 28, 4) != 32000:
    抛出 新建 错误(规范)
  如果 读小端(字节, 32, 2) != 2 或 读小端(字节, 34, 2) != 16:
    抛出 新建 错误(规范)
  # 长度自洽：RIFF 块长 = 总长-8 / data 块长 = 总长-44 / 数据偶对齐
  如果 读小端(字节, 4, 4) != 总长 - 8 或 读小端(字节, 40, 4) != 总长 - 44:
    抛出 新建 错误(规范)
  如果 (总长 - 44) % 2 != 0:
    抛出 新建 错误(规范)
  # 时长限流：PCM16 单声道 16kHz → 每秒 32000 字节
  设 秒 为 转浮点(总长 - 44) / 转浮点(32000)
  如果 秒 > 最大秒数:
    抛出 新建 错误("音频超过 " + 字符串(最大秒数) + " 秒上限")
  返回 空

# =====================================================================
# §3 配置形状（投影 index.ts Config：z.natural().min(46).default(4*1024*1024)
#   与 z.number().min(1).default(120)；zod 的拒绝语义投影为抛中文错）
# =====================================================================

# 返回校验后的配置字典；覆盖为空取默认，越下限抛错
段落 配置形状默认(覆盖):
  设 形状 为 ["maxAudioBytes": 4194304, "maxDurationSeconds": 120]
  如果 覆盖 != 空:
    如果 覆盖.包含("maxAudioBytes"):
      形状["maxAudioBytes"] 为 覆盖["maxAudioBytes"]
    如果 覆盖.包含("maxDurationSeconds"):
      形状["maxDurationSeconds"] 为 覆盖["maxDurationSeconds"]
  如果 形状["maxAudioBytes"] < 46:
    抛出 新建 错误("maxAudioBytes 不得小于 46")
  如果 形状["maxDurationSeconds"] < 1:
    抛出 新建 错误("maxDurationSeconds 不得小于 1")
  返回 形状

# =====================================================================
# §4 转写校验链（投影 index.ts:88-109 transcribe，逐段对齐）
#   入参：
#     请求        ["audioBase64": 串, "providerId": 可选, "language": 可选]
#     配置        配置形状默认 的产出
#     信号被中止  注入 () -> 真假（投影 AbortSignal.throwIfAborted）
#     识别转写    注入 (音频字节, 提供者, 语言) -> 稿本（投影 ctx.speechToText.resolve+transcribe）
#   错误码面：
#     speech/invalid-audio       入口长度预检（try 之外，不包装）
#     speech/aborted             入口中止（try 之外，透传不包装）
#     speech/transcription-failed  try 内一切错误的包装（中止则透抛）
# =====================================================================

段落 转写请求(请求, 配置, 信号被中止, 识别转写):
  # 信号 abort 先抛（对齐 signal.throwIfAborted()；在包装 try 之外）
  如果 信号被中止():
    抛出 新建 错误("speech/aborted: 请求已中止")
  设 编码 为 请求["audioBase64"]
  # base64 长度预检（对齐 index.ts:92-94；解码前拦截，报 speech/invalid-audio）
  设 预检上限 为 上取整(配置["maxAudioBytes"], 3) * 4
  如果 字符串长度(编码) > 预检上限:
    抛出 新建 错误("speech/invalid-audio: 音频无效或超过配置的字节上限（reason=encoding-or-size）")
  # 可选字段投影（dsh 用条件展开，这里用键存在性）
  设 提供者 为 空
  如果 请求.包含("providerId"):
    设 提供者 为 请求["providerId"]
  设 语言 为 空
  如果 请求.包含("language"):
    设 语言 为 请求["language"]
  # 解码（投影 Buffer.from(encoded, 'base64')）
  设 音频 为 音频解码(编码)
  尝试:
    # canonical base64 round-trip（对齐 index.ts:97）
    如果 音频编码(音频) != 编码:
      抛出 新建 错误("音频必须使用规范的 base64 编码")
    # 解码后字节数限流（对齐 index.ts:98）
    如果 列表长度(音频) > 配置["maxAudioBytes"]:
      抛出 新建 错误("音频超过配置的字节上限")
    # WAV 头与时长校验（对齐 index.ts:99）
    校验WAV(音频, 配置["maxDurationSeconds"])
    # 调识别器（对齐 index.ts:100-104 的 resolve+transcribe）
    返回 识别转写(音频, 提供者, 语言)
  捕获 原错:
    # 包装前若信号已中止则透抛（对齐 catch 里的 signal.throwIfAborted()）
    如果 信号被中止():
      抛出 原错
    # 任何错误包装成 speech/transcription-failed，原因取原始消息（对齐 index.ts:105-108）
    抛出 新建 错误("speech/transcription-failed: " + 转字符串(原错))

# =====================================================================
# §5 目录快照（投影 index.ts:43-46 catalog：{ ...snapshot, ...config }）
#   注入的 识别器快照() 返回字典；浅拷贝后写入配置限额（配置后写，同名键覆盖快照）。
# =====================================================================

段落 目录快照(识别器快照, 配置):
  设 原快照 为 识别器快照()
  设 快照 为 {}
  遍历 键名 之 字典键列表(原快照):
    快照[键名] 为 原快照[键名]
  快照["maxAudioBytes"] 为 配置["maxAudioBytes"]
  快照["maxDurationSeconds"] 为 配置["maxDurationSeconds"]
  返回 快照

# =====================================================================
# §6 薄转发四段（对齐 index.ts:53-80）
#   follow / configure / prepare / cancelPreparation 在 dsh 里只是薄转发到
#   ctx.speechToText，无新逻辑；光明侧导出同名段落，全部调注入字典里的同名函数，
#   不自建状态机。流式 follow 的分帧属 typert 宿主协议，不移植。
# =====================================================================

段落 follow(通道, 信号):
  返回 通道["follow"](信号)

段落 configure(通道, 偏好):
  返回 通道["configure"](偏好)

段落 prepare(通道, 提供者, 准备项):
  返回 通道["prepare"](提供者, 准备项)

段落 cancelPreparation(通道, 提供者):
  返回 通道["cancelPreparation"](提供者)

# =====================================================================
# §7 挂载（Remote 控制器装配的投影）
#   本插件不注册成模型工具（它是 Web Remote 控制器，不是模型可调工具），
#   而是把 目录快照 / 转写请求 注册成绳（绳构造注册），供绳装配归一可见。
#   识别器通道同时存入模块状态，供宿主侧装配读取。
# =====================================================================

段落 挂载(注册表, 识别器通道):
  状态["通道"] 为 识别器通道
  设 目录输入 为 ["type": "object", "properties": {}]
  设 目录输出 为 ["type": "object", "description": "SpeechCatalog：识别器快照 + maxAudioBytes + maxDurationSeconds"]
  设 快照绳 为 绳构造注册("speechController.catalog", "读取可用语音识别器与录音限额（不入会话）", "catalog", "空", 目录输入, 目录输出)
  注册表.追加(快照绳)
  设 音频字段 为 ["type": "string", "description": "规范 base64 编码的 16kHz 单声道 PCM16 WAV 录音"]
  设 提供者字段 为 ["type": "string", "description": "可选；指定识别器"]
  设 语言字段 为 ["type": "string", "description": "可选；语言提示"]
  设 转写输入 为 ["type": "object", "properties": ["audioBase64": 音频字段, "providerId": 提供者字段, "language": 语言字段], "required": ["audioBase64"]]
  设 稿本输出 为 ["type": "object", "description": "Transcript：一次性转写稿本（不进会话事件、不存附件）"]
  设 转写绳 为 绳构造注册("speechController.transcribe", "校验并转写一段浏览器录音", "transcribe", "request", 转写输入, 稿本输出)
  注册表.追加(转写绳)
  返回 真

# =====================================================================
# 导出
# =====================================================================

导出 配置形状默认
导出 校验WAV
导出 转写请求
导出 目录快照
导出 follow
导出 configure
导出 prepare
导出 cancelPreparation
导出 挂载
导出 音频编码
导出 音频解码
导出 向下整除
导出 上取整
