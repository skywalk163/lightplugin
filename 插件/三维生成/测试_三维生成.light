# 测试_三维生成.light —— P2-1 三维生成 的正例与反例
# 与图片生成同构（都依赖异步作业轮询底座），但参数域是「格式 + 精度」双域。

从 三维生成 导入 绑定建模器, 取建模器, 有效格式, 有效精度, 默认格式, 默认精度, 提交三维作业, 生成三维, 挂载
从 异步作业轮询 导入 查询作业
从 工具 导入 工具注册表
# stdlib 模块函数必须显式导入（见 语言缺陷反馈.md LP-D-002）
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性建模器 1：一次就完成 ----
段落 立即建模(提示词, 格式, 精度):
  返回 ["完成": 真, "资产": "http://model.test/a.glb", "原因": ""]

# ---- 确定性建模器 2：前两次未完成，第三次完成（验证多轮轮询）----
# 注：「尝试」是光明保留字，不可作变量名，故用 建模计数
设 建模计数 为 ["次数": 0]

段落 三轮建模(提示词, 格式, 精度):
  建模计数["次数"] 为 建模计数["次数"] + 1
  如果 建模计数["次数"] >= 3:
    返回 ["完成": 真, "资产": "http://model.test/c.obj", "原因": ""]
  返回 ["完成": 假, "资产": "", "原因": "排队中"]

# ---- 确定性建模器 3：永不完成（验证超时边界）----
段落 永不建模(提示词, 格式, 精度):
  返回 ["完成": 假, "资产": "", "原因": "服务繁忙"]

# ---- 确定性建模器 4：参数透传探针（把收到的参数记下来）----
设 探针 为 ["提示词": "", "格式": "", "精度": "", "调用次数": 0]

段落 探针建模(提示词, 格式, 精度):
  探针["提示词"] 为 提示词
  探针["格式"] 为 格式
  探针["精度"] 为 精度
  探针["调用次数"] 为 探针["调用次数"] + 1
  返回 ["完成": 真, "资产": "http://model.test/p.usdz", "原因": ""]

段落 主:
  # ---- 1. 两个参数域的校验 ----
  断言为真(有效格式("glb"), "glb 应有效")
  断言为真(有效格式("obj"), "obj 应有效")
  断言为真(有效格式("usdz"), "usdz 应有效")
  断言为假(有效格式("fbx"), "fbx 不在白名单应无效")
  断言为真(有效精度("低"), "低 应有效")
  断言为真(有效精度("高"), "高 应有效")
  断言为假(有效精度("极高"), "极高 不在白名单应无效")
  断言相等(默认格式(), "glb", "默认格式应为 glb")
  断言相等(默认精度(), "中", "默认精度应为 中")

  # ---- 2. 提交作业 ----
  设 编号 为 提交三维作业("一把木制的椅子")
  断言为真(编号 != "", "合法参数应返回作业号")
  断言相等(查询作业(编号)["名字"], "三维生成", "作业名应为三维生成")
  断言相等(查询作业(编号)["状态"], "待处理", "初始状态应为待处理")

  # ---- 3. 反例：三类非法参数都不应产生作业 ----
  断言相等(提交三维作业(""), "", "空提示词应返回空")
  断言相等(提交三维作业("椅子", "fbx", "中"), "", "非法格式应返回空")
  断言相等(提交三维作业("椅子", "glb", "极高"), "", "非法精度应返回空")

  # ---- 4. 生成（立即完成）----
  设 结果 为 生成三维("一把木制的椅子", 立即建模, 3)
  断言为真(结果["终"], "立即建模应达成终态")
  断言相等(结果["记录"]["状态"], "成功", "终态应为成功")
  断言相等(结果["记录"]["结果"], "http://model.test/a.glb", "结果应为资产地址")

  # ---- 5. 生成（多轮才完成）----
  建模计数["次数"] 为 0
  设 多轮 为 生成三维("黄昏的山脉", 三轮建模, 6)
  断言为真(多轮["终"], "多轮建模应最终达成")
  断言相等(多轮["记录"]["结果"], "http://model.test/c.obj", "多轮结果地址")
  断言为真(建模计数["次数"] >= 3, "建模器应被推进至少 3 次")

  # ---- 6. 反例：一直不完成 → 超时 ----
  设 超时 为 生成三维("永不出的模型", 永不建模, 2)
  断言为假(超时["终"], "永不推进应超时")
  断言相等(超时["原因"], "轮询超时", "超时原因")

  # ---- 7. 反例：参数不合法时不进入轮询 ----
  设 非法 为 生成三维("", 立即建模, 3)
  断言为假(非法["终"], "空提示词应失败")
  断言相等(非法["原因"], "参数不合法（提示词为空、格式或精度不受支持）", "参数校验原因")
  断言相等(非法["轮次"], 0, "非法参数不应消耗轮询轮次")

  # ---- 8. 参数透传：格式与精度应原样送达建模器 ----
  设 透传 为 生成三维("一只展翅的鹰", 探针建模, 3, "usdz", "高")
  断言为真(透传["终"], "透传用例应达成终态")
  断言相等(探针["提示词"], "一只展翅的鹰", "提示词应透传")
  断言相等(探针["格式"], "usdz", "格式应透传")
  断言相等(探针["精度"], "高", "精度应透传")
  断言相等(探针["调用次数"], 1, "建模器应被调用一次")

  # ---- 9. 挂载：绑定建模器后工具可用；未绑定应明确报错 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表, 立即建模)
  断言为真(注册表.登记表.包含("三维生成"), "三维生成应注册")
  设 定义 为 注册表.登记表["三维生成"]
  设 参 为 ["提示词": "白色的猫", "格式": "glb", "精度": "低"]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "绑定建模器后应成功")
  断言为真(子串位置(产出["content"], "http://model.test/a.glb") >= 0, "产出应含资产地址")

  设 空注册表 为 新建 工具注册表()
  绑定建模器(空)
  挂载(空注册表)
  设 空定义 为 空注册表.登记表["三维生成"]
  设 参2 为 ["提示词": "黑色的猫"]
  断言为真(空定义["execute"](参2)["isError"], "未绑定建模器应报错")

  打印 "测试_三维生成 全部通过"

主()
