# 三维生成.light —— Tool Plugin 形态（文本 → 3D 资产）的光明复刻（P2-1）
#
# 依赖：异步作业轮询（P0-1 底座）。与「图片生成」同构：
#       本模块不重复实现作业表与轮询策略，只负责「三维生成」这个具体能力的
#       参数校验 → 登记作业 → 驱动轮询 → 取回资产地址。
#
# 设计：真正的建模 API **不写死在插件里**，而是注入「建模器」函数。
#   建模器签名：(提示词, 格式, 精度) -> ["完成": 真假, "资产": 地址或空, "原因": 说明]
#   宿主可接真实文生 3D 服务（如 Tripo / Meshy 一类），测试注入确定性建模器
#   → 零网络、零计时 flaky。
#   挂载时通过 挂载(注册表, 建模器) 绑定，模型侧工具即完成闭环。
#
# 与图片生成的差异（不是无脑复制）：
#   图片是「单参数域（尺寸）」；三维是「双参数域（交付格式 + 建模精度）」，
#   且这两个域正交 —— 格式影响产物后缀与下游可用性，精度影响耗时与计费。
#   因此校验拆成 有效格式 / 有效精度 两个独立段落，便于宿主按需收紧其一。
#
# 光明限制遵守：
#   L-047  字典/列表字面量不可直接作实参 → 先赋变量。
#   L-044  含「文本」的标识符会被拆名 → 命名避开（用 提示词/资产/原因）。
#   字符串 `{...}` 是插值 → 不写字面花括号（LP-D-001）。
#   可变状态与建模器句柄放**模块级字典**（元素赋值天然共享，无需『全局』）。
#   变量名不得用中文数字（会被当整数字面量）；不得用保留字。

从 异步作业轮询 导入 提交作业, 查询作业, 完成作业, 失败作业, 轮询直到终态
从 工具 导入 造工具定义, 造工具结果

设 配置 为 ["建模器": 空]

# ---------- 建模器绑定 ----------
段落 绑定建模器(建模器):
  配置["建模器"] 为 建模器
  返回 真

段落 取建模器():
  返回 配置["建模器"]

# ---------- 参数校验（两个正交参数域）----------
段落 有效格式(格式):
  设 允许 为 ["glb": 真, "obj": 真, "usdz": 真]
  返回 允许.包含(格式)

段落 有效精度(精度):
  设 允许 为 ["低": 真, "中": 真, "高": 真]
  返回 允许.包含(精度)

段落 默认格式():
  返回 "glb"

段落 默认精度():
  返回 "中"

段落 提交三维作业(提示词, 格式="glb", 精度="中"):
  如果 提示词 == "":
    返回 ""
  如果 有效格式(格式) == 假:
    返回 ""
  如果 有效精度(精度) == 假:
    返回 ""
  设 参数表 为 ["提示词": 提示词, "格式": 格式, "精度": 精度]
  返回 提交作业("三维生成", 参数表)

# ---------- 轮询推进（被 异步作业轮询.轮询直到终态 回调）----------
段落 建模推进(作业号):
  设 建模器 为 配置["建模器"]
  如果 建模器 == 空:
    返回 空
  设 记录 为 查询作业(作业号)
  如果 记录 == 空:
    返回 空
  设 产出 为 建模器(记录["参数"]["提示词"], 记录["参数"]["格式"], 记录["参数"]["精度"])
  如果 产出["完成"] == 真:
    完成作业(作业号, 产出["资产"])
  返回 空

# ---------- 主流程 ----------
段落 生成三维(提示词, 建模器, 最大轮次=3, 格式="glb", 精度="中"):
  绑定建模器(建模器)
  设 编号 为 提交三维作业(提示词, 格式, 精度)
  如果 编号 == "":
    返回 ["终": 假, "原因": "参数不合法（提示词为空、格式或精度不受支持）", "轮次": 0, "记录": 空]
  返回 轮询直到终态(编号, 最大轮次, 建模推进)

# ---------- 模型可见工具 ----------
段落 三维生成模式():
  返回 ["type": "object",
        "properties": ["提示词": ["type": "string", "description": "描述要生成的三维物体"],
                       "格式": ["type": "string", "description": "交付格式：glb / obj / usdz"],
                       "精度": ["type": "string", "description": "建模精度：低 / 中 / 高"]],
        "required": ["提示词"]]

段落 三维生成处理(参数):
  如果 配置["建模器"] == 空:
    返回 造工具结果("未绑定建模器，无法调用外部三维生成服务", 真)
  设 格式 为 默认格式()
  如果 参数.包含("格式"):
    设 格式 为 参数["格式"]
  设 精度 为 默认精度()
  如果 参数.包含("精度"):
    设 精度 为 参数["精度"]
  设 结果 为 生成三维(参数["提示词"], 配置["建模器"], 3, 格式, 精度)
  如果 结果["终"] == 真:
    返回 造工具结果("生成完成: " + 结果["记录"]["结果"], 假)
  返回 造工具结果("生成未完成: " + 结果["原因"], 真)

段落 挂载(注册表, 建模器=空):
  如果 建模器 != 空:
    绑定建模器(建模器)
  注册表.注册(造工具定义("三维生成", "根据描述生成三维资产（异步作业驱动）", 三维生成模式(), 三维生成处理))
  返回 真

导出 绑定建模器
导出 取建模器
导出 有效格式
导出 有效精度
导出 默认格式
导出 默认精度
导出 提交三维作业
导出 建模推进
导出 生成三维
导出 挂载
