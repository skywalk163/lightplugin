# 测试_语音输入前端.light —— P3-2 语音输入前端 的正例与反例
# 纯状态机：不碰音频字节、不依赖真实计时，全程确定性。

从 语音输入前端 导入 配置阈值, 取状态, 取帧数, 取峰值, 开始录音, 停止录音, 复位, 采样, 采样序列, 取分片, 分片数, 录音摘要, 挂载
从 工具 导入 工具注册表
# stdlib 模块函数必须显式导入（见 语言缺陷反馈.md LP-D-002）
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # ---- 1. 配置阈值 ----
  断言为真(配置阈值(5, 10, 3000, 300), "合法配置应成功")
  断言为假(配置阈值(-1, 10, 3000, 300), "负静音阈值应失败")
  断言为假(配置阈值(5, 0, 3000, 300), "静音连击上限为 0 应失败")
  断言为假(配置阈值(5, 10, 0, 300), "最长帧数为 0 应失败")
  断言为假(配置阈值(5, 10, 3000, 0), "每片帧数为 0 应失败")

  # ---- 2. 生命周期 ----
  复位()
  断言相等(取状态(), "空闲", "复位后应为空闲")
  开始录音()
  断言相等(取状态(), "录音中", "开始后应为录音中")
  断言相等(取帧数(), 0, "开始后帧数应为 0")

  # ---- 3. 采样与峰值 ----
  设 动作 为 采样(80)
  断言相等(动作["动作"], "继续", "有声帧应继续")
  断言相等(取帧数(), 1, "采样一帧后帧数应为 1")
  断言相等(取峰值(), 80, "峰值应记录")
  设 动作2 为 采样(30)
  断言相等(取峰值(), 80, "更小的音量不应覆盖峰值")

  # ---- 4. 静音自动停止 ----
  复位()
  开始录音()
  设 静音表 为 []
  设 甲 为 0
  当 甲 < 12:
    静音表.追加(0)
    甲 为 甲 + 1
  设 轨迹 为 采样序列(静音表)
  断言相等(轨迹[9], "静音停止", "第 10 个静音帧应触发静音停止")
  断言相等(取状态(), "已停止", "静音停止后状态应为已停止")

  # ---- 5. 有声帧会重置静音连击（不会误停）----
  复位()
  开始录音()
  设 混合 为 [0, 0, 0, 0, 0, 50, 0, 0, 0, 0, 0]
  设 轨迹2 为 采样序列(混合)
  遍历 项 之 轨迹2:
    断言相等(项, "继续", "中途有声帧应重置连击，不应停止")

  # ---- 6. 超时强制停止优先于静音 ----
  复位()
  断言为真(配置阈值(5, 10, 20, 300), "把最长帧数调小以便测超时")
  开始录音()
  设 长表 为 []
  设 乙 为 0
  当 乙 < 25:
    长表.追加(60)
    乙 为 乙 + 1
  设 轨迹3 为 采样序列(长表)
  断言相等(轨迹3[19], "超时停止", "第 20 帧应触发超时停止")
  断言相等(取状态(), "已停止", "超时后应为已停止")
  断言为真(配置阈值(5, 10, 3000, 300), "恢复默认阈值")

  # ---- 7. 分片切分 ----
  复位()
  断言为真(配置阈值(5, 100, 3000, 10), "每片 10 帧便于验证")
  开始录音()
  设 丙 为 0
  当 丙 < 25:
    采样(60)
    丙 为 丙 + 1
  断言相等(分片数(), 2, "25 帧按每片 10 帧应已切出 2 片")
  停止录音()
  断言相等(分片数(), 3, "停止时残余 5 帧应补为第 3 片（否则尾音会丢）")
  断言为真(配置阈值(5, 10, 3000, 300), "恢复默认阈值")

  # ---- 8. 反例：未开始就停止 / 停止后采样无效 ----
  复位()
  断言为假(停止录音(), "空闲时停止应失败")
  开始录音()
  停止录音()
  设 无效 为 采样(60)
  断言相等(无效["动作"], "继续", "已停止后采样不应推进")
  断言相等(取帧数(), 0, "已停止后帧数不应变化")

  # ---- 9. 摘要与挂载 ----
  复位()
  开始录音()
  采样(42)
  设 摘要 为 录音摘要()
  断言相等(摘要["状态"], "录音中", "摘要状态")
  断言相等(摘要["帧数"], 1, "摘要帧数")
  断言相等(摘要["峰值"], 42, "摘要峰值")

  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("录音控制"), "录音控制应注册")
  设 定义 为 注册表.登记表["录音控制"]

  设 参 为 ["动作": "状态"]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "查询状态不应报错")
  断言为真(子串位置(产出["content"], "录音中") >= 0, "产出应含状态")

  设 参停 为 ["动作": "停止"]
  设 产出停 为 定义["execute"](参停)
  断言为假(产出停["isError"], "停止不应报错")
  断言为真(子串位置(产出停["content"], "个分片") >= 0, "停止产出应含分片数")

  设 参坏 为 ["动作": "乱来"]
  断言为真(定义["execute"](参坏)["isError"], "未知动作应报错")

  设 参采 为 ["动作": "采样"]
  断言为真(定义["execute"](参采)["isError"], "采样缺少音量应报错")

  打印 "测试_语音输入前端 全部通过"

主()
