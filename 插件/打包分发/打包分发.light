# 打包分发.light —— dsh packages/bundle 的光明复刻（P8 第 9 批）
#
# 能力：产物登记 / 依赖去重收集 / 版本登记 / 清单合并；真正的打包动作委托给**注入式打包器**。
#
# 设计取舍：**不碰磁盘、不碰网络**。
#   打包器是注入的段落引用：宿主可接真实 tarball / zip 写入，测试接确定性假打包器。
#   这样反例（缺名字、空清单、未注入打包器）都能被精确断言，且无计时 flaky。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作实参 → 一律先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 命名避开（用 内容/摘要/产物/负载）。
#   LP-D-013 变量不要命名为「出」（`出.追加(...)` 会报无法识别的 '.'）→ 用 结果表/条目们。
#   LP-D-010 遍历变量名不要与循环体内调用的函数同名 → 用 项/条目。
#   LP-D-014 `全局 X。` 只能写在段落体内；模块顶层直接 `设 X 为 ...`。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 去空格
从 内置核心字典 导入 字典键列表

设 产物表 为 {}
设 版本表 为 {}
设 默认打包器 为 空

# ---------- 校验 ----------
段落 判定合法名(名字):
  如果 名字 == 空:
    返回 "名字为空"
  设 紧凑 为 去空格(名字)
  如果 紧凑 == "":
    返回 "名字为空"
  返回 "ok"

段落 判定合法版本(版本):
  如果 版本 == 空:
    返回 "版本为空"
  设 紧凑 为 去空格(版本)
  如果 紧凑 == "":
    返回 "版本为空"
  返回 "ok"

# ---------- 依赖串 → 列表（保序去重） ----------
段落 解析依赖(依赖串):
  设 结果表 为 []
  如果 依赖串 == 空:
    返回 结果表
  设 段们 为 分割字符串(依赖串, ",")
  遍历 项 之 段们:
    设 名 为 去空格(项)
    如果 名 != "":
      如果 结果表.包含(名) == 假:
        结果表.追加(名)
  返回 结果表

# ---------- 登记 / 查询 / 移除 ----------
段落 登记产物(名字, 版本, 路径="", 依赖串=""):
  设 校验 为 判定合法名(名字)
  如果 校验 != "ok":
    返回 ["ok": 假, "原因": 校验, "产物": 空]
  设 校验2 为 判定合法版本(版本)
  如果 校验2 != "ok":
    返回 ["ok": 假, "原因": 校验2, "产物": 空]
  设 依赖们 为 解析依赖(依赖串)
  设 记录 为 ["名字": 名字,
              "版本": 版本,
              "路径": 路径,
              "依赖": 依赖们]
  产物表[名字] 为 记录
  版本表[名字] 为 版本
  返回 ["ok": 真, "原因": "", "产物": 记录]

段落 取产物(名字):
  如果 产物表.包含(名字) == 假:
    返回 空
  返回 产物表[名字]

段落 取版本(名字):
  如果 版本表.包含(名字) == 假:
    返回 ""
  返回 版本表[名字]

段落 移除产物(名字):
  如果 产物表.包含(名字) == 假:
    返回 假
  产物表.弹出(名字)
  版本表.弹出(名字)
  返回 真

段落 产物名列表():
  返回 字典键列表(产物表)

# ---------- 依赖收集：跨全部产物去重 ----------
段落 收集依赖():
  设 结果表 为 []
  设 键们 为 字典键列表(产物表)
  遍历 项 之 键们:
    设 记录 为 产物表[项]
    遍历 条目 之 记录["依赖"]:
      如果 结果表.包含(条目) == 假:
        结果表.追加(条目)
  返回 结果表

# ---------- 清单合并 ----------
段落 合并清单():
  设 条目们 为 []
  设 键们 为 字典键列表(产物表)
  遍历 项 之 键们:
    设 记录 为 产物表[项]
    设 依赖串 为 连接字符串(记录["依赖"], ",")
    设 一行 为 记录["名字"] + "@" + 记录["版本"] + " | " + 记录["路径"] + " | 依赖:" + 依赖串
    条目们.追加(一行)
  设 清单 为 ["产物数": 长(键们),
              "条目": 条目们,
              "依赖": 收集依赖(),
              "版本表": 版本表]
  返回 清单

段落 清单摘要(清单):
  设 头 为 "产物数=" + 字符串(清单["产物数"])
  设 依赖串 为 连接字符串(清单["依赖"], ",")
  设 正文 为 连接字符串(清单["条目"], "\n")
  返回 头 + "\n依赖汇总: " + 依赖串 + "\n" + 正文

# ---------- 注入式打包器 ----------
段落 设置打包器(打包器):
  全局 默认打包器。
  默认打包器 为 打包器
  返回 真

段落 执行打包(清单, 打包器):
  全局 默认打包器。
  设 实际器 为 打包器
  如果 实际器 == 空:
    实际器 为 默认打包器
  如果 实际器 == 空:
    返回 ["ok": 假, "原因": "未注入打包器", "产出": ""]
  设 产出 为 实际器(清单)
  返回 ["ok": 真, "原因": "", "产出": 产出]

# ---------- 模型可见工具 ----------
段落 登记产物模式():
  返回 ["type": "object",
        "properties": ["名字": ["type": "string", "description": "产物名称，必填"],
                       "版本": ["type": "string", "description": "产物版本号，必填"],
                       "路径": ["type": "string", "description": "产物相对路径，可空"],
                       "依赖": ["type": "string", "description": "依赖列表，英文逗号分隔，可空"]],
        "required": ["名字", "版本"]]

段落 登记产物处理(参数):
  设 名字 为 参数["名字"]
  设 版本 为 参数["版本"]
  设 路径 为 ""
  如果 参数.包含("路径") == 真:
    路径 为 参数["路径"]
  设 依赖串 为 ""
  如果 参数.包含("依赖") == 真:
    依赖串 为 参数["依赖"]
  设 登记 为 登记产物(名字, 版本, 路径, 依赖串)
  如果 登记["ok"] == 假:
    返回 造工具结果("登记失败: " + 登记["原因"], 真)
  设 记录 为 登记["产物"]
  设 依赖串2 为 连接字符串(记录["依赖"], ",")
  设 摘要 为 "已登记产物 " + 记录["名字"] + "@" + 记录["版本"] + " 路径=" + 记录["路径"] + " 依赖=" + 依赖串2
  返回 造工具结果(摘要, 假)

段落 生成清单模式():
  返回 ["type": "object",
        "properties": ["标题": ["type": "string", "description": "清单标题，可空"]],
        "required": []]

段落 生成清单处理(参数):
  设 清单 为 合并清单()
  如果 清单["产物数"] == 0:
    返回 造工具结果("产物清单为空，请先登记产物", 真)
  设 正文 为 清单摘要(清单)
  设 打包 为 执行打包(清单, 空)
  如果 打包["ok"] == 假:
    设 正文 为 正文 + "\n（未注入打包器，仅返回清单本身）"
    返回 造工具结果(正文, 假)
  设 前缀 为 ""
  如果 参数.包含("标题") == 真:
    如果 参数["标题"] != "":
      设 前缀 为 "[" + 参数["标题"] + "]\n"
  返回 造工具结果(前缀 + 打包["产出"], 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("登记产物", "把一个产物（名字/版本/路径/依赖）登记进打包清单", 登记产物模式(), 登记产物处理))
  注册表.注册(造工具定义("生成清单", "合并已登记产物，生成依赖去重后的打包清单", 生成清单模式(), 生成清单处理))
  返回 真

导出 判定合法名
导出 判定合法版本
导出 解析依赖
导出 登记产物
导出 取产物
导出 取版本
导出 移除产物
导出 产物名列表
导出 收集依赖
导出 合并清单
导出 清单摘要
导出 设置打包器
导出 执行打包
导出 挂载
