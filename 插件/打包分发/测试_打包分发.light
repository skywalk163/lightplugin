# 测试_打包分发.light —— P8 打包分发 的正例与反例
#
# 零磁盘、零网络：打包动作委托给注入的确定性假打包器。

从 打包分发 导入 判定合法名, 判定合法版本, 解析依赖, 登记产物, 取产物, 取版本, 移除产物, 产物名列表, 收集依赖, 合并清单, 清单摘要, 设置打包器, 执行打包, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性假打包器：只把清单规模编码成字符串，不做任何 IO ----
设 打包调用次数 为 0

段落 假打包器(清单):
  全局 打包调用次数。
  打包调用次数 为 打包调用次数 + 1
  返回 "BUNDLE|产物数=" + 字符串(清单["产物数"]) + "|依赖数=" + 字符串(长(清单["依赖"]))

段落 主:
  全局 打包调用次数。

  # ---- 1. 参数校验反例 ----
  断言相等(判定合法名(""), "名字为空", "空名字应报错")
  断言相等(判定合法名(空), "名字为空", "空值名字应报错")
  断言相等(判定合法名("  "), "名字为空", "纯空白名字应报错")
  断言相等(判定合法名("core"), "ok", "合法名字")
  断言相等(判定合法版本(""), "版本为空", "空版本应报错")
  断言相等(判定合法版本("1.0.0"), "ok", "合法版本")

  # ---- 2. 依赖解析：保序去重、跳过空项 ----
  设 依赖们 为 解析依赖("a, b,a ,, c")
  断言相等(长(依赖们), 3, "依赖去重后应有 3 项")
  断言相等(依赖们[0], "a", "依赖首项")
  断言相等(依赖们[1], "b", "依赖次项")
  断言相等(依赖们[2], "c", "依赖末项")
  断言相等(长(解析依赖(空)), 0, "空依赖串应返回空列表")

  # ---- 3. 登记产物（正例） ----
  设 登记 为 登记产物("core", "1.0.0", "dist/core.js", "lodash, zlib")
  断言为真(登记["ok"], "登记应成功")
  断言相等(登记["产物"]["名字"], "core", "登记名回读")
  断言相等(登记["产物"]["版本"], "1.0.0", "登记版本回读")
  断言相等(长(登记["产物"]["依赖"]), 2, "登记依赖数")
  断言相等(取产物("core")["路径"], "dist/core.js", "产物路径回读")

  # ---- 4. 版本登记 ----
  断言相等(取版本("core"), "1.0.0", "版本登记回读")
  断言相等(取版本("不存在"), "", "未登记产物版本应为空串")

  # ---- 5. 反例：缺名字 / 缺版本 ----
  设 无名 为 登记产物("", "1.0.0")
  断言为假(无名["ok"], "缺名字应登记失败")
  断言相等(无名["原因"], "名字为空", "缺名字原因")
  设 无版 为 登记产物("core2", "")
  断言为假(无版["ok"], "缺版本应登记失败")
  断言相等(无版["原因"], "版本为空", "缺版本原因")

  # ---- 6. 覆盖登记：同名产物版本被刷新 ----
  登记产物("ui", "0.1.0", "dist/ui.js", "core")
  登记产物("ui", "0.2.0", "dist/ui2.js", "core, react")
  断言相等(长(产物名列表()), 2, "产物总数应为 2（同名覆盖）")
  断言相等(取版本("ui"), "0.2.0", "同名登记后版本被刷新")
  断言相等(取产物("ui")["路径"], "dist/ui2.js", "同名登记后路径被刷新")

  # ---- 7. 依赖收集：跨产物去重 ----
  设 汇总 为 收集依赖()
  断言相等(长(汇总), 4, "跨产物依赖去重后应为 4 项")
  断言为真(汇总.包含("core"), "汇总应含 core")
  断言为真(汇总.包含("lodash"), "汇总应含 lodash")
  断言为真(汇总.包含("zlib"), "汇总应含 zlib")
  断言为真(汇总.包含("react"), "汇总应含 react")

  # ---- 8. 清单合并 ----
  设 清单 为 合并清单()
  断言相等(清单["产物数"], 2, "清单产物数")
  断言相等(长(清单["条目"]), 2, "清单条目数")
  设 摘要 为 清单摘要(清单)
  断言为真(包含(摘要, "产物数=2"), "摘要应含产物数")
  断言为真(包含(摘要, "core@1.0.0"), "摘要应含 core 条目")

  # ---- 9. 移除产物 ----
  断言为真(移除产物("ui"), "移除已登记产物应成功")
  断言为假(移除产物("ui"), "重复移除应失败")
  断言相等(长(产物名列表()), 1, "移除后产物数应为 1")
  断言为假(收集依赖().包含("react"), "移除后 react 依赖应消失")

  # ---- 10. 未注入打包器 → 反例 ----
  设 未注入 为 执行打包(清单, 空)
  断言为假(未注入["ok"], "未注入打包器应失败")
  断言相等(未注入["原因"], "未注入打包器", "未注入原因")

  # ---- 11. 注入打包器后被调用 ----
  打包调用次数 为 0
  断言为真(设置打包器(假打包器), "设置打包器应返回真")
  设 打包 为 执行打包(清单, 空)
  断言为真(打包["ok"], "注入后打包应成功")
  断言相等(打包调用次数, 1, "打包器应被调用一次")
  断言相等(打包["产出"], "BUNDLE|产物数=2|依赖数=4", "打包产出内容")

  # ---- 12. 显式传入打包器优先于默认打包器 ----
  设 打包2 为 执行打包(清单, 假打包器)
  断言相等(打包调用次数, 2, "显式打包器也应被调用")

  # ---- 13. 挂载进注册表并端到端执行 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("登记产物"), "登记产物应已注册")
  断言为真(注册表.登记表.包含("生成清单"), "生成清单应已注册")

  设 登记定义 为 注册表.登记表["登记产物"]
  设 入参 为 ["名字": "api", "版本": "2.0.0", "路径": "dist/api.js", "依赖": "core, http"]
  设 产出 为 登记定义["execute"](入参)
  断言为假(产出["isError"], "合法登记不应报错")
  断言为真(包含(产出["content"], "api@2.0.0"), "登记产出应含名字版本")

  设 坏参 为 ["名字": "", "版本": "1.0"]
  设 坏产出 为 登记定义["execute"](坏参)
  断言为真(坏产出["isError"], "缺名字登记应报错")
  断言为真(包含(坏产出["content"], "名字为空"), "缺名字报错原因")

  设 清单定义 为 注册表.登记表["生成清单"]
  设 清单参 为 ["标题": "发行版"]
  设 清单产出 为 清单定义["execute"](清单参)
  断言为假(清单产出["isError"], "生成清单不应报错")
  断言为真(包含(清单产出["content"], "[发行版]"), "清单应带标题前缀")
  断言为真(包含(清单产出["content"], "BUNDLE|"), "清单应经打包器产出")

  打印 "测试_打包分发 全部通过"

主()
