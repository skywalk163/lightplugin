# 测试_安全守卫策略.light —— P1 安全守卫策略 的正例与反例
# 本插件是「策略层」：只出判定，不拦人；是否拦截由调用方按等级决策。

从 安全守卫策略 导入 判定命令风险, 判定路径风险, 判定网址风险, 风险排序值, 取最高风险, 综合评级, 是否需审批, 守卫判定, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # ---- 1. 命令风险 ----
  断言相等(判定命令风险("rm -rf /tmp/x"), "高危", "rm -rf 应高危")
  断言相等(判定命令风险("sudo ls"), "中危", "sudo 应中危")
  断言相等(判定命令风险("ls -l"), "低危", "普通命令应低危")

  # ---- 2. 路径风险 ----
  断言相等(判定路径风险("/etc/passwd"), "高危", "/etc 应高危")
  断言相等(判定路径风险("C:/Windows/System32/x"), "高危", "系统目录应高危")
  断言相等(判定路径风险("项目/../其他"), "中危", "含 .. 应中危")
  断言相等(判定路径风险("项目/文档.md"), "低危", "普通路径应低危")

  # ---- 3. 网址风险 ----
  断言相等(判定网址风险("http://a.com"), "中危", "明文 http 应中危")
  断言相等(判定网址风险("https://a.com"), "低危", "https 应低危")
  断言相等(判定网址风险("ftp://a.com"), "高危", "非 http 协议应高危")
  断言相等(判定网址风险(""), "低危", "空网址应低危")

  # ---- 4. 排序与取最高 ----
  断言相等(风险排序值("高危"), 3, "高危排序值")
  断言相等(风险排序值("低危"), 1, "低危排序值")
  设 混合 为 ["低危", "高危", "中危"]
  断言相等(取最高风险(混合), "高危", "混合取最高")
  断言相等(取最高风险(["低危", "低危"]), "低危", "全低危取低危")

  # ---- 5. 综合评级：取三项最高 ----
  设 评级 为 综合评级("ls -l", "项目/文档.md", "https://a.com")
  断言相等(评级["综合"], "低危", "全低危综合为低危")
  设 评级2 为 综合评级("ls -l", "/etc/passwd", "https://a.com")
  断言相等(评级2["综合"], "高危", "路径高危则综合高危")
  断言相等(评级2["路径"], "高危", "明细路径")
  断言相等(评级2["命令"], "低危", "明细命令")

  # ---- 6. 是否需审批 ----
  断言为真(是否需审批("高危"), "高危需审批")
  断言为真(是否需审批("中危"), "中危需审批")
  断言为假(是否需审批("低危"), "低危不需审批")

  # ---- 7. 守卫判定 ----
  设 判定 为 守卫判定("rm -rf /", "项目/x", "https://a.com")
  断言相等(判定["等级"], "高危", "判定等级")
  断言为真(判定["需审批"], "高危需审批")
  断言为假(判定["放行"], "高危不应直接放行")
  设 放行判定 为 守卫判定("ls -l", "项目/x", "https://a.com")
  断言为真(放行判定["放行"], "低危应直接放行")
  断言为假(放行判定["需审批"], "低危不需审批")

  # ---- 8. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("风险判定"), "风险判定应注册")
  设 定义 为 注册表.登记表["风险判定"]
  设 危险参 为 ["命令": "rm -rf /", "路径": "", "网址": ""]
  设 危险产出 为 定义["execute"](危险参)
  断言为假(危险产出["isError"], "判定本身不应报错")
  断言为真(子串位置(危险产出["content"], "高危") >= 0, "危险命令应判为高危")
  设 安全参 为 ["命令": "ls -l", "路径": "项目/x", "网址": "https://a.com"]
  断言为真(子串位置(定义["execute"](安全参)["content"], "低危") >= 0, "安全组合应判为低危")

  打印 "测试_安全守卫策略 全部通过"

主()
