# 测试_技能运行时.light —— P0-4 技能运行时 的正例与反例

从 技能运行时 导入 登记技能, 技能清单, 是否已登记, 列举技能, 是否已加载, 取技能, 取加载次数, 取登记次数, 匹配技能, 渲染技能提示, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言不含键(字典, 键, 标签):
  如果 字典.包含(键):
    抛出 新建 错误("断言不含键失败 [" + 标签 + "]: 竟然含键 " + 键)

段落 主:
  # ---- 1. 登记 ----
  断言为真(登记技能("写周报", "按模板生成周报", "周报正文：先写进展再写风险"), "登记应成功")
  断言为真(登记技能("改错字", "校对中文错别字", "校对正文：检查同音字"), "登记第二个")
  断言相等(取登记次数(), 2, "登记次数")
  断言相等(长(技能清单()), 2, "技能清单长度")
  断言为真(是否已登记("写周报"), "已登记判定")

  # ---- 2. 渐进加载：初始未加载 ----
  断言为假(是否已加载("写周报"), "初始应未加载")
  断言相等(取加载次数(), 0, "初始加载次数为 0")

  # ---- 3. 列举只给元数据，绝不带正文（省 token / 防泄漏）----
  设 清单 为 列举技能()
  断言相等(长(清单), 2, "列举长度")
  设 首项 为 清单[0]
  断言相等(首项["name"], "写周报", "列举含 name")
  断言相等(首项["description"], "按模板生成周报", "列举含 description")
  断言不含键(首项, "正文", "列举**不得**携带正文")

  # ---- 4. 取用才载入 ----
  设 记录 为 取技能("写周报")
  断言相等(记录["名字"], "写周报", "取用返回名字")
  断言相等(记录["正文"], "周报正文：先写进展再写风险", "取用返回正文")
  断言为真(是否已加载("写周报"), "取用后应标记已加载")
  断言相等(取加载次数(), 1, "加载次数+1")
  断言为假(是否已加载("改错字"), "未取用的技能仍未加载")

  # ---- 5. 反例：取不存在的技能 ----
  断言相等(取技能("不存在的技能"), 空, "不存在应返回空")
  断言为假(是否已加载("不存在的技能"), "不存在的技能不应视为已加载")

  # ---- 6. 检索 ----
  设 命中1 为 匹配技能("周报")
  断言相等(长(命中1), 1, "按名字子串命中数")
  断言相等(命中1[0], "写周报", "命中项")
  设 命中2 为 匹配技能("校对")
  断言相等(命中2[0], "改错字", "按描述子串命中")
  断言相等(长(匹配技能("绝不匹配XYZ")), 0, "无命中返回空")

  # ---- 7. 提示渲染（含正文）----
  设 提示 为 渲染技能提示("改错字")
  断言为真(子串位置(提示, "改错字") >= 0, "提示含技能名")
  断言为真(子串位置(提示, "校对正文") >= 0, "提示含正文内容")
  断言相等(渲染技能提示("不存在的技能"), "", "不存在渲染为空")

  # ---- 8. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("技能列表"), "技能列表应注册")
  断言为真(注册表.登记表.包含("技能取用"), "技能取用应注册")
  设 列表定义 为 注册表.登记表["技能列表"]
  设 空参 为 []
  设 列表产出 为 列表定义["execute"](空参)
  断言为假(列表产出["isError"], "技能列表不应报错")
  断言为真(子串位置(列表产出["content"], "写周报") >= 0, "列表内容含技能名")
  断言为假(子串位置(列表产出["content"], "周报正文") >= 0, "列表内容不得含正文")

  设 取用定义 为 注册表.登记表["技能取用"]
  设 合法参 为 ["名字": "写周报"]
  断言为真(子串位置(取用定义["execute"](合法参)["content"], "周报正文") >= 0, "取用应含正文")
  设 非法参 为 ["名字": "不存在"]
  断言为真(取用定义["execute"](非法参)["isError"], "取用不存在应报错")

  打印 "测试_技能运行时 全部通过"

主()
