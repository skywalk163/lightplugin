# 视频生成.light —— Tool Plugin 形态（调外部 API）的光明复刻（P1）
#
# 依赖：异步作业轮询（P0-1 底座）。与「图片生成」同构：
#   参数校验 → 登记作业 → 轮询推进 → 取回结果。
#   差别只在参数域（时长 / 分辨率 / 是否含音频）与生成器契约。
#
# 生成器签名：(提示词, 时长) -> ["完成": 真假, "视频": 地址或空, "原因": 说明]
# 挂载时通过 挂载(注册表, 生成器) 绑定，模型侧工具即可闭环。
#
# 光明限制遵守：L-047 字面量不直接作实参 / L-044 避开「文本」/
#   字符串 `{...}` 是插值不写字面花括号 / 可变状态放模块级字典 /
#   变量名不用中文数字、不用保留字（尝试/捕获/如果/段落/返回/设/类…）。

从 异步作业轮询 导入 提交作业, 查询作业, 完成作业, 轮询直到终态
从 工具 导入 造工具定义, 造工具结果

设 配置 为 ["生成器": 空]

段落 绑定生成器(生成器):
  配置["生成器"] 为 生成器
  返回 真

段落 取生成器():
  返回 配置["生成器"]

# ---------- 参数校验 ----------
段落 有效时长(时长):
  设 允许 为 ["3": 真, "5": 真, "10": 真, "30": 真]
  返回 允许.包含(时长)

段落 提交视频作业(提示词, 时长="5"):
  如果 提示词 == "":
    返回 ""
  如果 有效时长(时长) == 假:
    返回 ""
  设 参数表 为 ["提示词": 提示词, "时长": 时长]
  返回 提交作业("视频生成", 参数表)

# ---------- 轮询推进（被 轮询直到终态 回调）----------
段落 视频推进(作业号):
  设 生成器 为 配置["生成器"]
  如果 生成器 == 空:
    返回 空
  设 记录 为 查询作业(作业号)
  如果 记录 == 空:
    返回 空
  设 产出 为 生成器(记录["参数"]["提示词"], 记录["参数"]["时长"])
  如果 产出["完成"] == 真:
    完成作业(作业号, 产出["视频"])
  返回 空

段落 生成视频(提示词, 生成器, 最大轮次=3):
  绑定生成器(生成器)
  设 编号 为 提交视频作业(提示词)
  如果 编号 == "":
    返回 ["终": 假, "原因": "参数不合法（提示词为空或时长不受支持）", "轮次": 0, "记录": 空]
  返回 轮询直到终态(编号, 最大轮次, 视频推进)

# ---------- 模型可见工具 ----------
段落 视频生成模式():
  返回 ["type": "object",
        "properties": ["提示词": ["type": "string", "description": "描述要生成的画面内容"],
                       "时长": ["type": "string", "description": "秒数，可选：3 / 5 / 10 / 30"]],
        "required": ["提示词"]]

段落 视频生成处理(参数):
  如果 配置["生成器"] == 空:
    返回 造工具结果("未绑定生成器，无法调用外部生视频服务", 真)
  设 时长 为 "5"
  如果 参数.包含("时长"):
    设 时长 为 参数["时长"]
  设 结果 为 生成视频(参数["提示词"], 配置["生成器"], 4)
  如果 结果["终"] == 真:
    返回 造工具结果("生成完成: " + 结果["记录"]["结果"], 假)
  返回 造工具结果("生成未完成: " + 结果["原因"], 真)

段落 挂载(注册表, 生成器=空):
  如果 生成器 != 空:
    绑定生成器(生成器)
  注册表.注册(造工具定义("视频生成", "根据描述生成视频（异步作业驱动）", 视频生成模式(), 视频生成处理))
  返回 真

导出 绑定生成器
导出 取生成器
导出 有效时长
导出 提交视频作业
导出 视频推进
导出 生成视频
导出 挂载
