# 测试_视频生成.light —— P1 视频生成 的正例与反例
# 依赖 P0-1 异步作业轮询（跨插件导入）

从 视频生成 导入 绑定生成器, 取生成器, 有效时长, 提交视频作业, 生成视频, 挂载
从 异步作业轮询 导入 查询作业
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 立即生成(提示词, 时长):
  返回 ["完成": 真, "视频": "http://v.test/a.mp4", "原因": ""]

设 生成计数 为 ["次数": 0]

段落 三轮生成(提示词, 时长):
  生成计数["次数"] 为 生成计数["次数"] + 1
  如果 生成计数["次数"] >= 3:
    返回 ["完成": 真, "视频": "http://v.test/c.mp4", "原因": ""]
  返回 ["完成": 假, "视频": "", "原因": "渲染中"]

段落 永不生成(提示词, 时长):
  返回 ["完成": 假, "视频": "", "原因": "队列拥堵"]

段落 主:
  # ---- 1. 时长白名单 ----
  断言为真(有效时长("5"), "默认 5 秒应有效")
  断言为真(有效时长("30"), "30 秒应有效")
  断言为假(有效时长("999"), "不支持时长应无效")

  # ---- 2. 提交作业 ----
  设 编号 为 提交视频作业("海浪拍打礁石")
  断言为真(编号 != "", "合法参数应返回作业号")
  断言相等(查询作业(编号)["名字"], "视频生成", "作业名")

  # ---- 3. 反例 ----
  断言相等(提交视频作业(""), "", "空提示词返回空")
  断言相等(提交视频作业("猫", "999"), "", "非法时长返回空")

  # ---- 4. 立即完成 ----
  设 结果 为 生成视频("海浪拍打礁石", 立即生成, 3)
  断言为真(结果["终"], "立即生成应达成")
  断言相等(结果["记录"]["结果"], "http://v.test/a.mp4", "结果地址")

  # ---- 5. 多轮完成 ----
  生成计数["次数"] 为 0
  设 多轮 为 生成视频("延时摄影", 三轮生成, 6)
  断言为真(多轮["终"], "多轮应最终达成")
  断言相等(多轮["记录"]["结果"], "http://v.test/c.mp4", "多轮结果")

  # ---- 6. 超时 ----
  设 超时 为 生成视频("永不出的视频", 永不生成, 2)
  断言为假(超时["终"], "永不推进应超时")
  断言相等(超时["原因"], "轮询超时", "超时原因")

  # ---- 7. 参数非法不入轮询 ----
  设 非法 为 生成视频("", 立即生成, 3)
  断言为假(非法["终"], "空提示词应失败")
  断言相等(非法["原因"], "参数不合法（提示词为空或时长不受支持）", "参数原因")

  # ---- 8. 挂载 + 绑定生成器 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表, 立即生成)
  断言为真(注册表.登记表.包含("视频生成"), "视频生成应注册")
  设 定义 为 注册表.登记表["视频生成"]
  设 参 为 ["提示词": "城市夜景", "时长": "10"]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "绑定后应成功")
  断言为真(子串位置(产出["content"], "http://v.test/a.mp4") >= 0, "产出含视频地址")

  # ---- 9. 未绑定生成器应报错 ----
  绑定生成器(空)
  设 空注册表 为 新建 工具注册表()
  挂载(空注册表)
  设 空参 为 ["提示词": "黑色猫"]
  断言为真(空注册表.登记表["视频生成"]["execute"](空参)["isError"], "未绑定应报错")

  打印 "测试_视频生成 全部通过"

主()
