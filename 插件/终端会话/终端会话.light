# 终端会话.light —— 对标 dsh packages/terminal 的「终端会话交互」能力
#
# 设计：会话状态机（新建 → 运行 → 关闭）+ 输入写入 + 累积输出读取，全部用纯逻辑实现，
#       真实 pty 由外部注入的「pty 驱动」提供（宿主接真实伪终端，测试注入确定性 fake），
#       因此单测零网络、零真实进程、零计时 flaky。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作函数实参 → 一律先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块命名避开「文本」（用 输出/内容）。
#   L-165/166 段落内写模块级标量须先写『全局 X。』，否则静默变局部变量（pty驱动/序号）。

从 工具 导入 造工具定义, 造工具结果

设 会话表 为 {}
设 会话序号 为 0
设 pty驱动 为 空

# ---------- pty 驱动注入（宿主接真实伪终端，测试传真回显）----------
段落 设定驱动(函数):
  全局 pty驱动。
  设 pty驱动 为 函数

# ---------- 编号 ----------
段落 新会话号():
  全局 会话序号。
  会话序号 为 会话序号 + 1
  返回 "TTY-" + 字符串(会话序号)

# ---------- 状态机：新建 → 运行 ----------
段落 新会话():
  设 编号 为 新会话号()
  设 记录 为 ["编号": 编号, "状态": "运行", "输出": ""]
  会话表[编号] 为 记录
  返回 编号

段落 查会话(编号):
  如果 会话表.包含(编号) == 假:
    返回 空
  返回 会话表[编号]

# ---------- 写入输入（注入式 pty 驱动把输入映射成输出并累积）----------
段落 写会话(编号, 输入):
  如果 会话表.包含(编号) == 假:
    返回 假
  设 记录 为 会话表[编号]
  如果 记录["状态"] != "运行":
    返回 假
  全局 pty驱动。
  设 产出 为 ""
  如果 pty驱动 != 空:
    设 产出 为 pty驱动(输入)
  否则:
    设 产出 为 输入
  设 记录["输出"] 为 记录["输出"] + 产出
  返回 真

# ---------- 读取累积输出 ----------
段落 读会话(编号):
  如果 会话表.包含(编号) == 假:
    返回 空
  返回 会话表[编号]["输出"]

# ---------- 关闭（清空缓冲、状态机 → 关闭）----------
段落 关会话(编号):
  如果 会话表.包含(编号) == 假:
    返回 假
  设 记录 为 会话表[编号]
  记录["状态"] 为 "关闭"
  记录["输出"] 为 ""
  返回 真

# ---------- 模型可见工具 ----------
段落 打开终端模式():
  返回 ["type": "object",
        "properties": ["描述": ["type": "string", "description": "可选：终端用途描述"]],
        "required": []]

段落 打开终端处理(参数):
  设 编号 为 新会话()
  返回 造工具结果("已开终端: " + 编号, 假)

段落 写入终端模式():
  返回 ["type": "object",
        "properties": ["会话号": ["type": "string", "description": "终端会话编号"],
                        "输入": ["type": "string", "description": "要写入终端的输入内容"]],
        "required": ["会话号", "输入"]]

段落 写入终端处理(参数):
  设 编号 为 参数["会话号"]
  设 输入 为 参数["输入"]
  如果 写会话(编号, 输入) == 真:
    返回 造工具结果("已写入: " + 编号, 假)
  返回 造工具结果("写入失败（会话不存在或已关闭）: " + 编号, 真)

段落 读取终端模式():
  返回 ["type": "object",
        "properties": ["会话号": ["type": "string", "description": "终端会话编号"]],
        "required": ["会话号"]]

段落 读取终端处理(参数):
  设 编号 为 参数["会话号"]
  如果 查会话(编号) == 空:
    返回 造工具结果("会话不存在: " + 编号, 真)
  返回 造工具结果(读会话(编号), 假)

段落 关闭终端模式():
  返回 ["type": "object",
        "properties": ["会话号": ["type": "string", "description": "终端会话编号"]],
        "required": ["会话号"]]

段落 关闭终端处理(参数):
  设 编号 为 参数["会话号"]
  如果 关会话(编号) == 真:
    返回 造工具结果("已关闭: " + 编号, 假)
  返回 造工具结果("关闭失败（会话不存在）: " + 编号, 真)

段落 挂载(注册表):
  注册表.注册(造工具定义("打开终端", "创建新的终端会话并返回会话编号", 打开终端模式(), 打开终端处理))
  注册表.注册(造工具定义("写入终端", "向运行中的终端会话写入输入", 写入终端模式(), 写入终端处理))
  注册表.注册(造工具定义("读取终端", "读取终端会话的累积输出", 读取终端模式(), 读取终端处理))
  注册表.注册(造工具定义("关闭终端", "关闭终端会话并清空缓冲", 关闭终端模式(), 关闭终端处理))
  返回 真

导出 设定驱动
导出 新会话号
导出 新会话
导出 查会话
导出 写会话
导出 读会话
导出 关会话
导出 挂载
