# 测试_扩展加载.light —— 扩展加载 的正例与反例
#
# 验证点：启用/禁用状态、加载顺序拓扑、依赖冲突检测、缺失依赖反例。
# 扩展清单由测试注入确定性假表（零磁盘、零进程）。
# 失败即 抛出 新建 错误(...)，绝不放宽。

从 扩展加载 导入 挂载, 装载扩展清单, 注册扩展, 计算加载顺序
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # ---- 1. 注入空清单，注册两个无依赖扩展 ----
  装载扩展清单({})
  设 甲 为 注册扩展("core", 真, [], [])
  断言为真(甲["ok"], "core 应注册成功")

  设 乙 为 注册扩展("ui", 真, ["core"], [])
  断言为真(乙["ok"], "ui 依赖已启用 core 应成功")

  # ---- 2. 反例：缺失依赖（依赖未登记的扩展）----
  设 缺 为 注册扩展("orphan", 真, ["NOPE"], [])
  断言为假(缺["ok"], "依赖缺失应失败")
  断言相等(缺["原因"], "缺失依赖: NOPE", "缺失依赖原因正确")

  # ---- 3. 反例：依赖未启用 ----
  装载扩展清单({})
  设 底 为 注册扩展("base", 假, [], [])
  断言为真(底["ok"], "禁用的 base 应可登记")
  设 上 为 注册扩展("top", 真, ["base"], [])
  断言为假(上["ok"], "启用扩展依赖禁用扩展应失败")
  断言相等(上["原因"], "依赖未启用: base", "依赖未启用原因正确")

  # ---- 4. 反例：互斥冲突（两个启用扩展互相冲突）----
  装载扩展清单({})
  设 丙 为 注册扩展("left", 真, [], ["right"])
  断言为真(丙["ok"], "left 应登记成功")
  设 丁 为 注册扩展("right", 真, [], ["left"])
  断言为假(丁["ok"], "right 与已启用 left 冲突应失败")
  断言相等(丁["原因"], "扩展冲突: left", "冲突原因正确")

  # ---- 5. 加载顺序拓扑（依赖在前）----
  装载扩展清单({})
  设 _a 为 注册扩展("core", 真, [], [])
  设 _b 为 注册扩展("ui", 真, ["core"], [])
  设 _c 为 注册扩展("plugin", 真, ["core", "ui"], [])
  设 期望顺序 为 ["core", "ui", "plugin"]
  断言相等(计算加载顺序(), 期望顺序, "加载顺序应为依赖拓扑")

  # ---- 6. 禁用扩展不进入加载顺序 ----
  装载扩展清单({})
  设 _d 为 注册扩展("keep", 真, [], [])
  设 _e 为 注册扩展("drop", 假, [], [])
  设 期望顺序2 为 ["keep"]
  断言相等(计算加载顺序(), 期望顺序2, "禁用扩展不应进入加载顺序")

  # ---- 7. 端到端：注册 + 经注册表执行 ----
  装载扩展清单({})
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("注册扩展"), "注册扩展应已注册")
  断言为真(注册表.登记表.包含("列出扩展"), "列出扩展应已注册")

  设 定义 为 注册表.登记表["注册扩展"]
  设 参 为 ["名字": "ext1", "启用": 真, "依赖": [], "冲突": []]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "注册 ext1 不应报错")

  设 缺参 为 ["名字": "ext2", "启用": 真, "依赖": ["ghost"], "冲突": []]
  设 缺产出 为 定义["execute"](缺参)
  断言为真(缺产出["isError"], "依赖缺失应报错")

  设 列定义 为 注册表.登记表["列出扩展"]
  设 列产出 为 列定义["execute"](["无": ""])
  断言为假(列产出["isError"], "列出扩展不应报错")

  打印 "测试_扩展加载 全部通过"

主()
