# 测试_上下文装配裁剪.light —— P1 上下文装配裁剪 的正例与反例
# 本插件是「策略层」：按优先级与预算挑块；压缩动作由既有 压缩.light 负责。

从 上下文装配裁剪 导入 造上下文块, 统计已用, 装配上下文, 裁剪丢弃, 装配报告, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 造三块():
  设 表 为 []
  设 高 为 造上下文块("系统提示", 3, 100)
  表.追加(高)
  设 中 为 造上下文块("近期对话", 2, 100)
  表.追加(中)
  设 低 为 造上下文块("历史摘要", 1, 100)
  表.追加(低)
  返回 表

段落 主:
  # ---- 1. 造块与统计 ----
  设 块 为 造上下文块("甲", 2, 50)
  断言相等(块["编号"], "甲", "块编号")
  断言相等(块["优先级"], 2, "块优先级")
  设 表 为 造三块()
  断言相等(统计已用(表), 300, "三块总长度")

  # ---- 2. 预算充足：全装 ----
  设 全装 为 装配上下文(表, 300)
  断言相等(长(全装), 3, "预算充足应全装")
  断言相等(全装[0]["编号"], "系统提示", "高优先在前")

  # ---- 3. 预算不足：按优先级截断 ----
  设 装 为 装配上下文(表, 150)
  断言相等(长(装), 1, "预算 150 只能装高优先那块")
  断言相等(装[0]["编号"], "系统提示", "装入的是最高优先块")

  # ---- 4. 丢弃列表 ----
  设 丢弃 为 裁剪丢弃(表, 150)
  断言相等(长(丢弃), 2, "应丢弃两块")
  断言相等(统计已用(丢弃), 200, "丢弃块总长")

  # ---- 5. 预算为 0：空 ----
  断言相等(长(装配上下文(表, 0)), 0, "零预算应装不进任何块")

  # ---- 6. 单块超预算：装不进 ----
  设 大块表 为 []
  设 超大 为 造上下文块("超大块", 5, 9999)
  大块表.追加(超大)
  断言相等(长(装配上下文(大块表, 100)), 0, "单块超预算应装不进")
  断言相等(长(裁剪丢弃(大块表, 100)), 1, "单块超预算应被丢弃")

  # ---- 7. 装配报告字段 ----
  设 报告 为 装配报告(表, 200)
  断言相等(报告["预算"], 200, "报告预算")
  断言相等(报告["已用"], 200, "报告已用")
  断言相等(报告["选中数"], 2, "报告选中数")
  断言相等(报告["丢弃数"], 1, "报告丢弃数")

  # ---- 8. 反例：空表 ----
  设 空表 为 []
  断言相等(长(装配上下文(空表, 100)), 0, "空表装配为空")
  断言相等(统计已用(空表), 0, "空表已用为 0")

  # ---- 9. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("上下文装配"), "上下文装配应注册")
  设 定义 为 注册表.登记表["上下文装配"]
  设 参 为 ["预算": 4096]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "工具不应报错")
  断言为真(子串位置(产出["content"], "4096") >= 0, "产出应回显预算")

  打印 "测试_上下文装配裁剪 全部通过"

主()
