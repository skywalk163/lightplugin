# 上下文装配裁剪.light —— 对标 dsh packages/context（P1）
#
# 与 lightharness 已有 `压缩.light` 的**分工**：
#   压缩 = 动作层（把对话压短）；
#   上下文装配 = **策略层**（在预算内按优先级挑选该装哪些块、丢弃哪些）。
#
# 核心：按「优先级从高到低」逐级装配，累计长度不超过预算。
#   不依赖任何排序库（手写分级遍历，避免引入未验证函数）。
#
# 块字典：["编号": 字符串, "优先级": 整数(越大越重要), "长度": 整数, "摘要": 字符串]
#
# 光明限制遵守：L-047 字面量先赋变量 / 避开「文本」/ 不写字面花括号 /
#   不用中文数字与保留字作变量名。

从 工具 导入 造工具定义, 造工具结果

段落 造上下文块(编号, 优先级, 长度, 摘要="", 必选=假, 可裁剪=假):
  返回 ["编号": 编号, "优先级": 优先级, "长度": 长度, "摘要": 摘要,
        "必选": 必选, "可裁剪": 可裁剪]

段落 是必选块(块):
  如果 块.包含("必选") == 真:
    如果 块["必选"] == 真:
      返回 真
  返回 假

段落 是可裁剪块(块):
  如果 块.包含("可裁剪") == 真:
    如果 块["可裁剪"] == 真:
      返回 真
  返回 假

# ---------- 单块裁剪：截断到剩余预算（保留开头，标注已截断）----------
段落 截断块(块, 余量):
  设 新块 为 ["编号": 块["编号"], "优先级": 块["优先级"], "长度": 余量,
              "摘要": "", "必选": 块["必选"], "可裁剪": 块["可裁剪"],
              "已截断": 真, "原长度": 块["长度"]]
  如果 块.包含("摘要") == 真:
    如果 块["摘要"] != "":
      设 新块["摘要"] 为 块["摘要"]
      如果 长(块["摘要"]) > 余量:
        新块["摘要"] 为 块["摘要"][0:余量]
  返回 新块

段落 统计已用(块表):
  设 已用 为 0
  遍历 块 之 块表:
    设 已用 为 已用 + 块["长度"]
  返回 已用

# ---------- 装配 ----------
# 两轮分级（优先级 9 → 0）：
#   第一轮：必选块**无视预算**优先全部装入（超预算时由 装配报告 给出 超出/告警）；
#   第二轮：其余块按优先级装入，累计不超预算；
#           单块超剩余预算时，若该块 可裁剪=真 则**截断到剩余预算**（保留开头、标注已截断），
#           否则整块丢弃。
段落 装配上下文(块表, 预算):
  设 已用 为 0
  设 选中 为 []
  设 级 为 9
  当 级 >= 0:
    遍历 块 之 块表:
      如果 块["优先级"] == 级:
        如果 是必选块(块) == 真:
          选中.追加(块)
          设 已用 为 已用 + 块["长度"]
    设 级 为 级 - 1
  设 级 为 9
  当 级 >= 0:
    遍历 块 之 块表:
      如果 块["优先级"] == 级:
        如果 是必选块(块) == 假:
          设 余量 为 预算 - 已用
          如果 块["长度"] <= 余量:
            选中.追加(块)
            设 已用 为 已用 + 块["长度"]
          否则:
            如果 是可裁剪块(块) == 真:
              如果 余量 > 0:
                设 截块 为 截断块(块, 余量)
                选中.追加(截块)
                设 已用 为 已用 + 余量
    设 级 为 级 - 1
  返回 选中

# ---------- 裁剪：返回因预算不足被丢弃的块 ----------
段落 裁剪丢弃(块表, 预算):
  设 选中 为 装配上下文(块表, 预算)
  设 丢弃 为 []
  遍历 块 之 块表:
    设 命中 为 假
    遍历 已选 之 选中:
      如果 已选["编号"] == 块["编号"]:
        设 命中 为 真
    如果 命中 == 假:
      丢弃.追加(块)
  返回 丢弃

段落 装配报告(块表, 预算):
  设 选中 为 装配上下文(块表, 预算)
  设 丢弃 为 裁剪丢弃(块表, 预算)
  设 已用 为 统计已用(选中)
  设 装入 为 []
  设 截断 为 []
  遍历 已选 之 选中:
    装入.追加(已选["编号"])
    如果 已选.包含("已截断") == 真:
      如果 已选["已截断"] == 真:
        截断.追加(已选["编号"])
  设 未装 为 []
  遍历 块 之 块表:
    如果 装入.包含(块["编号"]) == 假:
      未装.追加(块["编号"])
  设 超出 为 0
  如果 已用 > 预算:
    设 超出 为 已用 - 预算
  设 告警 为 []
  如果 超出 > 0:
    告警.追加("装配超出预算: 超出 " + 字符串(超出) + "（必选块无视预算优先装入）")
  遍历 已截 之 选中:
    如果 已截.包含("已截断") == 真:
      如果 已截["已截断"] == 真:
        告警.追加("块 " + 已截["编号"] + " 已截断到 " + 字符串(已截["长度"]) + "（原 " + 字符串(已截["原长度"]) + "）")
  设 必选数 为 0
  遍历 块 之 块表:
    如果 是必选块(块) == 真:
      设 必选数 为 必选数 + 1
  返回 ["预算": 预算, "选中": 选中, "丢弃": 丢弃, "已用": 已用,
        "选中数": 长(选中), "丢弃数": 长(丢弃),
        "装入": 装入, "跳过": 未装, "截断": 截断,
        "超出": 超出, "告警": 告警, "必选数": 必选数]

# ---------- 模型可见工具 ----------
段落 上下文装配模式():
  返回 ["type": "object",
        "properties": ["预算": ["type": "integer", "description": "上下文预算（字符/令牌数）"]],
        "required": ["预算"]]

段落 上下文装配处理(参数):
  设 空表 为 []
  设 报告 为 装配报告(空表, 参数["预算"])
  返回 造工具结果("当前未登记上下文块，装配结果为空（预算 " + 字符串(报告["预算"]) + "）", 假)

段落 上下文装配报告模式():
  返回 ["type": "object",
        "properties": ["预算": ["type": "integer", "description": "上下文预算（字符/令牌数）"],
                        "块": ["type": "string", "description": "上下文块定义（JSON 列表），每块含 编号/优先级/长度，可含 摘要/必选/可裁剪"]],
        "required": ["预算"]]

段落 上下文装配报告处理(参数):
  设 块表 为 []
  如果 参数.包含("块") == 真:
    设 原 为 参数["块"]
    如果 type(原) == str:
      设 块表 为 解析JSON(原)
    否则:
      设 块表 为 原
  设 报告 为 装配报告(块表, 参数["预算"])
  设 摘要 为 "装配报告: 预算=" + 字符串(报告["预算"]) + " 已用=" + 字符串(报告["已用"]) + " 装入=" + 连接字符串(报告["装入"], ",") + " 跳过=" + 连接字符串(报告["跳过"], ",") + " 截断=" + 连接字符串(报告["截断"], ",") + " 超出=" + 字符串(报告["超出"]) + " 告警数=" + 字符串(长(报告["告警"]))
  返回 造工具结果(摘要, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("上下文装配", "按优先级与预算装配上下文块", 上下文装配模式(), 上下文装配处理))
  注册表.注册(造工具定义("上下文装配报告", "按优先级与预算装配上下文块并返回装配报告（装入/跳过/截断/已用/超出/告警）", 上下文装配报告模式(), 上下文装配报告处理))
  返回 真

