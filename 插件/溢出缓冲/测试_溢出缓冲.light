# 测试_溢出缓冲.light —— P8 溢出缓冲 的正例与反例
#
# 写入器为注入式 fake（只记账、不碰磁盘）→ 零磁盘、零墙上时钟。
# 断言失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。

从 溢出缓冲 导入 装载写入器, 卸载写入器, 有写入器, 判定溢出, 分片, 重组, 写入缓冲, 读取缓冲, 缓冲数量, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言含于(大串, 子串, 标签):
  如果 包含(大串, 子串) == 假:
    抛出 新建 错误("断言含于失败 [" + 标签 + "]: 未含 " + 子串)

# ---- 假写入器：只记账，返回成功 ----
设 落盘表 为 []

段落 假写入器(编号, 序号, 片内容):
  落盘表.追加(编号 + "#" + 字符串(序号) + ":" + 片内容)
  返回 真

段落 坏写入器(编号, 序号, 片内容):
  返回 假

段落 造长内容(重复次数):
  设 结果表 为 ""
  设 下标 为 0
  当 下标 < 重复次数:
    设 结果表 为 结果表 + "abcdefghij"
    设 下标 为 下标 + 1
  返回 结果表

段落 主:
  # ---- 1. 阈值判定（边界：等于阈值不算溢出）----
  断言为假(判定溢出("abcde", 5), "等于阈值不应溢出")
  断言为真(判定溢出("abcdef", 5), "超过阈值应溢出")
  断言为假(判定溢出("ab", 5), "小于阈值不应溢出")

  # ---- 2. 分片（整除）----
  设 片表 为 分片("abcdefgh", 4)
  断言相等(长(片表), 2, "8 字按 4 切应得 2 片")
  断言相等(片表[0], "abcd", "第一片")
  断言相等(片表[1], "efgh", "第二片")

  # ---- 3. 分片（不整除，末片短）----
  设 片表2 为 分片("abcdefg", 3)
  断言相等(长(片表2), 3, "7 字按 3 切应得 3 片")
  断言相等(片表2[0], "abc", "片1")
  断言相等(片表2[1], "def", "片2")
  断言相等(片表2[2], "g", "末片应短")

  # ---- 4. 分片（反例：非法片大小）----
  断言相等(长(分片("abc", 0)), 0, "片大小 0 应得空表")
  断言相等(长(分片("abc", -1)), 0, "负片大小应得空表")
  断言相等(长(分片("", 4)), 0, "空内容应得空表")

  # ---- 5. 重组应还原原文 ----
  断言相等(重组(片表2), "abcdefg", "重组应还原原文")
  设 长内容 为 造长内容(3)
  断言相等(重组(分片(长内容, 7)), 长内容, "长内容重组应还原")

  # ---- 6. 未超阈值：走内存，不落盘 ----
  装载写入器(假写入器)
  断言为真(有写入器(), "装载后应有写入器")
  设 小结果 为 写入缓冲("abcde", 10, 4)
  断言为真(小结果["ok"], "小内容写入应成功")
  断言为假(小结果["是否溢出"], "未超阈值不应溢出")
  断言相等(小结果["片数"], 0, "未超阈值不应分片")
  断言为假(小结果["已落盘"], "未超阈值不应落盘")

  # ---- 7. 超阈值：分片 + 落盘 ----
  设 大内容 为 造长内容(2)
  断言相等(长(大内容), 20, "样本长度应为 20")
  设 大结果 为 写入缓冲(大内容, 10, 6)
  断言为真(大结果["ok"], "大内容写入应成功")
  断言为真(大结果["是否溢出"], "超阈值应溢出")
  断言相等(大结果["片数"], 4, "20 字按 6 切应得 4 片")
  断言为真(大结果["已落盘"], "有写入器且全部分片写成功应标记落盘")

  # ---- 8. 分片内容拼接应等于原文 ----
  设 拼回 为 重组(大结果["片表"])
  断言相等(拼回, 大内容, "分片拼接应等于原文")

  # ---- 9. 读取缓冲：超阈值读回走重组，内容与原文一致 ----
  设 读回 为 读取缓冲(大结果["编号"])
  断言为真(读回["ok"], "读取已存在缓冲应成功")
  断言相等(读回["内容"], 大内容, "读回内容应等于原文")
  断言为真(读回["是否溢出"], "读回应标记曾溢出")
  断言相等(读回["片数"], 4, "读回片数")
  断言为真(读回["已落盘"], "读回应标记已落盘")

  # ---- 10. 读取缓冲：未超阈值读回走内存 ----
  设 读回小 为 读取缓冲(小结果["编号"])
  断言为真(读回小["ok"], "读取小缓冲应成功")
  断言相等(读回小["内容"], "abcde", "小缓冲读回内容")
  断言为假(读回小["是否溢出"], "小缓冲不应标记溢出")
  断言相等(读回小["片数"], 0, "小缓冲片数为 0")

  # ---- 11. 反例：读取不存在的缓冲 ----
  设 缺失 为 读取缓冲("SPILL-999999")
  断言为假(缺失["ok"], "读取不存在的缓冲应失败")
  断言相等(缺失["原因"], "缓冲不存在: SPILL-999999", "不存在缓冲的原因")

  # ---- 12. 反例：空内容 ----
  设 空写 为 写入缓冲("", 10, 4)
  断言为假(空写["ok"], "空内容应失败")
  断言相等(空写["原因"], "内容为空", "空内容原因")

  # ---- 13. 反例：非字符串内容 ----
  设 非串 为 写入缓冲(123, 10, 4)
  断言为假(非串["ok"], "非字符串内容应失败")
  断言相等(非串["原因"], "内容必须是字符串", "非字符串原因")

  # ---- 14. 反例：负阈值 / 零阈值 ----
  设 负阈 为 写入缓冲("abc", -1, 4)
  断言为假(负阈["ok"], "负阈值应失败")
  断言相等(负阈["原因"], "阈值必须为正整数", "负阈值原因")
  设 零阈 为 写入缓冲("abc", 0, 4)
  断言为假(零阈["ok"], "零阈值应失败")

  # ---- 15. 反例：负片大小 ----
  设 负片 为 写入缓冲("abcdef", 2, -3)
  断言为假(负片["ok"], "负片大小应失败")
  断言相等(负片["原因"], "片大小必须为正整数", "负片大小原因")

  # ---- 16. 溢出但写入器失败：不应标记落盘 ----
  装载写入器(坏写入器)
  设 坏写 为 写入缓冲("abcdef", 3, 2)
  断言为真(坏写["ok"], "写入本身应成功（落盘失败不算写入失败）")
  断言为真(坏写["是否溢出"], "应判定溢出")
  断言为假(坏写["已落盘"], "写入器失败时不应标记落盘")
  设 仍可读 为 读取缓冲(坏写["编号"])
  断言为真(仍可读["ok"], "落盘失败时内存分片仍可读回")
  断言相等(仍可读["内容"], "abcdef", "落盘失败时读回内容仍完整")

  # ---- 17. 溢出但无写入器：分片但不落盘 ----
  卸载写入器()
  断言为假(有写入器(), "卸载后应无写入器")
  设 无器 为 写入缓冲("abcdef", 3, 2)
  断言为真(无器["ok"], "无写入器时写入应成功")
  断言为真(无器["是否溢出"], "无写入器时也应分片")
  断言相等(无器["片数"], 3, "6 字按 2 切应得 3 片")
  断言为假(无器["已落盘"], "无写入器时不应标记落盘")

  # ---- 18. 挂载进注册表并端到端执行 ----
  装载写入器(假写入器)
  设 起始 为 缓冲数量()
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("写入缓冲"), "写入缓冲应已注册")
  断言为真(注册表.登记表.包含("读取缓冲"), "读取缓冲应已注册")

  # 18a. 写入 → 读回（端到端，走工具出入参）
  设 写定义 为 注册表.登记表["写入缓冲"]
  设 写参 为 ["内容": "abcdefghij", "阈值": 4, "片大小": 3]
  设 写产出 为 写定义["execute"](写参)
  断言为假(写产出["isError"], "写入缓冲工具不应报错")
  断言含于(写产出["content"], "是否溢出=True", "工具应报出溢出")
  断言含于(写产出["content"], "片数=4", "10 字按 3 切应得 4 片")
  断言含于(写产出["content"], "已落盘=True", "工具应报出已落盘")

  # 18b. 从工具输出里取回编号再读回
  设 编号串 为 写产出["content"]
  设 切表 为 分割字符串(编号串, "编号=")
  设 余串 为 切表[1]
  设 切表2 为 分割字符串(余串, " ")
  设 编号 为 切表2[0]
  设 读定义 为 注册表.登记表["读取缓冲"]
  设 读参 为 ["编号": 编号]
  设 读产出 为 读定义["execute"](读参)
  断言为假(读产出["isError"], "读取缓冲工具不应报错")
  断言相等(读产出["content"], "abcdefghij", "端到端读回内容应等于原文")

  # 18c. 反例：工具层缺字段
  设 缺写参 为 ["阈值": 4]
  设 缺写产出 为 写定义["execute"](缺写参)
  断言为真(缺写产出["isError"], "缺内容字段应报错")
  设 缺读参 为 {}
  设 缺读产出 为 读定义["execute"](缺读参)
  断言为真(缺读产出["isError"], "缺编号字段应报错")

  # 18d. 反例：工具层读取不存在的编号
  设 坏读参 为 ["编号": "SPILL-999999"]
  设 坏读产出 为 读定义["execute"](坏读参)
  断言为真(坏读产出["isError"], "读取不存在编号应报错")
  断言含于(坏读产出["content"], "缓冲不存在", "不存在编号的原因")

  # 18e. 默认阈值：不传阈值时走 1024，短内容不溢出
  设 默认参 为 ["内容": "短内容"]
  设 默认产出 为 写定义["execute"](默认参)
  断言为假(默认产出["isError"], "默认阈值写入不应报错")
  断言含于(默认产出["content"], "是否溢出=False", "默认阈值下短内容不应溢出")
  断言为真(缓冲数量() > 起始, "缓冲表应有新增记录")

  打印 "测试_溢出缓冲 全部通过"

主()
