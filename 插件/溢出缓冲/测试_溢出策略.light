# 测试_溢出策略.light —— R101 #54 增量：spill-policy 共享预算策略层 的正例 / 反例 / 反跑
#
# 注入式 fake：只记账、不碰磁盘、确定性路径 → 零磁盘、零墙上时钟。
# 断言失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。

从 策略 导入 保留策略, 造文字条目, 造图片条目, 拼全文, 算首尾, 格式化通知

# ---- 通用断言 ----
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言含于(大串, 子串, 标签):
  如果 包含(大串, 子串) == 假:
    抛出 新建 错误("断言含于失败 [" + 标签 + "]: 未含 " + 子串)

段落 断言不含(大串, 子串, 标签):
  如果 包含(大串, 子串) == 真:
    抛出 新建 错误("断言不含失败 [" + 标签 + "]: 不应含 " + 子串)

段落 内联串(结果):
  设 串 为 ""
  遍历 块 之 结果["内联"]:
    设 串 为 串 + 块["text"]
  返回 串

# ---- 假落盘：记账 + 捕获落盘内容 ----
设 落盘计数 为 0
设 落盘内容 为 空

段落 假落盘(内容, 后缀):
  全局 落盘计数。
  全局 落盘内容。
  设 落盘计数 为 落盘计数 + 1
  设 落盘内容 为 内容
  返回 "/spill/result-" + 字符串(落盘计数) + "." + 后缀

段落 坏落盘(内容, 后缀):
  返回 空

# ---- 假附件：记账 + 确定性路径 ----
设 附件计数 为 0

段落 假附件(字节):
  全局 附件计数。
  设 附件计数 为 附件计数 + 1
  返回 "/att/img-" + 字符串(附件计数)

段落 坏附件(字节):
  返回 空

段落 造长文字(重复次数):
  设 结果 为 ""
  设 下标 为 0
  当 下标 < 重复次数:
    设 结果 为 结果 + "工具返回了一段很长的分析结果内容"
    设 下标 为 下标 + 1
  返回 结果

段落 重复(串, 次数):
  设 结果 为 ""
  设 下标 为 0
  当 下标 < 次数:
    设 结果 为 结果 + 串
    设 下标 为 下标 + 1
  返回 结果

段落 主:
  # ---- 1. 禁用：budget=0 → 直通原文（不 spill）----
  设 条目1 为 [造文字条目("短文本一二三")]
  设 果1 为 保留策略(条目1, 0, 假落盘, 假附件)
  断言为真(果1["直通"], "budget=0 应直通")
  断言为假(果1["降级"], "直通不应降级")
  断言相等(果1["省略数"], 0, "直通省略数=0")
  断言相等(果1["落盘路径"], 空, "直通不落盘")

  # ---- 2. 禁用：maxInlineTokens 省略（预算=空）→ 直通 ----
  设 条目2 为 [造文字条目("hello world"), 造文字条目("second piece")]
  设 果2 为 保留策略(条目2, 空, 假落盘, 假附件)
  断言为真(果2["直通"], "预算为空应直通")
  设 串2 为 内联串(果2)
  断言含于(串2, "hello world", "直通应保留原文")
  断言含于(串2, "second piece", "直通应保留原文")

  # ---- 3. 未超预算 → 直通，文字原样保留 ----
  设 条目3 为 [造文字条目("第一段结果"), 造文字条目("第二段结果很长很长很长")]
  设 果3 为 保留策略(条目3, 500, 假落盘, 假附件)
  断言为真(果3["直通"], "未超预算应直通")
  设 串3 为 内联串(果3)
  断言含于(串3, "第一段结果", "直通保留首段")
  断言含于(串3, "第二段结果很长很长很长", "直通保留尾段")

  # ---- 4. 超预算（文字+图片）→ spill；图片走附件路径（不内联字节）----
  设 长文41 为 造长文字(15)
  设 条目4 为 [造文字条目(长文41), 造图片条目("RAWB YTE_payload_0099")]
  设 果4 为 保留策略(条目4, 80, 假落盘, 假附件)
  断言为假(果4["直通"], "超预算应 spill")
  断言为假(果4["降级"], "落盘成功不应降级")
  断言含于(果4["落盘路径"], "result", "应落盘并返回路径")
  断言含于(果4["notice"], "Full formatted result stored at:", "notice 应含定位")
  断言含于(果4["notice"], "已省略", "notice 应含省略标记")
  # 落盘全文必须含图片附件路径、且不能含图片原始字节
  断言含于(落盘内容, "/att/img", "落盘全文图片应走附件路径")
  断言不含(落盘内容, "RAWB YTE_payload_0099", "落盘全文图片原始字节不应出现")

  # ---- 5. 图片与文字共享同一预算（图片计入总令牌，不各自算）----
  # 仅文字约 10 token；加图片（64 占位）合计约 74 token，越过 60 即 spill
  设 条目5 为 [造文字条目("接近预算的文字内容接近预算的文字内容接近预算"), 造图片条目("SHARED_budget_img")]
  设 果5a 为 保留策略(条目5, 200, 假落盘, 假附件)
  断言为真(果5a["直通"], "文字+图片未超 200 应直通")
  设 果5b 为 保留策略(条目5, 60, 假落盘, 假附件)
  断言为假(果5b["直通"], "文字+图片共享预算越过 60 应 spill")

  # ---- 6. 首尾顺序不可乱：保留首段与尾段，中间省略 ----
  设 A6 为 重复("AAAA首段内容", 15)
  设 B6 为 重复("BBBB中间被省略段内容较长", 20)
  设 C6 为 重复("CCCC尾段内容", 15)
  设 条目6 为 [造文字条目(A6), 造文字条目(B6), 造文字条目(C6)]
  设 果6 为 保留策略(条目6, 100, 假落盘, 假附件)
  断言为假(果6["直通"], "应触发 spill")
  断言含于(果6["落盘路径"], "result", "spill 应落盘")
  设 内联6 为 果6["内联"]
  断言为真(长(内联6) >= 3, "头+间隙+尾至少 3 块")
  断言含于(内联6[0]["text"], "AAAA首段", "内联首块应为首段")
  断言含于(内联6[长(内联6) - 1]["text"], "CCCC尾段", "内联末块应为尾段")
  断言含于(内联串(果6), "[...]", "中间应有省略间隙")
  断言不含(内联串(果6), "BBBB中间被省略段内容较长", "中间整段不应出现在内联")

  # ---- 7. 写盘失败 → 降级保留原文（不抛、不吐空）----
  设 条目7 为 [造文字条目("E0关键内容是一段稍长的文本以越过预算"), 造图片条目("DEGRADE_img")]
  设 果7 为 保留策略(条目7, 50, 坏落盘, 假附件)
  断言为真(果7["降级"], "写盘失败应降级")
  断言相等(果7["落盘路径"], 空, "降级不应落盘")
  设 串7 为 内联串(果7)
  断言含于(串7, "E0关键内容", "降级应保留原文不吐空")
  断言含于(串7, "/att/img", "降级时图片仍走附件")
  断言为假(长(果7["内联"]) == 0, "降级内联不应为空")

  打印 "测试_溢出策略 全部通过"

主()
