# 溢出缓冲.light —— dsh packages/spill 的光明复刻（P8）
#
# 定位：大输出溢出缓冲。工具输出一旦超过阈值，就**分片**并交给外部写入器落盘，
#       读回时自动把分片重组成原文；未超阈值的保持整块内存形态，不落盘。
#
# 设计取舍：**写入器注入式**。
#   真正落盘要碰磁盘，这里只定义契约 `写入器(编号, 分片序号, 分片内容) -> 真假`；
#   宿主可接真实文件写入，测试注入确定性 fake（只记账不碰盘）。→ 零磁盘、零计时 flaky。
#
# 分片按字符切（不按字节）：光明侧字符串以字符为单位，与 dsh 侧按字节切分在
#   多字节字符上会有计数差异 —— 这是如实记录的已知缺口，不是 bug。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作函数实参 → 一律先赋变量再传；空列表也先赋变量。
#   L-044   含「文本」的标识符会被词法拆名 → 命名避开（用 内容/片/编号/原因）。
#   LP-D-013 变量不要命名为「出」→ 用 收集表/片表/结果表。
#   LP-D-010 遍历变量名不与被调用函数同名 → 用 条目/片。
#   L-166   段落内给模块级同名变量赋值会静默变局部 → 计数器走 `全局 缓冲序号。`。
#   全局内置 `切片` 在插件运行器下**未注册**（实测 NameError）→ 分片用 字符串获取 逐字符拼。

从 工具 导入 造工具定义, 造工具结果

设 缓冲表 为 {}
设 缓冲序号 为 0
设 写入器表 为 {}

# ---------- 写入器注入 ----------
段落 装载写入器(写入器):
  写入器表["写入器"] 为 写入器
  返回 真

段落 卸载写入器():
  如果 写入器表.包含("写入器") == 真:
    写入器表.弹出("写入器")
  返回 真

段落 有写入器():
  返回 写入器表.包含("写入器") == 真

# ---------- 编号 ----------
段落 新缓冲号():
  全局 缓冲序号。
  缓冲序号 为 缓冲序号 + 1
  返回 "SPILL-" + 字符串(缓冲序号)

# ---------- 阈值判定 ----------
段落 判定溢出(内容, 阈值):
  返回 长(内容) > 阈值

# ---------- 分片 / 重组 ----------
段落 分片(内容, 片大小):
  设 片表 为 []
  如果 片大小 <= 0:
    返回 片表
  设 总长 为 长(内容)
  如果 总长 == 0:
    返回 片表
  设 起 为 0
  当 起 < 总长:
    设 止 为 起 + 片大小
    如果 止 > 总长:
      设 止 为 总长
    设 片 为 ""
    设 下标 为 起
    当 下标 < 止:
      设 片 为 片 + 字符串获取(内容, 下标)
      设 下标 为 下标 + 1
    片表.追加(片)
    设 起 为 止
  返回 片表

段落 重组(片表):
  返回 连接字符串(片表, "")

# ---------- 写入 ----------
段落 造空写入(原因):
  设 空表 为 []
  返回 ["ok": 假, "编号": "", "是否溢出": 假, "片数": 0, "片表": 空表, "已落盘": 假, "原因": 原因]

段落 写入缓冲(内容, 阈值, 片大小):
  如果 是字符串(内容) == 假:
    返回 造空写入("内容必须是字符串")
  如果 内容 == "":
    返回 造空写入("内容为空")
  如果 是整数(阈值) == 假:
    返回 造空写入("阈值必须是整数")
  如果 阈值 <= 0:
    返回 造空写入("阈值必须为正整数")
  如果 是整数(片大小) == 假:
    返回 造空写入("片大小必须是整数")
  如果 片大小 <= 0:
    返回 造空写入("片大小必须为正整数")

  设 编号 为 新缓冲号()
  设 溢出 为 判定溢出(内容, 阈值)
  设 片表 为 []
  设 已落盘 为 假

  如果 溢出 == 真:
    设 片表 为 分片(内容, 片大小)
    如果 有写入器() == 真:
      设 失败数 为 0
      设 序号 为 0
      遍历 条目 之 片表:
        设 序号 为 序号 + 1
        设 写回 为 写入器表["写入器"](编号, 序号, 条目)
        如果 写回 != 真:
          设 失败数 为 失败数 + 1
      如果 失败数 == 0:
        设 已落盘 为 真

  设 记录 为 ["编号": 编号,
             "内容": 内容,
             "阈值": 阈值,
             "片大小": 片大小,
             "是否溢出": 溢出,
             "片数": 长(片表),
             "片表": 片表,
             "已落盘": 已落盘]
  缓冲表[编号] 为 记录
  返回 ["ok": 真, "编号": 编号, "是否溢出": 溢出, "片数": 长(片表),
        "片表": 片表, "已落盘": 已落盘, "原因": ""]

# ---------- 读取 ----------
段落 读取缓冲(编号):
  如果 缓冲表.包含(编号) == 假:
    返回 ["ok": 假, "编号": 编号, "内容": "", "是否溢出": 假,
          "片数": 0, "已落盘": 假, "原因": "缓冲不存在: " + 编号]
  设 记录 为 缓冲表[编号]
  设 内容 为 记录["内容"]
  如果 记录["是否溢出"] == 真:
    设 内容 为 重组(记录["片表"])
  返回 ["ok": 真, "编号": 编号, "内容": 内容, "是否溢出": 记录["是否溢出"],
        "片数": 记录["片数"], "已落盘": 记录["已落盘"], "原因": ""]

段落 缓冲数量():
  返回 长(缓冲表)

# ---------- 模型可见工具 ----------
段落 写入缓冲模式():
  设 内容字段 为 ["type": "string", "description": "待写入缓冲的大块输出内容"]
  设 阈值字段 为 ["type": "integer", "description": "溢出阈值（字符数），超过即分片，缺省 1024"]
  设 片字段 为 ["type": "integer", "description": "单片大小（字符数），缺省 256"]
  设 属性表 为 ["内容": 内容字段, "阈值": 阈值字段, "片大小": 片字段]
  设 必填 为 ["内容"]
  返回 ["type": "object", "properties": 属性表, "required": 必填]

段落 写入缓冲处理(参数):
  如果 参数.包含("内容") == 假:
    返回 造工具结果("缺少必填字段: 内容", 真)
  设 阈值 为 1024
  如果 参数.包含("阈值") == 真:
    设 阈值 为 参数["阈值"]
  设 片大小 为 256
  如果 参数.包含("片大小") == 真:
    设 片大小 为 参数["片大小"]
  设 结果 为 写入缓冲(参数["内容"], 阈值, 片大小)
  如果 结果["ok"] == 假:
    返回 造工具结果("写入缓冲失败: " + 结果["原因"], 真)
  设 摘要 为 "编号=" + 结果["编号"] + " 是否溢出=" + 字符串(结果["是否溢出"])
  设 摘要 为 摘要 + " 片数=" + 字符串(结果["片数"]) + " 已落盘=" + 字符串(结果["已落盘"])
  返回 造工具结果(摘要, 假)

段落 读取缓冲模式():
  设 编号字段 为 ["type": "string", "description": "要读取的缓冲编号，形如 SPILL-1"]
  设 属性表 为 ["编号": 编号字段]
  设 必填 为 ["编号"]
  返回 ["type": "object", "properties": 属性表, "required": 必填]

段落 读取缓冲处理(参数):
  如果 参数.包含("编号") == 假:
    返回 造工具结果("缺少必填字段: 编号", 真)
  设 结果 为 读取缓冲(参数["编号"])
  如果 结果["ok"] == 假:
    返回 造工具结果("读取缓冲失败: " + 结果["原因"], 真)
  返回 造工具结果(结果["内容"], 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("写入缓冲", "把大块输出写入溢出缓冲，超阈值自动分片并可落盘", 写入缓冲模式(), 写入缓冲处理))
  注册表.注册(造工具定义("读取缓冲", "按编号读回溢出缓冲内容，自动重组分片", 读取缓冲模式(), 读取缓冲处理))
  返回 真

导出 装载写入器
导出 卸载写入器
导出 有写入器
导出 新缓冲号
导出 判定溢出
导出 分片
导出 重组
导出 写入缓冲
导出 读取缓冲
导出 缓冲数量
导出 挂载
