# 团队界面.light —— 对标 dsh packages/experimental/client-ui-agent-team 的团队界面状态
#
# 定位：**UI 状态装配层**（只读装配，不做通信）。
#   成员面板（成员 + 状态） / 消息流装配（按时间序拼接「成员:内容」） / 选中态。
#   边界：代理团队.light 负责「派给谁、结果怎么回收」（运行时）；
#         本插件负责「界面上怎么摆、消息按什么顺序显示、当前选中谁」。
#
# 数据源注入：团队快照由外部注入的「数据源」提供，签名
#   () -> {"成员": [{"名字","状态"}], "消息": [{"序号","成员","内容"}]}
#   宿主可接真实客户端状态；测试注入确定性样本 → 零网络、零计时。
#   未配置数据源时，兜底直读 代理团队 的注册成员与本模块自持的消息表。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作实参 → 先赋变量。
#   L-044   含「文本」的标识符会被词法拆名 → 命名避开「文本」。
#   L-165/166 段内重新绑定模块级名字须先『全局 X。』（放在段首）。
#   LP-D-010 遍历 循环变量不与被调用函数同名 → 用 条目/名字/消息项。
#   LP-D-013 不用「出」做变量名 → 用 结果表 / 收集表。
#   链式下标赋值未验证 → 一律先取局部变量再改。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表
从 代理团队 导入 列出成员, 取成员, 汇总团队结果

# ---------- 模块级状态 ----------
设 界面数据源 为 空        # () -> ["成员": [...], "消息": [...]]
设 选中成员 为 ""
设 消息表 为 []            # 无数据源时的消息流：[{"序号","成员","内容"}]
设 消息序号 为 0

# ---------- 注入入口（宿主/测试）----------
段落 配置数据源(源):
  全局 界面数据源。
  界面数据源 为 源
  返回 真

段落 取数据源():
  返回 界面数据源

段落 追加消息(成员, 内容):
  全局 消息序号。
  全局 消息表。
  消息序号 为 消息序号 + 1
  设 条目 为 ["序号": 消息序号, "成员": 成员, "内容": 内容]
  消息表.追加(条目)
  返回 消息序号

# ---------- 数据读取 ----------
# 成员名单：优先数据源；否则回退到 代理团队 的注册成员。
段落 取团队成员():
  如果 界面数据源 != 空:
    设 快照 为 界面数据源()
    如果 快照.包含("成员") == 真:
      返回 快照["成员"]
  设 收集表 为 []
  遍历 名字 之 列出成员():
    设 记录 为 取成员(名字)
    设 条目 为 ["名字": 名字, "状态": 记录["状态"]]
    收集表.追加(条目)
  返回 收集表

# 消息列表：优先数据源；否则用本模块自持的消息表。
段落 取团队消息():
  如果 界面数据源 != 空:
    设 快照 为 界面数据源()
    如果 快照.包含("消息") == 真:
      返回 快照["消息"]
  返回 消息表

# ---------- 按时间序（序号升序）----------
# 选择排序：数据源不保证顺序时，界面必须按时间序展示。
段落 按序排消息(表):
  设 出 为 []
  遍历 消息项 之 表:
    出.追加(消息项)
  设 总数 为 长(出)
  设 甲 为 0
  当 甲 < 总数:
    设 乙 为 甲 + 1
    当 乙 < 总数:
      如果 出[乙]["序号"] < 出[甲]["序号"]:
        设 暂存 为 出[甲]
        出[甲] 为 出[乙]
        出[乙] 为 暂存
      乙 为 乙 + 1
    甲 为 甲 + 1
  返回 出

# ---------- 装配 ----------
# 成员面板：["甲[忙碌]", "*乙[空闲]"]（选中者加 * 前缀）
段落 装配成员面板():
  设 成员表 为 取团队成员()
  设 收集表 为 []
  遍历 条目 之 成员表:
    设 名字 为 条目["名字"]
    设 状态 为 条目["状态"]
    设 串 为 名字 + "[" + 状态 + "]"
    如果 名字 == 选中成员:
      设 串 为 "*" + 串
    收集表.追加(串)
  返回 收集表

# 消息流：按时间序拼接「成员:内容」，用换行连接。
段落 装配消息流():
  设 原始 为 取团队消息()
  设 排好 为 按序排消息(原始)
  设 收集表 为 []
  遍历 条目 之 排好:
    收集表.追加(条目["成员"] + ":" + 条目["内容"])
  如果 长(收集表) == 0:
    返回 "（暂无消息）"
  返回 连接字符串(收集表, "\n")

段落 选中(名字):
  全局 选中成员。
  如果 名字 == "":
    选中成员 为 ""
    返回 真
  设 成员表 为 取团队成员()
  设 命中 为 假
  遍历 条目 之 成员表:
    如果 条目["名字"] == 名字:
      设 命中 为 真
  如果 命中 == 假:
    返回 假
  选中成员 为 名字
  返回 真

段落 取选中():
  返回 选中成员

# 面板快照：["成员面板", "消息流", "选中", "成员数", "消息数", "就绪", "派单数", "成功数"]
段落 装配团队面板():
  设 成员表 为 取团队成员()
  设 消息列表 为 取团队消息()
  设 成员面板 为 装配成员面板()
  设 消息流 为 装配消息流()
  设 成员数 为 长(成员表)
  设 消息数 为 长(消息列表)
  设 就绪 为 假
  如果 成员数 > 0:
    设 就绪 为 真
  设 汇总 为 汇总团队结果()
  设 面板 为 ["成员面板": 成员面板,
              "消息流": 消息流,
              "选中": 选中成员,
              "成员数": 成员数,
              "消息数": 消息数,
              "就绪": 就绪,
              "派单数": 汇总["总数"],
              "成功数": 汇总["成功"]]
  返回 面板

段落 清空界面():
  全局 界面数据源。
  全局 选中成员。
  全局 消息表。
  全局 消息序号。
  界面数据源 为 空
  选中成员 为 ""
  消息表 为 []
  消息序号 为 0
  返回 真

# ---------- 模型可见工具 ----------
段落 装配团队面板模式():
  返回 ["type": "object",
        "properties": ["选中": ["type": "string", "description": "可选：先切换选中成员再装配；留空表示取消选中"]],
        "required": []]

段落 装配团队面板处理(参数):
  如果 参数.包含("选中") == 真:
    设 目标 为 参数["选中"]
    如果 目标 != "":
      如果 选中(目标) == 假:
        返回 造工具结果("选中失败：团队中没有成员 " + 目标, 真)
    否则:
      选中("")
  设 面板 为 装配团队面板()
  如果 面板["就绪"] == 假:
    返回 造工具结果("团队暂无成员，无法装配面板", 真)
  设 摘要 为 "成员(" + 字符串(面板["成员数"]) + ")=" + 连接字符串(面板["成员面板"], " ") + " | 消息(" + 字符串(面板["消息数"]) + ")=" + 替换字符串(面板["消息流"], "\n", " / ")
  如果 面板["选中"] != "":
    设 摘要 为 摘要 + " | 选中=" + 面板["选中"]
  返回 造工具结果(摘要, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("装配团队面板", "装配团队成员面板与消息流，并支持切换选中态", 装配团队面板模式(), 装配团队面板处理))
  返回 真

导出 配置数据源
导出 取数据源
导出 追加消息
导出 取团队成员
导出 取团队消息
导出 按序排消息
导出 装配成员面板
导出 装配消息流
导出 选中
导出 取选中
导出 装配团队面板
导出 清空界面
导出 挂载
