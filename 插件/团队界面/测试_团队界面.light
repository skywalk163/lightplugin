# 测试_团队界面.light —— 团队界面 的正例与反例
#
# 与宿主一致的断言惯用法（照抄 lightharness/examples/test_*.light）：
#   失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。
# 团队快照由注入的确定性「数据源」提供 → 零网络、零计时。

从 团队界面 导入 配置数据源, 取数据源, 追加消息, 取团队成员, 取团队消息, 按序排消息, 装配成员面板, 装配消息流, 选中, 取选中, 装配团队面板, 清空界面, 挂载
从 代理团队 导入 注册成员, 清空团队, 配置派发器, 分派团队任务
从 工具 导入 工具注册表
从 内置核心字典 导入 字典键列表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性数据源：3 成员 + 4 条消息（序号故意乱序）----
段落 样本数据源():
  设 成员表 为 []
  设 成1 为 ["名字": "甲", "状态": "忙碌"]
  成员表.追加(成1)
  设 成2 为 ["名字": "乙", "状态": "空闲"]
  成员表.追加(成2)
  设 成3 为 ["名字": "丙", "状态": "离线"]
  成员表.追加(成3)
  设 消息表 为 []
  设 消1 为 ["序号": 3, "成员": "甲", "内容": "完成"]
  消息表.追加(消1)
  设 消2 为 ["序号": 1, "成员": "甲", "内容": "开工"]
  消息表.追加(消2)
  设 消3 为 ["序号": 4, "成员": "丙", "内容": "归档"]
  消息表.追加(消3)
  设 消4 为 ["序号": 2, "成员": "乙", "内容": "收到"]
  消息表.追加(消4)
  设 快照 为 ["成员": 成员表, "消息": 消息表]
  返回 快照

# ---- 确定性派发器（供代理团队联动用例用）----
段落 界面派发器(任务体):
  设 好回 为 ["ok": 真, "结果": "完成:" + 任务体, "原因": ""]
  返回 好回

段落 主:
  清空界面()
  清空团队()

  # ---- 1. 空团队反例 ----
  设 空面板 为 装配团队面板()
  断言为假(空面板["就绪"], "空团队不应就绪")
  断言相等(空面板["成员数"], 0, "空团队成员数应为 0")
  断言相等(空面板["消息数"], 0, "空团队消息数应为 0")
  断言相等(长(装配成员面板()), 0, "空团队成员面板应为空")
  断言相等(装配消息流(), "（暂无消息）", "空团队消息流应提示暂无消息")

  # ---- 2. 反例：空团队下无法选中 ----
  断言为假(选中("甲"), "空团队下选中任何成员都应失败")
  断言相等(取选中(), "", "选中失败后不应改变选中态")

  # ---- 3. 配置数据源 ----
  配置数据源(样本数据源)
  断言相等(取数据源(), 样本数据源, "数据源应已配置")
  断言相等(长(取团队成员()), 3, "数据源应提供 3 名成员")
  断言相等(长(取团队消息()), 4, "数据源应提供 4 条消息")

  # ---- 4. 按时间序排序 ----
  设 排好 为 按序排消息(取团队消息())
  断言相等(排好[0]["序号"], 1, "排序后首条序号应为 1")
  断言相等(排好[1]["序号"], 2, "排序后第二条序号应为 2")
  断言相等(排好[2]["序号"], 3, "排序后第三条序号应为 3")
  断言相等(排好[3]["序号"], 4, "排序后第四条序号应为 4")

  # ---- 5. 消息流装配：按时间序拼接「成员:内容」----
  断言相等(装配消息流(), "甲:开工\n乙:收到\n甲:完成\n丙:归档", "消息流应按时间序拼接")

  # ---- 6. 成员面板：成员 + 状态 ----
  设 面板 为 装配团队面板()
  断言为真(面板["就绪"], "有成员时应就绪")
  断言相等(面板["成员数"], 3, "成员数应为 3")
  断言相等(面板["消息数"], 4, "消息数应为 4")
  断言相等(面板["成员面板"][0], "甲[忙碌]", "首个成员应为甲[忙碌]")
  断言相等(面板["成员面板"][1], "乙[空闲]", "第二个成员应为乙[空闲]")
  断言相等(面板["成员面板"][2], "丙[离线]", "第三个成员应为丙[离线]")
  断言相等(面板["选中"], "", "初始不应有选中")

  # ---- 7. 选中态切换 ----
  断言为真(选中("乙"), "选中已有成员应成功")
  断言相等(取选中(), "乙", "选中态应为乙")
  断言相等(子串位置(装配成员面板()[1], "*"), 0, "选中成员应带 * 前缀")
  断言相等(装配成员面板()[0], "甲[忙碌]", "未选中成员不应带前缀")
  断言相等(装配团队面板()["选中"], "乙", "面板应回读选中态")

  # ---- 8. 反例：选中不存在的成员 ----
  断言为假(选中("不存在"), "选中不存在的成员应失败")
  断言相等(取选中(), "乙", "选中失败后选中态不应被改")

  # ---- 9. 取消选中 ----
  断言为真(选中(""), "传空串应取消选中")
  断言相等(取选中(), "", "取消后选中态应为空")
  断言相等(子串位置(装配成员面板()[1], "*"), -1, "取消后不应再有 * 前缀")

  # ---- 10. 回退：无数据源时读代理团队 + 自持消息表 ----
  配置数据源(空)
  断言相等(取数据源(), 空, "数据源应已置空")
  断言相等(长(取团队成员()), 0, "未注册成员时应为 0")
  断言为真(注册成员("戊", "写作"), "注册戊应成功")
  断言为真(注册成员("己", "检索"), "注册己应成功")
  设 回退面板 为 装配团队面板()
  断言相等(回退面板["成员数"], 2, "回退时应读到代理团队的 2 名成员")
  断言相等(回退面板["成员面板"][0], "戊[空闲]", "回退成员面板首项应为戊[空闲]")
  断言相等(回退面板["消息流"], "（暂无消息）", "无消息时应提示暂无消息")
  断言相等(回退面板["消息数"], 0, "回退初始消息数应为 0")

  # ---- 11. 追加消息并按时间序拼接 ----
  断言相等(追加消息("戊", "报到"), 1, "首条消息序号应为 1")
  追加消息("己", "收到")
  追加消息("戊", "开工")
  设 回退面板2 为 装配团队面板()
  断言相等(回退面板2["消息数"], 3, "追加后消息数应为 3")
  断言相等(回退面板2["消息流"], "戊:报到\n己:收到\n戊:开工", "追加消息应按时间序拼接")

  # ---- 12. 与代理团队的派单联动 ----
  配置派发器(界面派发器)
  设 派回 为 分派团队任务("写一篇稿子", "写作")
  断言为真(派回["ok"], "派发写作任务应成功")
  设 联动面板 为 装配团队面板()
  断言相等(联动面板["派单数"], 1, "面板派单数应为 1")
  断言相等(联动面板["成功数"], 1, "面板成功数应为 1")

  # ---- 13. 清空界面（L-166 回归）----
  清空界面()
  断言相等(取数据源(), 空, "清空后数据源应为空")
  断言相等(取选中(), "", "清空后选中态应为空")
  断言相等(长(取团队消息()), 0, "清空后消息表应为空")

  # ---- 14. 挂载进注册表，并从注册表取出工具执行（端到端）----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("装配团队面板"), "装配团队面板应已注册")
  设 定义 为 注册表.登记表["装配团队面板"]
  断言相等(定义["name"], "装配团队面板", "注册名一致")

  配置数据源(样本数据源)
  设 选中参 为 ["选中": "丙"]
  设 产出 为 定义["execute"](选中参)
  断言为假(产出["isError"], "合法装配参数不应报错")
  断言为真(包含(产出["content"], "成员(3)"), "回执应含成员数")
  断言为真(包含(产出["content"], "*丙[离线]"), "回执应标出选中的丙")
  断言为真(包含(产出["content"], "消息(4)"), "回执应含消息数")
  断言为真(包含(产出["content"], "甲:开工 / 乙:收到"), "回执应含按序消息流")
  断言相等(取选中(), "丙", "工具执行后选中态应已切换")

  设 坏参 为 ["选中": "不存在"]
  设 产出2 为 定义["execute"](坏参)
  断言为真(产出2["isError"], "选中不存在成员时应报错")

  设 取消参 为 ["选中": ""]
  设 产出3 为 定义["execute"](取消参)
  断言为假(产出3["isError"], "取消选中不应报错")
  断言相等(取选中(), "", "取消后选中态应为空")

  # ---- 15. 反例：空团队装配（清掉代理团队成员与数据源）----
  配置数据源(空)
  清空团队()
  设 产出4 为 定义["execute"]([])
  断言为真(产出4["isError"], "空团队装配应报错")
  断言为真(包含(产出4["content"], "团队暂无成员"), "空团队回执应提示无成员")

  打印 "测试_团队界面 全部通过"

主()
