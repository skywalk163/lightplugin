# 交付呈现.light —— 对标 dsh packages/deliverables
#
# 设计：交付物登记表（id -> {名, 路径, 完成, 类型}）。
# 登记 / 列出（可只看未完成）/ 标记完成 / 关联文件路径。零真实 I/O。
# 与「打包分发」区别：那是构建产物清单，这是**面向用户的交付物台账**。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 交付表 为 {}                  # id -> {名, 路径, 完成, 类型}
设 下一号 为 1
设 持久写 为 空                  # 宿主注入：(全表快照)->真

段落 注入持久化(写):
  全局 持久写。
  持久写 为 写
  返回 真

段落 持久化():
  如果 持久写 != 空:
    持久写(交付表)
  返回 真

# ---------- 内核 ----------
段落 登记核心(名, 类型):
  全局 下一号。
  如果 名 == "":
    返回 -1
  设 类型定 为 类型
  如果 类型定 == "":
    类型定 为 "文件"
  设 id 为 字符串(下一号)
  设 记录 为 ["名": 名, "路径": "", "完成": 假, "类型": 类型定]
  交付表[id] 为 记录
  下一号 为 下一号 + 1
  持久化()
  返回 下一号 - 1

段落 列出核心(只未完成):
  设 键们 为 字典键列表(交付表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 交付表[键]
    如果 只未完成 == 假 或 项["完成"] == 假:
      设 行 为 "[" + 键 + "] " + 项["名"] + " (" + 项["类型"] + ")"
      如果 项["路径"] != "":
        行 为 行 + " -> " + 项["路径"]
      如果 项["完成"] == 真:
        行 为 行 + " [已完成]"
      结果.追加(行)
  返回 结果

段落 完成核心(id):
  如果 交付表.包含(id) == 假:
    返回 假
  交付表[id]["完成"] 为 真
  持久化()
  返回 真

段落 关联核心(id, 路径):
  如果 交付表.包含(id) == 假:
    返回 假
  如果 路径 == "":
    返回 假
  交付表[id]["路径"] 为 路径
  持久化()
  返回 真

段落 路径核心(id):
  如果 交付表.包含(id) == 假:
    返回 ""
  返回 交付表[id]["路径"]

段落 计数核心():
  设 未 为 0
  设 键们 为 字典键列表(交付表)
  遍历 键 之 键们:
    如果 交付表[键]["完成"] == 假:
      设 未 为 未 + 1
  返回 未

# ---------- 工具 ----------
段落 登记模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "交付物名称"],
                       "类型": ["type": "string", "description": "交付物类型，如 文件 / 报告 / 链接"]],
        "required": ["名"]]

段落 登记处理(参数):
  设 名 为 参数["名"]
  设 类型定 为 ""
  如果 参数.包含("类型"):
    类型定 为 参数["类型"]
  设 n 为 登记核心(名, 类型定)
  如果 n < 0:
    返回 造工具结果("交付物名不可为空", 真)
  返回 造工具结果("已登记交付物 #" + 字符串(n) + ": " + 名, 假)

段落 列出模式():
  返回 ["type": "object",
        "properties": ["只未完成": ["type": "boolean", "description": "真=只列未完成的交付物"]]]

段落 列出处理(参数):
  设 只未 为 假
  如果 参数.包含("只未完成"):
    只未 为 参数["只未完成"]
  设 行们 为 列出核心(只未)
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 完成模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "要标记完成的交付物编号"]],
        "required": ["编号"]]

段落 完成处理(参数):
  设 id 为 参数["编号"]
  如果 完成核心(id) == 假:
    返回 造工具结果("交付物不存在: " + id, 真)
  返回 造工具结果("交付物 #" + id + " 已标记完成", 假)

段落 关联模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "交付物编号"],
                       "路径": ["type": "string", "description": "要关联的交付物路径"]],
        "required": ["编号", "路径"]]

段落 关联处理(参数):
  设 id 为 参数["编号"]
  设 路径 为 参数["路径"]
  如果 路径 == "":
    返回 造工具结果("关联路径不可为空", 真)
  如果 关联核心(id, 路径) == 假:
    返回 造工具结果("交付物不存在: " + id, 真)
  返回 造工具结果("交付物 #" + id + " 已关联路径: " + 路径, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("交付登记", "登记一个交付物", 登记模式(), 登记处理))
  注册表.注册(造工具定义("交付列出", "列出交付物（可只看未完成）", 列出模式(), 列出处理))
  注册表.注册(造工具定义("交付完成", "把指定交付物标记为已完成", 完成模式(), 完成处理))
  注册表.注册(造工具定义("交付关联", "给指定交付物关联文件路径", 关联模式(), 关联处理))
  返回 真

导出 注入持久化
导出 登记核心
导出 列出核心
导出 完成核心
导出 关联核心
导出 路径核心
导出 计数核心
导出 挂载
