# 测试_交付呈现.light —— 交付呈现 正例与反例

从 交付呈现 导入 登记核心, 列出核心, 完成核心, 关联核心, 路径核心, 计数核心, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # 1. 登记两条交付物
  设 n1 为 登记核心("复刻报告", "报告")
  设 n2 为 登记核心("归档包", "")
  断言相等(n1, 1, "第一条编号为 1")
  断言相等(n2, 2, "第二条编号为 2")

  # 2. 列出与计数
  断言相等(长(列出核心(假)), 2, "全列应有 2 条")
  断言相等(计数核心(), 2, "未完成计数应为 2")

  # 3. 关联路径
  断言为真(关联核心("1", "G:/out/report.md"), "关联编号 1 应成功")
  断言相等(路径核心("1"), "G:/out/report.md", "路径应写回")
  断言相等(路径核心("2"), "", "未关联的交付物路径应为空")
  设 行们 为 列出核心(假)
  断言为真(长(行们[0]) > 长("归档包"), "关联后首行应含路径信息")

  # 4. 反例：空路径关联
  断言为假(关联核心("1", ""), "空路径关联应失败")
  # 5. 反例：关联不存在的编号
  断言为假(关联核心("999", "/x"), "关联不存在编号应失败")

  # 6. 标记完成
  断言为真(完成核心("1"), "完成编号 1 应成功")
  断言相等(长(列出核心(真)), 1, "只列未完成应剩 1 条")
  断言相等(长(列出核心(假)), 2, "全列仍 2 条")
  断言相等(计数核心(), 1, "未完成计数应为 1")

  # 7. 反例：空名登记
  断言相等(登记核心("", "报告"), -1, "空名登记应返回 -1")

  # 8. 反例：完成不存在的编号
  断言为假(完成核心("999"), "完成不存在编号应失败")

  # 9. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("交付登记"), "交付登记 应注册")
  断言为真(注册表.登记表.包含("交付列出"), "交付列出 应注册")
  断言为真(注册表.登记表.包含("交付完成"), "交付完成 应注册")
  断言为真(注册表.登记表.包含("交付关联"), "交付关联 应注册")

  设 参 为 ["名": "端到端交付", "类型": "文件"]
  设 产 为 注册表.登记表["交付登记"]["execute"](参)
  断言为假(产["isError"], "端到端登记不应报错")

  设 参2 为 ["编号": "3", "路径": "G:/out/e2e.zip"]
  设 产2 为 注册表.登记表["交付关联"]["execute"](参2)
  断言为假(产2["isError"], "端到端关联不应报错")

  设 参3 为 ["编号": "3"]
  设 产3 为 注册表.登记表["交付完成"]["execute"](参3)
  断言为假(产3["isError"], "端到端完成不应报错")

  设 空参 为 ["占位": "x"]
  设 出列 为 注册表.登记表["交付列出"]["execute"](空参)
  断言为假(出列["isError"], "交付列出不应报错")

  # 10. 反例：空名登记工具报错
  设 坏参 为 ["名": ""]
  设 坏产 为 注册表.登记表["交付登记"]["execute"](坏参)
  断言为真(坏产["isError"], "空名登记应报错")

  # 11. 反例：空路径关联工具报错
  设 坏参2 为 ["编号": "1", "路径": ""]
  设 坏产2 为 注册表.登记表["交付关联"]["execute"](坏参2)
  断言为真(坏产2["isError"], "空路径关联应报错")

  # 12. 反例：完成不存在编号工具报错
  设 坏参3 为 ["编号": "999"]
  设 坏产3 为 注册表.登记表["交付完成"]["execute"](坏参3)
  断言为真(坏产3["isError"], "完成不存在编号应报错")

  打印 "测试_交付呈现 全部通过"

主()
