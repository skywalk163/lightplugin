# 测试_反馈通道.light —— 反馈通道 正例与反例

从 反馈通道 导入 提交核心, 列出核心, 处理核心, 筛选核心, 计数核心, 类型核心, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # 1. 提交三条反馈（两种类型）
  设 n1 为 提交核心("编译报错看不懂", "缺陷")
  设 n2 为 提交核心("建议加个暗色主题", "建议")
  设 n3 为 提交核心("用着还行", "")
  断言相等(n1, 1, "第一条编号为 1")
  断言相等(n2, 2, "第二条编号为 2")
  断言相等(n3, 3, "第三条编号为 3")

  # 2. 缺省类型归为「一般」
  断言相等(类型核心("3"), "一般", "缺省类型应为 一般")

  # 3. 列出：全列 3 条
  断言相等(长(列出核心(假)), 3, "全列应有 3 条")
  断言相等(计数核心(), 3, "未处理计数应为 3")

  # 4. 处理一条后：只列未处理 = 2，全列仍 3
  断言为真(处理核心("1"), "处理编号 1 应成功")
  断言相等(长(列出核心(真)), 2, "只列未处理应剩 2 条")
  断言相等(长(列出核心(假)), 3, "全列仍 3 条")
  断言相等(计数核心(), 2, "未处理计数应为 2")

  # 5. 按类型筛选
  设 建议行 为 筛选核心("建议")
  断言相等(长(建议行), 1, "类型 建议 应只有 1 条")
  设 缺陷行 为 筛选核心("缺陷")
  断言相等(长(缺陷行), 1, "类型 缺陷 应只有 1 条")
  断言为真(缺陷行[0] != "", "缺陷行应非空")
  设 空行 为 筛选核心("不存在类型")
  断言相等(长(空行), 0, "不存在的类型应筛出 0 条")

  # 6. 反例：空内容
  断言相等(提交核心("", "缺陷"), -1, "空内容应返回 -1")

  # 7. 反例：处理不存在的编号
  断言为假(处理核心("999"), "处理不存在编号应失败")

  # 8. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("反馈提交"), "反馈提交 应注册")
  断言为真(注册表.登记表.包含("反馈列出"), "反馈列出 应注册")
  断言为真(注册表.登记表.包含("反馈处理"), "反馈处理 应注册")
  断言为真(注册表.登记表.包含("反馈筛选"), "反馈筛选 应注册")

  设 参 为 ["内容": "端到端反馈", "类型": "建议"]
  设 产 为 注册表.登记表["反馈提交"]["execute"](参)
  断言为假(产["isError"], "端到端提交不应报错")

  设 空参 为 ["占位": "x"]
  设 出列 为 注册表.登记表["反馈列出"]["execute"](空参)
  断言为假(出列["isError"], "反馈列出不应报错")

  设 参3 为 ["类型": "建议"]
  设 出筛 为 注册表.登记表["反馈筛选"]["execute"](参3)
  断言为假(出筛["isError"], "反馈筛选不应报错")

  # 9. 反例：空内容工具报错
  设 坏参 为 ["内容": ""]
  设 坏产 为 注册表.登记表["反馈提交"]["execute"](坏参)
  断言为真(坏产["isError"], "空内容提交应报错")

  # 10. 反例：处理不存在编号工具报错
  设 坏参2 为 ["编号": "999"]
  设 坏产2 为 注册表.登记表["反馈处理"]["execute"](坏参2)
  断言为真(坏产2["isError"], "处理不存在编号应报错")

  # 11. 反例：空类型筛选工具报错
  设 坏参3 为 ["类型": ""]
  设 坏产3 为 注册表.登记表["反馈筛选"]["execute"](坏参3)
  断言为真(坏产3["isError"], "空类型筛选应报错")

  打印 "测试_反馈通道 全部通过"

主()
