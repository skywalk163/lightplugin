# 反馈通道.light —— 对标 dsh packages/feedback
#
# 设计：反馈队列（id -> {内容, 类型, 已处理, 序}）。
# 提交 / 列出（可只看未处理）/ 标记已处理 / 按类型筛选。零真实 I/O。
# 与「交互询问」区别：反馈是**单向**上报（用户→宿主），交互询问是**双向**问答。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 反馈表 为 {}                  # id -> {内容, 类型, 已处理, 序}
设 下一号 为 1
设 持久写 为 空                  # 宿主注入：(全表快照)->真

段落 注入持久化(写):
  全局 持久写。
  持久写 为 写
  返回 真

段落 持久化():
  如果 持久写 != 空:
    持久写(反馈表)
  返回 真

# ---------- 内核 ----------
段落 提交核心(内容, 类型):
  全局 下一号。
  如果 内容 == "":
    返回 -1
  设 类型定 为 类型
  如果 类型定 == "":
    类型定 为 "一般"
  设 id 为 字符串(下一号)
  设 记录 为 ["内容": 内容, "类型": 类型定, "已处理": 假, "序": 下一号]
  反馈表[id] 为 记录
  下一号 为 下一号 + 1
  持久化()
  返回 下一号 - 1

段落 列出核心(只未处理):
  设 键们 为 字典键列表(反馈表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 反馈表[键]
    如果 只未处理 == 假 或 项["已处理"] == 假:
      设 行 为 "[" + 键 + "] (" + 项["类型"] + ") " + 项["内容"]
      如果 项["已处理"] == 真:
        行 为 行 + " [已处理]"
      结果.追加(行)
  返回 结果

段落 处理核心(id):
  如果 反馈表.包含(id) == 假:
    返回 假
  反馈表[id]["已处理"] 为 真
  持久化()
  返回 真

段落 筛选核心(类型):
  设 键们 为 字典键列表(反馈表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 反馈表[键]
    如果 项["类型"] == 类型:
      设 行 为 "[" + 键 + "] " + 项["内容"]
      如果 项["已处理"] == 真:
        行 为 行 + " [已处理]"
      结果.追加(行)
  返回 结果

段落 类型核心(编号):
  如果 反馈表.包含(编号) == 假:
    返回 "一般"
  返回 反馈表[编号]["类型"]

段落 计数核心():
  设 未 为 0
  设 键们 为 字典键列表(反馈表)
  遍历 键 之 键们:
    如果 反馈表[键]["已处理"] == 假:
      设 未 为 未 + 1
  返回 未

# ---------- 工具 ----------
段落 提交模式():
  返回 ["type": "object",
        "properties": ["内容": ["type": "string", "description": "反馈内容"],
                       "类型": ["type": "string", "description": "反馈类型，如 缺陷 / 建议 / 一般"]],
        "required": ["内容"]]

段落 提交处理(参数):
  设 内容 为 参数["内容"]
  设 类型定 为 ""
  如果 参数.包含("类型"):
    类型定 为 参数["类型"]
  设 n 为 提交核心(内容, 类型定)
  如果 n < 0:
    返回 造工具结果("反馈内容不可为空", 真)
  设 id串 为 字符串(n)
  返回 造工具结果("已提交反馈 #" + id串 + "（类型=" + 类型核心(id串) + "）", 假)

段落 列出模式():
  返回 ["type": "object",
        "properties": ["只未处理": ["type": "boolean", "description": "真=只列未处理的反馈"]]]

段落 列出处理(参数):
  设 只未 为 假
  如果 参数.包含("只未处理"):
    只未 为 参数["只未处理"]
  设 行们 为 列出核心(只未)
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 处理模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "要标记已处理的反馈编号"]],
        "required": ["编号"]]

段落 处理处理(参数):
  设 id 为 参数["编号"]
  如果 处理核心(id) == 假:
    返回 造工具结果("反馈不存在: " + id, 真)
  返回 造工具结果("反馈 #" + id + " 已标记处理", 假)

段落 筛选模式():
  返回 ["type": "object",
        "properties": ["类型": ["type": "string", "description": "要筛选的反馈类型"]],
        "required": ["类型"]]

段落 筛选处理(参数):
  设 类型定 为 参数["类型"]
  如果 类型定 == "":
    返回 造工具结果("筛选类型不可为空", 真)
  设 行们 为 筛选核心(类型定)
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(该类型下无反馈)"
  返回 造工具结果(串, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("反馈提交", "提交一条反馈到反馈队列", 提交模式(), 提交处理))
  注册表.注册(造工具定义("反馈列出", "列出反馈（可只看未处理）", 列出模式(), 列出处理))
  注册表.注册(造工具定义("反馈处理", "把指定反馈标记为已处理", 处理模式(), 处理处理))
  注册表.注册(造工具定义("反馈筛选", "按类型筛选反馈", 筛选模式(), 筛选处理))
  返回 真

导出 注入持久化
导出 提交核心
导出 列出核心
导出 处理核心
导出 筛选核心
导出 计数核心
导出 类型核心
导出 挂载
