# 测试_凭据管理.light —— 凭据管理 正例与反例
#
# 零真实加解密：默认恒等后端；再注入一个「前缀+反转」的可逆桩验证加密后端真的被调用。

从 凭据管理 导入 注入加密后端, 存入核心, 存在核心, 读取核心, 类型核心, 删除核心, 列出核心, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# 可逆桩：加密 = 前后加方括号；解密 = 去掉方括号
段落 桩加密(明文):
  返回 "[" + 明文 + "]"

段落 桩解密(密文):
  返回 密文[1:长(密文) - 1]

段落 主:
  # 1. 默认恒等后端：存入什么读出什么
  断言为真(存入核心("令牌", "abc123", "token"), "存入 令牌 应成功")
  断言为真(存在核心("令牌"), "令牌 应存在")
  断言相等(读取核心("令牌"), "abc123", "恒等后端下明文应原样读出")
  断言相等(类型核心("令牌"), "token", "类型应为 token")

  # 2. 类型缺省
  断言为真(存入核心("密码", "secret", ""), "存入 密码 应成功")
  断言相等(类型核心("密码"), "通用", "缺省类型应为 通用")

  # 3. 覆盖存入
  断言为真(存入核心("令牌", "newvalue", "token"), "覆盖存入应成功")
  断言相等(读取核心("令牌"), "newvalue", "覆盖后应读出新值")
  断言相等(长(列出核心()), 2, "覆盖不应新增条目")

  # 4. 列出
  设 行们 为 列出核心()
  断言相等(长(行们), 2, "列出应有 2 条")

  # 5. 反例：空名 / 空明文
  断言为假(存入核心("", "x", "token"), "空名存入应失败")
  断言为假(存入核心("无名", "", "token"), "空明文存入应失败")

  # 6. 反例：读取不存在的凭据返回 空
  断言为假(存在核心("不存在"), "不存在的凭据应判否")
  设 缺 为 读取核心("不存在")
  断言相等(缺, 空, "读取不存在凭据应返回空")
  断言相等(类型核心("不存在"), "", "不存在凭据类型应为空串")

  # 7. 反例：删除不存在的凭据
  断言为假(删除核心("不存在"), "删除不存在凭据应失败")

  # 8. 注入可逆加密桩：明文应被加密存储，但读回来仍相等
  断言为真(注入加密后端(桩加密, 桩解密), "注入加密后端应成功")
  断言为真(存入核心("密钥", "plain", "密码"), "注入后存入应成功")
  断言相等(读取核心("密钥"), "plain", "注入后端下读回应等于原明文")
  断言相等(长(列出核心()), 3, "注入后共 3 条")
  # 密文 = "[plain]"（长度 7，比明文 5 多出前后各一个字符）→ 证明加密后端真的被调用
  设 行们2 为 列出核心()
  设 末尾 为 行们2[长(行们2) - 1]
  断言相等(末尾, "[密钥] 类型=密码 密文长度=7", "注入后端下列出行应体现加密后的长度")

  # 9. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("凭据存入"), "凭据存入 应注册")
  断言为真(注册表.登记表.包含("凭据读取"), "凭据读取 应注册")
  断言为真(注册表.登记表.包含("凭据删除"), "凭据删除 应注册")
  断言为真(注册表.登记表.包含("凭据列出"), "凭据列出 应注册")

  设 参 为 ["名": "端到端", "明文": "e2e-value", "类型": "token"]
  设 产 为 注册表.登记表["凭据存入"]["execute"](参)
  断言为假(产["isError"], "端到端存入不应报错")

  设 参2 为 ["名": "端到端"]
  设 产2 为 注册表.登记表["凭据读取"]["execute"](参2)
  断言为假(产2["isError"], "端到端读取不应报错")

  # 10. 反例：空明文工具报错
  设 坏参 为 ["名": "坏", "明文": ""]
  设 坏产 为 注册表.登记表["凭据存入"]["execute"](坏参)
  断言为真(坏产["isError"], "空明文存入应报错")

  # 11. 反例：读取不存在凭据工具报错
  设 坏参2 为 ["名": "压根没有"]
  设 坏产2 为 注册表.登记表["凭据读取"]["execute"](坏参2)
  断言为真(坏产2["isError"], "读取不存在凭据应报错")

  # 12. 删除工具可用
  设 参3 为 ["名": "端到端"]
  设 出删 为 注册表.登记表["凭据删除"]["execute"](参3)
  断言为假(出删["isError"], "端到端删除不应报错")
  设 空参 为 ["占位": "x"]
  设 出列 为 注册表.登记表["凭据列出"]["execute"](空参)
  断言为假(出列["isError"], "凭据列出不应报错")

  打印 "测试_凭据管理 全部通过"

主()
