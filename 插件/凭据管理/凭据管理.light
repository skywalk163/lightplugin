# 凭据管理.light —— 对标 dsh packages/credentials
#
# 设计：注入式加密后端。凭据名 -> {密文, 类型, 序}。
# 加密/解密由宿主注入（默认 空 = 恒等透传，便于纯逻辑测试），零真实 I/O、零密钥管理。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 凭据表 为 {}                  # 名 -> {密文, 类型, 序}
设 下一号 为 1
设 加密器 为 空                  # 宿主注入：(明文)->密文
设 解密器 为 空                  # 宿主注入：(密文)->明文

段落 注入加密后端(加密, 解密):
  全局 加密器。
  全局 解密器。
  加密器 为 加密
  解密器 为 解密
  返回 真

段落 加密(明文):
  如果 加密器 != 空:
    返回 加密器(明文)
  返回 明文

段落 解密(密文):
  如果 解密器 != 空:
    返回 解密器(密文)
  返回 密文

# ---------- 内核 ----------
段落 存入核心(名, 明文, 类型):
  全局 下一号。
  如果 名 == "":
    返回 假
  如果 明文 == "":
    返回 假
  设 类型定 为 类型
  如果 类型定 == "":
    类型定 为 "通用"
  设 密文 为 加密(明文)
  如果 凭据表.包含(名):
    凭据表[名]["密文"] 为 密文
    凭据表[名]["类型"] 为 类型定
    返回 真
  设 记录 为 ["密文": 密文, "类型": 类型定, "序": 下一号]
  凭据表[名] 为 记录
  下一号 为 下一号 + 1
  返回 真

段落 存在核心(名):
  返回 凭据表.包含(名)

段落 读取核心(名):
  如果 凭据表.包含(名) == 假:
    返回 空
  返回 解密(凭据表[名]["密文"])

段落 类型核心(名):
  如果 凭据表.包含(名) == 假:
    返回 ""
  返回 凭据表[名]["类型"]

段落 删除核心(名):
  如果 凭据表.包含(名) == 假:
    返回 假
  凭据表.弹出(名)
  返回 真

段落 列出核心():
  设 键们 为 字典键列表(凭据表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 凭据表[键]
    结果.追加("[" + 键 + "] 类型=" + 项["类型"] + " 密文长度=" + 字符串(长(项["密文"])))
  返回 结果

# ---------- 工具 ----------
段落 存入模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "凭据名（唯一）"],
                       "明文": ["type": "string", "description": "凭据明文值"],
                       "类型": ["type": "string", "description": "凭据类型，如 token / 密码 / 证书"]],
        "required": ["名", "明文"]]

段落 存入处理(参数):
  设 名 为 参数["名"]
  设 明文 为 参数["明文"]
  设 类型定 为 ""
  如果 参数.包含("类型"):
    类型定 为 参数["类型"]
  如果 存入核心(名, 明文, 类型定) == 假:
    返回 造工具结果("凭据存入失败：名与明文均不可为空", 真)
  返回 造工具结果("已存入凭据『" + 名 + "』（类型=" + 类型核心(名) + "）", 假)

段落 读取模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "要读取的凭据名"]],
        "required": ["名"]]

段落 读取处理(参数):
  设 名 为 参数["名"]
  如果 名 == "":
    返回 造工具结果("凭据名不可为空", 真)
  如果 存在核心(名) == 假:
    返回 造工具结果("凭据不存在: " + 名, 真)
  返回 造工具结果("凭据『" + 名 + "』明文长度=" + 字符串(长(读取核心(名))), 假)

段落 删除模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "要删除的凭据名"]],
        "required": ["名"]]

段落 删除处理(参数):
  设 名 为 参数["名"]
  如果 名 == "":
    返回 造工具结果("凭据名不可为空", 真)
  如果 删除核心(名) == 假:
    返回 造工具结果("凭据不存在: " + 名, 真)
  返回 造工具结果("已删除凭据『" + 名 + "』", 假)

段落 列出模式():
  返回 ["type": "object", "properties": {}]

段落 列出处理(参数):
  设 行们 为 列出核心()
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("凭据存入", "存入（或覆盖）一条命名凭据，经注入式加密后端加密", 存入模式(), 存入处理))
  注册表.注册(造工具定义("凭据读取", "按名读取凭据并解密（只回长度，不回明文）", 读取模式(), 读取处理))
  注册表.注册(造工具定义("凭据删除", "删除指定凭据", 删除模式(), 删除处理))
  注册表.注册(造工具定义("凭据列出", "列出全部凭据名与类型（不含明文）", 列出模式(), 列出处理))
  返回 真

导出 注入加密后端
导出 存入核心
导出 存在核心
导出 读取核心
导出 类型核心
导出 删除核心
导出 列出核心
导出 挂载
