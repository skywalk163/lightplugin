# 身份人格装配.light —— 对标 dsh packages/identity 的光明复刻（P2-2）
#
# 能力：Agent 人格卡 / 系统提示人格段装配。
#   lightharness 已有 `技能清单.light`（技能维度）与静态提示，但**人格维度**是空的：
#   没有「把人格卡装配成系统提示」的运行时。本插件补这一层。
#
# 设计要点：
#   1. **装配与渲染分离**：先出「段表」（标题 + 正文的结构化列表），再渲染成文本。
#      宿主可只取部分段（例如只想注入边界段），不必接受整段拼接结果 ——
#      这与「上下文装配裁剪」插件天然可对接（段表即上下文块）。
#   2. **空段跳过**：基调/专长/禁忌/示例/任务为空时不产生段，避免系统提示里出现
#      「专长: 」这种空壳。
#   3. **多卡合成**：支持 "甲+乙" 语法。专长/禁忌取**去重并集**，基调沿用首位，
#      基调不一致时给出**显式警告**而不是静默取舍（人格冲突静默吞掉是隐蔽 bug）。
#   4. 纯逻辑，零网络零计时 —— 单测确定性。
#
# 光明限制遵守：
#   L-047  字典/列表字面量不可直接作实参 → 先赋变量。
#   L-044  含「文本」的标识符会被拆名 → 命名避开（用 正文/示例/名字串）。
#   字符串 `{...}` 是插值 → 不写字面花括号（LP-D-001）。
#   可变状态与计数放**模块级字典**（元素赋值天然共享，无需『全局』）。
#   变量名不得用中文数字（会被当整数字面量）；不得用保留字。
#   列表去重/包含不依赖未验证的内置方法 → 手写 含于 / 并入去重。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 人格表 为 {}
设 计数 为 ["登记次数": 0, "装配次数": 0]

# ---------- 基础工具 ----------
段落 含于(表, 值):
  设 命中 为 假
  遍历 项 之 表:
    如果 项 == 值:
      命中 为 真
  返回 命中

段落 并入去重(目标, 来源):
  遍历 项 之 来源:
    如果 含于(目标, 项) == 假:
      目标.追加(项)
  返回 目标

# ---------- 登记与查询 ----------
段落 登记人格(名字, 基调, 专长表, 禁忌表, 示例=""):
  如果 名字 == "":
    返回 假
  设 卡 为 ["名字": 名字, "基调": 基调, "专长": 专长表, "禁忌": 禁忌表, "示例": 示例]
  人格表[名字] 为 卡
  计数["登记次数"] 为 计数["登记次数"] + 1
  返回 真

段落 是否有效人格(名字):
  返回 人格表.包含(名字)

段落 取人格(名字):
  如果 人格表.包含(名字) == 假:
    返回 空
  返回 人格表[名字]

段落 列举人格():
  返回 字典键列表(人格表)

# 软删除：置空而非依赖字典删除方法（光明字典删除方法未在本仓验证过）
段落 注销人格(名字):
  如果 人格表.包含(名字) == 假:
    返回 假
  人格表[名字] 为 空
  返回 真

段落 取登记次数():
  返回 计数["登记次数"]

段落 取装配次数():
  返回 计数["装配次数"]

# ---------- 多卡合成 ----------
段落 合并人格(名字表):
  设 专长 为 []
  设 禁忌 为 []
  设 基调 为 ""
  设 名字串 为 []
  遍历 名 之 名字表:
    如果 人格表.包含(名) == 真:
      设 卡 为 人格表[名]
      如果 卡 != 空:
        如果 基调 == "":
          基调 为 卡["基调"]
        并入去重(专长, 卡["专长"])
        并入去重(禁忌, 卡["禁忌"])
        名字串.追加(名)
  设 合名 为 连接字符串(名字串, "+")
  设 合卡 为 ["名字": 合名, "基调": 基调, "专长": 专长, "禁忌": 禁忌, "示例": ""]
  返回 合卡

段落 检测冲突(名字表):
  设 冲突 为 []
  设 基调表 为 []
  遍历 名 之 名字表:
    如果 人格表.包含(名) == 真:
      设 卡 为 人格表[名]
      如果 卡 != 空:
        如果 卡["基调"] != "":
          如果 含于(基调表, 卡["基调"]) == 假:
            基调表.追加(卡["基调"])
  如果 长(基调表) > 1:
    冲突.追加("基调不一致: " + 连接字符串(基调表, " / "))
  返回 冲突

# ---------- 装配：先出段表，再渲染 ----------
段落 装配分段(卡, 任务=""):
  设 段表 为 []
  设 段1 为 ["标题": "身份", "正文": "你是一名 " + 卡["名字"]]
  段表.追加(段1)
  如果 卡["基调"] != "":
    设 段2 为 ["标题": "基调", "正文": 卡["基调"]]
    段表.追加(段2)
  如果 长(卡["专长"]) > 0:
    设 行 为 []
    遍历 项 之 卡["专长"]:
      行.追加("- " + 项)
    设 段3 为 ["标题": "专长", "正文": 连接字符串(行, "\n")]
    段表.追加(段3)
  如果 长(卡["禁忌"]) > 0:
    设 行2 为 []
    遍历 项 之 卡["禁忌"]:
      行2.追加("- " + 项)
    设 段4 为 ["标题": "边界", "正文": 连接字符串(行2, "\n")]
    段表.追加(段4)
  如果 卡["示例"] != "":
    设 段5 为 ["标题": "示例", "正文": 卡["示例"]]
    段表.追加(段5)
  如果 任务 != "":
    设 段6 为 ["标题": "当前任务", "正文": 任务]
    段表.追加(段6)
  返回 段表

段落 渲染段表(段表):
  设 行串 为 []
  遍历 段 之 段表:
    行串.追加(段["标题"] + ": " + 段["正文"])
  返回 连接字符串(行串, "\n")

段落 装配提示(名字, 任务=""):
  如果 人格表.包含(名字) == 假:
    返回 ""
  设 卡 为 人格表[名字]
  如果 卡 == 空:
    返回 ""
  计数["装配次数"] 为 计数["装配次数"] + 1
  返回 渲染段表(装配分段(卡, 任务))

段落 装配多人格提示(名字表, 任务=""):
  设 名单 为 []
  遍历 名 之 名字表:
    如果 人格表.包含(名) == 真:
      名单.追加(名)
  如果 长(名单) == 0:
    返回 ""
  计数["装配次数"] 为 计数["装配次数"] + 1
  设 卡 为 合并人格(名单)
  设 提示 为 渲染段表(装配分段(卡, 任务))
  设 警告 为 检测冲突(名单)
  如果 长(警告) > 0:
    返回 提示 + "\n警告: " + 连接字符串(警告, "\n")
  返回 提示

# ---------- 模型可见工具 ----------
段落 人格列表模式():
  返回 ["type": "object", "properties": [], "required": []]

段落 人格列表处理(参数):
  设 名单 为 列举人格()
  如果 长(名单) == 0:
    返回 造工具结果("（暂无已登记人格）", 假)
  返回 造工具结果(连接字符串(名单, "\n"), 假)

段落 人格装配模式():
  返回 ["type": "object",
        "properties": ["名字": ["type": "string", "description": "人格名；多张卡用 + 连接，如 审查者+教师"],
                       "任务": ["type": "string", "description": "可选，当前任务描述"]],
        "required": ["名字"]]

段落 人格装配处理(参数):
  设 名字串 为 参数["名字"]
  设 任务 为 ""
  如果 参数.包含("任务"):
    设 任务 为 参数["任务"]
  设 名单 为 分割字符串(名字串, "+")
  遍历 名 之 名单:
    如果 人格表.包含(名) == 假:
      返回 造工具结果("人格不存在: " + 名, 真)
    如果 人格表[名] == 空:
      返回 造工具结果("人格已注销: " + 名, 真)
  如果 长(名单) == 1:
    返回 造工具结果(装配提示(名单[0], 任务), 假)
  返回 造工具结果(装配多人格提示(名单, 任务), 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("人格列表", "列出已登记的人格名", 人格列表模式(), 人格列表处理))
  注册表.注册(造工具定义("人格装配", "按人格名装配系统提示（多张卡用 + 连接）", 人格装配模式(), 人格装配处理))
  返回 真

导出 含于
导出 并入去重
导出 登记人格
导出 是否有效人格
导出 取人格
导出 列举人格
导出 注销人格
导出 取登记次数
导出 取装配次数
导出 合并人格
导出 检测冲突
导出 装配分段
导出 渲染段表
导出 装配提示
导出 装配多人格提示
导出 挂载
