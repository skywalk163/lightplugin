# 文档处理.light —— 对标 dsh packages/document 的光明复刻（P0-3）
#
# 设计：纯逻辑层自己做「类型判定 / 转换命令编造 / 文本与表格解析 / 分块 / 大纲提取」；
#       二进制文档（pdf/word/excel/ppt）的实际抽取交给**注入的转换器**，
#       因此本模块在无外部依赖下可完整单测，宿主可接 pdftotext / LibreOffice / python 脚本。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047  字典/列表字面量不可直接作实参 → 先赋变量。
#   L-044  含「文本」的标识符会被词法拆名 → 命名避开（用 内容/摘要/正文）。
#   字符串 `{...}` 是插值 → 一律不写字面花括号（见 LP-D-001）。
#   模块级标量赋值需『全局 X。』；本模块可变状态一律放字典，规避该坑。
#   stdlib 需导入：字符串处理 的 子串位置 / 去空格 / 去除重复空格。
#
# 已知缺口（如实记录）：
#   - 扩展名判定为**大小写敏感**（光明侧无已验证的转小写函数），
#     `.PDF` 会被判为未知；宿主可在调用前自行归一。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置, 去空格, 去除重复空格

# ---------- 扩展名与类型 ----------
段落 取扩展名(路径):
  设 段们 为 分割字符串(路径, ".")
  如果 长(段们) < 2:
    返回 ""
  返回 段们[长(段们) - 1]

段落 判定文档类型(路径):
  设 扩展 为 取扩展名(路径)
  如果 扩展 == "pdf":
    返回 "pdf"
  如果 扩展 == "docx" 或 扩展 == "doc":
    返回 "word"
  如果 扩展 == "xlsx" 或 扩展 == "xls":
    返回 "excel"
  如果 扩展 == "pptx" 或 扩展 == "ppt":
    返回 "ppt"
  如果 扩展 == "csv":
    返回 "csv"
  如果 扩展 == "md" 或 扩展 == "markdown":
    返回 "markdown"
  如果 扩展 == "txt" 或 扩展 == "log":
    返回 "纯文本"
  如果 扩展 == "html" 或 扩展 == "htm":
    返回 "html"
  返回 "未知"

段落 是否需要外部转换器(类型):
  设 二进制类 为 ["pdf": 真, "word": 真, "excel": 真, "ppt": 真]
  返回 二进制类.包含(类型)

# ---------- 转换命令编造（纯逻辑，不执行）----------
# 返回 ["可用": 真假, "命令": 命令行字符串, "说明": 说明]
段落 造转换命令(路径, 类型):
  如果 类型 == "pdf":
    返回 ["可用": 真, "命令": "pdftotext -layout " + 路径 + " -", "说明": "用 pdftotext 抽取文本"]
  如果 类型 == "word":
    返回 ["可用": 真, "命令": "libreoffice --headless --convert-to txt " + 路径, "说明": "用 LibreOffice 转 txt"]
  如果 类型 == "excel":
    返回 ["可用": 真, "命令": "libreoffice --headless --convert-to csv " + 路径, "说明": "用 LibreOffice 转 csv"]
  如果 类型 == "ppt":
    返回 ["可用": 真, "命令": "libreoffice --headless --convert-to txt " + 路径, "说明": "用 LibreOffice 转 txt"]
  如果 类型 == "未知":
    返回 ["可用": 假, "命令": "", "说明": "未知类型，无法转换"]
  返回 ["可用": 假, "命令": "", "说明": "该类型无需外部转换，直接读取即可"]

# ---------- 纯文本 / Markdown 处理 ----------
段落 清洗内容(内容):
  设 出 为 替换字符串(内容, "\r\n", "\n")
  设 出 为 替换字符串(出, "\r", "\n")
  设 行们 为 分割字符串(出, "\n")
  设 干净行 为 []
  遍历 行 之 行们:
    干净行.追加(去除重复空格(去空格(行)))
  返回 连接字符串(干净行, "\n")

段落 按行切块(内容, 每块行数):
  设 行们 为 分割字符串(清洗内容(内容), "\n")
  设 块表 为 []
  设 当前 为 []
  遍历 行 之 行们:
    当前.追加(行)
    如果 长(当前) >= 每块行数:
      块表.追加(连接字符串(当前, "\n"))
      设 当前 为 []
  如果 长(当前) > 0:
    块表.追加(连接字符串(当前, "\n"))
  返回 块表

段落 取Markdown大纲(内容):
  设 行们 为 分割字符串(内容, "\n")
  设 大纲 为 []
  遍历 行 之 行们:
    设 级别 为 0
    设 标题 为 ""
    如果 子串位置(行, "###### ") == 0:
      设 级别 为 6
      设 标题 为 去空格(替换字符串(行, "###### ", ""))
    否则:
      如果 子串位置(行, "##### ") == 0:
        设 级别 为 5
        设 标题 为 去空格(替换字符串(行, "##### ", ""))
      否则:
        如果 子串位置(行, "#### ") == 0:
          设 级别 为 4
          设 标题 为 去空格(替换字符串(行, "#### ", ""))
        否则:
          如果 子串位置(行, "### ") == 0:
            设 级别 为 3
            设 标题 为 去空格(替换字符串(行, "### ", ""))
          否则:
            如果 子串位置(行, "## ") == 0:
              设 级别 为 2
              设 标题 为 去空格(替换字符串(行, "## ", ""))
            否则:
              如果 子串位置(行, "# ") == 0:
                设 级别 为 1
                设 标题 为 去空格(替换字符串(行, "# ", ""))
    如果 级别 > 0:
      大纲.追加(["级别": 级别, "标题": 标题])
  返回 大纲

# ---------- CSV 解析 ----------
段落 解析CSV(内容):
  设 行们 为 分割字符串(清洗内容(内容), "\n")
  设 表 为 []
  遍历 行 之 行们:
    如果 行 != "":
      表.追加(分割字符串(行, ","))
  返回 表

段落 取CSV首行(内容):
  设 表 为 解析CSV(内容)
  如果 长(表) == 0:
    返回 []
  返回 表[0]

# ---------- 统一入口：文档 → 文本 ----------
# 转换器：段落引用，签名 (路径, 类型) -> ["ok": 真假, "正文": 内容, "原因": 说明]
# 文本文件直接读，二进制走转换器。
段落 文档转文本(路径, 转换器):
  设 类型 为 判定文档类型(路径)
  如果 类型 == "未知":
    返回 ["ok": 假, "正文": "", "原因": "未知文档类型", "类型": 类型]
  如果 是否需要外部转换器(类型) == 真:
    如果 转换器 == 空:
      返回 ["ok": 假, "正文": "", "原因": "该类型需要转换器但未注入", "类型": 类型]
    返回 转换器(路径, 类型)
  如果 文件存在(路径) == 假:
    返回 ["ok": 假, "正文": "", "原因": "文件不存在", "类型": 类型]
  返回 ["ok": 真, "正文": 清洗内容(读取文件(路径)), "原因": "", "类型": 类型]

# ---------- 模型可见工具 ----------
段落 文档大纲模式():
  返回 ["type": "object",
        "properties": ["路径": ["type": "string", "description": "Markdown 文档路径"]],
        "required": ["路径"]]

段落 文档大纲处理(参数):
  如果 文件存在(参数["路径"]) == 假:
    返回 造工具结果("文件不存在: " + 参数["路径"], 真)
  设 大纲 为 取Markdown大纲(读取文件(参数["路径"]))
  设 行串 为 []
  遍历 项 之 大纲:
    行串.追加(字符串(项["级别"]) + " 级: " + 项["标题"])
  返回 造工具结果(连接字符串(行串, "\n"), 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("文档大纲", "提取 Markdown 文档的标题大纲", 文档大纲模式(), 文档大纲处理))
  返回 真

导出 取扩展名
导出 判定文档类型
导出 是否需要外部转换器
导出 造转换命令
导出 清洗内容
导出 按行切块
导出 取Markdown大纲
导出 解析CSV
导出 取CSV首行
导出 文档转文本
导出 挂载
