# 测试_客户端状态.light —— P8 客户端状态 的正例与反例
#
# 零网络：事件由注入的确定性假事件源提供，队列顺序可精确断言。

从 客户端状态 导入 合法迁移表, 判定合法迁移, 取连接态, 切换连接态, 建会话, 推进轮次, 会话视图, 待处理事件数, 事件入队, 出队事件, 设置事件源, 拉取一批, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性假事件源：无视上限，固定返回 3 条 ----
设 事件源调用次数 为 0

段落 假事件源(上限):
  全局 事件源调用次数。
  事件源调用次数 为 事件源调用次数 + 1
  设 第一条 为 ["种类": "消息", "负载": "你好"]
  设 第二条 为 ["种类": "工具调用", "负载": "搜索"]
  设 第三条 为 ["种类": "消息", "负载": "结束"]
  返回 [第一条, 第二条, 第三条]

段落 空事件源(上限):
  返回 空

段落 主:
  全局 事件源调用次数。

  # ---- 1. 初始态 ----
  断言相等(取连接态(), "未连接", "初始连接态应为未连接")

  # ---- 2. 合法迁移：未连接 → 连接中 → 已连接 ----
  设 切1 为 切换连接态("连接中")
  断言为真(切1["ok"], "未连接→连接中 应合法")
  断言相等(切1["旧态"], "未连接", "迁移旧态")
  断言相等(切1["新态"], "连接中", "迁移新态")
  断言相等(取连接态(), "连接中", "迁移后连接态")
  设 切2 为 切换连接态("已连接")
  断言为真(切2["ok"], "连接中→已连接 应合法")
  断言相等(取连接态(), "已连接", "已连接态")

  # ---- 3. 反例：已连接 → 连接中 非法 ----
  设 坏1 为 切换连接态("连接中")
  断言为假(坏1["ok"], "已连接→连接中 应非法")
  断言相等(坏1["原因"], "非法迁移: 已连接 -> 连接中", "非法迁移原因")
  断言相等(取连接态(), "已连接", "非法迁移后状态不变")

  # ---- 4. 反例：自迁移非法 ----
  设 坏2 为 切换连接态("已连接")
  断言为假(坏2["ok"], "已连接→已连接 自迁移应非法")

  # ---- 5. 已连接 → 断开 → 连接中（回到可重连） ----
  断言为真(切换连接态("断开")["ok"], "已连接→断开 应合法")
  断言相等(取连接态(), "断开", "断开态")
  断言为假(切换连接态("已连接")["ok"], "断开→已连接 应非法")
  断言为真(切换连接态("连接中")["ok"], "断开→连接中 应合法")
  断言为真(切换连接态("已连接")["ok"], "连接中→已连接 应合法")

  # ---- 6. 反例：未连接 → 已连接 / 未连接 → 断开 非法 ----
  断言为真(判定合法迁移("未连接", "连接中"), "判定：未连接→连接中 合法")
  断言为假(判定合法迁移("未连接", "已连接"), "判定：未连接→已连接 非法")
  断言为假(判定合法迁移("未连接", "断开"), "判定：未连接→断开 非法")
  断言为假(判定合法迁移("不存在态", "连接中"), "判定：未知态一律非法")
  断言为假(判定合法迁移("已连接", "已连接"), "判定：自迁移非法")

  # ---- 7. 会话视图字段 ----
  设 建 为 建会话("sess-1", "小明")
  断言为真(建["ok"], "建会话应成功")
  设 视图 为 会话视图()
  断言相等(视图["会话号"], "sess-1", "视图会话号")
  断言相等(视图["用户"], "小明", "视图用户")
  断言相等(视图["连接态"], "已连接", "视图连接态")
  断言相等(视图["轮次"], 0, "初始轮次")

  # ---- 8. 反例：空会话号 ----
  设 坏会话 为 建会话("   ")
  断言为假(坏会话["ok"], "空会话号应失败")
  断言相等(坏会话["原因"], "会话号为空", "空会话号原因")
  断言相等(会话视图()["会话号"], "sess-1", "失败后会话号不变")

  # ---- 9. 轮次推进 ----
  推进轮次()
  推进轮次()
  断言相等(会话视图()["轮次"], 2, "推进两次后轮次")

  # ---- 10. 事件入队与出队顺序（FIFO） ----
  断言相等(待处理事件数(), 0, "初始队列为空")
  设 序1 为 事件入队("消息", "A")
  设 序2 为 事件入队("工具调用", "B")
  设 序3 为 事件入队("消息", "C")
  断言相等(序1, 1, "首个事件序号")
  断言相等(序3, 3, "第三个事件序号")
  断言相等(待处理事件数(), 3, "待处理事件数")
  设 首件 为 出队事件()
  断言相等(首件["序号"], 1, "出队首个事件序号")
  断言相等(首件["种类"], "消息", "出队首个事件种类")
  断言相等(首件["负载"], "A", "出队首个事件负载")
  设 次件 为 出队事件()
  断言相等(次件["负载"], "B", "出队第二个事件负载")
  断言相等(待处理事件数(), 1, "出队两个后待处理数")
  设 末件 为 出队事件()
  断言相等(末件["负载"], "C", "出队第三个事件负载")
  断言相等(待处理事件数(), 0, "队列排空")
  设 空取 为 出队事件()
  断言相等(空取, 空, "空队列出队应返回空")

  # ---- 11. 反例：未注入事件源 ----
  设 无源 为 拉取一批(3, 空)
  断言为假(无源["ok"], "未注入事件源应失败")
  断言相等(无源["原因"], "未注入事件源", "未注入原因")

  # ---- 12. 注入事件源后批量拉取（顺序 + 入队） ----
  事件源调用次数 为 0
  断言为真(设置事件源(假事件源), "设置事件源应返回真")
  设 拉取 为 拉取一批(3, 空)
  断言为真(拉取["ok"], "注入后拉取应成功")
  断言相等(事件源调用次数, 1, "事件源应被调用一次")
  断言相等(长(拉取["事件们"]), 3, "拉取条数")
  断言相等(拉取["事件们"][0]["负载"], "你好", "拉取首条负载")
  断言相等(拉取["事件们"][2]["负载"], "结束", "拉取末条负载")
  断言相等(拉取["事件们"][0]["序号"], 4, "拉取事件应带入队序号")
  断言相等(待处理事件数(), 3, "拉取后待处理数")

  # ---- 13. 反例：事件源返回空 ----
  设 空拉 为 拉取一批(3, 空事件源)
  断言为假(空拉["ok"], "事件源返回空应失败")
  断言相等(空拉["原因"], "事件源返回空", "空源原因")

  # ---- 14. 挂载进注册表并端到端执行 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("切换连接态"), "切换连接态应已注册")
  断言为真(注册表.登记表.包含("拉取事件"), "拉取事件应已注册")

  设 切换定义 为 注册表.登记表["切换连接态"]
  设 切参 为 ["目标态": "断开"]
  设 切产出 为 切换定义["execute"](切参)
  断言为假(切产出["isError"], "合法切换不应报错")
  断言为真(包含(切产出["content"], "已连接 -> 断开"), "切换产出应含迁移信息")

  设 坏切参 为 ["目标态": "已连接"]
  设 坏切产出 为 切换定义["execute"](坏切参)
  断言为真(坏切产出["isError"], "非法切换应报错")
  断言为真(包含(坏切产出["content"], "非法迁移"), "非法切换报错原因")

  设 拉取定义 为 注册表.登记表["拉取事件"]
  设 拉参 为 ["上限": 10]
  设 拉产出 为 拉取定义["execute"](拉参)
  断言为假(拉产出["isError"], "拉取不应报错")
  断言为真(包含(拉产出["content"], "拉取 3 条事件"), "拉取产出条数")
  断言为真(包含(拉产出["content"], "你好"), "拉取产出应含首条负载")

  打印 "测试_客户端状态 全部通过"

主()
