# 测试_核心工具桥.light —— 核心工具桥 正例与反例
#
# 门面插件：真实取值走注入式宿主函数；未注入时必须**报错**，不许编造。

从 核心工具桥 导入 注入宿主函数, 查时间核心, 查工作目录核心, 查版本核心, 查退出码核心, 汇总核心, 挂载
从 工具 导入 工具注册表

设 退出码桩 为 0

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 桩时间():
  返回 "2026-09-28T23:00:00"

段落 桩目录():
  返回 "G:/dswork/duan-light-merge"

段落 桩版本():
  返回 "7.0.0"

段落 桩退出码():
  全局 退出码桩。
  返回 退出码桩

段落 主:
  全局 退出码桩。
  # 1. 未注入时：内核返回空值（不编造）
  断言相等(查时间核心(), "", "未注入时时间应为空串")
  断言相等(查工作目录核心(), "", "未注入时目录应为空串")
  断言相等(查版本核心(), "", "未注入时版本应为空串")
  断言相等(查退出码核心(), -1, "未注入时退出码应为 -1")

  # 2. 未注入时：工具层报错（挂载后验证）
  设 注册表0 为 新建 工具注册表()
  挂载(注册表0)
  设 空参 为 ["占位": "x"]
  设 出0 为 注册表0.登记表["查时间"]["execute"](空参)
  断言为真(出0["isError"], "未注入时 查时间 应报错")

  # 3. 注入宿主函数
  断言为真(注入宿主函数(桩时间, 桩目录, 桩版本, 桩退出码), "注入宿主函数应成功")
  断言相等(查时间核心(), "2026-09-28T23:00:00", "时间应来自宿主")
  断言相等(查工作目录核心(), "G:/dswork/duan-light-merge", "目录应来自宿主")
  断言相等(查版本核心(), "7.0.0", "版本应来自宿主")
  断言相等(查退出码核心(), 0, "退出码默认应为 0")

  # 4. 退出码随宿主状态变化
  退出码桩 为 3
  断言相等(查退出码核心(), 3, "退出码应随宿主变化")

  # 5. 汇总
  设 汇总 为 汇总核心()
  断言相等(汇总["版本"], "7.0.0", "汇总版本应一致")
  断言相等(汇总["时间"], "2026-09-28T23:00:00", "汇总时间应一致")
  断言相等(汇总["退出码"], 3, "汇总退出码应一致")

  # 6. 注入后：4 个工具全部可用
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("查时间"), "查时间 应注册")
  断言为真(注册表.登记表.包含("查工作目录"), "查工作目录 应注册")
  断言为真(注册表.登记表.包含("查版本"), "查版本 应注册")
  断言为真(注册表.登记表.包含("查退出码"), "查退出码 应注册")

  设 出1 为 注册表.登记表["查时间"]["execute"](空参)
  断言为假(出1["isError"], "注入后 查时间 不应报错")
  设 出2 为 注册表.登记表["查工作目录"]["execute"](空参)
  断言为假(出2["isError"], "注入后 查工作目录 不应报错")
  设 出3 为 注册表.登记表["查版本"]["execute"](空参)
  断言为假(出3["isError"], "注入后 查版本 不应报错")
  设 出4 为 注册表.登记表["查退出码"]["execute"](空参)
  断言为假(出4["isError"], "注入后 查退出码 不应报错")

  打印 "测试_核心工具桥 全部通过"

主()
