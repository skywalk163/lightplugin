# 网络钩子.light —— 对标 dsh packages/webhook
#
# 设计：钩子注册表（名 -> {事件列表, 处理器标识, 序}）+ 事件派发。
# 真实 HTTP 收发由宿主注入的「派发器」完成（默认 空 → 只记录命中，不发起网络动作）。
# 零真实网络、零端口监听。
# 与「钩子总线」区别：钩子总线是**进程内同步事件总线**；本插件是**外部事件 → 处理器**的登记与派发。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 钩子表 为 {}                  # 名 -> {事件列表, 处理器, 序}
设 下一号 为 1
设 派发器 为 空                  # 宿主注入：(处理器标识, 事件名, 负载)->结果串
设 派发记录 为 []                # 每次触发的派发明细（可观测，便于测试断言）

段落 注入派发器(函数):
  全局 派发器。
  派发器 为 函数
  返回 真

段落 列表包含(列表, 值):
  设 找到 为 假
  遍历 项 之 列表:
    如果 项 == 值:
      找到 为 真
  返回 找到

# ---------- 内核 ----------
段落 注册核心(名, 事件列表, 处理器):
  全局 下一号。
  如果 名 == "":
    返回 假
  如果 长(事件列表) == 0:
    返回 假
  如果 处理器 == "":
    返回 假
  设 记录 为 ["事件": 事件列表, "处理器": 处理器, "序": 下一号]
  钩子表[名] 为 记录
  下一号 为 下一号 + 1
  返回 真

段落 触发核心(事件名, 负载):
  全局 派发记录。
  如果 事件名 == "":
    返回 []
  设 命中 为 []
  设 键们 为 字典键列表(钩子表)
  遍历 键 之 键们:
    设 项 为 钩子表[键]
    如果 列表包含(项["事件"], 事件名) == 真:
      设 结果 为 "(未注入派发器)"
      如果 派发器 != 空:
        结果 为 字符串(派发器(项["处理器"], 事件名, 负载))
      派发记录.追加(事件名 + "|" + 键 + "|" + 结果)
      命中.追加(键 + " -> " + 结果)
  返回 命中

段落 列出核心():
  设 键们 为 字典键列表(钩子表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 钩子表[键]
    设 行 为 "[" + 键 + "] 处理器=" + 项["处理器"] + " 事件=" + 连接字符串(项["事件"], ",")
    结果.追加(行)
  返回 结果

段落 删除核心(名):
  如果 钩子表.包含(名) == 假:
    返回 假
  钩子表.弹出(名)
  返回 真

段落 记录核心():
  返回 派发记录

# ---------- 工具 ----------
段落 注册模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "钩子名（唯一）"],
                       "事件": ["type": "array", "description": "该钩子监听的事件名列表"],
                       "处理器": ["type": "string", "description": "处理器标识（交给注入派发器执行）"]],
        "required": ["名", "事件", "处理器"]]

段落 注册处理(参数):
  设 名 为 参数["名"]
  设 事件列表 为 参数["事件"]
  设 处理器 为 参数["处理器"]
  如果 注册核心(名, 事件列表, 处理器) == 假:
    返回 造工具结果("钩子注册失败：名 / 事件列表 / 处理器 均不可为空", 真)
  返回 造工具结果("已注册钩子『" + 名 + "』（监听 " + 连接字符串(事件列表, ",") + "）", 假)

段落 触发模式():
  返回 ["type": "object",
        "properties": ["事件名": ["type": "string", "description": "要触发的事件名"],
                       "负载": ["type": "string", "description": "随事件携带的负载字符串"]],
        "required": ["事件名"]]

段落 触发处理(参数):
  设 事件名 为 参数["事件名"]
  设 负载 为 ""
  如果 参数.包含("负载"):
    负载 为 参数["负载"]
  设 命中 为 触发核心(事件名, 负载)
  如果 长(命中) == 0:
    返回 造工具结果("事件『" + 事件名 + "』无匹配钩子", 假)
  返回 造工具结果("事件『" + 事件名 + "』命中 " + 字符串(长(命中)) + " 个钩子:\n" + 连接字符串(命中, "\n"), 假)

段落 列出模式():
  返回 ["type": "object", "properties": {}]

段落 列出处理(参数):
  设 行们 为 列出核心()
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 删除模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "要删除的钩子名"]],
        "required": ["名"]]

段落 删除处理(参数):
  设 名 为 参数["名"]
  如果 删除核心(名) == 假:
    返回 造工具结果("钩子不存在: " + 名, 真)
  返回 造工具结果("已删除钩子『" + 名 + "』", 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("Webhook注册", "注册一个网络钩子（名 + 监听事件列表 + 处理器标识）", 注册模式(), 注册处理))
  注册表.注册(造工具定义("Webhook触发", "按事件名触发匹配的钩子，经注入派发器执行", 触发模式(), 触发处理))
  注册表.注册(造工具定义("Webhook列出", "列出全部钩子及其监听事件", 列出模式(), 列出处理))
  注册表.注册(造工具定义("Webhook删除", "删除指定钩子", 删除模式(), 删除处理))
  返回 真

导出 注入派发器
导出 注册核心
导出 触发核心
导出 列出核心
导出 删除核心
导出 记录核心
导出 列表包含
导出 挂载
