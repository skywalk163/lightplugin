# 测试_网络钩子.light —— 网络钩子 正例与反例
#
# 零真实网络：派发器由「注入派发器」替换成内存桩（只记调用，不发包）。

从 网络钩子 导入 注入派发器, 注册核心, 触发核心, 列出核心, 删除核心, 记录核心, 列表包含, 挂载
从 工具 导入 工具注册表

设 派发次数 为 0

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 桩派发器(处理器, 事件名, 负载):
  全局 派发次数。
  派发次数 为 派发次数 + 1
  返回 "已处理:" + 处理器 + ":" + 事件名

段落 主:
  # 1. 注册两个钩子，其中一个监听两个事件
  设 事件1 为 ["push", "merge"]
  设 事件2 为 ["release"]
  断言为真(注册核心("代码钩子", 事件1, "处理A"), "注册 代码钩子 应成功")
  断言为真(注册核心("发布钩子", 事件2, "处理B"), "注册 发布钩子 应成功")
  断言相等(长(列出核心()), 2, "列出应有 2 个钩子")

  # 2. 未注入派发器时触发：命中但结果为「未注入派发器」
  设 命中1 为 触发核心("push", "负载1")
  断言相等(长(命中1), 1, "push 应命中 1 个钩子")
  断言相等(派发次数, 0, "未注入派发器时不应调用派发器")

  # 3. 注入派发器后再触发
  断言为真(注入派发器(桩派发器), "注入派发器应成功")
  设 命中2 为 触发核心("push", "负载2")
  断言相等(长(命中2), 1, "push 仍应命中 1 个")
  断言相等(派发次数, 1, "注入后应调用派发器 1 次")
  断言为真(列表包含(命中2, "代码钩子 -> 已处理:处理A:push"), "命中明细应含处理器结果")

  # 4. 一个钩子监听多事件：merge 也命中同一个钩子
  设 命中3 为 触发核心("merge", "")
  断言相等(长(命中3), 1, "merge 应命中 1 个")
  断言相等(派发次数, 2, "第二次触发应再调派发器")

  # 5. 无匹配事件 → 空命中
  设 命中4 为 触发核心("没人监听", "")
  断言相等(长(命中4), 0, "无匹配事件应命中 0 个")
  断言相等(派发次数, 2, "无匹配时不应调用派发器")

  # 6. 反例：空事件名
  断言相等(长(触发核心("", "")), 0, "空事件名应命中 0 个")

  # 7. 反例：注册参数缺失
  断言为假(注册核心("", 事件1, "处理C"), "空名注册应失败")
  设 空事件 为 []
  断言为假(注册核心("空事件钩子", 空事件, "处理C"), "空事件列表注册应失败")
  断言为假(注册核心("空处理器钩子", 事件1, ""), "空处理器注册应失败")
  断言相等(长(列出核心()), 2, "失败注册不应新增钩子")

  # 8. 反例：删除不存在的钩子
  断言为假(删除核心("不存在"), "删除不存在钩子应失败")

  # 9. 删除已存在的 → 再触发不再命中
  断言为真(删除核心("代码钩子"), "删除 代码钩子 应成功")
  设 命中5 为 触发核心("push", "")
  断言相等(长(命中5), 0, "删除后 push 应命中 0 个")
  断言相等(长(列出核心()), 1, "删除后只剩 1 个钩子")

  # 10. 派发记录可观测
  # 派发记录含「未注入派发器」那一次：push(未注入) + push(注入) + merge(注入) = 3 条
  设 记录 为 记录核心()
  断言相等(长(记录), 3, "派发记录应有 3 条（含未注入时的 1 次）")

  # 11. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("Webhook注册"), "Webhook注册 应注册")
  断言为真(注册表.登记表.包含("Webhook触发"), "Webhook触发 应注册")
  断言为真(注册表.登记表.包含("Webhook列出"), "Webhook列出 应注册")
  断言为真(注册表.登记表.包含("Webhook删除"), "Webhook删除 应注册")

  设 端到端事件 为 ["e2e"]
  设 参 为 ["名": "端到端钩子", "事件": 端到端事件, "处理器": "处理E"]
  设 产 为 注册表.登记表["Webhook注册"]["execute"](参)
  断言为假(产["isError"], "端到端注册不应报错")

  设 参2 为 ["事件名": "e2e", "负载": "payload"]
  设 产2 为 注册表.登记表["Webhook触发"]["execute"](参2)
  断言为假(产2["isError"], "端到端触发不应报错")

  设 空参 为 ["占位": "x"]
  设 出列 为 注册表.登记表["Webhook列出"]["execute"](空参)
  断言为假(出列["isError"], "Webhook列出不应报错")

  设 参3 为 ["名": "端到端钩子"]
  设 出删 为 注册表.登记表["Webhook删除"]["execute"](参3)
  断言为假(出删["isError"], "端到端删除不应报错")

  # 12. 反例：注册参数缺失工具报错
  设 坏参 为 ["名": "", "事件": 端到端事件, "处理器": "处理X"]
  设 坏产 为 注册表.登记表["Webhook注册"]["execute"](坏参)
  断言为真(坏产["isError"], "空名注册应报错")

  # 13. 反例：删除不存在钩子工具报错
  设 坏参2 为 ["名": "压根没有"]
  设 坏产2 为 注册表.登记表["Webhook删除"]["execute"](坏参2)
  断言为真(坏产2["isError"], "删除不存在钩子应报错")

  打印 "测试_网络钩子 全部通过"

主()
