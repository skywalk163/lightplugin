# 测试_网页抓取.light —— P0-2 网页抓取 的正例与反例
# 核心逻辑零网络依赖：所有 HTML 由固定样本注入，取字节器确定性返回。

从 网页抓取 导入 判定安全网址, 取网址主机, 去标签, 删块, 解码实体, 压缩空白, 取标题, 数链接, 网页正文抽取, 抓取正文, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言不含(大串, 子串, 标签):
  如果 子串位置(大串, 子串) >= 0:
    抛出 新建 错误("断言不含失败 [" + 标签 + "]: 竟然含 " + 子串)

# ---- 固定样本：含 script / style / 实体 / 链接 ----
段落 造样本():
  # 注：样本内的 CSS 一律避开字面花括号 —— 光明字符串支持 {变量} 插值（已验证），
  #     写字面 {} 会被当插值求值而 NameError。详见 ../../语言缺陷反馈.md LP-D-001。
  设 s 为 "<html><head><title>光明屋的猫</title><style>body-color-red</style></head>"
  设 s 为 s + "<body><script>var 坏 = 1;</script>"
  设 s 为 s + "<h1>标题甲</h1><p>第一段 &amp; 第二段</p>"
  设 s 为 s + "<a href=\"x\">链接甲</a><a href=\"y\">链接乙</a></body></html>"
  返回 s

段落 固定取字节器(地址):
  返回 造样本()

段落 空取字节器(地址):
  返回 ""

段落 主:
  设 样本 为 造样本()

  # ---- 1. 网址安全判定 ----
  断言相等(判定安全网址("https://example.com/a"), "ok", "https 应放行")
  断言相等(判定安全网址("http://example.com"), "ok", "http 应放行")
  断言相等(判定安全网址("file:///etc/passwd"), "仅支持 http/https 协议", "file 协议应拒绝")
  断言相等(判定安全网址("javascript:alert(1)"), "仅支持 http/https 协议", "伪协议应拒绝")
  断言相等(判定安全网址(""), "网址为空", "空网址")

  # ---- 2. 主机提取 ----
  断言相等(取网址主机("https://example.com/a/b?x=1#y"), "example.com", "剥离路径查询锚点")

  # ---- 3. 去标签 ----
  断言相等(去标签("<p>你好</p>"), "你好", "去标签基本")
  断言相等(去标签("<b>甲</b>与<i>乙</i>"), "甲与乙", "多标签")

  # ---- 4. 删块 script / style ----
  设 删后 为 删块(样本, "script")
  断言不含(删后, "var 坏", "script 内容应被删")
  设 删双 为 删块(删块(样本, "script"), "style")
  断言不含(删双, "body-color-red", "style 内容应被删")

  # ---- 5. 实体解码 ----
  断言相等(解码实体("&amp;"), "&", "amp 解码")
  断言相等(解码实体("&lt;b&gt;"), "<b>", "尖括号解码")
  断言相等(解码实体("甲&nbsp;乙"), "甲 乙", "nbsp 解码")

  # ---- 6. 空白压缩：去空行 + 行内重复空格 ----
  断言相等(压缩空白("甲  乙\n\n  丙  "), "甲 乙\n丙", "空白压缩")

  # ---- 7. 标题 ----
  断言相等(取标题(样本), "光明屋的猫", "title 提取")
  断言相等(取标题("<html><p>无标题</p></html>"), "", "无 title 返回空")

  # ---- 8. 链接计数 ----
  断言相等(数链接(样本), 2, "链接数")

  # ---- 9. 正文抽取：不得混入脚本/样式，正文应含可见文字 ----
  设 正文 为 网页正文抽取(样本)
  断言不含(正文, "var 坏", "正文不含脚本")
  断言不含(正文, "color:red", "正文不含样式")
  断言为真(子串位置(正文, "第一段") >= 0, "正文应含第一段")
  断言为真(子串位置(正文, "第二段") >= 0, "正文应含第二段")
  断言为真(子串位置(正文, "链接甲") >= 0, "正文应含链接文字")

  # ---- 10. 抓取正文（注入取字节器）----
  设 结果 为 抓取正文("https://example.com/p", 固定取字节器)
  断言为真(结果["ok"], "抓取应成功")
  断言相等(结果["标题"], "光明屋的猫", "抓取标题")
  断言相等(结果["链接数"], 2, "抓取链接数")

  # ---- 11. 反例：非法网址 ----
  设 坏 为 抓取正文("file:///etc/passwd", 固定取字节器)
  断言为假(坏["ok"], "非法网址应失败")
  断言相等(坏["原因"], "仅支持 http/https 协议", "非法网址原因")

  # ---- 12. 反例：取回为空 ----
  设 空结 为 抓取正文("https://example.com/none", 空取字节器)
  断言为假(空结["ok"], "空内容应失败")
  断言相等(空结["原因"], "取回内容为空", "空内容原因")

  # ---- 13. 挂载与工具校验 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("网页抓取"), "网页抓取应注册")
  设 定义 为 注册表.登记表["网页抓取"]
  设 合法参 为 ["网址": "https://example.com/a"]
  断言为假(定义["execute"](合法参)["isError"], "合法网址不应报错")
  设 非法参 为 ["网址": "file:///etc/passwd"]
  断言为真(定义["execute"](非法参)["isError"], "非法网址应报错")

  打印 "测试_网页抓取 全部通过"

主()
