# 测试_工作线程打包.light —— P5-3 工作线程打包 的正例与反例

从 工作线程打包 导入 注册模块, 注册Overlay, 位置, 打包, 装配, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# 辅助：列表长度断言 / 包含断言 / 报错断言
段落 断言Equal_长度(表, 期望, 标签):
  如果 长(表) != 期望:
    抛出 新建 错误("长度断言失败 [" + 标签 + "]: 实际=" + 字符串(长(表)) + " 期望=" + 字符串(期望))

段落 断言True_含(表, 值, 标签):
  遍历 项 之 表:
    如果 项 == 值:
      返回
  抛出 新建 错误("包含断言失败 [" + 标签 + "]: 未找到 " + 值)

段落 断言True_isError(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("应为报错 [" + 标签 + "]")

段落 主:
  # ---- 1. 拓扑序：a <- b <- c ----
  注册模块("a", [])
  注册模块("b", ["a"])
  注册模块("c", ["b"])
  设 包 为 打包()
  断言为真(包["就绪"], "无环图应就绪")
  断言相等(长(包["顺序"]), 3, "应有 3 个模块")
  断言为真(位置(包["顺序"], "a") < 位置(包["顺序"], "b"), "a 应在 b 之前")
  断言为真(位置(包["顺序"], "b") < 位置(包["顺序"], "c"), "b 应在 c 之前")

  # ---- 2. overlay 挂载点校验 ----
  断言为真(注册Overlay("conf.json", "home/app/conf.json"), "home/ 下挂载点应合法")
  断言为真(注册Overlay("ws.json", "workspace/data/ws.json"), "workspace/ 下挂载点应合法")
  断言为假(注册Overlay("evil.json", "etc/x.json"), "etc/ 下挂载点应被拒")

  # ---- 3. 装配（图就绪 + overlays）----
  设 装 为 装配()
  断言为真(装["就绪"], "装配应就绪")
  断言Equal_长度(装["顺序"], 3, "装配顺序应为 3")
  断言Equal_长度(装["overlays"], 2, "装配应含 2 个 overlay")

  # ---- 4. 循环检测 ----
  注册模块("x", ["y"])
  注册模块("y", ["x"])
  设 环 为 打包()
  断言为假(环["就绪"], "有环图不应就绪")
  断言True_含(环["循环"], "x", "循环应包含 x")
  断言True_含(环["循环"], "y", "循环应包含 y")
  设 装坏 为 装配()
  断言为假(装坏["就绪"], "环图装配应失败")

  # ---- 5. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("工作线程打包"), "工作线程打包应注册")
  设 定义 为 注册表.登记表["工作线程打包"]
  设 参 为 ["动作": "装配"]
  设 产出 为 定义["execute"](参)
  断言为真(产出["isError"], "环图下装配工具应报错")
  设 参坏 为 ["动作": "乱来"]
  断言True_isError(定义["execute"](参坏)["isError"], "未知动作应报错")

  打印 "测试_工作线程打包 全部通过"

主()
