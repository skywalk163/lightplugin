# 测试_代理团队.light —— 代理团队 的正例与反例
#
# 与宿主一致的断言惯用法（照抄 lightharness/examples/test_*.light）：
#   失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。
# 派发后端复用 子代理派发，执行器由本测试注入确定性回执 → 零网络、零墙上时钟。

从 代理团队 导入 配置派发器, 注册成员, 注销成员, 取成员, 列出成员, 成员能力, 匹配成员, 分派团队任务, 分派团队批量, 汇总团队结果, 清空团队, 挂载
从 工具 导入 工具注册表
从 内置核心字典 导入 字典键列表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性执行器：任务名含「坏任务」即失败 ----
段落 团队执行器(任务体):
  如果 任务体 == "坏任务":
    设 坏回 为 ["ok": 假, "结果": "", "原因": "远端不可用"]
    返回 坏回
  设 好回 为 ["ok": 真, "结果": "完成:" + 任务体, "原因": ""]
  返回 好回

段落 主:
  # ---- 0. 从干净团队开始（模块级状态可跨用例，先清）----
  清空团队()
  配置派发器(团队执行器)

  # ---- 1. 成员注册与能力登记 ----
  断言为真(注册成员("甲", "写作,检索"), "注册甲应成功")
  断言为真(注册成员("乙", "检索"), "注册乙应成功")
  断言为真(注册成员("丙", "计算"), "注册丙应成功")
  断言相等(长(列出成员()), 3, "团队应有 3 名成员")
  断言为真(列出成员().包含("甲"), "甲应在成员列表中")
  断言为真(成员能力("甲").包含("写作"), "甲应具备写作能力")
  断言为真(成员能力("甲").包含("检索"), "甲应具备检索能力")
  断言为假(成员能力("甲").包含("计算"), "甲不应具备计算能力")
  断言相等(长(成员能力("乙")), 1, "乙应只有 1 项能力")

  # ---- 2. 反例：空名字注册失败 ----
  断言为假(注册成员("", "写作"), "空名字注册应失败")

  # ---- 3. 取成员 / 未注册成员 ----
  断言相等(取成员("甲")["名字"], "甲", "取成员应回读名字")
  断言相等(取成员("不存在"), 空, "未注册成员应返回空")

  # ---- 4. 按能力匹配到正确成员 ----
  断言相等(匹配成员("写作"), "甲", "写作应匹配到甲")
  断言相等(匹配成员("计算"), "丙", "计算应匹配到丙")
  断言相等(匹配成员("检索"), "甲", "检索应按注册顺序匹配到甲")

  # ---- 5. 反例：无匹配成员 ----
  断言相等(匹配成员("绘画"), 空, "无成员具备绘画时应返回空")

  # ---- 6. 分派：命中正确成员并成功 ----
  设 回1 为 分派团队任务("写一篇稿子", "写作")
  断言为真(回1["ok"], "写作任务应派发成功")
  断言相等(回1["成员"], "甲", "写作任务应派给甲")
  断言相等(回1["状态"], "成功", "写作任务状态应为成功")
  断言相等(取成员("甲")["任务数"], 1, "甲的任务数应为 1")

  # ---- 7. 分派：另一能力命中另一成员 ----
  设 回2 为 分派团队任务("算一下", "计算")
  断言为真(回2["ok"], "计算任务应派发成功")
  断言相等(回2["成员"], "丙", "计算任务应派给丙")

  # ---- 8. 反例：无匹配成员时分派失败 ----
  设 回3 为 分派团队任务("画张图", "绘画")
  断言为假(回3["ok"], "无匹配成员时派发应失败")
  断言相等(回3["原因"], "无匹配成员: 绘画", "无匹配成员原因应明确")
  断言相等(回3["成员"], "", "无匹配成员时不应有成员")

  # ---- 9. 反例：空任务 ----
  设 回4 为 分派团队任务("", "写作")
  断言为假(回4["ok"], "空任务应派发失败")
  断言相等(回4["原因"], "任务不可为空", "空任务原因应明确")

  # ---- 10. 执行器失败 → 状态失败并计入汇总 ----
  设 回5 为 分派团队任务("坏任务", "计算")
  断言为假(回5["ok"], "执行器失败时派发应失败")
  断言相等(回5["状态"], "失败", "失败状态应为失败")
  断言相等(回5["原因"], "远端不可用", "失败原因应透传")

  # ---- 11. 结果汇总统计 ----
  设 汇总 为 汇总团队结果()
  断言相等(汇总["总数"], 3, "汇总总数应为 3（失败派单不入账）")
  断言相等(汇总["成功"], 2, "汇总成功数应为 2")
  断言相等(汇总["失败"], 1, "汇总失败数应为 1")
  断言相等(汇总["成员数"], 3, "汇总成员数应为 3")
  断言相等(汇总["按成员"]["甲"], 1, "甲应承担 1 单")
  断言相等(汇总["按成员"]["丙"], 2, "丙应承担 2 单")
  断言为假(汇总["按成员"].包含("乙"), "乙未接单不应出现在按成员统计中")

  # ---- 12. 批量分派 ----
  设 任务们 为 ["查资料A", "查资料B"]
  设 批量回 为 分派团队批量(任务们, "检索")
  断言相等(长(批量回), 2, "批量分派应返回 2 条回执")
  断言相等(批量回[0]["成员"], "甲", "检索批量第一单应给甲")
  断言相等(批量回[1]["成员"], "甲", "检索批量第二单应给甲")
  断言相等(取成员("甲")["任务数"], 3, "甲累计任务数应为 3")

  # ---- 13. 注销成员 ----
  断言为真(注销成员("乙"), "注销乙应成功")
  断言相等(长(列出成员()), 2, "注销后应剩 2 名成员")
  断言为假(注销成员("乙"), "重复注销应失败")

  # ---- 13.5 清空：验证模块级名字在段内可重新绑定（L-166 回归）----
  清空团队()
  断言相等(长(列出成员()), 0, "清空后成员数应归零")
  断言相等(汇总团队结果()["总数"], 0, "清空后结果总数应归零")
  断言相等(匹配成员("写作"), 空, "清空后不应再匹配到成员")

  # ---- 14. 挂载进注册表，并从注册表取出工具执行（端到端）----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("注册成员"), "注册成员应已注册")
  断言为真(注册表.登记表.包含("分派团队任务"), "分派团队任务应已注册")

  设 定义 为 注册表.登记表["注册成员"]
  断言相等(定义["name"], "注册成员", "注册名一致")
  设 注册参 为 ["名字": "丁", "能力": "审校,写作"]
  设 产出 为 定义["execute"](注册参)
  断言为假(产出["isError"], "合法注册参数不应报错")
  断言为真(包含(产出["content"], "已注册成员 丁"), "注册回执应含成员名")
  断言为真(成员能力("丁").包含("审校"), "丁的能力应已登记")

  设 缺参 为 ["名字": "戊"]
  设 产出2 为 定义["execute"](缺参)
  断言为真(产出2["isError"], "缺少能力参数应报错")

  设 定义2 为 注册表.登记表["分派团队任务"]
  设 派参 为 ["任务": "校一遍稿", "能力": "审校"]
  设 产出3 为 定义2["execute"](派参)
  断言为假(产出3["isError"], "合法分派参数不应报错")
  断言为真(包含(产出3["content"], "已派给 丁"), "审校任务应派给丁")

  设 坏派参 为 ["任务": "画个图", "能力": "绘画"]
  设 产出4 为 定义2["execute"](坏派参)
  断言为真(产出4["isError"], "无匹配成员时分派工具应报错")

  打印 "测试_代理团队 全部通过"

主()
