# 浏览器运行时.light —— 对标 dsh packages/experimental/browser-use-runtime 的浏览器会话运行时
#
# 定位：**会话 / 队列运行时**。
#   上下文登记 → 页面登记 → 动作入队（打开/点击/填表/截图）→ 批量执行（驱动注入）。
#   边界：浏览器自动化.light 是**动作定义层**（一个动作长什么样），
#         本插件是**会话与队列运行时**（这一批动作按什么顺序、在哪儿跑、失败怎么办）。
#
# 驱动注入：动作的**真实执行**由外部注入的「驱动」提供，签名
#   (动作条目) -> {"ok": 布尔, "内容": 字符串, "原因": 字符串}
#   宿主可接 Playwright / DevTools；测试注入确定性 fake → 零网络、零浏览器、零计时。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作实参 → 先赋变量。
#   L-044   含「文本」的标识符会被词法拆名 → 命名避开「文本」。
#   L-165/166 段内重新绑定模块级名字须先『全局 X。』。
#   LP-D-010 遍历 循环变量不与被调用函数同名 → 用 条目/页面项/名字。
#   LP-D-013 不用「出」做变量名 → 用 结果表 / 收集表。
#   链式下标赋值未验证 → 一律先取局部变量再改。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

# ---------- 模块级状态 ----------
设 上下文表 为 {}          # 上下文名 -> ["名字", "页面表", "队列"]
设 浏览器驱动 为 空        # 注入式执行器
设 动作序号 为 0
设 合法动作 为 ["打开", "点击", "填表", "截图"]

# ---------- 注入入口（宿主/测试）----------
段落 配置驱动(驱动):
  全局 浏览器驱动。
  浏览器驱动 为 驱动
  返回 真

段落 取驱动():
  返回 浏览器驱动

# ---------- 上下文 ----------
段落 登记上下文(名字):
  如果 名字 == "":
    返回 假
  如果 上下文表.包含(名字) == 真:
    返回 真
  设 页面表 为 {}
  设 队列 为 []
  设 记录 为 ["名字": 名字, "页面表": 页面表, "队列": 队列]
  上下文表[名字] 为 记录
  返回 真

段落 取上下文(名字):
  如果 上下文表.包含(名字) == 假:
    返回 空
  返回 上下文表[名字]

段落 列出上下文():
  返回 字典键列表(上下文表)

# ---------- 页面 ----------
# 上下文不存在 → 失败（不做静默建上下文，便于反例断言）
段落 登记页面(上下文名, 页面名, 网址):
  如果 上下文名 == "" 或 页面名 == "":
    返回 假
  设 记录 为 取上下文(上下文名)
  如果 记录 == 空:
    返回 假
  设 页面表 为 记录["页面表"]
  设 页面 为 ["名字": 页面名, "网址": 网址, "上下文": 上下文名, "状态": "已登记", "动作数": 0]
  页面表[页面名] 为 页面
  返回 真

段落 取页面(上下文名, 页面名):
  设 记录 为 取上下文(上下文名)
  如果 记录 == 空:
    返回 空
  设 页面表 为 记录["页面表"]
  如果 页面表.包含(页面名) == 假:
    返回 空
  返回 页面表[页面名]

段落 列出页面(上下文名):
  设 记录 为 取上下文(上下文名)
  如果 记录 == 空:
    返回 []
  设 页面表 为 记录["页面表"]
  返回 字典键列表(页面表)

# ---------- 动作队列 ----------
# 动作必须是 合法动作 之一；页面必须已登记（未知页面 → 失败）
段落 入队动作(上下文名, 页面名, 动作, 目标, 值):
  全局 动作序号。
  如果 合法动作.包含(动作) == 假:
    返回 假
  设 页面 为 取页面(上下文名, 页面名)
  如果 页面 == 空:
    返回 假
  设 记录 为 取上下文(上下文名)
  动作序号 为 动作序号 + 1
  设 条目 为 ["序号": 动作序号, "动作": 动作, "页面": 页面名, "上下文": 上下文名, "目标": 目标, "值": 值]
  设 队列 为 记录["队列"]
  队列.追加(条目)
  返回 真

段落 取队列(上下文名):
  设 记录 为 取上下文(上下文名)
  如果 记录 == 空:
    返回 []
  返回 记录["队列"]

段落 队列长度(上下文名):
  返回 长(取队列(上下文名))

段落 清空队列(上下文名):
  设 记录 为 取上下文(上下文名)
  如果 记录 == 空:
    返回 假
  设 空队 为 []
  记录["队列"] 为 空队
  返回 真

# ---------- 批量执行 ----------
# 逐个出队交给驱动；**任一步失败即中止**，并把失败原因带出。
# 返回 ["ok", "原因", "已执行", "总数", "结果表"]
段落 执行动作队列(上下文名):
  设 记录 为 取上下文(上下文名)
  如果 记录 == 空:
    设 无回 为 ["ok": 假, "原因": "上下文不存在: " + 上下文名, "已执行": 0, "总数": 0, "结果表": []]
    返回 无回
  设 队列 为 记录["队列"]
  设 总数 为 长(队列)
  如果 总数 == 0:
    设 空回 为 ["ok": 真, "原因": "队列为空", "已执行": 0, "总数": 0, "结果表": []]
    返回 空回
  如果 浏览器驱动 == 空:
    设 未回 为 ["ok": 假, "原因": "未配置浏览器驱动", "已执行": 0, "总数": 总数, "结果表": []]
    返回 未回
  设 结果表 为 []
  设 已执行 为 0
  遍历 条目 之 队列:
    设 驱动回 为 浏览器驱动(条目)
    如果 驱动回["ok"] == 假:
      设 失败串 为 "动作#" + 字符串(条目["序号"]) + " " + 条目["动作"] + " 失败: " + 驱动回["原因"]
      结果表.追加(失败串)
      设 中止回 为 ["ok": 假, "原因": 失败串, "已执行": 已执行, "总数": 总数, "结果表": 结果表]
      返回 中止回
    已执行 为 已执行 + 1
    结果表.追加(驱动回["内容"])
    设 页面 为 取页面(上下文名, 条目["页面"])
    如果 页面 != 空:
      页面["动作数"] 为 页面["动作数"] + 1
      页面["状态"] 为 "已执行"
  # 全部成功 → 清空队列（队列语义：消费掉）
  设 空队 为 []
  记录["队列"] 为 空队
  设 成功回 为 ["ok": 真, "原因": "", "已执行": 已执行, "总数": 总数, "结果表": 结果表]
  返回 成功回

# ---------- 展示 ----------
段落 队列摘要(上下文名):
  设 队列 为 取队列(上下文名)
  设 收集表 为 []
  遍历 条目 之 队列:
    设 串 为 "#" + 字符串(条目["序号"]) + " " + 条目["动作"] + " " + 条目["页面"]
    如果 条目["目标"] != "":
      设 串 为 串 + " -> " + 条目["目标"]
    收集表.追加(串)
  返回 连接字符串(收集表, " | ")

段落 清空运行时():
  全局 上下文表。
  全局 浏览器驱动。
  全局 动作序号。
  上下文表 为 {}
  浏览器驱动 为 空
  动作序号 为 0
  返回 真

# ---------- 模型可见工具 ----------
段落 登记页面模式():
  返回 ["type": "object",
        "properties": ["上下文": ["type": "string", "description": "浏览器上下文名，需先由 登记上下文 建立"],
                       "页面": ["type": "string", "description": "页面名，登记后可供动作引用"],
                       "网址": ["type": "string", "description": "页面初始网址"]],
        "required": ["上下文", "页面", "网址"]]

段落 登记页面处理(参数):
  如果 参数.包含("上下文") == 假:
    返回 造工具结果("缺少参数: 上下文", 真)
  如果 参数.包含("页面") == 假:
    返回 造工具结果("缺少参数: 页面", 真)
  如果 参数.包含("网址") == 假:
    返回 造工具结果("缺少参数: 网址", 真)
  设 上下文名 为 参数["上下文"]
  设 页面名 为 参数["页面"]
  如果 登记页面(上下文名, 页面名, 参数["网址"]) == 假:
    返回 造工具结果("登记页面失败: 上下文不存在或页面名为空（上下文=" + 上下文名 + "）", 真)
  设 摘要 为 "已登记页面 " + 页面名 + " 网址=" + 参数["网址"] + " 上下文页面数=" + 字符串(长(列出页面(上下文名)))
  返回 造工具结果(摘要, 假)

段落 执行动作队列模式():
  返回 ["type": "object",
        "properties": ["上下文": ["type": "string", "description": "要批量执行动作队列的上下文名"]],
        "required": ["上下文"]]

段落 执行动作队列处理(参数):
  如果 参数.包含("上下文") == 假:
    返回 造工具结果("缺少参数: 上下文", 真)
  设 回 为 执行动作队列(参数["上下文"])
  如果 回["ok"] == 真:
    设 摘要 为 "执行完成 " + 字符串(回["已执行"]) + "/" + 字符串(回["总数"]) + " 结果=" + 连接字符串(回["结果表"], " | ")
    返回 造工具结果(摘要, 假)
  返回 造工具结果("执行中止: " + 回["原因"] + "（已执行 " + 字符串(回["已执行"]) + "/" + 字符串(回["总数"]) + "）", 真)

段落 挂载(注册表):
  注册表.注册(造工具定义("登记页面", "在指定浏览器上下文里登记一个页面", 登记页面模式(), 登记页面处理))
  注册表.注册(造工具定义("执行动作队列", "批量执行该上下文的动作队列，失败即中止", 执行动作队列模式(), 执行动作队列处理))
  返回 真

导出 配置驱动
导出 取驱动
导出 登记上下文
导出 取上下文
导出 列出上下文
导出 登记页面
导出 取页面
导出 列出页面
导出 入队动作
导出 取队列
导出 队列长度
导出 清空队列
导出 执行动作队列
导出 队列摘要
导出 清空运行时
导出 挂载
