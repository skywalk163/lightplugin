# 测试_浏览器运行时.light —— 浏览器运行时 的正例与反例
#
# 与宿主一致的断言惯用法（照抄 lightharness/examples/test_*.light）：
#   失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。
# 动作的真实执行由注入的确定性 fake 驱动提供 → 零网络、零浏览器、零计时。

从 浏览器运行时 导入 配置驱动, 取驱动, 登记上下文, 取上下文, 列出上下文, 登记页面, 取页面, 列出页面, 入队动作, 取队列, 队列长度, 清空队列, 执行动作队列, 队列摘要, 清空运行时, 挂载
从 工具 导入 工具注册表
从 内置核心字典 导入 字典键列表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性驱动：全部成功 ----
设 驱动调用数 为 0

段落 正常驱动(条目):
  全局 驱动调用数。
  驱动调用数 为 驱动调用数 + 1
  设 好回 为 ["ok": 真, "内容": 条目["动作"] + "@" + 条目["页面"] + ":ok", "原因": ""]
  返回 好回

# ---- 确定性驱动：遇到「点击」即失败 ----
段落 失败驱动(条目):
  如果 条目["动作"] == "点击":
    设 坏回 为 ["ok": 假, "内容": "", "原因": "元素未找到"]
    返回 坏回
  设 好回 为 ["ok": 真, "内容": 条目["动作"] + ":ok", "原因": ""]
  返回 好回

段落 主:
  全局 驱动调用数。
  清空运行时()
  配置驱动(正常驱动)

  # ---- 1. 上下文登记 ----
  断言为真(登记上下文("会话A"), "登记会话A应成功")
  断言为真(列出上下文().包含("会话A"), "会话A应在上下文列表中")
  断言相等(长(列出上下文()), 1, "应有 1 个上下文")

  # ---- 2. 反例：空上下文名 ----
  断言为假(登记上下文(""), "空上下文名登记应失败")

  # ---- 3. 反例：取不存在的上下文 ----
  断言相等(取上下文("不存在"), 空, "不存在的上下文应返回空")

  # ---- 4. 反例：向不存在的上下文登记页面 ----
  断言为假(登记页面("不存在", "首页", "https://a.example"), "未知上下文登记页面应失败")

  # ---- 5. 页面登记 ----
  断言为假(登记页面("会话A", "", "https://a.example"), "空页面名登记应失败")
  断言为真(登记页面("会话A", "首页", "https://a.example"), "登记首页应成功")
  断言为真(登记页面("会话A", "列表页", "https://a.example/list"), "登记列表页应成功")
  断言相等(长(列出页面("会话A")), 2, "会话A应有 2 个页面")
  断言相等(取页面("会话A", "首页")["网址"], "https://a.example", "首页网址回读")
  断言相等(取页面("会话A", "首页")["状态"], "已登记", "新页面状态应为已登记")

  # ---- 6. 反例：取未知页面 ----
  断言相等(取页面("会话A", "不存在页"), 空, "未知页面应返回空")

  # ---- 7. 反例：向未知页面入队 ----
  断言为假(入队动作("会话A", "不存在页", "打开", "", ""), "未知页面入队应失败")

  # ---- 8. 反例：非法动作 ----
  断言为假(入队动作("会话A", "首页", "起飞", "", ""), "非法动作入队应失败")

  # ---- 9. 动作入队与顺序 ----
  断言为真(入队动作("会话A", "首页", "打开", "首页", "https://a.example"), "入队打开应成功")
  断言为真(入队动作("会话A", "首页", "填表", "#q", "关键词"), "入队填表应成功")
  断言为真(入队动作("会话A", "首页", "点击", "#go", ""), "入队点击应成功")
  断言为真(入队动作("会话A", "列表页", "截图", "", "shot.png"), "入队截图应成功")
  断言相等(队列长度("会话A"), 4, "队列应有 4 个动作")
  设 队列 为 取队列("会话A")
  断言相等(队列[0]["动作"], "打开", "队列第 1 个应是打开")
  断言相等(队列[1]["动作"], "填表", "队列第 2 个应是填表")
  断言相等(队列[2]["动作"], "点击", "队列第 3 个应是点击")
  断言相等(队列[3]["动作"], "截图", "队列第 4 个应是截图")
  断言相等(队列[1]["值"], "关键词", "填表动作应带值")
  断言相等(队列[3]["页面"], "列表页", "截图应落在列表页")
  断言为真(包含(队列摘要("会话A"), "#1 打开 首页"), "队列摘要应含首个动作")

  # ---- 10. 批量执行：驱动被调用，队列被消费 ----
  驱动调用数 为 0
  设 回1 为 执行动作队列("会话A")
  断言为真(回1["ok"], "正常驱动下执行应成功")
  断言相等(回1["已执行"], 4, "应执行 4 个动作")
  断言相等(回1["总数"], 4, "总数应为 4")
  断言相等(长(回1["结果表"]), 4, "结果表应有 4 条")
  断言相等(驱动调用数, 4, "驱动应被逐个调用 4 次")
  断言相等(队列长度("会话A"), 0, "全部成功后队列应被消费")
  断言相等(取页面("会话A", "首页")["动作数"], 3, "首页应累计 3 个动作")
  断言相等(取页面("会话A", "首页")["状态"], "已执行", "执行后页面状态应为已执行")
  断言相等(取页面("会话A", "列表页")["动作数"], 1, "列表页应累计 1 个动作")

  # ---- 11. 反例：空队列执行 ----
  设 回空 为 执行动作队列("会话A")
  断言为真(回空["ok"], "空队列执行不应报错")
  断言相等(回空["总数"], 0, "空队列总数应为 0")
  断言相等(回空["原因"], "队列为空", "空队列原因应明确")

  # ---- 12. 反例：不存在的上下文执行 ----
  设 回无 为 执行动作队列("不存在")
  断言为假(回无["ok"], "未知上下文执行应失败")
  断言相等(回无["原因"], "上下文不存在: 不存在", "未知上下文原因应明确")

  # ---- 13. 驱动失败即中止 ----
  断言为真(登记上下文("会话B"), "登记会话B应成功")
  断言为真(登记页面("会话B", "表单页", "https://b.example"), "登记表单页应成功")
  断言为真(入队动作("会话B", "表单页", "打开", "", "https://b.example"), "会话B入队打开")
  断言为真(入队动作("会话B", "表单页", "点击", "#submit", ""), "会话B入队点击")
  断言为真(入队动作("会话B", "表单页", "截图", "", "b.png"), "会话B入队截图")
  配置驱动(失败驱动)
  设 回2 为 执行动作队列("会话B")
  断言为假(回2["ok"], "驱动失败时执行应中止并报错")
  断言相等(回2["已执行"], 1, "失败前只应成功 1 个")
  断言相等(回2["总数"], 3, "总数仍应为 3")
  断言为真(包含(回2["原因"], "点击 失败"), "中止原因应指出失败动作")
  断言为真(包含(回2["原因"], "元素未找到"), "中止原因应带驱动原因")
  断言相等(长(回2["结果表"]), 2, "结果表应为 1 成功 + 1 失败")
  断言相等(队列长度("会话B"), 3, "失败时队列不应被清空")
  断言相等(取页面("会话B", "表单页")["动作数"], 1, "失败前只累计 1 个动作")

  # ---- 14. 清空队列 ----
  断言为真(清空队列("会话B"), "清空会话B队列应成功")
  断言相等(队列长度("会话B"), 0, "清空后队列长度应为 0")
  断言为假(清空队列("不存在"), "清空未知上下文队列应失败")

  # ---- 15. 反例：未配置驱动 ----
  配置驱动(空)
  断言相等(取驱动(), 空, "驱动应已被置空")
  断言为真(入队动作("会话A", "首页", "打开", "", ""), "重新入队打开")
  设 回3 为 执行动作队列("会话A")
  断言为假(回3["ok"], "未配置驱动时执行应失败")
  断言相等(回3["原因"], "未配置浏览器驱动", "未配置驱动原因应明确")
  配置驱动(正常驱动)

  # ---- 16. 清空运行时（L-166 回归）----
  清空运行时()
  断言相等(长(列出上下文()), 0, "清空后应无上下文")
  断言相等(取驱动(), 空, "清空后驱动应为空")

  # ---- 17. 挂载进注册表，并从注册表取出工具执行（端到端）----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("登记页面"), "登记页面应已注册")
  断言为真(注册表.登记表.包含("执行动作队列"), "执行动作队列应已注册")

  设 定义 为 注册表.登记表["登记页面"]
  断言相等(定义["name"], "登记页面", "注册名一致")
  设 登记参 为 ["上下文": "会话C", "页面": "主页", "网址": "https://c.example"]
  设 产出 为 定义["execute"](登记参)
  断言为真(产出["isError"], "上下文未建立时登记页面应报错")

  断言为真(登记上下文("会话C"), "建立会话C")
  配置驱动(正常驱动)
  设 产出2 为 定义["execute"](登记参)
  断言为假(产出2["isError"], "上下文已建立时登记页面应成功")
  断言为真(包含(产出2["content"], "已登记页面 主页"), "登记回执应含页面名")

  设 缺参 为 ["上下文": "会话C", "页面": "主页"]
  设 产出3 为 定义["execute"](缺参)
  断言为真(产出3["isError"], "缺少网址参数应报错")

  设 定义2 为 注册表.登记表["执行动作队列"]
  设 产出4 为 定义2["execute"](["上下文": "会话C"])
  断言为假(产出4["isError"], "空队列执行不应报错")
  断言为真(包含(产出4["content"], "0/0"), "空队列回执应为 0/0")

  设 坏参 为 ["上下文": "不存在"]
  设 产出5 为 定义2["execute"](坏参)
  断言为真(产出5["isError"], "未知上下文执行应报错")

  打印 "测试_浏览器运行时 全部通过"

主()
