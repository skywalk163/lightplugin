# 测试_SSH远程执行.light —— SSH 远程执行 的正例与反例
#
# 与宿主一致的断言惯用法：失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。
# 传输器注入确定性 fake（成功/失败），零真实网络。

从 SSH远程执行 导入 执行命令, 规范化配置, 设定传输, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性传输器：成功 / 失败 ----
段落 假成功传输(配置, 命令):
  返回 ["退出码": 0, "标准输出": "已执行: " + 命令, "标准错误": ""]

段落 假失败传输(配置, 命令):
  返回 ["退出码": 1, "标准输出": "", "标准错误": "command not found: " + 命令]

段落 主:
  # ---- 1. 配置归一：缺省端口 22、认证 密码 ----
  设 配置 为 ["主机": "h.example", "用户": "u"]
  设 归一 为 规范化配置(配置)
  断言相等(归一["端口"], 22, "缺省端口应为 22")
  断言相等(归一["认证"], "密码", "缺省认证应为密码")

  # ---- 2. 端到端注册校验（先注入成功传输器）----
  设定传输(假成功传输)
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("SSH执行"), "SSH执行应已注册")

  # ---- 3. 成功路径：结果结构 + handler 不报错 ----
  设 成功结果 为 执行命令(配置, "ls")
  断言为真(成功结果["成功"], "成功传输应判成功")
  断言相等(成功结果["退出码"], 0, "成功退出码为 0")
  断言相等(成功结果["标准输出"], "已执行: ls", "标准输出应回读")
  断言相等(成功结果["标准错误"], "", "成功错误输出应为空")

  设 定义 为 注册表.登记表["SSH执行"]
  设 入参 为 ["主机": "h.example", "用户": "u", "命令": "ls"]
  设 产出 为 定义["execute"](入参)
  断言为假(产出["isError"], "成功执行 handler 不应报错")

  # ---- 4. 失败路径：非零退出码 → 失败 + 附 stderr ----
  设定传输(假失败传输)
  设 失败结果 为 执行命令(配置, "badcmd")
  断言为假(失败结果["成功"], "失败传输应判失败")
  断言相等(失败结果["退出码"], 1, "失败退出码为 1")
  断言相等(失败结果["标准错误"], "command not found: badcmd", "错误输出应回读")
  设 失败产出 为 定义["execute"](入参)
  断言为真(失败产出["isError"], "失败执行 handler 应报错")

  # ---- 5. 反例：未注入传输器 → 失败并提示 ----
  设定传输(空)
  设 缺传输 为 执行命令(配置, "ls")
  断言为假(缺传输["成功"], "未注入传输器应判失败")
  断言相等(缺传输["原因"], "未注入传输器", "原因应指明未注入传输器")
  断言相等(缺传输["退出码"], -1, "未注入时退出码为 -1")

  打印 "测试_SSH远程执行 全部通过"

主()
