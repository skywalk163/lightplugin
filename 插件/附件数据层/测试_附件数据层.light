# 测试_附件数据层.light —— 附件数据层 的正例与反例
#
# 注入式后端：测试自带确定性 fake（内存字典），断言上传/下载/列举/格式标记。
# 不依赖真实网络或磁盘。

从 附件数据层 导入 注入后端, 挂载, 归一格式
从 工具 导入 工具注册表

# ---------- 断言惯用法 ----------
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---------- 确定性 fake 后端 ----------
设 假仓 为 {}

段落 假上传(名字, 内容, 格式):
  设 编号 为 "ATT-" + 字符串(长(假仓) + 1)
  设 记录 为 ["编号": 编号, "名字": 名字, "内容": 内容, "格式": 格式]
  假仓[编号] 为 记录
  返回 编号

段落 假下载(编号):
  如果 假仓.包含(编号) == 假:
    返回 空
  返回 假仓[编号]

段落 假列举():
  设 表 为 []
  遍历 键 之 假仓:
    表.追加(假仓[键])
  返回 表

段落 主:
  # 注入内存 fake
  注入后端(假上传, 假下载, 假列举)

  # ---- 1. 格式归一（正例）----
  断言相等(归一格式("文本"), "文本", "文本保持")
  断言相等(归一格式("二进制"), "二进制", "二进制保持")
  断言相等(归一格式("image/png"), "文本", "未知格式归一成文本")
  断言相等(归一格式(""), "文本", "空格式归一成文本")

  # ---- 2. 上传 → 下载 往返 ----
  设 参数上传 为 ["名字": "笔记.txt", "内容": "今天天气不错", "格式": "文本"]
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("附件上传"), "附件上传已注册")
  断言为真(注册表.登记表.包含("附件下载"), "附件下载已注册")
  断言为真(注册表.登记表.包含("附件列举"), "附件列举已注册")
  设 定义上传 为 注册表.登记表["附件上传"]
  设 产出上传 为 定义上传["execute"](参数上传)
  断言为假(产出上传["isError"], "上传不应报错")
  断言为真(包含(产出上传["content"], "ATT-1"), "上传回带编号")

  # fake 后端里应有这条记录，格式标记被正确归一
  断言为真(假仓.包含("ATT-1"), "fake 后端记录了上传")
  断言相等(假仓["ATT-1"]["格式"], "文本", "上传格式标记=文本")
  断言相等(假仓["ATT-1"]["名字"], "笔记.txt", "上传名字回读")
  断言相等(假仓["ATT-1"]["内容"], "今天天气不错", "上传内容回读")

  # ---- 3. 下载往返 ----
  设 参数下载 为 ["编号": "ATT-1"]
  设 定义下载 为 注册表.登记表["附件下载"]
  设 产出下载 为 定义下载["execute"](参数下载)
  断言为假(产出下载["isError"], "下载不应报错")
  断言为真(包含(产出下载["content"], "今天天气不错"), "下载内容回读")

  # ---- 4. 反例：下载不存在 ----
  设 参数缺 为 ["编号": "ATT-999"]
  设 产出缺 为 定义下载["execute"](参数缺)
  断言为真(产出缺["isError"], "下载不存在应报错")

  # ---- 5. 列举（含关键字过滤）----
  设 参数上传2 为 ["名字": "图片.png", "内容": "rawbytes", "格式": "二进制"]
  定义上传["execute"](参数上传2)
  断言相等(假仓["ATT-2"]["格式"], "二进制", "二进制上传格式标记")

  设 定义列举 为 注册表.登记表["附件列举"]
  设 产出列举 为 定义列举["execute"](["关键字": ""])
  断言为假(产出列举["isError"], "列举不应报错")
  断言为真(包含(产出列举["content"], "ATT-1"), "列举含 ATT-1")
  断言为真(包含(产出列举["content"], "ATT-2"), "列举含 ATT-2")

  设 产出过滤 为 定义列举["execute"](["关键字": "png"])
  断言为真(包含(产出过滤["content"], "图片.png"), "过滤命中 png")
  断言为真(包含(产出过滤["content"], "ATT-1") == 假, "过滤排除非命中")

  # ---- 6. 反例：上传缺必填字段（无 名字）→ 经注册表执行流水线触发 schema 拒绝 ----
  设 产出无名字 为 注册表.执行("附件上传", "{\"内容\":\"x\"}")
  断言为真(产出无名字["isError"], "缺名字上传应被 schema 拒绝")

  打印 "测试_附件数据层 全部通过"

主()
