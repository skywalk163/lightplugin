# 待办清单.light —— 对标 dsh packages/todo
#
# 设计：内存待办项表（id -> {标题, 完成, 优先级, 创建序}），增/查/完成/删。
# 持久化由宿主注入的「读器/写器」提供；测试走内存表，零真实 I/O。
#
# 光明限制遵守（与 存储抽象 同套）：
#   L-047   字典/列表字面量不可直接作实参 → 先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 避开。
#   L-165/166 模块级可变标量须先写『全局 X。』。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 项表 为 {}                  # id -> {标题, 完成, 优先级, 序}
设 下一号 为 1
设 持久写 为 空                # 宿主注入：(全表快照)->真
设 持久读 为 空                # 宿主注入：-> 全表字典

段落 注入持久化(写, 读):
  全局 持久写。
  全局 持久读。
  持久写 为 写
  持久读 为 读
  返回 真

段落 持久化():
  如果 持久写 != 空:
    持久写(项表)
  返回 真

# ---------- 内核（与工具解耦）----------
段落 添加核心(标题, 优先级):
  全局 下一号。
  如果 标题 == "":
    返回 -1
  设 id 为 字符串(下一号)
  设 记录 为 ["标题": 标题, "完成": 假, "优先级": 优先级, "序": 下一号]
  项表[id] 为 记录
  下一号 为 下一号 + 1
  持久化()
  返回 下一号 - 1

段落 完成核心(id):
  如果 项表.包含(id) == 假:
    返回 假
  项表[id]["完成"] 为 真
  持久化()
  返回 真

段落 删除核心(id):
  如果 项表.包含(id) == 假:
    返回 假
  项表.弹出(id)
  持久化()
  返回 真

段落 列出核心(只未完成):
  设 键们 为 字典键列表(项表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 项表[键]
    如果 只未完成 == 假 或 项["完成"] == 假:
      设 行 为 "[" + 键 + "] " + 项["标题"] + " (优先级=" + 项["优先级"] + ")"
      如果 项["完成"] == 真:
        行 为 行 + " [已完成]"
      结果.追加(行)
  返回 结果

# ---------- 工具 ----------
段落 添加模式():
  返回 ["type": "object",
        "properties": ["标题": ["type": "string", "description": "待办项标题"],
                       "优先级": ["type": "string", "description": "优先级：高/中/低"]],
        "required": ["标题"]]

段落 添加处理(参数):
  设 标题 为 参数["标题"]
  设 优先级 为 "中"
  如果 参数.包含("优先级"):
    设 p 为 参数["优先级"]
    如果 p != "":
      优先级 为 p
  设 n 为 添加核心(标题, 优先级)
  如果 n < 0:
    返回 造工具结果("标题不可为空", 真)
  返回 造工具结果("已添加待办 #" + 字符串(n) + ": " + 标题, 假)

段落 完成模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "待办项编号（字符串 id）"]],
        "required": ["编号"]]

段落 完成处理(参数):
  设 id 为 参数["编号"]
  如果 完成核心(id) == 假:
    返回 造工具结果("待办项不存在: " + id, 真)
  返回 造工具结果("已完成待办 #" + id, 假)

段落 列出模式():
  返回 ["type": "object",
        "properties": ["只未完成": ["type": "boolean", "description": "真=只列未完成；假=全列"]]]

段落 列出处理(参数):
  设 只未 为 假
  如果 参数.包含("只未完成"):
    只未 为 参数["只未完成"]
  设 行们 为 列出核心(只未)
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 删除模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "要删除的待办编号"]],
        "required": ["编号"]]

段落 删除处理(参数):
  设 id 为 参数["编号"]
  如果 删除核心(id) == 假:
    返回 造工具结果("待办项不存在: " + id, 真)
  返回 造工具结果("已删除待办 #" + id, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("待办添加", "新增一条待办项", 添加模式(), 添加处理))
  注册表.注册(造工具定义("待办完成", "把指定编号的待办标记为已完成", 完成模式(), 完成处理))
  注册表.注册(造工具定义("待办列出", "列出待办项（可只看未完成）", 列出模式(), 列出处理))
  注册表.注册(造工具定义("待办删除", "删除指定编号的待办项", 删除模式(), 删除处理))
  返回 真

导出 注入持久化
导出 添加核心
导出 完成核心
导出 删除核心
导出 列出核心
导出 挂载
