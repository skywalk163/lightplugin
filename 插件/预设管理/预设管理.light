# 预设管理.light —— 对标 dsh packages/preset
#
# 设计：预设槽（名 -> {键值字典, 描述, 序}），保存 / 应用 / 列出 / 删除。
# 与「设置持久化」区别：那是单键值持久化，这是**成组配置槽**并支持按名一次性应用。
# 持久化由宿主注入的写器提供，默认 空 → 纯内存，零真实 I/O。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 预设表 为 {}                  # 名 -> {键值, 描述, 序}
设 下一号 为 1
设 持久写 为 空                  # 宿主注入：(全表快照)->真

段落 注入持久化(写):
  全局 持久写。
  持久写 为 写
  返回 真

段落 持久化():
  如果 持久写 != 空:
    持久写(预设表)
  返回 真

# ---------- 内核 ----------
段落 保存核心(名, 键值, 描述):
  全局 下一号。
  如果 名 == "":
    返回 假
  如果 预设表.包含(名):
    预设表[名]["键值"] 为 键值
    预设表[名]["描述"] 为 描述
    持久化()
    返回 真
  设 记录 为 ["键值": 键值, "描述": 描述, "序": 下一号]
  预设表[名] 为 记录
  下一号 为 下一号 + 1
  持久化()
  返回 真

段落 存在核心(名):
  返回 预设表.包含(名)

段落 应用核心(名):
  如果 预设表.包含(名) == 假:
    返回 空
  返回 预设表[名]["键值"]

段落 描述核心(名):
  如果 预设表.包含(名) == 假:
    返回 ""
  返回 预设表[名]["描述"]

段落 列出核心():
  设 键们 为 字典键列表(预设表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 预设表[键]
    设 键数 为 长(字典键列表(项["键值"]))
    结果.追加("[" + 键 + "] " + 项["描述"] + " (键数=" + 字符串(键数) + ")")
  返回 结果

段落 删除核心(名):
  如果 预设表.包含(名) == 假:
    返回 假
  预设表.弹出(名)
  持久化()
  返回 真

# ---------- 工具 ----------
段落 保存模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "预设名（唯一槽位）"],
                       "键值": ["type": "object", "description": "预设内容（键值字典）"],
                       "描述": ["type": "string", "description": "预设说明文字"]],
        "required": ["名", "键值"]]

段落 保存处理(参数):
  设 名 为 参数["名"]
  如果 名 == "":
    返回 造工具结果("预设名不可为空", 真)
  设 键值 为 参数["键值"]
  设 描述 为 ""
  如果 参数.包含("描述"):
    描述 为 参数["描述"]
  如果 保存核心(名, 键值, 描述) == 假:
    返回 造工具结果("预设保存失败: " + 名, 真)
  返回 造工具结果("已保存预设『" + 名 + "』（键数=" + 字符串(长(字典键列表(键值))) + "）", 假)

段落 应用模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "要应用的预设名"]],
        "required": ["名"]]

段落 应用处理(参数):
  设 名 为 参数["名"]
  如果 名 == "":
    返回 造工具结果("预设名不可为空", 真)
  如果 存在核心(名) == 假:
    返回 造工具结果("预设不存在: " + 名, 真)
  设 键值 为 应用核心(名)
  设 键们 为 字典键列表(键值)
  设 行们 为 []
  遍历 键 之 键们:
    行们.追加(键 + "=" + 字符串(键值[键]))
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空预设)"
  返回 造工具结果("预设『" + 名 + "』:\n" + 串, 假)

段落 列出模式():
  返回 ["type": "object", "properties": {}]

段落 列出处理(参数):
  设 行们 为 列出核心()
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 删除模式():
  返回 ["type": "object",
        "properties": ["名": ["type": "string", "description": "要删除的预设名"]],
        "required": ["名"]]

段落 删除处理(参数):
  设 名 为 参数["名"]
  如果 名 == "":
    返回 造工具结果("预设名不可为空", 真)
  如果 删除核心(名) == 假:
    返回 造工具结果("预设不存在: " + 名, 真)
  返回 造工具结果("已删除预设『" + 名 + "』", 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("预设保存", "保存（或覆盖）一个命名预设槽", 保存模式(), 保存处理))
  注册表.注册(造工具定义("预设应用", "按名取出预设内容并返回键值明细", 应用模式(), 应用处理))
  注册表.注册(造工具定义("预设列出", "列出全部预设及键数", 列出模式(), 列出处理))
  注册表.注册(造工具定义("预设删除", "删除指定预设", 删除模式(), 删除处理))
  返回 真

导出 注入持久化
导出 保存核心
导出 存在核心
导出 应用核心
导出 描述核心
导出 列出核心
导出 删除核心
导出 挂载
