# 测试_预设管理.light —— 预设管理 正例与反例

从 预设管理 导入 保存核心, 存在核心, 应用核心, 描述核心, 列出核心, 删除核心, 挂载
从 工具 导入 工具注册表
从 内置核心字典 导入 字典键列表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # 1. 保存两个预设
  设 键值1 为 ["模型": "deepseek", "温度": 0.2]
  设 键值2 为 ["模型": "qwen", "温度": 0.8]
  断言为真(保存核心("严谨", 键值1, "低温严谨模式"), "保存预设 严谨")
  断言为真(保存核心("发散", 键值2, "高温发散模式"), "保存预设 发散")

  # 2. 存在性判定
  断言为真(存在核心("严谨"), "严谨 应存在")
  断言为假(存在核心("不存在"), "不存在的预设应判否")

  # 3. 应用：取回的字典内容一致
  设 取回 为 应用核心("严谨")
  断言相等(取回["模型"], "deepseek", "取回 模型 应为 deepseek")
  断言相等(长(字典键列表(取回)), 2, "取回应有 2 个键")
  断言相等(描述核心("严谨"), "低温严谨模式", "描述应一致")

  # 4. 覆盖保存：同名的键数变化
  设 键值3 为 ["模型": "gpt", "温度": 0.5, "上限": 100]
  断言为真(保存核心("严谨", 键值3, "覆盖后的严谨"), "覆盖保存应成功")
  设 取回2 为 应用核心("严谨")
  断言相等(取回2["模型"], "gpt", "覆盖后模型应更新")
  断言相等(长(字典键列表(取回2)), 3, "覆盖后应有 3 个键")
  断言相等(长(列出核心()), 2, "覆盖不应新增槽位")

  # 5. 列出
  设 行们 为 列出核心()
  断言相等(长(行们), 2, "列出应有 2 条")

  # 6. 反例：空名字
  设 空键值 为 ["甲": 1]
  断言为假(保存核心("", 空键值, "无名"), "空名保存应失败")

  # 7. 反例：不存在的预设应用返回 空
  设 缺 为 应用核心("不存在")
  断言相等(缺, 空, "不存在的预设应用应返回空")

  # 8. 反例：删除不存在的预设
  断言为假(删除核心("不存在"), "删除不存在预设应失败")

  # 9. 删除已存在的
  断言为真(删除核心("发散"), "删除 发散 应成功")
  断言相等(长(列出核心()), 1, "删除后只剩 1 条")

  # 10. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("预设保存"), "预设保存 应注册")
  断言为真(注册表.登记表.包含("预设应用"), "预设应用 应注册")
  断言为真(注册表.登记表.包含("预设列出"), "预设列出 应注册")
  断言为真(注册表.登记表.包含("预设删除"), "预设删除 应注册")

  设 端到端键值 为 ["语言": "光明", "批次": 11]
  设 参 为 ["名": "端到端", "键值": 端到端键值, "描述": "测试用"]
  设 产 为 注册表.登记表["预设保存"]["execute"](参)
  断言为假(产["isError"], "端到端保存不应报错")

  设 参2 为 ["名": "端到端"]
  设 产2 为 注册表.登记表["预设应用"]["execute"](参2)
  断言为假(产2["isError"], "端到端应用不应报错")

  # 11. 反例：空名工具报错
  设 坏参 为 ["名": "", "键值": 端到端键值]
  设 坏产 为 注册表.登记表["预设保存"]["execute"](坏参)
  断言为真(坏产["isError"], "空名保存应报错")

  # 12. 反例：应用不存在的预设工具报错
  设 坏参2 为 ["名": "压根没有"]
  设 坏产2 为 注册表.登记表["预设应用"]["execute"](坏参2)
  断言为真(坏产2["isError"], "应用不存在预设应报错")

  # 13. 列出与删除工具可用
  设 空参 为 ["占位": "x"]
  设 出列 为 注册表.登记表["预设列出"]["execute"](空参)
  断言为假(出列["isError"], "预设列出不应报错")
  设 参3 为 ["名": "端到端"]
  设 出删 为 注册表.登记表["预设删除"]["execute"](参3)
  断言为假(出删["isError"], "预设删除不应报错")

  打印 "测试_预设管理 全部通过"

主()
