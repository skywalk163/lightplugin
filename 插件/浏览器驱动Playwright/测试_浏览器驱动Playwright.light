# 测试_浏览器驱动Playwright.light —— P5-4 浏览器驱动Playwright 的正例与反例

从 浏览器驱动Playwright 导入 翻译动作, 翻译序列, 渲染计划, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 主:
  # ---- 1. 各动作翻译 ----
  设 开 为 ["类型": "打开", "url": "https://example.com"]
  设 点 为 ["类型": "点击", "选择器": "#btn"]
  设 填 为 ["类型": "填表", "选择器": "#name", "文本": "张三"]
  设 拍 为 ["类型": "截图"]
  设 滚 为 ["类型": "滚动", "量": 300]
  设 抽 为 ["类型": "抽取", "选择器": "p"]
  断言True_含(翻译动作(开)["工具"], "browser_navigate", "打开→navigate")
  断言True_含(翻译动作(点)["工具"], "browser_click", "点击→click")
  断言True_含(翻译动作(填)["工具"], "browser_fill", "填表→fill")
  断言True_含(翻译动作(拍)["工具"], "browser_take_screenshot", "截图→screenshot")
  断言True_含(翻译动作(滚)["工具"], "browser_scroll", "滚动→scroll")
  断言True_含(翻译动作(抽)["工具"], "browser_text_content", "抽取→text_content")
  断言Equal_字典(翻译动作(填)["参数"]["value"], "张三", "填表参数含文本")

  # ---- 2. 序列翻译保序 ----
  设 序列 为 []
  序列.追加(开)
  序列.追加(点)
  序列.追加(填)
  设 计划 为 翻译序列(序列)
  断言Equal_长度(计划, 3, "计划应有 3 条")
  断言True_含(计划[0]["工具"], "navigate", "第 1 条应为 navigate")
  断言True_含(计划[2]["工具"], "fill", "第 3 条应为 fill")

  # ---- 3. 未知动作标记跳过 ----
  设 未知 为 ["类型": "飞天"]
  设 序列2 为 []
  序列2.追加(开)
  序列2.追加(未知)
  设 计划2 为 翻译序列(序列2)
  断言Equal_长度(计划2, 2, "含未知动作仍应有 2 条")
  断言True_含(计划2[1]["工具"], "未知", "未知动作应标记")
  断言为真(计划2[1]["跳过"], "未知动作应跳过")

  # ---- 4. 渲染计划为可读行 ----
  设 渲染 为 渲染计划(计划)
  断言Equal_长度(渲染, 3, "渲染应有 3 行")
  断言True_含(渲染[0], "navigate", "渲染行含工具名")
  断言True_含(渲染[2], "fill", "渲染行含工具名")

  # ---- 5. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言True_含_dict(注册表.登记表, "浏览器驱动Playwright", "浏览器驱动Playwright应注册")
  设 定义 为 注册表.登记表["浏览器驱动Playwright"]
  设 参 为 ["动作": "翻译", "序列": 序列]
  设 产出 为 定义["execute"](参)
  断言False_isError(产出["isError"], "翻译不应报错")
  断言True_含(产出["content"], "navigate", "产出含工具名")
  设 参坏 为 ["动作": "瞎搞"]
  断言True_isError(定义["execute"](参坏)["isError"], "未知动作应报错")

  打印 "测试_浏览器驱动Playwright 全部通过"

# 辅助
段落 断言Equal_长度(表, 期望, 标签):
  如果 长(表) != 期望:
    抛出 新建 错误("长度断言失败 [" + 标签 + "]: 实际=" + 字符串(长(表)))

段落 断言True_含(串, 子, 标签):
  如果 子串位置(串, 子) < 0:
    抛出 新建 错误("包含断言失败 [" + 标签 + "]: 未找到 " + 子)

段落 断言Equal_字典(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("字典断言失败 [" + 标签 + "]")

段落 断言True_含_dict(字典, 键, 标签):
  如果 字典.包含(键) == 假:
    抛出 新建 错误("字典包含失败 [" + 标签 + "]: 缺 " + 键)

段落 断言False_isError(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("应不报错 [" + 标签 + "]")

段落 断言True_isError(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("应报错 [" + 标签 + "]")

主()
