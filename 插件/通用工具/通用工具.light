# 通用工具.light —— 对标 dsh packages/util 的通用工具集
#
# 定位：纯逻辑、零宿主依赖的通用数据结构操作：
#   深拷贝（字典/列表递归复制，带环检测保护） / 深合并（嵌套字典逐层递归合并） /
#   循环引用检测 有环 / 字典合并（后者覆盖前者，浅） /
#   列表去重（保序） / 列表扁平化一层 / 按大小分块。
#
# 设计取舍：**不引任何 I/O**。所有函数都是纯函数，便于其它插件内联复用。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作函数实参 → 一律先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块命名一律避开「文本」。
#   LP-D-013 变量不要命名为「出」（`出.追加(...)` 会报「无法识别的语法元素 '.'」）
#            → 统一用 结果表 / 收集表。
#   LP-D-010 遍历 循环变量名不要与循环体内被调用的函数同名 → 循环变量用 项/子项/键。
#   只用已验证 stdlib：分割字符串 / 连接字符串 / 替换字符串 / 长 / 切片 / 包含 /
#                       字典键列表（需显式导入）。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

# ---------- 深拷贝 ----------
# 字典/列表递归复制；标量原样返回。
# 递归是本模块唯一依赖递归实现的地方（光明段落支持自调用）。
# 已见 = 当前递归路径上的容器栈（进入前 追加、退出后 弹出），命中即返回安全空容器，
#        这样既防自引用死循环，又不会把「同一子结构出现两次」的 DAG 误判成环。
段落 深拷贝(值, 已见=空):
  如果 已见 == 空:
    设 已见 为 []
  如果 type(值) == dict:
    如果 已见.包含(值) == 真:
      返回 {}
    已见.追加(值)
    设 副本表 为 {}
    遍历 键 之 字典键列表(值):
      副本表[键] 为 深拷贝(值[键], 已见)
    已见.弹出()
    返回 副本表
  如果 type(值) == list:
    如果 已见.包含(值) == 真:
      返回 []
    已见.追加(值)
    设 副本表 为 []
    遍历 项 之 值:
      副本表.追加(深拷贝(项, 已见))
    已见.弹出()
    返回 副本表
  返回 值

# ---------- 循环引用检测 ----------
# 已见 = 当前递归路径栈；命中路径上已出现过的容器即判为有环。
段落 有环(值, 已见=空):
  如果 已见 == 空:
    设 已见 为 []
  如果 type(值) != dict 且 type(值) != list:
    返回 假
  如果 已见.包含(值) == 真:
    返回 真
  已见.追加(值)
  如果 type(值) == dict:
    遍历 键 之 字典键列表(值):
      如果 有环(值[键], 已见) == 真:
        已见.弹出()
        返回 真
  否则:
    遍历 项 之 值:
      如果 有环(项, 已见) == 真:
        已见.弹出()
        返回 真
  已见.弹出()
  返回 假

# ---------- 深合并（递归合并）----------
# 两边都是字典 → 逐键递归合并；列表按覆盖整体替换；标量覆盖；结果不共享入参内部引用。
# 任一侧检测到环 → 返回安全空字典，不死循环。
段落 深合并(基, 覆盖, 已见=空):
  如果 已见 == 空:
    设 已见 为 []
  如果 type(基) != dict 或 type(覆盖) != dict:
    返回 深拷贝(覆盖)
  如果 有环(基, 已见) == 真 或 有环(覆盖, 已见) == 真:
    返回 {}
  已见.追加(基)
  设 结果表 为 {}
  遍历 键 之 字典键列表(基):
    结果表[键] 为 深拷贝(基[键])
  遍历 键 之 字典键列表(覆盖):
    如果 结果表.包含(键) == 真 且 type(结果表[键]) == dict 且 type(覆盖[键]) == dict:
      结果表[键] 为 深合并(结果表[键], 覆盖[键], 已见)
    否则:
      结果表[键] 为 深拷贝(覆盖[键])
  已见.弹出()
  返回 结果表

# ---------- 字典合并 ----------
# 后者覆盖前者；值做深拷贝，避免调用方改副本时误改原字典。
段落 合并字典(基, 覆盖):
  设 结果表 为 {}
  遍历 键 之 字典键列表(基):
    结果表[键] 为 深拷贝(基[键])
  遍历 键 之 字典键列表(覆盖):
    结果表[键] 为 深拷贝(覆盖[键])
  返回 结果表

# ---------- 列表去重（保序）----------
段落 去重列表(表):
  设 结果表 为 []
  遍历 项 之 表:
    如果 结果表.包含(项) == 假:
      结果表.追加(项)
  返回 结果表

# ---------- 列表扁平化一层 ----------
# 只摊一层：[[1,2],[3]] → [1,2,3]；[[1,[2]]] → [1,[2]]
段落 扁平化一层(表):
  设 结果表 为 []
  遍历 项 之 表:
    如果 type(项) == list:
      遍历 子项 之 项:
        结果表.追加(子项)
    否则:
      结果表.追加(项)
  返回 结果表

# ---------- 按大小分块 ----------
# 大小 <= 0 视为非法，返回空列表（不做静默兜底成 1）。
段落 按块切分(表, 大小):
  设 结果表 为 []
  如果 大小 <= 0:
    返回 结果表
  设 当前块 为 []
  遍历 项 之 表:
    当前块.追加(项)
    如果 长(当前块) >= 大小:
      结果表.追加(当前块)
      设 当前块 为 []
  如果 长(当前块) > 0:
    结果表.追加(当前块)
  返回 结果表

# ---------- 辅助：列表转展示串 ----------
段落 列表转串(表):
  设 收集表 为 []
  遍历 项 之 表:
    收集表.追加(字符串(项))
  返回 连接字符串(收集表, ",")

# ---------- 模型可见工具 ----------
段落 合并字典模式():
  返回 ["type": "object",
        "properties": ["基": ["type": "object", "description": "基础字典"],
                       "覆盖": ["type": "object", "description": "覆盖字典，同键以它为准"]],
        "required": ["基", "覆盖"]]

段落 合并字典处理(参数):
  如果 参数.包含("基") == 假:
    返回 造工具结果("缺少参数: 基", 真)
  如果 参数.包含("覆盖") == 假:
    返回 造工具结果("缺少参数: 覆盖", 真)
  设 合并后 为 合并字典(参数["基"], 参数["覆盖"])
  设 键们 为 字典键列表(合并后)
  设 摘要 为 "合并完成 键数=" + 字符串(长(键们)) + " 键=" + 连接字符串(键们, ",")
  返回 造工具结果(摘要, 假)

段落 去重列表模式():
  返回 ["type": "object",
        "properties": ["列表": ["type": "array", "description": "待去重的列表，保持原有顺序"]],
        "required": ["列表"]]

段落 去重列表处理(参数):
  如果 参数.包含("列表") == 假:
    返回 造工具结果("缺少参数: 列表", 真)
  设 去重后 为 去重列表(参数["列表"])
  设 摘要 为 "去重完成 原长=" + 字符串(长(参数["列表"])) + " 去重后=" + 字符串(长(去重后)) + " 内容=" + 列表转串(去重后)
  返回 造工具结果(摘要, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("合并字典", "把两个字典合并成一个，后者覆盖前者的同名键", 合并字典模式(), 合并字典处理))
  注册表.注册(造工具定义("去重列表", "对列表保序去重，返回去重后的内容", 去重列表模式(), 去重列表处理))
  返回 真

导出 深拷贝
导出 有环
导出 深合并
导出 合并字典
导出 去重列表
导出 扁平化一层
导出 按块切分
导出 列表转串
导出 挂载
