# 会话管理.light —— 对标 dsh packages/session 的「会话生命周期」层
#
# 能力：会话生命周期（创建/挂起/恢复/销毁）+ 上下文槽（key-value 读写）+ 当前会话切换。
#       注册给模型的工具仅 3 个：创建会话 / 切换会话 / 列出会话；
#       挂起/恢复/销毁/上下文槽 为内部段落，供测试与宿主直接调用。
#
# 状态机：新会话 = 活跃；挂起 → 挂起态；恢复（仅从挂起态）→ 活跃；销毁 → 移除。
#       当前会话（全局 当前会话）指向最近创建/切换的会话。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作实参 → 先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块用 名字/状态/槽 避开。
#   L-165/166 段落内写模块级标量须先写『全局 X。』，否则静默变局部变量。
#   只用本仓已验证的 stdlib：长 / 字典.包含 / 字典.弹出 / 字符串()。

从 工具 导入 造工具定义, 造工具结果

# ---------- 模块级状态 ----------
设 会话表 为 {}
设 当前会话 为 ""
设 会话序号 为 0

# ---------- 编号 ----------
段落 新会话号():
  全局 会话序号。
  会话序号 为 会话序号 + 1
  返回 "SES-" + 字符串(会话序号)

# ---------- 生命周期 ----------
段落 创建会话(名字):
  设 编号 为 新会话号()
  设 会话 为 ["编号": 编号, "名字": 名字, "状态": "活跃", "槽": {}]
  会话表[编号] 为 会话
  全局 当前会话。
  当前会话 为 编号
  返回 编号

段落 取会话(编号):
  如果 会话表.包含(编号) == 假:
    返回 空
  返回 会话表[编号]

段落 挂起会话(编号):
  设 会话 为 取会话(编号)
  如果 会话 == 空:
    返回 假
  会话["状态"] 为 "挂起"
  返回 真

段落 恢复会话(编号):
  设 会话 为 取会话(编号)
  如果 会话 == 空:
    返回 假
  如果 会话["状态"] != "挂起":
    返回 假
  会话["状态"] 为 "活跃"
  返回 真

段落 销毁会话(编号):
  如果 会话表.包含(编号) == 假:
    返回 假
  会话表.弹出(编号)
  全局 当前会话。
  如果 当前会话 == 编号:
    当前会话 为 ""
  返回 真

# ---------- 上下文槽 ----------
段落 设槽(编号, 键, 值):
  设 会话 为 取会话(编号)
  如果 会话 == 空:
    返回 假
  设 槽 为 会话["槽"]
  槽[键] 为 值
  返回 真

段落 取槽(编号, 键):
  设 会话 为 取会话(编号)
  如果 会话 == 空:
    返回 空
  设 槽 为 会话["槽"]
  如果 槽.包含(键) == 假:
    返回 空
  返回 槽[键]

# ---------- 切换 / 列举 ----------
段落 切换会话(编号):
  设 会话 为 取会话(编号)
  如果 会话 == 空:
    返回 假
  全局 当前会话。
  当前会话 为 编号
  返回 真

段落 列出会话():
  设 表 为 []
  遍历 键 之 会话表:
    设 会话 为 会话表[键]
    设 行 为 ["编号": 键, "名字": 会话["名字"], "状态": 会话["状态"]]
    表.追加(行)
  返回 表

# ---------- 模型可见工具 ----------
段落 创建会话模式():
  返回 ["type": "object",
        "properties": ["名字": ["type": "string", "description": "会话显示名"]],
        "required": ["名字"]]

段落 创建会话处理(参数):
  设 名字 为 参数["名字"]
  设 编号 为 创建会话(名字)
  返回 造工具结果("已创建会话 名字=" + 名字 + " 编号=" + 编号 + " 当前=" + 编号, 假)

段落 切换会话模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "要切换到的会话编号，形如 SES-1"]],
        "required": ["编号"]]

段落 切换会话处理(参数):
  设 编号 为 参数["编号"]
  如果 切换会话(编号) == 真:
    返回 造工具结果("已切换当前会话到 " + 编号, 假)
  返回 造工具结果("会话不存在，无法切换: " + 编号, 真)

段落 列出会话模式():
  返回 ["type": "object",
        "properties": ["状态": ["type": "string", "description": "按状态过滤（活跃/挂起），留空表示全部"]],
        "required": []]

段落 列出会话处理(参数):
  设 表 为 列出会话()
  设 过滤状态 为 ""
  如果 参数.包含("状态") == 真:
    设 过滤状态 为 参数["状态"]
  设 行们 为 []
  遍历 每条 之 表:
    设 命中 为 真
    如果 过滤状态 != "" 且 每条["状态"] != 过滤状态:
      设 命中 为 假
    如果 命中 == 真:
      设 行 为 每条["编号"] + " " + 每条["名字"] + " [" + 每条["状态"] + "]"
      行们.追加(行)
  设 正文 为 连接字符串(行们, "\n")
  如果 正文 == "":
    设 正文 为 "(无会话)"
  返回 造工具结果(正文, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("创建会话", "创建一个新会话并切为当前会话", 创建会话模式(), 创建会话处理))
  注册表.注册(造工具定义("切换会话", "把指定会话切换为当前会话", 切换会话模式(), 切换会话处理))
  注册表.注册(造工具定义("列出会话", "列出全部会话（可按状态过滤）", 列出会话模式(), 列出会话处理))
  返回 真

导出 创建会话
导出 取会话
导出 挂起会话
导出 恢复会话
导出 销毁会话
导出 设槽
导出 取槽
导出 切换会话
导出 列出会话
导出 新会话号
导出 挂载
