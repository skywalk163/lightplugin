# 测试_设置持久化.light —— 设置持久化 的正例与反例
#
# 与宿主一致的断言惯用法：失败即 抛出 新建 错误(...)，绝不放宽。
# 存储后端 / 变更监听用**确定性 fake**（注入式内存字典 + 记录型监听），不依赖网络/磁盘。

从 设置持久化 导入 设存储后端, 设默认, 注册监听, 读取设置, 写入设置, 挂载
从 工具 导入 工具注册表

设 变更记录 为 []

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性 fake 变更监听 ----
段落 监听甲(作用域, 键, 新值, 旧值):
  全局 变更记录。
  变更记录.追加(作用域 + "/" + 键 + "=" + 字符串(新值))
  返回 空

段落 主:
  全局 变更记录。
  # 注入内存后端（字典字面量不可直接作实参，先赋变量）
  设 新后端 为 {}
  设存储后端(新后端)

  # ---- 1. 作用域隔离 ----
  写入设置("用户", "名", "甲")
  写入设置("会话", "名", "乙")
  断言相等(读取设置("用户", "名"), "甲", "用户/名 应为甲")
  断言相等(读取设置("会话", "名"), "乙", "会话/名 应为乙")
  断言相等(读取设置("插件", "名"), 空, "插件/名 未写应为空")

  # ---- 2. 默认值回退 ----
  设默认("主题", "dark")
  断言相等(读取设置("用户", "主题"), "dark", "未写应回退默认 dark（用户）")
  断言相等(读取设置("会话", "主题"), "dark", "未写应回退默认 dark（会话）")

  # ---- 3. 写入后读回 ----
  写入设置("用户", "主题", "light")
  断言相等(读取设置("用户", "主题"), "light", "写入后应读回 light")

  # ---- 4. 监听触发（含 旧值 捕获）----
  变更记录 为 []
  注册监听(监听甲)
  写入设置("用户", "通知", "开")
  断言为真(长(变更记录) > 0, "写入应触发至少一次监听")
  断言相等(变更记录[0], "用户/通知=开", "监听应收到变更内容")

  # ---- 5. 反例：未知键无默认应返回空 ----
  断言相等(读取设置("用户", "不存在键"), 空, "未知键应返回空")

  # ---- 6. 挂载端到端 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("读取设置"), "读取设置应已注册")
  断言为真(注册表.登记表.包含("写入设置"), "写入设置应已注册")
  设 定义W 为 注册表.登记表["写入设置"]
  设 参1 为 ["作用域": "用户", "键": "e2e", "值": "v1"]
  设 产出 为 定义W["execute"](参1)
  断言为假(产出["isError"], "写入设置不应报错")
  设 定义R 为 注册表.登记表["读取设置"]
  设 参2 为 ["作用域": "用户", "键": "e2e"]
  设 产出2 为 定义R["execute"](参2)
  断言为假(产出2["isError"], "读取设置不应报错")

  打印 "测试_设置持久化 全部通过"

主()
