# 测试_浏览器驱动DevTools.light —— P6-1 浏览器驱动DevTools 的正例与反例

从 浏览器驱动DevTools 导入 翻译动作, 翻译序列, 渲染计划, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言True_含(串, 子, 标签):
  如果 子串位置(串, 子) < 0:
    抛出 新建 错误("包含断言失败 [" + 标签 + "]: 未找到 " + 子)

段落 主:
  # ---- 1. 各动作翻译（翻译动作返回 CDP 消息列表）----
  设 计划1 为 翻译动作(["类型": "打开", "url": "https://x.com"])
  断言相等(长(计划1), 1, "打开应产生 1 条 CDP 消息")
  断言True_含(计划1[0]["方法"], "Page.navigate", "打开应翻译为 Page.navigate")

  设 计划2 为 翻译动作(["类型": "点击", "选择器": "#btn"])
  断言相等(长(计划2), 3, "点击应产生 3 条 CDP 消息（querySelector + 两次 mouseEvent）")
  断言True_含(计划2[0]["方法"], "DOM.querySelector", "点击首步应为 DOM.querySelector")
  断言True_含(计划2[1]["方法"], "Input.dispatchMouseEvent", "点击应含 Input.dispatchMouseEvent")

  设 计划3 为 翻译动作(["类型": "填表", "选择器": "#inp", "文本": "hi"])
  断言True_含(计划3[0]["方法"], "DOM.querySelector", "填表首步应为 DOM.querySelector")
  断言True_含(计划3[2]["方法"], "Input.insertText", "填表末步应为 Input.insertText")

  设 计划4 为 翻译动作(["类型": "截图"])
  断言True_含(计划4[0]["方法"], "Page.captureScreenshot", "截图应翻译为 Page.captureScreenshot")

  设 计划5 为 翻译动作(["类型": "抽取", "选择器": ".title"])
  断言True_含(计划5[0]["方法"], "Runtime.evaluate", "抽取应翻译为 Runtime.evaluate")

  设 计划6 为 翻译动作(["类型": "滚动", "量": 200])
  断言True_含(计划6[0]["方法"], "Input.dispatchMouseEvent", "滚动应翻译为 mouseWheel 事件")

  设 计划7 为 翻译动作(["类型": "瞎搞"])
  断言True_含(计划7[0]["方法"], "未知", "未知动作方法应为 未知")
  断言为真(计划7[0]["跳过"] == 真, "未知动作应标跳过")

  # ---- 2. 翻译序列（扁平化为 CDP 消息序列）----
  设 序列 为 翻译序列([["类型": "打开", "url": "https://x.com"],
                      ["类型": "点击", "选择器": "#btn"],
                      ["类型": "瞎搞"]])
  断言相等(长(序列), 5, "序列应含 5 条 CDP 消息（1+3+1）")
  断言True_含(序列[4]["方法"], "未知", "序列末条应为跳过的未知动作")

  # ---- 3. 渲染计划 ----
  设 渲染 为 渲染计划(序列)
  断言相等(长(渲染), 5, "渲染应 5 行")
  断言True_含(渲染[0], "Page.navigate", "渲染首行应含 Page.navigate")

  # ---- 4. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("浏览器驱动DevTools"), "浏览器驱动DevTools 应注册")
  设 定义 为 注册表.登记表["浏览器驱动DevTools"]
  设 产出 为 定义["execute"](["动作": "翻译", "序列": [["类型": "打开", "url": "https://x.com"], ["类型": "点击", "选择器": "#btn"]]])
  断言为假(产出["isError"], "翻译不应报错")
  设 参坏 为 ["动作": "瞎搞"]
  断言为真(定义["execute"](参坏)["isError"], "未知动作应报错")

  打印 "测试_浏览器驱动DevTools 全部通过"

主()
