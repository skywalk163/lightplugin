# 测试_接口服务.light —— 接口服务 的正例与反例
#
# 断言惯用法（照抄 lightharness 与 异步作业轮询）：失败即 抛出 新建 错误(...)，
# 绝不放宽。分发测试用**注入式假处理器 + 假请求**，不依赖真实 HTTP，无网络 flaky。
# 路径参数标记用尖括号 <名>，避开光明字符串花括号插值。

从 接口服务 导入 注册处理器, 注册路由, 抽取路径参数, 匹配路由, 分发请求, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 注入式假处理器（宿主在真实环境会绑定真实业务逻辑）----
段落 假取用户(参数, 请求):
  设 id 为 参数["id"]
  返回 "用户#" + id

段落 假列项目(参数, 请求):
  返回 "项目列表"

段落 假建项目(参数, 请求):
  设 负载 为 请求["负载"]
  返回 "已创建:" + 字符串(负载)

段落 主:
  # ---- 0. 注入处理器并登记路由 ----
  注册处理器("取用户", 假取用户)
  注册处理器("列项目", 假列项目)
  注册处理器("建项目", 假建项目)
  注册路由("GET", "/users/<id>", "取用户")
  注册路由("GET", "/projects", "列项目")
  注册路由("POST", "/projects/<pid>/items/<iid>", "建项目")

  # ---- 1. 路径参数抽取（单参数）----
  设 参数 为 抽取路径参数("/users/<id>", "/users/42")
  断言相等(参数["id"], "42", "抽取单路径参数")

  # ---- 2. 路径参数抽取（多参数）----
  设 参数2 为 抽取路径参数("/projects/<pid>/items/<iid>", "/projects/7/items/9")
  断言相等(参数2["pid"], "7", "抽取 pid")
  断言相等(参数2["iid"], "9", "抽取 iid")

  # ---- 3. 反例：段数不符应返回空 ----
  设 无 为 抽取路径参数("/users/<id>", "/users")
  断言相等(无, 空, "段数不符应返回空")

  # ---- 4. 反例：字面段不匹配应返回空 ----
  设 无2 为 抽取路径参数("/users/<id>", "/accounts/42")
  断言相等(无2, 空, "字面段不匹配应返回空")

  # ---- 5. 路由匹配 ----
  设 匹配 为 匹配路由("GET", "/users/5")
  断言为真(匹配["命中"], "应命中 GET /users/5")
  断言相等(匹配["处理器名"], "取用户", "命中处理器名")
  设 失配 为 匹配路由("DELETE", "/users/5")
  断言为假(失配["命中"], "DELETE 未注册应不命中")

  # ---- 6. 分发请求：命中并封装处理器返回值 ----
  设 请求 为 ["方法": "GET", "路径": "/users/3"]
  设 响应 为 分发请求(请求)
  断言相等(响应["状态"], 200, "命中状态200")
  断言相等(响应["正文"], "用户#3", "处理器返回值封装为正文")
  断言相等(响应["参数"]["id"], "3", "分发携带路径参数")

  # ---- 7. 分发请求：多参数 + 负载透传 ----
  设 请求2 为 ["方法": "POST", "路径": "/projects/7/items/9", "负载": "数据A"]
  设 响应2 为 分发请求(请求2)
  断言相等(响应2["状态"], 200, "POST 命中")
  断言相等(响应2["正文"], "已创建:数据A", "负载透传")

  # ---- 8. 反例：404（未匹配路由）----
  设 请求3 为 ["方法": "GET", "路径": "/nope"]
  设 响应3 为 分发请求(请求3)
  断言相等(响应3["状态"], 404, "未匹配应 404")

  # ---- 9. 反例：500（命中路由但处理器未登记）----
  注册路由("GET", "/orphan", "无主")
  设 请求4 为 ["方法": "GET", "路径": "/orphan"]
  设 响应4 为 分发请求(请求4)
  断言相等(响应4["状态"], 500, "缺处理器应 500")

  # ---- 10. 挂载进注册表，并从注册表取出工具执行（端到端）----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("注册路由"), "注册路由应已注册")
  断言为真(注册表.登记表.包含("分发请求"), "分发请求应已注册")

  设 定义 为 注册表.登记表["分发请求"]
  设 入参 为 ["方法": "GET", "路径": "/users/99"]
  设 产出 为 定义["execute"](入参)
  断言为假(产出["isError"], "分发已注册路由不应报错")

  设 定义2 为 注册表.登记表["注册路由"]
  设 入参2 为 ["方法": "GET", "模式": "/ping", "处理器名": "列项目"]
  设 产出2 为 定义2["execute"](入参2)
  断言为假(产出2["isError"], "注册路由不应报错")

  打印 "测试_接口服务 全部通过"

主()
