# 测试_shell环境层.light —— shell环境层 的正例与反例
#
# 验证点：环境变量读写、工作目录归一、命令行解析分片（引号/空白）。
# 环境字典与工作目录由测试注入确定性假值（零网络、零进程、零磁盘）。
# 失败即 抛出 新建 错误(...)，绝不放宽。

从 shell环境层 导入 挂载, 装载环境, 设置环境变量, 获取环境变量, 归一工作目录, 解析命令行为令牌
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言包含(列表, 项, 标签):
  如果 列表.包含(项) == 假:
    抛出 新建 错误("断言包含失败 [" + 标签 + "]: 列表不含 " + 转字符串(项))

段落 主:
  # ---- 1. 注入环境字典 ----
  设 环境 为 ["PATH": "/usr/bin", "HOME": "/home/x"]
  装载环境(环境)

  # ---- 2. 环境变量读写（经逻辑函数，且校验注入字典被原地修改）----
  设置环境变量("FOO", "BAR")
  断言为真(环境.包含("FOO"), "设置后注入字典应含 FOO")
  断言相等(环境["FOO"], "BAR", "FOO 值应为 BAR")
  断言相等(获取环境变量("FOO"), "BAR", "读取 FOO 应为 BAR")
  断言相等(获取环境变量("HOME"), "/home/x", "读取 HOME 应为 /home/x")
  断言相等(获取环境变量("不存在"), 空, "读取未设置变量应返回空")

  # ---- 3. 工作目录归一（路径段规整）----
  断言相等(归一工作目录("a/b/../c"), "a/c", "回退一级")
  断言相等(归一工作目录("./x/./y"), "x/y", "压掉 . 段")
  断言相等(归一工作目录("a/./b/"), "a/b", "尾斜杠与 . 段")
  断言相等(归一工作目录("../a"), "a", "根处 .. 不越界")
  断言相等(归一工作目录("a/../../b"), "b", "多级回退")
  断言相等(归一工作目录(""), ".", "空目录归一为 .")
  断言相等(归一工作目录("c:\\foo\\..\\bar"), "c:/bar", "反斜杠归一")

  # ---- 4. 命令行解析分片（引号/空白）----
  设 令牌 为 解析命令行为令牌("echo 'hello world' foo bar")
  断言相等(长(令牌), 4, "应切出 4 个令牌")
  断言相等(令牌[0], "echo", "第1令牌")
  断言相等(令牌[1], "hello world", "引号内空白保留")
  断言相等(令牌[2], "foo", "第3令牌")
  断言相等(令牌[3], "bar", "第4令牌")

  设 令牌2 为 解析命令行为令牌("run --name \"my app\" -x")
  断言相等(长(令牌2), 4, "双引号也应切出 4 个")
  断言相等(令牌2[0], "run", "双引号第1")
  断言相等(令牌2[2], "my app", "双引号内空白保留")
  断言相等(令牌2[3], "-x", "双引号第末")

  设 令牌3 为 解析命令行为令牌("  多   余   空白  ")
  断言相等(长(令牌3), 3, "连续空白压缩为单分隔")
  断言相等(令牌3[0], "多", "首令牌")
  断言相等(令牌3[2], "空白", "末令牌")

  # ---- 5. 端到端：注册 + 经注册表执行（变量读写）----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("设置环境变量"), "设置环境变量应已注册")
  断言为真(注册表.登记表.包含("获取环境变量"), "获取环境变量应已注册")
  断言为真(注册表.登记表.包含("解析命令行"), "解析命令行应已注册")

  设 定义 为 注册表.登记表["设置环境变量"]
  设 参 为 ["名": "E2E", "值": "ok"]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "设置不应报错")
  断言为真(环境.包含("E2E"), "端到端设置应写入注入字典")
  断言相等(环境["E2E"], "ok", "端到端设置值正确")

  设 取定义 为 注册表.登记表["获取环境变量"]
  设 取参 为 ["名": "E2E"]
  设 取产出 为 取定义["execute"](取参)
  断言为假(取产出["isError"], "获取已设置变量不应报错")

  设 缺参 为 ["名": "NO_SUCH"]
  设 缺产出 为 取定义["execute"](缺参)
  断言为真(缺产出["isError"], "获取未设置变量应报错")

  设 解定义 为 注册表.登记表["解析命令行"]
  设 解参 为 ["命令行": "ls -l '/tmp/a b'"]
  设 解产出 为 解定义["execute"](解参)
  断言为假(解产出["isError"], "解析命令行不应报错")

  打印 "测试_shell环境层 全部通过"

主()
