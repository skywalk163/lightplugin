# 测试_存储抽象.light —— 存储抽象 的正例与反例
#
# 零真实磁盘：内存后端默认；文件后端用「注入式内存字典模拟」验证后端切换。
# 失败即 抛出 新建 错误(...)，绝不放宽。

从 存储抽象 导入 写核心, 读核心, 列核心, 删核心, 设后端, 注入文件后端, 挂载
从 工具 导入 工具注册表
从 内置核心字典 导入 字典键列表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 注入式文件后端：用内存字典模拟磁盘 ----
设 假文件 为 {}

段落 假写(桶, 键, 值):
  全局 假文件。
  如果 假文件.包含(桶) == 假:
    假文件[桶] 为 {}
  假文件[桶][键] 为 值

段落 假读(桶, 键):
  全局 假文件。
  如果 假文件.包含(桶) == 假:
    返回 空
  设 子 为 假文件[桶]
  如果 子.包含(键) == 假:
    返回 空
  返回 子[键]

段落 假列(桶):
  全局 假文件。
  如果 假文件.包含(桶) == 假:
    返回 []
  返回 字典键列表(假文件[桶])

段落 假删(桶, 键):
  全局 假文件。
  如果 假文件.包含(桶) == 假:
    返回 假
  设 子 为 假文件[桶]
  如果 子.包含(键) == 假:
    返回 假
  子.弹出(键)
  返回 真

段落 主:
  # ---- 1. 内存后端：写入与读取 ----
  断言为真(写核心("桶甲", "名字", "阿明"), "内存写入应成功")
  断言相等(读核心("桶甲", "名字"), "阿明", "内存读回应回写值")
  断言为真(写核心("桶甲", "年龄", "7"), "内存写入第二键")

  # ---- 2. 内存后端：列举 ----
  设 键们 为 列核心("桶甲")
  断言相等(长(键们), 2, "桶甲应有 2 个键")
  断言为真(键们.包含("名字"), "列举应含 名字")
  断言为真(键们.包含("年龄"), "列举应含 年龄")

  # ---- 3. 内存后端：删除 ----
  断言为真(删核心("桶甲", "年龄"), "删除存在的键应成功")
  断言为假(删核心("桶甲", "年龄"), "重复删除应失败")
  断言相等(读核心("桶甲", "年龄"), 空, "删除后读取应为空")

  # ---- 4. 反例：内存读取不存在的键 → 空 ----
  断言相等(读核心("桶甲", "不存在"), 空, "读缺失键返回空")

  # ---- 5. 文件后端切换 + 注入式 I/O ----
  设后端("文件")
  注入文件后端(假写, 假读, 假列, 假删)
  断言为真(写核心("桶乙", "标题", "你好"), "文件后端写入应成功")
  断言相等(读核心("桶乙", "标题"), "你好", "文件后端读回")
  设 键们2 为 列核心("桶乙")
  断言相等(长(键们2), 1, "文件后端桶乙应有 1 个键")
  断言为真(删核心("桶乙", "标题"), "文件后端删除应成功")

  # ---- 6. 反例：文件后端未注入时写入失败 ----
  设后端("内存")
  注入文件后端(空, 空, 空, 空)
  设后端("文件")
  断言为假(写核心("桶丙", "x", "y"), "未注入文件后端时写入应失败")

  # ---- 7. 挂载进注册表，端到端执行（内存后端）----
  设后端("内存")
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("存储写入"), "存储写入应已注册")
  断言为真(注册表.登记表.包含("存储读取"), "存储读取应已注册")
  断言为真(注册表.登记表.包含("存储列举"), "存储列举应已注册")
  断言为真(注册表.登记表.包含("存储删除"), "存储删除应已注册")

  设 写入参 为 ["命名空间": "端到端", "键": "k", "值": "v"]
  设 写入产出 为 注册表.登记表["存储写入"]["execute"](写入参)
  断言为假(写入产出["isError"], "写入不应报错")
  设 读取参 为 ["命名空间": "端到端", "键": "k"]
  设 读取产出 为 注册表.登记表["存储读取"]["execute"](读取参)
  断言为假(读取产出["isError"], "读取不应报错")
  断言为真(包含(读取产出["content"], "v"), "读取结果应含值 v")

  # ---- 8. 反例：空命名空间 → 工具报错 ----
  设 坏参 为 ["命名空间": "", "键": "k", "值": "v"]
  设 坏产出 为 注册表.登记表["存储写入"]["execute"](坏参)
  断言为真(坏产出["isError"], "空命名空间应报错")

  # ---- 9. 反例：读取缺失键 → 工具报错 ----
  设 缺参 为 ["命名空间": "端到端", "键": "没有"]
  设 缺产出 为 注册表.登记表["存储读取"]["execute"](缺参)
  断言为真(缺产出["isError"], "读取缺失键应报错")

  打印 "测试_存储抽象 全部通过"

主()
