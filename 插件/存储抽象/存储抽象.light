# 存储抽象.light —— 对标 dsh packages/storage 的键值/对象存储抽象
#
# 设计：命名空间（桶）概念 + 增/查/删/列键。多后端适配：
#   - 内存后端：模块内字典，零 I/O，单测默认走这条。
#   - 文件后端：真实磁盘 I/O 由宿主注入的「读器/写器/列举器/删除器」提供，
#     测试注入内存字典模拟 → 零真实磁盘、零网络、零墙上时钟。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作实参 → 先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块命名避开「文本」。
#   L-165/166 模块级可变标量须先写『全局 X。』，否则静默变局部变量。
#   L-048   不要用中文数字作标识符。

从 工具 导入 造工具定义, 造工具结果

# ---------- 模块级状态 ----------
设 库 为 {}                       # 内存后端：命名空间 -> {键: 值}
设 后端 为 "内存"                 # 当前后端：内存 / 文件

# 注入式文件后端（宿主提供；默认 空 表示文件后端不可用）
设 文件写 为 空
设 文件读 为 空
设 文件列 为 空
设 文件删 为 空

# ---------- 后端配置（宿主/测试注入入口）----------
段落 设后端(名称):
  全局 后端。
  后端 为 名称
  返回 真

段落 注入文件后端(写, 读, 列, 删):
  全局 文件写。
  全局 文件读。
  全局 文件列。
  全局 文件删。
  文件写 为 写
  文件读 为 读
  文件列 为 列
  文件删 为 删
  返回 真

# ---------- 内核（与工具解耦，便于单测直调）----------
段落 写核心(桶, 键, 值):
  如果 后端 == "内存":
    如果 库.包含(桶) == 假:
      库[桶] 为 {}
    库[桶][键] 为 值
    返回 真
  否则:
    如果 文件写 == 空:
      返回 假
    文件写(桶, 键, 值)
    返回 真

段落 读核心(桶, 键):
  如果 后端 == "内存":
    如果 库.包含(桶) == 假:
      返回 空
    设 子 为 库[桶]
    如果 子.包含(键) == 假:
      返回 空
    返回 子[键]
  否则:
    如果 文件读 == 空:
      返回 空
    返回 文件读(桶, 键)

段落 列核心(桶):
  如果 后端 == "内存":
    如果 库.包含(桶) == 假:
      返回 []
    设 子 为 库[桶]
    设 键们 为 字典键列表(子)
    返回 键们
  否则:
    如果 文件列 == 空:
      返回 []
    返回 文件列(桶)

段落 删核心(桶, 键):
  如果 后端 == "内存":
    如果 库.包含(桶) == 假:
      返回 假
    设 子 为 库[桶]
    如果 子.包含(键) == 假:
      返回 假
    子.弹出(键)
    返回 真
  否则:
    如果 文件删 == 空:
      返回 假
    返回 文件删(桶, 键)

# ---------- 模型可见工具 ----------
段落 存储写入模式():
  返回 ["type": "object",
        "properties": ["命名空间": ["type": "string", "description": "桶/命名空间名"],
                       "键": ["type": "string", "description": "键名"],
                       "值": ["type": "string", "description": "要写入的值"]],
        "required": ["命名空间", "键", "值"]]

段落 存储写入处理(参数):
  设 桶 为 参数["命名空间"]
  设 键 为 参数["键"]
  如果 桶 == "" 或 键 == "":
    返回 造工具结果("命名空间与键均不可为空", 真)
  设 值 为 参数["值"]
  如果 写核心(桶, 键, 值) == 假:
    返回 造工具结果("写入失败：文件后端未注入或不可用", 真)
  返回 造工具结果("已写入 " + 桶 + "/" + 键, 假)

段落 存储读取模式():
  返回 ["type": "object",
        "properties": ["命名空间": ["type": "string", "description": "桶/命名空间名"],
                       "键": ["type": "string", "description": "键名"]],
        "required": ["命名空间", "键"]]

段落 存储读取处理(参数):
  设 桶 为 参数["命名空间"]
  设 键 为 参数["键"]
  如果 桶 == "" 或 键 == "":
    返回 造工具结果("命名空间与键均不可为空", 真)
  设 值 为 读核心(桶, 键)
  如果 值 == 空:
    返回 造工具结果("未找到键: " + 桶 + "/" + 键, 真)
  返回 造工具结果(桶 + "/" + 键 + " = " + 值, 假)

段落 存储列举模式():
  返回 ["type": "object",
        "properties": ["命名空间": ["type": "string", "description": "桶/命名空间名"]],
        "required": ["命名空间"]]

段落 存储列举处理(参数):
  设 桶 为 参数["命名空间"]
  如果 桶 == "":
    返回 造工具结果("命名空间不可为空", 真)
  设 键们 为 列核心(桶)
  设 串 为 连接字符串(键们, ", ")
  返回 造工具结果("桶 " + 桶 + " 共 " + 字符串(长(键们)) + " 个键: " + 串, 假)

段落 存储删除模式():
  返回 ["type": "object",
        "properties": ["命名空间": ["type": "string", "description": "桶/命名空间名"],
                       "键": ["type": "string", "description": "键名"]],
        "required": ["命名空间", "键"]]

段落 存储删除处理(参数):
  设 桶 为 参数["命名空间"]
  设 键 为 参数["键"]
  如果 桶 == "" 或 键 == "":
    返回 造工具结果("命名空间与键均不可为空", 真)
  如果 删核心(桶, 键) == 假:
    返回 造工具结果("删除失败：键不存在或后端不可用", 真)
  返回 造工具结果("已删除 " + 桶 + "/" + 键, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("存储写入", "向指定命名空间写入键值", 存储写入模式(), 存储写入处理))
  注册表.注册(造工具定义("存储读取", "读取指定命名空间的键值", 存储读取模式(), 存储读取处理))
  注册表.注册(造工具定义("存储列举", "列举指定命名空间下的全部键", 存储列举模式(), 存储列举处理))
  注册表.注册(造工具定义("存储删除", "删除指定命名空间下的键", 存储删除模式(), 存储删除处理))
  返回 真

导出 设后端
导出 注入文件后端
导出 写核心
导出 读核心
导出 列核心
导出 删核心
导出 挂载
