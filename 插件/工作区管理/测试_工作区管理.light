# 测试_工作区管理.light —— 工作区管理 的正例与反例
#
# 断言惯用法（照抄 lightharness 与 异步作业轮询）：失败即 抛出 新建 错误(...)，
# 绝不放宽。解析测试用注入式 存在性判定（fake），不依赖真实文件系统，无磁盘 flaky。

从 工作区管理 导入 注册工作区, 列出根, 切换根, 取当前根, 拼接路径, 解析路径, 设存在性判定, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 注入式 存在性判定：路径含 “缺失” 视为不存在，其余视为存在 ----
段落 假存在(路径):
  如果 子串位置(路径, "缺失") >= 0:
    返回 假
  返回 真

段落 主:
  # ---- 0. 注入存在性判定并注册两个根 ----
  设存在性判定(假存在)
  注册工作区("主", "/repo/main")
  注册工作区("副", "/repo/side")

  # ---- 1. 列出根 ----
  设 名单 为 列出根()
  断言为真(名单.包含("主"), "应列出 主")
  断言为真(名单.包含("副"), "应列出 副")

  # ---- 2. 首注册成为当前根 ----
  断言相等(取当前根(), "主", "首注册应成为当前根")

  # ---- 3. 根切换 ----
  设 切 为 切换根("副")
  断言相等(切["当前根"], "副", "切换后应选中 副")
  断言相等(取当前根(), "副", "取当前根应回读 副")

  # ---- 4. 反例：切换未知根应失败 ----
  设 切2 为 切换根("不存在")
  断言为假(切2["成功"], "切换未知根应失败")

  # ---- 5. 路径拼接归一化 ----
  设 拼 为 拼接路径("/repo/main", "src/app.py")
  断言相等(拼, "/repo/main/src/app.py", "拼接应正确")
  设 拼2 为 拼接路径("/repo/main/", "/src/app.py")
  断言相等(拼2, "/repo/main/src/app.py", "去多余斜杠应归一")

  # ---- 6. 解析：存在 ----
  设 解 为 解析路径("主", "src/app.py")
  断言为真(解["成功"], "应解析成功")
  断言相等(解["绝对路径"], "/repo/main/src/app.py", "绝对路径正确")

  # ---- 7. 反例：未知根报错 ----
  设 解2 为 解析路径("幽灵", "x")
  断言为假(解2["成功"], "未知根应失败")
  断言为真(子串位置(解2["原因"], "未知工作区") >= 0, "原因应说明未知工作区")

  # ---- 8. 反例：路径不存在报错 ----
  设 解3 为 解析路径("主", "缺失/file.py")
  断言为假(解3["成功"], "不存在路径应失败")
  断言为真(子串位置(解3["原因"], "路径不存在") >= 0, "原因应说明路径不存在")

  # ---- 9. 挂载进注册表，并从注册表取出工具执行（端到端）----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("注册工作区"), "注册工作区应已注册")
  断言为真(注册表.登记表.包含("解析路径"), "解析路径应已注册")

  设 定义 为 注册表.登记表["解析路径"]
  设 入参 为 ["根名": "主", "相对路径": "src/app.py"]
  设 产出 为 定义["execute"](入参)
  断言为假(产出["isError"], "解析已注册根应成功")

  设 定义2 为 注册表.登记表["注册工作区"]
  设 入参2 为 ["名字": "三", "路径": "/repo/three"]
  设 产出2 为 定义2["execute"](入参2)
  断言为假(产出2["isError"], "注册工作区应成功")

  打印 "测试_工作区管理 全部通过"

主()
