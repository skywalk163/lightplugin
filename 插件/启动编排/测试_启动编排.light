# 测试_启动编排.light —— 启动编排 的正例与反例
#
# 与宿主一致的断言惯用法：失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。
# 步骤清单均注入确定性 fake（含会失败的步骤、会成环的依赖），零网络、零墙上时钟。

从 启动编排 导入 执行启动序列, 设启动步骤, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言包含(实际, 子, 标签):
  如果 包含(实际, 子) == 假:
    抛出 新建 错误("断言包含失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 应含=" + 子)

段落 下标(列表, 值):
  设 i 为 0
  当 i < 长(列表):
    如果 列表[i] == 值:
      返回 i
    设 i 为 i + 1
  返回 -1

# ---- 确定性 fake 步骤 run ----
设 已跑 为 []

段落 步成功(名):
  已跑.追加(名)
  返回 真

段落 步失败(名):
  返回 假

段落 主:
  全局 已跑。
  # ---- 1. 拓扑顺序：依赖先于依赖者 ----
  设 已跑 为 []
  设 步A 为 ["name": "A", "deps": [], "optional": 假, "run": 步成功]
  设 步B 为 ["name": "B", "deps": ["A"], "optional": 假, "run": 步成功]
  设 步C 为 ["name": "C", "deps": ["A"], "optional": 假, "run": 步成功]
  设 步D 为 ["name": "D", "deps": ["B"], "optional": 假, "run": 步成功]
  设启动步骤([步A, 步B, 步C, 步D])
  设 结果 为 执行启动序列()
  断言为真(结果["ok"], "全成功应 ok=真")
  断言相等(下标(结果["顺序"], "A"), 0, "A 应排第一")
  断言为真(下标(结果["顺序"], "A") < 下标(结果["顺序"], "B"), "A 应先于 B")
  断言为真(下标(结果["顺序"], "B") < 下标(结果["顺序"], "D"), "B 应先于 D")
  断言为真(下标(结果["顺序"], "A") < 下标(结果["顺序"], "C"), "A 应先于 C")

  # ---- 2. 失败短路：必选步骤失败 → 序列失败 + 强依赖者跳过 ----
  设 已跑 为 []
  设 步A2 为 ["name": "A", "deps": [], "optional": 假, "run": 步成功]
  设 步B2 为 ["name": "B", "deps": ["A"], "optional": 假, "run": 步失败]
  设 步C2 为 ["name": "C", "deps": ["B"], "optional": 假, "run": 步成功]
  设启动步骤([步A2, 步B2, 步C2])
  设 结果2 为 执行启动序列()
  断言为假(结果2["ok"], "必选步骤失败应 ok=假")
  断言包含(连接字符串(结果2["失败"], ","), "B", "B 记录为失败")
  断言包含(连接字符串(结果2["跳过"], ","), "C", "C 因依赖 B 被跳过")
  断言包含(连接字符串(结果2["顺序"], ","), "C", "C 仍在拓扑顺序中（仅未加载）")
  断言为真(已跑.包含("A"), "A 应已执行")
  断言为假(已跑.包含("C"), "C 不应被加载")

  # ---- 3. 可选失败：不阻断依赖者、不使序列失败 ----
  设 已跑 为 []
  设 步A3 为 ["name": "A", "deps": [], "optional": 假, "run": 步成功]
  设 步B3 为 ["name": "B", "deps": ["A"], "optional": 真, "run": 步失败]
  设 步C3 为 ["name": "C", "deps": ["B"], "optional": 假, "run": 步成功]
  设启动步骤([步A3, 步B3, 步C3])
  设 结果3 为 执行启动序列()
  断言为真(结果3["ok"], "仅可选失败应 ok=真")
  断言包含(连接字符串(结果3["失败"], ","), "B", "B 记录为失败（可选）")
  断言为真(已跑.包含("C"), "C 仍被执行（可选失败不阻断依赖者）")

  # ---- 4. 循环依赖检测 ----
  设 已跑 为 []
  设 步A4 为 ["name": "A", "deps": ["B"], "optional": 假, "run": 步成功]
  设 步B4 为 ["name": "B", "deps": ["A"], "optional": 假, "run": 步成功]
  设启动步骤([步A4, 步B4])
  设 结果4 为 执行启动序列()
  断言为假(结果4["ok"], "循环依赖应 ok=假")
  断言包含(结果4["原因"], "循环", "原因应含循环依赖")
  断言相等(长(结果4["顺序"]), 0, "成环时拓扑序为空")

  # ---- 5. 挂载 + 端到端 ----
  设 已跑 为 []
  设启动步骤([步A, 步B, 步C, 步D])
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("执行启动序列"), "执行启动序列应已注册")
  设 定义 为 注册表.登记表["执行启动序列"]
  断言相等(定义["name"], "执行启动序列", "注册名一致")
  设 产出 为 定义["execute"](["序列名": "boot1"])
  断言为假(产出["isError"], "成功启动序列工具不应报错")
  # 反例：缺必填参数应触发 schema 校验失败
  设 产出缺 为 注册表.执行("执行启动序列", "{}")
  断言为真(产出缺["isError"], "缺序列名应报 schema 错误")

  打印 "测试_启动编排 全部通过"

主()
