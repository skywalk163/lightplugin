# 工作线程运行时.light —— 对标 dsh packages/experimental/webworker-runtime（P5-2）
#
# 能力：浏览器 Web Worker 的**消息循环 + 任务派发 + 生命周期**的纯逻辑核心。
#
# 设计取舍：dsh 真实运行时是「整棵插件树跑在 Web Worker 里 + VFS 挂载 + 模块加载器 + 进程 shim」。
# 本复刻版只复刻**调度语义**：任务队列、按类型路由处理器、生命周期（空闲/忙碌/已停止）。
# 真实隧道/传输由宿主注入，本模块不碰浏览器、不碰 WebSocket。
#
# 光明限制遵守：L-047 / L-044 / LP-D-002 / LP-D-006 / 模块级状态统一放字典（元素赋值共享）。
#   队列采用「只追加 + 头指针」模式：绝不重绑 队列 这个名字（避免 全局），清空只在 强制终止/重启 用 全局。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置

# 状态字典：状态 / 序号 / 头指针（消费游标）
设 状态量 为 ["状态": "空闲", "序号": 0, "头": 0]
# 队列：只追加的列表，靠 状态量["头"] 消费；清空只在 强制终止/重启 处用 全局
设 队列 为 []
# 处理器表：类型 -> 处理函数（字典元素赋值天然共享）
设 处理表 为 {}

段落 注册处理器(类型, 处理器):
  处理表[类型] 为 处理器
  返回 真

段落 提交任务(类型, 载荷=""):
  如果 状态量["状态"] == "已停止":
    返回 假
  状态量["序号"] 为 状态量["序号"] + 1
  队列.追加(["序号": 状态量["序号"], "类型": 类型, "载荷": 载荷])
  返回 状态量["序号"]

段落 队列长():
  返回 长(队列) - 状态量["头"]

段落 取状态():
  返回 状态量["状态"]

段落 派发():
  如果 状态量["状态"] == "已停止":
    返回 ["完成": 假, "原因": "已停止", "结果": 空]
  如果 队列长() == 0:
    返回 ["完成": 假, "原因": "空队列", "结果": 空]
  设 任务 为 队列[状态量["头"]]
  状态量["头"] 为 状态量["头"] + 1
  设 类型 为 任务["类型"]
  如果 处理表.包含(类型) == 假:
    返回 ["完成": 假, "原因": "未知类型", "结果": 空]
  状态量["状态"] 为 "忙碌"
  设 结果 为 处理表[类型](任务["载荷"])
  状态量["状态"] 为 "空闲"
  返回 ["完成": 真, "结果": 结果, "类型": 类型]

段落 停止():
  状态量["状态"] 为 "已停止"
  返回 真

段落 强制终止():
  状态量["状态"] 为 "已停止"
  状态量["头"] 为 0
  全局 队列。
  队列 为 []
  返回 真

段落 重启():
  状态量["状态"] 为 "空闲"
  状态量["头"] 为 0
  全局 队列。
  队列 为 []
  返回 真

# ---------- 模型可见工具 ----------
段落 工作线程运行时模式():
  返回 ["type": "object",
        "properties": ["动作": ["type": "string", "description": "提交任务/派发/停止/强制终止/重启/状态"],
                       "类型": ["type": "string", "description": "可选；任务类型（提交任务时）"],
                       "载荷": ["type": "string", "description": "可选；任务载荷"]],
        "required": ["动作"]]

段落 工作线程运行时处理(参数):
  设 动作 为 参数["动作"]
  如果 动作 == "提交任务":
    如果 参数.包含("类型") == 假:
      返回 造工具结果("提交任务需要 类型", 真)
    设 载荷 为 ""
    如果 参数.包含("载荷"):
      设 载荷 为 参数["载荷"]
    设 号 为 提交任务(参数["类型"], 载荷)
    如果 号 == 假:
      返回 造工具结果("已停止，无法提交", 真)
    返回 造工具结果("已提交 序号=" + 字符串(号), 假)
  如果 动作 == "派发":
    设 结果 为 派发()
    如果 结果["完成"] == 假:
      返回 造工具结果("派发未执行: " + 结果["原因"], 真)
    返回 造工具结果("已派发 类型=" + 结果["类型"] + " 结果=" + 字符串(结果["结果"]), 假)
  如果 动作 == "停止":
    停止()
    返回 造工具结果("已停止", 假)
  如果 动作 == "强制终止":
    强制终止()
    返回 造工具结果("已强制终止，队列清空", 假)
  如果 动作 == "重启":
    重启()
    返回 造工具结果("已重启", 假)
  如果 动作 == "状态":
    返回 造工具结果("状态=" + 取状态() + " 队列=" + 字符串(队列长()), 假)
  返回 造工具结果("未知动作: " + 动作, 真)

段落 挂载(注册表):
  注册表.注册(造工具定义("工作线程运行时", "Web Worker 消息循环与任务派发", 工作线程运行时模式(), 工作线程运行时处理))
  返回 真

导出 注册处理器
导出 提交任务
导出 队列长
导出 取状态
导出 派发
导出 停止
导出 强制终止
导出 重启
导出 挂载
