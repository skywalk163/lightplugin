# 测试_工作线程运行时.light —— P5-2 工作线程运行时 的正例与反例

从 工作线程运行时 导入 注册处理器, 提交任务, 队列长, 取状态, 派发, 停止, 强制终止, 重启, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# 注入的处理器（函数作为一等公民传入）
段落 回声(载荷):
  返回 载荷

段落 主:
  # ---- 1. 注册处理器 + 提交任务 ----
  注册处理器("回声", 回声)
  断言为真(提交任务("回声", "你好") > 0, "提交任务应返回正序号")
  断言相等(队列长(), 1, "提交后队列长应为 1")

  # ---- 2. 派发成功 ----
  设 结果 为 派发()
  断言为真(结果["完成"], "派发应成功")
  断言相等(结果["结果"], "你好", "回声处理器应原样返回载荷")
  断言相等(队列长(), 0, "派发后队列应空")

  # ---- 3. 空队列派发应失败 ----
  设 空派发 为 派发()
  断言为假(空派发["完成"], "空队列派发应失败")
  断言相等(空派发["原因"], "空队列", "原因应为 空队列")

  # ---- 4. 未知类型应失败 ----
  提交任务("不存在的类型", "x")
  设 未知 为 派发()
  断言为假(未知["完成"], "未知类型派发应失败")
  断言相等(未知["原因"], "未知类型", "原因应为 未知类型")

  # ---- 5. 停止后提交与派发均拒绝 ----
  停止()
  断言相等(取状态(), "已停止", "状态应为 已停止")
  断言为假(提交任务("回声", "y") > 0, "已停止后提交应失败（返回 假）")
  断言相等(派发()["原因"], "已停止", "已停止后派发原因应为 已停止")

  # ---- 6. 强制终止清空队列 ----
  强制终止()
  断言相等(队列长(), 0, "强制终止后队列应清空")
  重启()
  断言相等(取状态(), "空闲", "重启后状态应为 空闲")

  # ---- 7. 重启后重新提交 ----
  提交任务("回声", "重生")
  设 重生 为 派发()
  断言相等(重生["结果"], "重生", "重启后应能重新派发")

  # ---- 8. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("工作线程运行时"), "工作线程运行时应注册")
  设 定义 为 注册表.登记表["工作线程运行时"]
  设 参 为 ["动作": "状态"]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "状态查询不应报错")
  断言为真(子串位置(产出["content"], "空闲") >= 0, "状态应包含 空闲")
  设 参坏 为 ["动作": "乱来"]
  断言为真(定义["execute"](参坏)["isError"], "未知动作应报错")

  打印 "测试_工作线程运行时 全部通过"

主()
