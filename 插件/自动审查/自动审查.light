# 自动审查.light —— 对标 dsh packages/experimental/auto-review（P3-4）
#
# 能力：改动差异 → 结构化审查意见（分级 + 定位 + 可操作建议）。
#
# 设计取舍：**规则驱动 + 可选注入评审器**。
#   纯规则部分（本模块）负责「能确定性判定的问题」，例如：
#     空改动的占位、删除无说明、新增 TODO/FIXME 未挂人、超长行、调试语句残留。
#   需要语义判断的部分交给注入的「评审器」，本模块负责汇总与格式化。
#   这样单测零网络、零 LLM 依赖，宿主想接模型再审也留了口子。
#
# 与 dsh 的差异（如实）：dsh auto-review 直接接模型做语义评审；
#   本复刻版把「确定性规则」抽出来先跑（这部分不需要模型，省钱且稳），
#   语义评审作为可选增强。这是**有意的设计差异**，不是能力缺失。
#
# 光明限制遵守：
#   L-047  字典/列表字面量不可直接作实参 → 先赋变量。
#   L-044  含「文本」的标识符会被拆名 → 命名避开（用 稿本/内容/说明）。
#   字符串 `{...}` 是插值 → 不写字面花括号（LP-D-001）。
#   LP-D-006：禁止行尾「+」续行 —— 多行一律用分步 `设 X 为 X + ...`。
#   可变状态放**模块级字典**（元素赋值天然共享，无需『全局』）。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置, 去空格
从 内置核心字典 导入 字典键列表

设 配置 为 ["评审器": 空, "超长行阈值": 120]
设 计数 为 ["审查次数": 0, "意见总数": 0]

段落 绑定评审器(评审器):
  配置["评审器"] 为 评审器
  返回 真

段落 配置阈值(超长行阈值=120):
  如果 超长行阈值 <= 0:
    返回 假
  配置["超长行阈值"] 为 超长行阈值
  返回 真

段落 取审查次数():
  返回 计数["审查次数"]

段落 取意见总数():
  返回 计数["意见总数"]

# ---------- 差异行解析 ----------
# 统一差异行格式：以 + / - / 空格 开头（+ 新增、- 删除、空格 上下文）
段落 解析差异行(行):
  如果 长(行) == 0:
    返回 ["类型": "空", "内容": "", "行号": 0]
  设 首 为 行[0:1]
  设 内容 为 行[1:长(行)]
  如果 首 == "+":
    返回 ["类型": "新增", "内容": 内容, "行号": 0]
  如果 首 == "-":
    返回 ["类型": "删除", "内容": 内容, "行号": 0]
  如果 首 == " ":
    返回 ["类型": "上下文", "内容": 内容, "行号": 0]
  返回 ["类型": "未知", "内容": 行, "行号": 0]

段落 统计差异(行表):
  设 新增 为 0
  设 删除 为 0
  设 序号 为 0
  遍历 行 之 行表:
    设 解析 为 解析差异行(行)
    如果 解析["类型"] == "新增":
      新增 为 新增 + 1
    如果 解析["类型"] == "删除":
      删除 为 删除 + 1
    序号 为 序号 + 1
  返回 ["新增": 新增, "删除": 删除, "总行": 长(行表)]

# ---------- 确定性规则 ----------
# 每条规则返回一条意见：["级别": "阻断"/"警告"/"提示", "文件": 串, "行号": n, "规则": 串, "说明": 串]
段落 造意见(级别, 文件, 行号, 规则, 说明):
  返回 ["级别": 级别, "文件": 文件, "行号": 行号, "规则": 规则, "说明": 说明]

段落 规则_调试残留(内容, 文件, 行号):
  如果 子串位置(内容, "console.log") >= 0:
    返回 造意见("警告", 文件, 行号, "调试残留", "存在 console.log，提交前请移除")
  如果 子串位置(内容, "print(") >= 0:
    # 只在新增行提示，避免误报正常业务输出
    返回 造意见("提示", 文件, 行号, "调试残留", "新增行含 print(，确认是否为调试输出")
  返回 空

段落 规则_未挂人标记(内容, 文件, 行号):
  如果 子串位置(内容, "TODO") >= 0:
    返回 造意见("警告", 文件, 行号, "未挂人标记", "TODO 未指定负责人与期限")
  如果 子串位置(内容, "FIXME") >= 0:
    返回 造意见("阻断", 文件, 行号, "未挂人标记", "FIXME 必须在提交前处理或挂单")
  返回 空

段落 规则_超长行(内容, 文件, 行号):
  如果 长(内容) > 配置["超长行阈值"]:
    返回 造意见("提示", 文件, 行号, "超长行",
                "行长度 " + 字符串(长(内容)) + " 超过阈值 " + 字符串(配置["超长行阈值"]))
  返回 空

段落 规则_空改动(内容, 文件, 行号):
  如果 去空格(内容) == "":
    返回 造意见("提示", 文件, 行号, "空改动", "新增了空行或仅空白的改动")
  返回 空

# ---------- 主审查 ----------
段落 审查差异(行表, 文件="未命名"):
  计数["审查次数"] 为 计数["审查次数"] + 1
  设 意见表 为 []
  设 行号 为 0
  遍历 行 之 行表:
    行号 为 行号 + 1
    设 解析 为 解析差异行(行)
    # 只对新增行跑规则：删除行与上下文行不该被要求"清理"
    如果 解析["类型"] == "新增":
      设 内容 为 解析["内容"]
      设 结论 为 规则_空改动(内容, 文件, 行号)
      如果 结论 != 空:
        意见表.追加(结论)
      设 结论2 为 规则_未挂人标记(内容, 文件, 行号)
      如果 结论2 != 空:
        意见表.追加(结论2)
      设 结论3 为 规则_调试残留(内容, 文件, 行号)
      如果 结论3 != 空:
        意见表.追加(结论3)
      设 结论4 为 规则_超长行(内容, 文件, 行号)
      如果 结论4 != 空:
        意见表.追加(结论4)
  计数["意见总数"] 为 计数["意见总数"] + 长(意见表)
  返回 意见表

# ---------- 汇总与渲染 ----------
段落 意见计数(意见表):
  设 阻断 为 0
  设 警告 为 0
  设 提示 为 0
  遍历 项 之 意见表:
    如果 项["级别"] == "阻断":
      阻断 为 阻断 + 1
    如果 项["级别"] == "警告":
      警告 为 警告 + 1
    如果 项["级别"] == "提示":
      提示 为 提示 + 1
  返回 ["阻断": 阻断, "警告": 警告, "提示": 提示, "总数": 长(意见表)]

段落 是否阻断(意见表):
  设 统计 为 意见计数(意见表)
  返回 统计["阻断"] > 0

段落 渲染意见(项):
  设 串 为 "[" + 项["级别"] + "] " + 项["文件"] + ":" + 字符串(项["行号"])
  设 串 为 串 + " " + 项["规则"]
  设 串 为 串 + " —— " + 项["说明"]
  返回 串

段落 渲染报告(意见表):
  设 行串 为 []
  遍历 项 之 意见表:
    行串.追加(渲染意见(项))
  如果 长(行串) == 0:
    返回 "未发现问题"
  设 统计 为 意见计数(意见表)
  设 头 为 "共 " + 字符串(统计["总数"]) + " 条"
  设 头 为 头 + "（阻断 " + 字符串(统计["阻断"])
  设 头 为 头 + " / 警告 " + 字符串(统计["警告"])
  设 头 为 头 + " / 提示 " + 字符串(统计["提示"]) + "）"
  设 行串2 为 [头]
  遍历 项 之 行串:
    行串2.追加(项)
  返回 连接字符串(行串2, "\n")

# ---------- 可选：注入评审器做语义增强 ----------
段落 审查并增强(行表, 文件="未命名"):
  设 意见表 为 审查差异(行表, 文件)
  如果 配置["评审器"] == 空:
    返回 意见表
  设 追加 为 配置["评审器"](行表, 文件)
  遍历 项 之 追加:
    意见表.追加(项)
  返回 意见表

# ---------- 模型可见工具 ----------
段落 自动审查模式():
  返回 ["type": "object",
        "properties": ["差异": ["type": "array", "description": "差异行列表，每行以 + / - / 空格 开头"],
                       "文件": ["type": "string", "description": "可选；被审查文件路径"]],
        "required": ["差异"]]

段落 自动审查处理(参数):
  设 文件 为 "未命名"
  如果 参数.包含("文件"):
    设 文件 为 参数["文件"]
  设 意见表 为 审查并增强(参数["差异"], 文件)
  设 报告 为 渲染报告(意见表)
  如果 是否阻断(意见表) == 真:
    返回 造工具结果("审查不通过（存在阻断项）:\n" + 报告, 真)
  返回 造工具结果(报告, 假)

段落 挂载(注册表, 评审器=空):
  如果 评审器 != 空:
    绑定评审器(评审器)
  注册表.注册(造工具定义("自动审查", "对改动差异做规则审查，输出分级意见", 自动审查模式(), 自动审查处理))
  返回 真

导出 绑定评审器
导出 配置阈值
导出 取审查次数
导出 取意见总数
导出 解析差异行
导出 统计差异
导出 造意见
导出 规则_调试残留
导出 规则_未挂人标记
导出 规则_超长行
导出 规则_空改动
导出 审查差异
导出 意见计数
导出 是否阻断
导出 渲染意见
导出 渲染报告
导出 审查并增强
导出 挂载
