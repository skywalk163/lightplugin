# 测试_语音输入打包.light —— P3-3 语音输入打包 的正例与反例
# 依赖「语音输入前端」：验证跨域联动（直接打包前端当前会话）。

从 语音输入打包 导入 配置默认, 装配元信息, 估算字节, 分片总帧数, 校验分片, 装配负载, 打包当前会话, 挂载
从 语音输入前端 导入 配置阈值, 复位, 开始录音, 采样, 停止录音, 取分片, 分片数
从 工具 导入 工具注册表
# stdlib 模块函数必须显式导入（见 语言缺陷反馈.md LP-D-002）
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # ---- 1. 默认配置校验 ----
  断言为真(配置默认(16000, "wav", 1, 2, 10485760), "合法默认配置应成功")
  断言为假(配置默认(0, "wav", 1, 2, 10485760), "采样率为 0 应失败")
  断言为假(配置默认(16000, "wav", 0, 2, 10485760), "声道为 0 应失败")
  断言为假(配置默认(16000, "wav", 1, 0, 10485760), "每帧字节为 0 应失败")
  断言为假(配置默认(16000, "wav", 1, 2, 0), "上限为 0 应失败")

  # ---- 2. 元信息与字节估算 ----
  设 元 为 装配元信息("sess-1", 16000, "wav", 1)
  断言相等(元["会话号"], "sess-1", "元信息会话号")
  断言相等(元["采样率"], 16000, "元信息采样率")
  断言相等(估算字节(100, 2, 1), 200, "单声道 100 帧应为 200 字节")
  断言相等(估算字节(100, 2, 2), 400, "双声道应翻倍")
  断言相等(估算字节(0, 2, 1), 0, "零帧应为零字节")

  # ---- 3. 分片统计与校验 ----
  断言相等(分片总帧数([10, 20, 5]), 35, "分片总帧数")
  设 好校验 为 校验分片([10, 20, 5])
  断言为真(好校验["合法"], "全正分片应合法")
  设 空校验 为 校验分片([])
  断言为假(空校验["合法"], "空分片应非法")
  断言相等(空校验["原因"], "分片为空", "空分片原因")
  设 坏校验 为 校验分片([10, 0, 5])
  断言为假(坏校验["合法"], "含非正帧数应非法")
  断言相等(坏校验["坏序号"], 1, "坏分片序号应为 1")

  # ---- 4. 装配负载（正常）----
  设 分片表 为 [300, 300, 150]
  设 负载 为 装配负载(分片表, 元)
  断言为真(负载["就绪"], "正常分片应就绪")
  断言相等(负载["总帧数"], 750, "总帧数")
  断言相等(负载["总字节"], 1500, "总字节（750*2*1）")
  断言相等(负载["分片数"], 3, "分片数")
  断言为假(负载["超限"], "不应超限")
  断言为真(子串位置(负载["负载"], "sess-1.wav?") >= 0, "负载应以 会话号.编码? 开头")
  断言为真(子串位置(负载["负载"], "帧数=750") >= 0, "负载应含总帧数")

  # ---- 5. 反例：超限 ----
  断言为真(配置默认(16000, "wav", 1, 2, 1000), "把上限调小以便测超限")
  设 超限 为 装配负载(分片表, 元)
  断言为假(超限["就绪"], "超上限应未就绪")
  断言为真(超限["超限"], "超限位应为真")
  断言为真(子串位置(超限["原因"], "负载超上限") >= 0, "超限原因")
  断言为真(配置默认(16000, "wav", 1, 2, 10485760), "恢复上限")

  # ---- 6. 反例：非法分片不应产出负载 ----
  设 坏负载 为 装配负载([10, 0], 元)
  断言为假(坏负载["就绪"], "非法分片应未就绪")
  断言相等(坏负载["负载"], "", "非法时不应产出负载串")

  # ---- 7. 跨域联动：直接打包「语音输入前端」当前会话 ----
  断言为真(配置阈值(5, 100, 3000, 10), "每片 10 帧")
  复位()
  开始录音()
  设 甲 为 0
  当 甲 < 25:
    采样(60)
    甲 为 甲 + 1
  停止录音()
  断言相等(分片数(), 3, "前端应产出 3 个分片")
  设 打包 为 打包当前会话("sess-live")
  断言为真(打包["就绪"], "当前会话应能打包")
  断言相等(打包["分片数"], 3, "打包分片数应与前端一致")
  断言相等(打包["总帧数"], 25, "打包总帧数应为 25")
  断言相等(打包["总字节"], 50, "25 帧单声道应为 50 字节")

  # ---- 8. 反例：空会话打包应失败 ----
  复位()
  设 空打包 为 打包当前会话("sess-empty")
  断言为假(空打包["就绪"], "空会话应打包失败")
  断言相等(空打包["原因"], "分片为空", "空会话原因")

  # ---- 9. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("语音打包"), "语音打包应注册")
  设 定义 为 注册表.登记表["语音打包"]
  设 参 为 ["会话号": "sess-x", "分片": [100, 200]]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "合法分片不应报错")
  断言为真(子串位置(产出["content"], "帧数=300") >= 0, "产出应含总帧数")

  设 参坏 为 ["会话号": "sess-y", "分片": [0]]
  断言为真(定义["execute"](参坏)["isError"], "非法分片应报错")

  打印 "测试_语音输入打包 全部通过"

主()
