# 模型适配器.light —— 对标 dsh packages/llm
#
# 定位：模型适配器 —— 多后端路由 + 请求构造/响应解析。
#   真实网络调用由注入式 transport(模型名, 消息列表) -> 回复文本 提供
#   （宿主接真实 HTTP/sdk，测试注入假 transport）。零网络、零墙上时钟。
#
# 多后端路由：按模型名启发式选后端（claude→anthropic / gemini→google / 其它→openai），
#   各后端可独立注入 transport；未注册的后端 → 失败（对应「未知模型/未知后端」反例）。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作函数实参 → 先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块命名避开「文本」（用 回复/内容/负载）。
#   L-165/166 模块级可变标量须先写『全局 X。』，否则静默变局部变量。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置

设 后端表 为 {}                  # 后端名 -> 运输函数(模型名, 消息表) -> 回复文本
设 预设后端 为 "openai"

# ---------- 注入入口（宿主/测试）----------
段落 设定传输(后端名, 运输):
  全局 后端表。
  后端表[后端名] 为 运输
  返回 真

# ---------- 后端路由 ----------
段落 解析后端(模型名):
  如果 子串位置(模型名, "claude") >= 0:
    返回 "anthropic"
  如果 子串位置(模型名, "gemini") >= 0:
    返回 "google"
  返回 "openai"

# ---------- 请求构造（校验模型名/消息角色/内容）----------
段落 构造请求(模型名, 消息表):
  如果 模型名 == "":
    返回 ["ok": 假, "请求": 空, "原因": "模型名不可为空"]
  如果 消息表 == 空 或 长(消息表) == 0:
    返回 ["ok": 假, "请求": 空, "原因": "消息列表不可为空"]
  遍历 项 之 消息表:
    如果 项.包含("角色") == 假:
      返回 ["ok": 假, "请求": 空, "原因": "消息缺少角色字段"]
    如果 项.包含("内容") == 假:
      返回 ["ok": 假, "请求": 空, "原因": "消息缺少内容字段"]
  设 后端 为 解析后端(模型名)
  设 请求 为 ["模型": 模型名, "消息": 消息表, "后端": 后端]
  返回 ["ok": 真, "请求": 请求, "原因": ""]

# ---------- 响应解析（空回复视为失败）----------
段落 解析响应(回复):
  如果 回复 == 空 或 回复 == "":
    返回 ["ok": 假, "内容": "", "原因": "空回复"]
  返回 ["ok": 真, "内容": 回复, "原因": ""]

# ---------- 补全核心 ----------
段落 模型补全核心(模型名, 消息表):
  设 构造 为 构造请求(模型名, 消息表)
  如果 构造["ok"] == 假:
    返回 ["ok": 假, "内容": "", "原因": 构造["原因"]]
  设 请求 为 构造["请求"]
  设 后端 为 请求["后端"]
  如果 后端表.包含(后端) == 假:
    返回 ["ok": 假, "内容": "", "原因": "未知后端: " + 后端]
  设 运输 为 后端表[后端]
  设 回复 为 运输(模型名, 消息表)
  设 解析 为 解析响应(回复)
  如果 解析["ok"] == 假:
    返回 ["ok": 假, "内容": "", "原因": 解析["原因"]]
  返回 ["ok": 真, "内容": 解析["内容"], "原因": ""]

# ---------- 模型可见工具 ----------
段落 模型补全模式():
  设 角色项 为 ["type": "object",
              "properties": ["角色": ["type": "string", "description": "消息发送者角色"],
                            "内容": ["type": "string", "description": "消息正文"]],
              "required": ["角色", "内容"]]
  设 属性 为 ["模型名": ["type": "string", "description": "模型标识，含 claude/gemini 自动路由到对应后端"],
            "消息": ["type": "array", "description": "对话消息列表", "items": 角色项]]
  返回 ["type": "object", "properties": 属性, "required": ["模型名", "消息"]]

段落 模型补全处理(参数):
  设 模型名 为 参数["模型名"]
  设 消息表 为 参数["消息"]
  设 结果 为 模型补全核心(模型名, 消息表)
  如果 结果["ok"] == 假:
    返回 造工具结果("模型补全失败: " + 结果["原因"], 真)
  设 内容 为 结果["内容"]
  返回 造工具结果("模型=" + 模型名 + " 回复=" + 内容, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("模型补全", "调用多后端大模型完成一次补全", 模型补全模式(), 模型补全处理))
  返回 真

导出 设定传输
导出 解析后端
导出 构造请求
导出 解析响应
导出 模型补全核心
导出 模型补全模式
导出 模型补全处理
导出 挂载
