# 测试_模型适配器.light —— 多后端路由 + 请求构造/响应解析 的正例与反例
#
# 与宿主一致的断言惯用法：失败即 抛出 新建 错误(...)，绝不放宽。
# transport 由注入式假函数提供（确定性回执），零网络、零墙上时钟。

从 模型适配器 导入 设定传输, 解析后端, 构造请求, 解析响应, 模型补全核心, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性 transport（记录被哪个模型调用，便于断言路由）----
# 注：transport 契约签名 (模型名, 消息表)，与 模型补全核心 的调用一致。
设 调用记录 为 {}

段落 假运输(模型名, 消息表):
  全局 调用记录。
  调用记录[模型名] 为 长(消息表)
  返回 "RAN:" + 模型名

段落 假运输空(模型名, 消息表):
  返回 ""

段落 主:
  全局 调用记录。

  # ---- 0. 路由判定（多后端）----
  断言相等(解析后端("claude-3"), "anthropic", "claude 应路由到 anthropic")
  断言相等(解析后端("gemini-pro"), "google", "gemini 应路由到 google")
  断言相等(解析后端("gpt-4"), "openai", "gpt 应路由到 openai")

  # ---- 1. 请求结构（模型名 + 消息角色/内容）----
  设 消息 为 [["角色": "用户", "内容": "你好"], ["角色": "助手", "内容": "在"]]
  设 构造 为 构造请求("gpt-4", 消息)
  断言为真(构造["ok"] == 真, "合法请求应构造成功")
  断言相等(构造["请求"]["模型"], "gpt-4", "请求应含模型名")
  断言相等(构造["请求"]["消息"], 消息, "请求应含消息原表")
  断言相等(构造["请求"]["后端"], "openai", "请求应含路由后端")
  断言相等(构造["请求"]["消息"][0]["角色"], "用户", "消息应含角色字段")
  断言相等(构造["请求"]["消息"][0]["内容"], "你好", "消息应含内容字段")

  # ---- 2. 注入双后端 transport，断言路由命中正确后端 ----
  调用记录 为 {}
  设定传输("openai", 假运输)
  设定传输("anthropic", 假运输)
  设 完成 为 模型补全核心("gpt-4", 消息)
  断言为真(完成["ok"] == 真, "openai 补全应成功")
  断言相等(完成["内容"], "RAN:gpt-4", "回复应来自 openai 运输")
  断言为真(调用记录.包含("gpt-4") == 真, "应调用 openai 后端（gpt-4）")
  断言为假(调用记录.包含("claude-3") == 真, "不应调用 anthropic 后端")
  设 完成2 为 模型补全核心("claude-3", 消息)
  断言相等(完成2["内容"], "RAN:claude-3", "claude 应路由到 anthropic 运输")

  # ---- 3. 响应解析：空回复 → 失败 ----
  设定传输("openai", 假运输空)
  设 空回 为 模型补全核心("gpt-4", 消息)
  断言为假(空回["ok"] == 真, "空回复应判定失败")
  断言相等(空回["原因"], "空回复", "空回复原因应回读")

  # ---- 4. 反例：空消息报错 ----
  设 空消息 为 构造请求("gpt-4", [])
  断言为假(空消息["ok"] == 真, "空消息应构造失败")
  设 空消息2 为 模型补全核心("gpt-4", [])
  断言为假(空消息2["ok"] == 真, "空消息补全应失败")

  # ---- 5. 反例：未知后端/未知模型（后端未注册）----
  设 未知 为 模型补全核心("gemini-x", 消息)
  断言为假(未知["ok"] == 真, "未注册后端的模型应失败")
  断言为真(未知["原因"].包含("未知后端") == 真, "应报未知后端")

  # ---- 6. 挂载进注册表，端到端执行 ----
  设定传输("openai", 假运输)
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("模型补全"), "模型补全应已注册")
  设 定义 为 注册表.登记表["模型补全"]
  设 入参 为 ["模型名": "gpt-4", "消息": 消息]
  设 产出 为 定义["execute"](入参)
  断言为假(产出["isError"], "合法补全不应报错")
  设 产出2 为 定义["execute"](["模型名": "gpt-4", "消息": []])
  断言为真(产出2["isError"], "空消息端到端应报错")

  打印 "测试_模型适配器 全部通过"

主()
