# 测试_语音转文字.light —— P3-1 语音转文字 的正例与反例
# 核心验证点：长音频「分段 + 按序归并 + 任一段失败即整体失败」。

从 语音转文字 导入 绑定识别器, 取识别器, 切分段, 有效语言, 转写音频, 分段转写, 挂载
从 异步作业轮询 导入 查询作业
从 工具 导入 工具注册表
# stdlib 模块函数必须显式导入（见 语言缺陷反馈.md LP-D-002）
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性识别器 1：一次就成 ----
段落 立即转写(音频, 语言, 要时间戳):
  返回 ["完成": 真, "稿本": "你好世界", "原因": ""]

# ---- 确定性识别器 2：只对特定音频成功（用于验证「任一段失败即整体失败」）----
段落 选择性转写(音频, 语言, 要时间戳):
  如果 子串位置(音频, "坏段") >= 0:
    返回 ["完成": 假, "稿本": "", "原因": "服务繁忙"]
  返回 ["完成": 真, "稿本": "片段", "原因": ""]

# ---- 确定性识别器 3：永不成功 ----
段落 永不转写(音频, 语言, 要时间戳):
  返回 ["完成": 假, "稿本": "", "原因": "排队中"]

段落 主:
  # ---- 1. 切分段 ----
  设 段表 为 切分段(75, 30)
  断言相等(长(段表), 3, "75 秒按 30 秒切应为 3 段")
  断言相等(段表[0]["起点"], 0, "首段起点")
  断言相等(段表[0]["终点"], 30, "首段终点")
  断言相等(段表[2]["终点"], 75, "末段终点应被总时长截断")
  断言相等(段表[2]["时长"], 15, "末段时长")
  断言相等(长(切分段(60, 30)), 2, "整除时应为 2 段")
  断言相等(长(切分段(0, 30)), 0, "零时长应无段")
  断言相等(长(切分段(60, 0)), 0, "零段长应无段")

  # ---- 2. 语言校验 ----
  断言为真(有效语言("zh"), "zh 应有效")
  断言为真(有效语言("auto"), "auto 应有效")
  断言为假(有效语言("fr"), "fr 不在白名单应无效")

  # ---- 3. 单音频转写（立即完成）----
  设 结果 为 转写音频("a.wav", 立即转写, 3)
  断言为真(结果["终"], "立即转写应达成终态")
  断言相等(结果["记录"]["状态"], "成功", "终态应为成功")
  断言相等(结果["记录"]["结果"], "你好世界", "稿本应为识别器产出")

  # ---- 4. 反例：永不成功 → 超时 ----
  设 超时 为 转写音频("b.wav", 永不转写, 2)
  断言为假(超时["终"], "永不推进应超时")
  断言相等(超时["原因"], "轮询超时", "超时原因")

  # ---- 5. 分段转写：全部成功 → 按序归并 ----
  设 分段 为 分段转写("long.wav", 90, 立即转写, 30)
  断言为真(分段["全成"], "全成应为真")
  断言相等(分段["总段数"], 3, "90 秒按 30 秒应为 3 段")
  断言相等(分段["完成段数"], 3, "应完成 3 段")
  断言相等(分段["稿本"], "你好世界你好世界你好世界", "稿本应按序拼接")
  断言相等(分段["失败段"], -1, "无失败段时失败段应为 -1")

  # ---- 6. 分段转写：任一段失败即整体失败（顺序敏感，不能部分交付）----
  设 坏 为 分段转写("坏段.wav", 60, 选择性转写, 30)
  断言为假(坏["全成"], "含坏段时整体应失败")
  断言相等(坏["完成段数"], 0, "第一段即失败，完成段数应为 0")
  断言相等(坏["失败段"], 0, "失败段应为第 0 段")
  断言相等(坏["稿本"], "", "失败时不应交付部分稿本")
  断言为真(子串位置(坏["原因"], "第 0 段转写失败") >= 0, "原因应指明失败段序号")

  # ---- 7. 反例：非法时长 ----
  设 非法 为 分段转写("x.wav", 0, 立即转写, 30)
  断言为假(非法["全成"], "零时长应失败")
  断言相等(非法["原因"], "时长或段长不合法", "非法原因")

  # ---- 8. 挂载：绑定后工具可用；未绑定应报错 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表, 立即转写)
  断言为真(注册表.登记表.包含("语音转文字"), "语音转文字应注册")
  设 定义 为 注册表.登记表["语音转文字"]
  设 参 为 ["音频": "a.wav"]
  设 产出 为 定义["execute"](参)
  断言为假(产出["isError"], "绑定识别器后应成功")
  断言为真(子串位置(产出["content"], "你好世界") >= 0, "产出应含稿本")

  # 工具层走分段路径
  设 参长 为 ["音频": "long.wav", "总时长": 60]
  设 产出长 为 定义["execute"](参长)
  断言为假(产出长["isError"], "分段转写应成功")
  断言为真(子串位置(产出长["content"], "2 段") >= 0, "产出应回显段数")

  设 空注册表 为 新建 工具注册表()
  绑定识别器(空)
  挂载(空注册表)
  设 空定义 为 空注册表.登记表["语音转文字"]
  设 参2 为 ["音频": "a.wav"]
  断言为真(空定义["execute"](参2)["isError"], "未绑定识别器应报错")

  打印 "测试_语音转文字 全部通过"

主()
