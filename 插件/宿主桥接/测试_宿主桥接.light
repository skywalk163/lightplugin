# 测试_宿主桥接.light —— 宿主桥接 正例与反例
#
# 门面插件：宿主信息全靠注入，未注入时必须**报错**，不许自己探测平台/路径。

从 宿主桥接 导入 注入宿主信息, 宿主名核心, 平台核心, 工作区根核心, 能力声明核心, 摘要核心, 取字段, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 桩信息():
  设 能力 为 ["bash", "文件", "网络"]
  设 信息 为 ["名": "lightharness", "平台": "windows",
              "工作区根": "G:/dswork/duan-light-merge", "能力": 能力]
  返回 信息

段落 主:
  # 1. 未注入时：内核返回空（不探测、不编造）
  断言相等(宿主名核心(), "", "未注入时宿主名应为空串")
  断言相等(平台核心(), "", "未注入时平台应为空串")
  断言相等(工作区根核心(), "", "未注入时工作区根应为空串")
  断言相等(长(能力声明核心()), 0, "未注入时能力应为空列表")

  # 2. 未注入时：工具层全部报错
  设 注册表0 为 新建 工具注册表()
  挂载(注册表0)
  设 空参 为 ["占位": "x"]
  设 出0 为 注册表0.登记表["宿主名称"]["execute"](空参)
  断言为真(出0["isError"], "未注入时 宿主名称 应报错")
  设 出0b 为 注册表0.登记表["宿主能力声明"]["execute"](空参)
  断言为真(出0b["isError"], "未注入时 宿主能力声明 应报错")

  # 3. 注入宿主信息
  断言为真(注入宿主信息(桩信息), "注入宿主信息应成功")
  断言相等(宿主名核心(), "lightharness", "宿主名应来自注入")
  断言相等(平台核心(), "windows", "平台应来自注入")
  断言相等(工作区根核心(), "G:/dswork/duan-light-merge", "工作区根应来自注入")
  断言相等(长(能力声明核心()), 3, "能力应含 3 项")
  断言相等(能力声明核心()[0], "bash", "第一项能力应为 bash")

  # 4. 缺字段时返回空（不报错、不编造）
  断言相等(取字段("不存在的字段"), "", "缺字段应返回空串")

  # 5. 摘要
  设 摘要 为 摘要核心()
  断言相等(摘要["名"], "lightharness", "摘要名应一致")
  断言相等(摘要["能力数"], 3, "摘要能力数应为 3")

  # 6. 注入后：4 个工具全部可用
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("宿主名称"), "宿主名称 应注册")
  断言为真(注册表.登记表.包含("宿主平台"), "宿主平台 应注册")
  断言为真(注册表.登记表.包含("宿主工作区根"), "宿主工作区根 应注册")
  断言为真(注册表.登记表.包含("宿主能力声明"), "宿主能力声明 应注册")

  设 出1 为 注册表.登记表["宿主名称"]["execute"](空参)
  断言为假(出1["isError"], "注入后 宿主名称 不应报错")
  设 出2 为 注册表.登记表["宿主平台"]["execute"](空参)
  断言为假(出2["isError"], "注入后 宿主平台 不应报错")
  设 出3 为 注册表.登记表["宿主工作区根"]["execute"](空参)
  断言为假(出3["isError"], "注入后 宿主工作区根 不应报错")
  设 出4 为 注册表.登记表["宿主能力声明"]["execute"](空参)
  断言为假(出4["isError"], "注入后 宿主能力声明 不应报错")

  打印 "测试_宿主桥接 全部通过"

主()
