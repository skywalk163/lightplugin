# 宿主桥接.light —— 对标 dsh packages/host
#
# 设计：**门面插件**，不重实现任何宿主逻辑。
# 宿主信息（名 / 平台 / 工作区根 / 能力声明）由宿主注入的一个信息函数提供，
# 本插件只做「取值 + 成行 + 未注入即报错」。零平台探测、零环境变量读取。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 信息源 为 空                  # 宿主注入：()->信息字典（名/平台/工作区根/能力）

段落 注入宿主信息(函数):
  全局 信息源。
  信息源 为 函数
  返回 真

# ---------- 内核 ----------
段落 取字段(键):
  如果 信息源 == 空:
    返回 ""
  设 信息 为 信息源()
  如果 信息 == 空:
    返回 ""
  如果 信息.包含(键) == 假:
    返回 ""
  返回 字符串(信息[键])

段落 宿主名核心():
  返回 取字段("名")

段落 平台核心():
  返回 取字段("平台")

段落 工作区根核心():
  返回 取字段("工作区根")

段落 能力声明核心():
  如果 信息源 == 空:
    返回 []
  设 信息 为 信息源()
  如果 信息 == 空:
    返回 []
  如果 信息.包含("能力") == 假:
    返回 []
  设 能力 为 信息["能力"]
  设 结果 为 []
  遍历 项 之 能力:
    结果.追加(字符串(项))
  返回 结果

段落 摘要核心():
  设 结果 为 ["名": 宿主名核心(), "平台": 平台核心(),
              "工作区根": 工作区根核心(), "能力数": 长(能力声明核心())]
  返回 结果

# ---------- 工具 ----------
段落 名模式():
  返回 ["type": "object", "properties": {}]

段落 名处理(参数):
  设 值 为 宿主名核心()
  如果 值 == "":
    返回 造工具结果("未注入宿主信息函数（或缺少『名』字段）", 真)
  返回 造工具结果("宿主名: " + 值, 假)

段落 平台模式():
  返回 ["type": "object", "properties": {}]

段落 平台处理(参数):
  设 值 为 平台核心()
  如果 值 == "":
    返回 造工具结果("未注入宿主信息函数（或缺少『平台』字段）", 真)
  返回 造工具结果("宿主平台: " + 值, 假)

段落 根模式():
  返回 ["type": "object", "properties": {}]

段落 根处理(参数):
  设 值 为 工作区根核心()
  如果 值 == "":
    返回 造工具结果("未注入宿主信息函数（或缺少『工作区根』字段）", 真)
  返回 造工具结果("工作区根: " + 值, 假)

段落 能力模式():
  返回 ["type": "object", "properties": {}]

段落 能力处理(参数):
  设 能力 为 能力声明核心()
  如果 长(能力) == 0:
    返回 造工具结果("未注入宿主信息函数（或『能力』为空）", 真)
  返回 造工具结果("宿主能力(" + 字符串(长(能力)) + "): " + 连接字符串(能力, ", "), 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("宿主名称", "查询宿主名称（走注入式宿主信息）", 名模式(), 名处理))
  注册表.注册(造工具定义("宿主平台", "查询宿主运行平台", 平台模式(), 平台处理))
  注册表.注册(造工具定义("宿主工作区根", "查询宿主工作区根路径", 根模式(), 根处理))
  注册表.注册(造工具定义("宿主能力声明", "列出宿主声明的能力清单", 能力模式(), 能力处理))
  返回 真

导出 注入宿主信息
导出 取字段
导出 宿主名核心
导出 平台核心
导出 工作区根核心
导出 能力声明核心
导出 摘要核心
导出 挂载
