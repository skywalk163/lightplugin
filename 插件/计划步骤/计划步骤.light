# 计划步骤.light —— 对标 dsh packages/plan
#
# 设计：计划步骤表（id -> {描述, 状态, 依赖序}），状态机：
#   待开始 -> 进行中 -> 已完成；任一阶段可 -> 阻塞(原因)。
# 与 待办清单 区别：待办是平列表，计划是有依赖顺序与阻塞态的步骤图。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 步骤表 为 {}
设 下一号 为 1
设 持久写 为 空

段落 注入持久化(写):
  全局 持久写。
  持久写 为 写
  返回 真

段落 持久化():
  如果 持久写 != 空:
    持久写(步骤表)
  返回 真

段落 添加核心(描述):
  全局 下一号。
  如果 描述 == "":
    返回 -1
  设 id 为 字符串(下一号)
  设 记录 为 ["描述": 描述, "状态": "待开始", "阻塞原因": ""]
  步骤表[id] 为 记录
  下一号 为 下一号 + 1
  持久化()
  返回 下一号 - 1

段落 开始核心(id):
  如果 步骤表.包含(id) == 假:
    返回 "不存在"
  如果 步骤表[id]["状态"] == "已完成":
    返回 "已完成不可重开"
  步骤表[id]["状态"] 为 "进行中"
  持久化()
  返回 "确定"

段落 完成核心(id):
  如果 步骤表.包含(id) == 假:
    返回 "不存在"
  步骤表[id]["状态"] 为 "已完成"
  步骤表[id]["阻塞原因"] 为 ""
  持久化()
  返回 "确定"

段落 阻塞核心(id, 原因):
  如果 步骤表.包含(id) == 假:
    返回 "不存在"
  步骤表[id]["状态"] 为 "阻塞"
  步骤表[id]["阻塞原因"] 为 原因
  持久化()
  返回 "确定"

段落 列出核心(只未完成):
  设 键们 为 字典键列表(步骤表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 步骤表[键]
    如果 只未完成 == 假 或 项["状态"] != "已完成":
      设 行 为 "[" + 键 + "] " + 项["描述"] + " [" + 项["状态"] + "]"
      如果 项["状态"] == "阻塞":
        行 为 行 + " 原因=" + 项["阻塞原因"]
      结果.追加(行)
  返回 结果

# ---- 工具 ----
段落 创建模式():
  返回 ["type": "object",
        "properties": ["描述": ["type": "string", "description": "步骤描述"]],
        "required": ["描述"]]

段落 创建处理(参数):
  设 描述 为 参数["描述"]
  设 n 为 添加核心(描述)
  如果 n < 0:
    返回 造工具结果("步骤描述不可为空", 真)
  返回 造工具结果("已创建步骤 #" + 字符串(n) + ": " + 描述, 假)

段落 开始模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "步骤编号"]],
        "required": ["编号"]]

段落 开始处理(参数):
  设 r 为 开始核心(参数["编号"])
  如果 r != "确定":
    返回 造工具结果("开始失败: " + r, 真)
  返回 造工具结果("步骤 #" + 参数["编号"] + " 进入进行中", 假)

段落 完成模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "步骤编号"]],
        "required": ["编号"]]

段落 完成处理(参数):
  设 r 为 完成核心(参数["编号"])
  如果 r != "确定":
    返回 造工具结果("完成失败: " + r, 真)
  返回 造工具结果("步骤 #" + 参数["编号"] + " 已完成", 假)

段落 阻塞模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "步骤编号"],
                       "原因": ["type": "string", "description": "阻塞原因"]],
        "required": ["编号", "原因"]]

段落 阻塞处理(参数):
  设 r 为 阻塞核心(参数["编号"], 参数["原因"])
  如果 r != "确定":
    返回 造工具结果("阻塞失败: " + r, 真)
  返回 造工具结果("步骤 #" + 参数["编号"] + " 标记阻塞: " + 参数["原因"], 假)

段落 列出模式():
  返回 ["type": "object",
        "properties": ["只未完成": ["type": "boolean", "description": "真=只列未完成"]]]

段落 列出处理(参数):
  设 只未 为 假
  如果 参数.包含("只未完成"):
    只未 为 参数["只未完成"]
  设 行们 为 列出核心(只未)
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("计划创建", "新增一条计划步骤", 创建模式(), 创建处理))
  注册表.注册(造工具定义("计划开始", "把步骤标记为进行中", 开始模式(), 开始处理))
  注册表.注册(造工具定义("计划完成", "把步骤标记为已完成", 完成模式(), 完成处理))
  注册表.注册(造工具定义("计划阻塞", "把步骤标记为阻塞并记录原因", 阻塞模式(), 阻塞处理))
  注册表.注册(造工具定义("计划列出", "列出计划步骤（可只看未完成）", 列出模式(), 列出处理))
  返回 真

导出 注入持久化
导出 添加核心
导出 开始核心
导出 完成核心
导出 阻塞核心
导出 列出核心
导出 挂载
