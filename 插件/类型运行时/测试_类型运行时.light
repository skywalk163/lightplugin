# 测试_类型运行时.light —— P8 类型运行时 的正例与反例
#
# 全纯逻辑 + 注入式转换器 → 零网络、零磁盘、零墙上时钟。
# 断言失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。

从 类型运行时 导入 判定类型, 类型合法, 是纯数字串, 是浮点串, 校验结构, 转换字段, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言含于(大串, 子串, 标签):
  如果 包含(大串, 子串) == 假:
    抛出 新建 错误("断言含于失败 [" + 标签 + "]: 未含 " + 子串)

# ---- 注入式转换器：宿主覆盖规则（这里一律把值变成字符串 "已转换"）----
段落 假转换器(值, 目标类型):
  返回 ["ok": 真, "值": "已转换->" + 字符串(目标类型), "原因": ""]

段落 坏转换器(值, 目标类型):
  返回 ["ok": 假, "值": 空, "原因": "转换器拒绝"]

段落 主:
  # ---- 1. 类型判定：七类正例 ----
  断言相等(判定类型(空), "空", "空值")
  断言相等(判定类型(42), "整数", "整数")
  断言相等(判定类型(0), "整数", "0 应是整数而不是真假")
  断言相等(判定类型(1.5), "浮点", "浮点")
  断言相等(判定类型("甲"), "文本", "文本")
  断言相等(判定类型(真), "真假", "真")
  断言相等(判定类型(假), "真假", "假")
  设 列表样本 为 ["甲", "乙"]
  断言相等(判定类型(列表样本), "列表", "列表")
  设 映射样本 为 ["甲": 1]
  断言相等(判定类型(映射样本), "映射", "映射")

  # ---- 2. 类型合法判定 ----
  断言为真(类型合法("整数"), "整数 是合法类型名")
  断言为真(类型合法("任意"), "任意 是合法类型名")
  断言为假(类型合法("复数"), "复数 不是合法类型名")

  # ---- 3. 字符串守卫 ----
  断言为真(是纯数字串("123"), "123 是纯数字串")
  断言为真(是纯数字串("0"), "0 是纯数字串")
  断言为假(是纯数字串("12a"), "12a 不是纯数字串")
  断言为假(是纯数字串(""), "空串不是纯数字串")
  断言为假(是纯数字串("-1"), "负号不算纯数字串")
  断言为真(是浮点串("1.5"), "1.5 是浮点串")
  断言为真(是浮点串("123"), "纯整数也可转浮点")
  断言为假(是浮点串("1.2.3"), "两个小数点不是浮点串")
  断言为假(是浮点串("abc"), "字母不是浮点串")

  # ---- 4. 结构校验：全命中 ----
  设 声明1 为 ["名字": "甲", "类型": "整数", "必填": 真]
  设 声明2 为 ["名字": "乙", "类型": "文本", "必填": 真]
  设 声明3 为 ["名字": "丙", "类型": "列表", "必填": 假]
  设 字段表 为 [声明1, 声明2, 声明3]
  设 目标 为 ["甲": 1, "乙": "x", "丙": 列表样本]
  设 结果 为 校验结构(目标, 字段表)
  断言为真(结果["ok"], "全命中时应通过")
  断言相等(结果["原因"], "", "通过时无原因")
  断言相等(长(结果["缺失"]), 0, "通过时无缺失")
  断言相等(长(结果["不符"]), 0, "通过时无不符")

  # ---- 5. 结构校验：可选字段缺失不算错 ----
  设 目标2 为 ["甲": 1, "乙": "x"]
  设 结果2 为 校验结构(目标2, 字段表)
  断言为真(结果2["ok"], "可选字段缺失应通过")
  断言相等(长(结果2["缺失"]), 0, "可选字段缺失不计入缺失")

  # ---- 6. 结构校验：反例 —— 必填缺失 ----
  设 目标3 为 ["乙": "x"]
  设 结果3 为 校验结构(目标3, 字段表)
  断言为假(结果3["ok"], "必填缺失应失败")
  断言含于(结果3["原因"], "缺少必填字段", "必填缺失的原因前缀")
  断言含于(结果3["原因"], "甲", "必填缺失应点名甲")
  断言相等(长(结果3["缺失"]), 1, "缺失表应有 1 项")
  断言相等(结果3["缺失"][0], "甲", "缺失表首项应是甲")

  # ---- 7. 结构校验：反例 —— 类型不符 ----
  设 目标4 为 ["甲": "不是整数", "乙": "x"]
  设 结果4 为 校验结构(目标4, 字段表)
  断言为假(结果4["ok"], "类型不符应失败")
  断言含于(结果4["原因"], "字段类型不符", "类型不符的原因前缀")
  断言含于(结果4["原因"], "甲", "类型不符应点名甲")
  断言相等(长(结果4["不符"]), 1, "不符表应有 1 项")

  # ---- 8. 结构校验：一次收集全部问题（不只报第一个）----
  设 目标5 为 ["甲": "串", "乙": 1]
  设 结果5 为 校验结构(目标5, 字段表)
  断言为假(结果5["ok"], "多问题时仍应失败")
  断言相等(长(结果5["不符"]), 2, "应收集到 2 处类型不符")

  # ---- 9. 结构校验：任意类型放行 ----
  设 声明任 为 ["名字": "甲", "类型": "任意", "必填": 真]
  设 字段表任 为 [声明任]
  设 目标任 为 ["甲": 列表样本]
  断言为真(校验结构(目标任, 字段表任)["ok"], "任意 类型应放行任意值")

  # ---- 10. 结构校验：反例 —— 目标不是映射 ----
  设 结果6 为 校验结构("我不是映射", 字段表)
  断言为假(结果6["ok"], "非映射目标应失败")
  断言含于(结果6["原因"], "待校验值不是映射", "非映射目标的原因")

  # ---- 11. 结构校验：反例 —— 字段表不是列表 ----
  设 结果7 为 校验结构(目标, "我不是列表")
  断言为假(结果7["ok"], "字段表非列表应失败")
  断言含于(结果7["原因"], "字段表不是列表", "字段表非列表的原因")

  # ---- 12. 字段转换：文本化 ----
  断言相等(转换字段(42, "文本")["值"], "42", "整数转文本")
  断言相等(转换字段(1.5, "文本")["值"], "1.5", "浮点转文本")
  断言相等(转换字段(真, "文本")["值"], "True", "真假转文本")
  断言为真(转换字段(42, "文本")["ok"], "转文本应成功")

  # ---- 13. 字段转换：转整数 ----
  断言相等(转换字段("42", "整数")["值"], 42, "数字串转整数")
  断言相等(转换字段("007", "整数")["值"], 7, "前导零串转整数")
  断言相等(转换字段(7, "整数")["值"], 7, "整数转整数应原样")
  断言相等(转换字段(7.9, "整数")["值"], 7, "浮点转整数应截断")
  设 坏整 为 转换字段("abc", "整数")
  断言为假(坏整["ok"], "非数字串转整数应失败")
  断言含于(坏整["原因"], "无法把文本转为整数", "非数字串转整数的原因")
  设 坏整2 为 转换字段(列表样本, "整数")
  断言为假(坏整2["ok"], "列表转整数应失败")

  # ---- 14. 字段转换：转浮点 ----
  断言相等(转换字段("1.5", "浮点")["值"], 1.5, "浮点串转浮点")
  断言相等(转换字段(3, "浮点")["值"], 3.0, "整数转浮点")
  断言相等(转换字段(2.5, "浮点")["值"], 2.5, "浮点转浮点应原样")
  设 坏浮 为 转换字段("abc", "浮点")
  断言为假(坏浮["ok"], "非数字串转浮点应失败")

  # ---- 15. 字段转换：转真假 ----
  断言相等(转换字段(真, "真假")["值"], 真, "真转真假")
  断言相等(转换字段("真", "真假")["值"], 真, "文本真转真假")
  断言相等(转换字段("假", "真假")["值"], 假, "文本假转真假")
  设 坏真 为 转换字段("也许", "真假")
  断言为假(坏真["ok"], "无法转换的文本应失败")

  # ---- 16. 字段转换：反例 —— 不支持的目标类型 ----
  设 坏类 为 转换字段(1, "复数")
  断言为假(坏类["ok"], "不支持的目标类型应失败")
  断言含于(坏类["原因"], "不支持的目标类型", "不支持类型的原因")

  # ---- 17. 字段转换：注入转换器优先 ----
  设 转后 为 转换字段(42, "整数", 假转换器)
  断言为真(转后["ok"], "注入转换器时应按转换器结果")
  断言相等(转后["值"], "已转换->整数", "转换器应覆盖内置规则")
  设 拒 为 转换字段(42, "整数", 坏转换器)
  断言为假(拒["ok"], "转换器拒绝时应失败")
  断言相等(拒["原因"], "转换器拒绝", "转换器拒绝的原因应透传")

  # ---- 18. 挂载进注册表并端到端执行 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("判定类型"), "判定类型应已注册")
  断言为真(注册表.登记表.包含("校验结构"), "校验结构应已注册")

  # 18a. 判定类型（正例）
  设 判定义 为 注册表.登记表["判定类型"]
  设 整参 为 ["值": 42]
  断言相等(判定义["execute"](整参)["content"], "整数", "工具判定整数")
  设 串参 为 ["值": "甲"]
  断言相等(判定义["execute"](串参)["content"], "文本", "工具判定文本")
  设 真参 为 ["值": 真]
  断言相等(判定义["execute"](真参)["content"], "真假", "工具判定真假")
  设 空参值 为 ["值": 空]
  断言相等(判定义["execute"](空参值)["content"], "空", "工具判定空")

  # 18b. 判定类型（反例：缺字段）
  设 缺参 为 {}
  断言为真(判定义["execute"](缺参)["isError"], "缺值字段应报错")

  # 18c. 校验结构（正例）
  设 校定义 为 注册表.登记表["校验结构"]
  设 校参 为 ["目标": 目标, "字段表": 字段表]
  设 校产出 为 校定义["execute"](校参)
  断言为假(校产出["isError"], "合法结构不应报错")
  断言相等(校产出["content"], "结构校验通过", "通过时的返回内容")

  # 18d. 校验结构（反例：必填缺失）
  设 缺校参 为 ["目标": 目标3, "字段表": 字段表]
  设 缺校产出 为 校定义["execute"](缺校参)
  断言为真(缺校产出["isError"], "必填缺失应报错")
  断言含于(缺校产出["content"], "缺少必填字段", "必填缺失的报错内容")

  # 18e. 校验结构（反例：类型不符）
  设 错校参 为 ["目标": 目标4, "字段表": 字段表]
  设 错校产出 为 校定义["execute"](错校参)
  断言为真(错校产出["isError"], "类型不符应报错")
  断言含于(错校产出["content"], "字段类型不符", "类型不符的报错内容")

  # 18f. 校验结构（反例：缺字段表 / 缺目标）
  设 只目标 为 ["目标": 目标]
  断言为真(校定义["execute"](只目标)["isError"], "缺字段表应报错")
  设 只字段 为 ["字段表": 字段表]
  断言为真(校定义["execute"](只字段)["isError"], "缺目标应报错")

  打印 "测试_类型运行时 全部通过"

主()
