# 目标管理.light —— 对标 dsh packages/goal
#
# 设计：目标树（id -> {描述, 进度0-100, 父id, 子id列表, 完成}）。
# 与 计划步骤 区别：计划是线性步骤状态机，目标是树状进度分解。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 目标表 为 {}
设 下一号 为 1

段落 添加核心(描述, 父id):
  全局 下一号。
  如果 描述 == "":
    返回 -1
  设 id 为 字符串(下一号)
  设 记录 为 ["描述": 描述, "进度": 0, "父": 父id, "子": [], "完成": 假]
  目标表[id] 为 记录
  如果 父id != "" 且 目标表.包含(父id):
    目标表[父id]["子"].追加(id)
  下一号 为 下一号 + 1
  返回 下一号 - 1

段落 推进核心(id, 进度):
  如果 目标表.包含(id) == 假:
    返回 "不存在"
  如果 进度 < 0:
    进度 为 0
  如果 进度 > 100:
    进度 为 100
  目标表[id]["进度"] 为 进度
  如果 进度 >= 100:
    目标表[id]["完成"] 为 真
  否则:
    目标表[id]["完成"] 为 假
  返回 "确定"

段落 列出核心():
  设 键们 为 字典键列表(目标表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 目标表[键]
    设 行 为 "[" + 键 + "] " + 项["描述"] + " 进度=" + 字符串(项["进度"]) + "%"
    如果 项["父"] != "":
      行 为 行 + " (父=" + 项["父"] + ")"
    如果 项["完成"] == 真:
      行 为 行 + " [完成]"
    结果.追加(行)
  返回 结果

# ---- 工具 ----
段落 创建模式():
  返回 ["type": "object",
        "properties": ["描述": ["type": "string", "description": "目标描述"],
                       "父id": ["type": "string", "description": "父目标 id（空串=顶层）"]],
        "required": ["描述"]]

段落 创建处理(参数):
  设 父 为 ""
  如果 参数.包含("父id"):
    父 为 参数["父id"]
  设 n 为 添加核心(参数["描述"], 父)
  如果 n < 0:
    返回 造工具结果("目标描述不可为空", 真)
  返回 造工具结果("已创建目标 #" + 字符串(n), 假)

段落 推进模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "目标 id"],
                       "进度": ["type": "number", "description": "0-100"]],
        "required": ["编号", "进度"]]

段落 推进处理(参数):
  设 r 为 推进核心(参数["编号"], 参数["进度"])
  如果 r != "确定":
    返回 造工具结果("推进失败: " + r, 真)
  返回 造工具结果("目标 #" + 参数["编号"] + " 进度更新为 " + 字符串(参数["进度"]) + "%", 假)

段落 列出模式():
  返回 ["type": "object", "properties": {}]

段落 列出处理(参数):
  设 行们 为 列出核心()
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("目标创建", "新增一个目标（可挂到父目标下）", 创建模式(), 创建处理))
  注册表.注册(造工具定义("目标推进", "更新目标进度（0-100，100=完成）", 推进模式(), 推进处理))
  注册表.注册(造工具定义("目标列出", "列出全部目标及进度", 列出模式(), 列出处理))
  返回 真

导出 添加核心
导出 推进核心
导出 列出核心
导出 挂载
