# 运行时PTC.light —— dsh packages/ptc-runtime 的光明复刻（P8 第 9 批）
#
# 能力：运行时执行上下文 —— 任务槽登记/释放、资源账累计、生命周期推进。
#
# 设计取舍：**不起真实进程**。
#   槽内任务的执行委托给**注入式执行器**（宿主接真实运行时，测试接确定性假执行器），
#   因此单测零进程、零网络、零计时 flaky；容量上限等边界可被精确断言。
#
# 生命周期：已登记 → 运行中 → 已完成 / 已失败（后两者为终态）；释放后进入 已释放。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作实参 → 一律先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 命名避开（用 负载/内容/摘要）。
#   LP-D-013 变量不要命名为「出」（`出.追加(...)` 报无法识别的 '.'）→ 用 结果表/收集表。
#   模块级标量（槽序号）写回必须在段落体内先 `全局 槽序号。`。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 去空格
从 内置核心字典 导入 字典键列表

设 槽表 为 {}
设 配置 为 ["容量": 4]
设 账本 为 ["在用资源": 0, "累计资源": 0, "峰值资源": 0, "登记次数": 0, "释放次数": 0]
设 生命周期表 为 {}
设 槽序号 为 0
设 默认执行器 为 空

# ---------- 生命周期 ----------
段落 判定终态阶段(阶段):
  设 终态集 为 ["已完成": 真, "已失败": 真, "已释放": 真]
  返回 终态集.包含(阶段)

段落 合法推进表():
  返回 ["已登记": ["运行中"],
        "运行中": ["已完成", "已失败"]]

段落 判定合法推进(当前阶段, 目标阶段):
  设 表 为 合法推进表()
  如果 表.包含(当前阶段) == 假:
    返回 假
  如果 当前阶段 == 目标阶段:
    返回 假
  返回 表[当前阶段].包含(目标阶段)

段落 推进生命周期(槽号, 目标阶段):
  如果 槽表.包含(槽号) == 假:
    返回 ["ok": 假, "原因": "槽号不存在", "旧阶段": "", "新阶段": ""]
  设 记录 为 槽表[槽号]
  设 旧阶段 为 记录["阶段"]
  如果 判定合法推进(旧阶段, 目标阶段) == 假:
    返回 ["ok": 假, "原因": "非法推进: " + 旧阶段 + " -> " + 目标阶段, "旧阶段": 旧阶段, "新阶段": 旧阶段]
  记录["阶段"] 为 目标阶段
  生命周期表[槽号] 为 目标阶段
  返回 ["ok": 真, "原因": "", "旧阶段": 旧阶段, "新阶段": 目标阶段]

# ---------- 容量 ----------
段落 取容量():
  返回 配置["容量"]

段落 设置容量(新容量):
  如果 新容量 < 1:
    返回 假
  配置["容量"] 为 新容量
  返回 真

段落 在用槽数():
  返回 长(字典键列表(槽表))

# ---------- 任务槽登记 / 释放 ----------
段落 登记任务槽(任务名, 资源=1):
  全局 槽序号。
  设 紧凑 为 去空格(任务名)
  如果 紧凑 == "":
    返回 ["ok": 假, "原因": "任务名为空", "槽号": ""]
  如果 资源 < 0:
    返回 ["ok": 假, "原因": "资源需求非法", "槽号": ""]
  如果 在用槽数() >= 配置["容量"]:
    返回 ["ok": 假, "原因": "容量已满", "槽号": ""]
  槽序号 为 槽序号 + 1
  设 槽号 为 "SLOT-" + 字符串(槽序号)
  设 记录 为 ["槽号": 槽号, "任务名": 紧凑, "资源": 资源, "阶段": "已登记"]
  槽表[槽号] 为 记录
  生命周期表[槽号] 为 "已登记"
  账本["在用资源"] 为 账本["在用资源"] + 资源
  账本["累计资源"] 为 账本["累计资源"] + 资源
  账本["登记次数"] 为 账本["登记次数"] + 1
  如果 账本["在用资源"] > 账本["峰值资源"]:
    账本["峰值资源"] 为 账本["在用资源"]
  返回 ["ok": 真, "原因": "", "槽号": 槽号]

段落 取槽(槽号):
  如果 槽表.包含(槽号) == 假:
    返回 空
  返回 槽表[槽号]

段落 槽号列表():
  返回 字典键列表(槽表)

段落 释放任务槽(槽号):
  如果 槽表.包含(槽号) == 假:
    返回 ["ok": 假, "原因": "槽号不存在", "槽号": 槽号, "资源": 0]
  设 记录 为 槽表[槽号]
  设 资源 为 记录["资源"]
  槽表.弹出(槽号)
  生命周期表[槽号] 为 "已释放"
  账本["在用资源"] 为 账本["在用资源"] - 资源
  如果 账本["在用资源"] < 0:
    账本["在用资源"] 为 0
  账本["释放次数"] 为 账本["释放次数"] + 1
  返回 ["ok": 真, "原因": "", "槽号": 槽号, "资源": 资源]

段落 取资源账():
  返回 ["在用资源": 账本["在用资源"],
        "累计资源": 账本["累计资源"],
        "峰值资源": 账本["峰值资源"],
        "登记次数": 账本["登记次数"],
        "释放次数": 账本["释放次数"]]

段落 取生命周期(槽号):
  如果 生命周期表.包含(槽号) == 假:
    返回 ""
  返回 生命周期表[槽号]

# ---------- 注入式执行器 ----------
段落 设置执行器(执行器):
  全局 默认执行器。
  默认执行器 为 执行器
  返回 真

段落 执行槽内任务(槽号, 执行器):
  全局 默认执行器。
  设 实际器 为 执行器
  如果 实际器 == 空:
    实际器 为 默认执行器
  如果 实际器 == 空:
    返回 ["ok": 假, "原因": "未注入执行器", "产出": ""]
  如果 槽表.包含(槽号) == 假:
    返回 ["ok": 假, "原因": "槽号不存在", "产出": ""]
  设 记录 为 槽表[槽号]
  如果 判定终态阶段(记录["阶段"]) == 真:
    返回 ["ok": 假, "原因": "槽位已处于终态: " + 记录["阶段"], "产出": ""]
  推进生命周期(槽号, "运行中")
  设 产出 为 实际器(记录)
  返回 ["ok": 真, "原因": "", "产出": 产出]

# ---------- 模型可见工具 ----------
段落 登记任务槽模式():
  返回 ["type": "object",
        "properties": ["任务名": ["type": "string", "description": "要登记的任务名，必填"],
                       "资源": ["type": "integer", "description": "任务占用的资源额度，默认 1"]],
        "required": ["任务名"]]

段落 登记任务槽处理(参数):
  设 资源 为 1
  如果 参数.包含("资源") == 真:
    资源 为 参数["资源"]
  设 登记 为 登记任务槽(参数["任务名"], 资源)
  如果 登记["ok"] == 假:
    返回 造工具结果("登记失败: " + 登记["原因"], 真)
  设 记录 为 取槽(登记["槽号"])
  设 摘要 为 "已登记槽位 " + 记录["槽号"] + " 任务=" + 记录["任务名"] + " 资源=" + 字符串(记录["资源"]) + " 阶段=" + 记录["阶段"]
  返回 造工具结果(摘要, 假)

段落 释放任务槽模式():
  返回 ["type": "object",
        "properties": ["槽号": ["type": "string", "description": "要释放的槽号，形如 SLOT-1"]],
        "required": ["槽号"]]

段落 释放任务槽处理(参数):
  设 释放 为 释放任务槽(参数["槽号"])
  如果 释放["ok"] == 假:
    返回 造工具结果("释放失败: " + 释放["原因"], 真)
  设 摘要 为 "已释放槽位 " + 释放["槽号"] + " 归还资源=" + 字符串(释放["资源"]) + " 在用资源=" + 字符串(取资源账()["在用资源"])
  返回 造工具结果(摘要, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("登记任务槽", "在运行时上下文中登记一个任务槽并计入资源账", 登记任务槽模式(), 登记任务槽处理))
  注册表.注册(造工具定义("释放任务槽", "释放指定任务槽并把资源归还资源账", 释放任务槽模式(), 释放任务槽处理))
  返回 真

导出 判定终态阶段
导出 合法推进表
导出 判定合法推进
导出 推进生命周期
导出 取容量
导出 设置容量
导出 在用槽数
导出 登记任务槽
导出 取槽
导出 槽号列表
导出 释放任务槽
导出 取资源账
导出 取生命周期
导出 设置执行器
导出 执行槽内任务
导出 挂载
