# 测试_运行时PTC.light —— P8 运行时PTC 的正例与反例
#
# 零进程：槽内任务的执行委托给注入的确定性假执行器。

从 运行时PTC 导入 判定终态阶段, 判定合法推进, 推进生命周期, 取容量, 设置容量, 在用槽数, 登记任务槽, 取槽, 槽号列表, 释放任务槽, 取资源账, 取生命周期, 设置执行器, 执行槽内任务, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# ---- 确定性假执行器：不做任何真实执行，只回一段固定产出 ----
设 执行器调用次数 为 0

段落 假执行器(记录):
  全局 执行器调用次数。
  执行器调用次数 为 执行器调用次数 + 1
  返回 "RUN:" + 记录["槽号"] + ":" + 记录["任务名"]

段落 主:
  全局 执行器调用次数。

  # ---- 1. 容量默认值与设置 ----
  断言相等(取容量(), 4, "默认容量应为 4")
  断言为假(设置容量(0), "容量设为 0 应被拒")
  断言为真(设置容量(2), "容量设为 2 应成功")
  断言相等(取容量(), 2, "设置后容量")

  # ---- 2. 登记任务槽（正例） ----
  设 登1 为 登记任务槽("编译", 3)
  断言为真(登1["ok"], "首个登记应成功")
  断言相等(登1["槽号"], "SLOT-1", "首个槽号")
  断言相等(在用槽数(), 1, "在用槽数")
  断言相等(取槽("SLOT-1")["任务名"], "编译", "槽位任务名")
  断言相等(取槽("SLOT-1")["资源"], 3, "槽位资源")
  断言相等(取槽("SLOT-1")["阶段"], "已登记", "槽位初始阶段")

  # ---- 3. 反例：任务名为空 ----
  设 无名 为 登记任务槽("   ", 1)
  断言为假(无名["ok"], "空任务名应失败")
  断言相等(无名["原因"], "任务名为空", "空任务名原因")

  # ---- 4. 反例：资源需求非法 ----
  设 负资源 为 登记任务槽("异常任务", -1)
  断言为假(负资源["ok"], "负资源应失败")
  断言相等(负资源["原因"], "资源需求非法", "负资源原因")

  # ---- 5. 容量上限反例 ----
  设 登2 为 登记任务槽("测试", 2)
  断言为真(登2["ok"], "第二个登记应成功（容量 2）")
  断言相等(在用槽数(), 2, "在用槽数达上限")
  设 登3 为 登记任务槽("溢出", 1)
  断言为假(登3["ok"], "超出容量应失败")
  断言相等(登3["原因"], "容量已满", "容量已满原因")
  断言相等(在用槽数(), 2, "失败后槽数不变")

  # ---- 6. 资源账累计 ----
  设 账 为 取资源账()
  断言相等(账["在用资源"], 5, "在用资源应为 3+2")
  断言相等(账["累计资源"], 5, "累计资源")
  断言相等(账["峰值资源"], 5, "峰值资源")
  断言相等(账["登记次数"], 2, "登记次数")
  断言相等(账["释放次数"], 0, "释放次数")

  # ---- 7. 释放槽位：资源归还 ----
  设 释 为 释放任务槽("SLOT-1")
  断言为真(释["ok"], "释放应成功")
  断言相等(释["资源"], 3, "释放归还资源")
  断言相等(在用槽数(), 1, "释放后在用槽数")
  断言相等(取资源账()["在用资源"], 2, "释放后在用资源")
  断言相等(取资源账()["累计资源"], 5, "累计资源不因释放减少")
  断言相等(取资源账()["峰值资源"], 5, "峰值资源保留")
  断言相等(取资源账()["释放次数"], 1, "释放次数")

  # ---- 8. 反例：释放不存在的槽位 ----
  设 释坏 为 释放任务槽("SLOT-999")
  断言为假(释坏["ok"], "释放不存在槽位应失败")
  断言相等(释坏["原因"], "槽号不存在", "槽号不存在原因")

  # ---- 9. 反例：重复释放 ----
  断言为假(释放任务槽("SLOT-1")["ok"], "重复释放应失败")

  # ---- 10. 生命周期推进 ----
  断言为假(判定合法推进("已登记", "已完成"), "已登记→已完成 应非法")
  断言为真(判定合法推进("已登记", "运行中"), "已登记→运行中 应合法")
  断言为真(判定合法推进("运行中", "已完成"), "运行中→已完成 应合法")
  断言为假(判定合法推进("已完成", "运行中"), "终态不可再推进")
  设 推1 为 推进生命周期("SLOT-2", "运行中")
  断言为真(推1["ok"], "推进到运行中应成功")
  断言相等(取槽("SLOT-2")["阶段"], "运行中", "推进后阶段")
  设 推2 为 推进生命周期("SLOT-2", "已完成")
  断言为真(推2["ok"], "推进到已完成应成功")
  断言相等(取生命周期("SLOT-2"), "已完成", "生命周期表登记终态")
  设 推3 为 推进生命周期("SLOT-2", "已失败")
  断言为假(推3["ok"], "终态后不可再推进")
  断言相等(推3["原因"], "非法推进: 已完成 -> 已失败", "非法推进原因")

  # ---- 11. 反例：推进不存在的槽位 ----
  设 推坏 为 推进生命周期("SLOT-999", "运行中")
  断言为假(推坏["ok"], "推进不存在槽位应失败")
  断言相等(推坏["原因"], "槽号不存在", "推进不存在原因")

  # ---- 12. 终态判定 ----
  断言为真(判定终态阶段("已完成"), "已完成是终态")
  断言为真(判定终态阶段("已失败"), "已失败是终态")
  断言为真(判定终态阶段("已释放"), "已释放是终态")
  断言为假(判定终态阶段("运行中"), "运行中不是终态")

  # ---- 13. 释放后生命周期标记保留 ----
  释放任务槽("SLOT-2")
  断言相等(取生命周期("SLOT-2"), "已释放", "释放后生命周期标记为已释放")
  断言相等(取槽("SLOT-2"), 空, "释放后槽位记录已移除")

  # ---- 14. 反例：未注入执行器 ----
  设 无器 为 执行槽内任务("SLOT-3", 空)
  断言为假(无器["ok"], "未注入执行器时应失败")
  设 登4 为 登记任务槽("待执行", 1)
  断言为真(登4["ok"], "登记待执行任务")
  设 无器2 为 执行槽内任务(登4["槽号"], 空)
  断言为假(无器2["ok"], "未注入执行器时应失败")
  断言相等(无器2["原因"], "未注入执行器", "未注入执行器原因")

  # ---- 15. 注入执行器后执行槽内任务 ----
  执行器调用次数 为 0
  断言为真(设置执行器(假执行器), "设置执行器应返回真")
  设 跑 为 执行槽内任务(登4["槽号"], 空)
  断言为真(跑["ok"], "注入后执行应成功")
  断言相等(执行器调用次数, 1, "执行器应被调用一次")
  断言相等(跑["产出"], "RUN:SLOT-3:待执行", "执行产出内容")
  断言相等(取槽(登4["槽号"])["阶段"], "运行中", "执行后阶段推进为运行中")

  # ---- 16. 反例：终态槽位不可再执行 ----
  推进生命周期(登4["槽号"], "已完成")
  设 跑终 为 执行槽内任务(登4["槽号"], 空)
  断言为假(跑终["ok"], "终态槽位不应再执行")
  断言为真(包含(跑终["原因"], "终态"), "终态拒绝原因")

  # ---- 17. 反例：执行不存在的槽位 ----
  设 跑缺 为 执行槽内任务("SLOT-不存在", 假执行器)
  断言为假(跑缺["ok"], "不存在槽位不应执行")
  断言相等(跑缺["原因"], "槽号不存在", "不存在槽位原因")

  # ---- 18. 挂载进注册表并端到端执行 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("登记任务槽"), "登记任务槽应已注册")
  断言为真(注册表.登记表.包含("释放任务槽"), "释放任务槽应已注册")

  设 登记定义 为 注册表.登记表["登记任务槽"]
  设 入参 为 ["任务名": "部署", "资源": 2]
  设 产出 为 登记定义["execute"](入参)
  断言为假(产出["isError"], "合法登记不应报错")
  断言为真(包含(产出["content"], "已登记槽位"), "登记产出前缀")
  断言为真(包含(产出["content"], "任务=部署"), "登记产出应含任务名")

  设 坏参 为 ["任务名": ""]
  设 坏产出 为 登记定义["execute"](坏参)
  断言为真(坏产出["isError"], "空任务名登记应报错")
  断言为真(包含(坏产出["content"], "任务名为空"), "空任务名报错原因")

  设 释放定义 为 注册表.登记表["释放任务槽"]
  设 释参 为 ["槽号": "SLOT-4"]
  设 释产出 为 释放定义["execute"](释参)
  断言为假(释产出["isError"], "合法释放不应报错")
  断言为真(包含(释产出["content"], "已释放槽位 SLOT-4"), "释放产出内容")

  设 坏释参 为 ["槽号": "SLOT-999"]
  设 坏释产出 为 释放定义["execute"](坏释参)
  断言为真(坏释产出["isError"], "释放不存在槽位应报错")

  打印 "测试_运行时PTC 全部通过"

主()
