# 开发工具包.light —— dsh packages/sdk 的光明复刻（P8）
#
# 定位：SDK 门面。做两件事——
#   1) 能力发现：向宿主问「你有哪些工具」，返回能力清单；
#   2) 调用封装：给定能力名 + 参数，转交宿主并把**千奇百怪的返回**归一成统一形状。
#
# 设计取舍：**宿主注入式**。
#   列能力器 / 调能力器 都由外部注入（宿主可接真实工具注册表，测试注入确定性 fake），
#   因此本模块零网络、零进程、零墙上时钟依赖。
#   宿主能力发现失败（未装载 / 返回物不是列表）一律走「软失败」：ok=假 且给出原因，不抛异常。
#
# 结果归一的三类输入（宿主极不统一，这里统一收口）：
#   空            → ok=假, 是否错误=真, 原因="宿主返回空"
#   字典          → 取 content（兼容「内容」）/ isError（兼容「是否错误」）
#   其它（字符串等）→ ok=真, 内容=字符串(原始)
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作函数实参 → 一律先赋变量再传；空列表也先赋变量。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块命名一律避开（用 内容/名字/原因）。
#   LP-D-013 变量不要命名为「出」→ 用 收集表/名字表。
#   LP-D-010 遍历变量名不与被调用函数同名 → 用 项/条目。
#   模块级只放字典（元素赋值天然共享），标量序号不用，故无需「全局」声明。

从 工具 导入 造工具定义, 造工具结果
从 字符串处理 导入 子串位置

# ---------- 宿主注入 ----------
设 宿主表 为 {}

段落 装载宿主(列能力, 调能力):
  宿主表["列能力"] 为 列能力
  宿主表["调能力"] 为 调能力
  返回 真

段落 卸载宿主():
  如果 宿主表.包含("列能力") == 真:
    宿主表.弹出("列能力")
  如果 宿主表.包含("调能力") == 真:
    宿主表.弹出("调能力")
  返回 真

段落 宿主已装载():
  如果 宿主表.包含("列能力") == 假:
    返回 假
  如果 宿主表.包含("调能力") == 假:
    返回 假
  返回 真

# ---------- 能力发现 ----------
段落 造空清单(原因):
  设 空表 为 []
  返回 ["ok": 假, "原因": 原因, "能力": 空表, "数量": 0]

段落 能力清单():
  如果 宿主已装载() == 假:
    返回 造空清单("宿主未装载")
  设 名字表 为 宿主表["列能力"]()
  如果 是列表(名字表) == 假:
    返回 造空清单("宿主返回的能力清单不是列表")
  返回 ["ok": 真, "原因": "", "能力": 名字表, "数量": 长(名字表)]

段落 有此能力(名字):
  设 清单 为 能力清单()
  如果 清单["ok"] == 假:
    返回 假
  设 名字表 为 清单["能力"]
  返回 名字表.包含(名字)

# ---------- 结果归一（SDK 的核心价值）----------
段落 取内容(原始):
  如果 原始.包含("content") == 真:
    返回 原始["content"]
  如果 原始.包含("内容") == 真:
    返回 原始["内容"]
  返回 字符串(原始)

段落 取是否错误(原始):
  如果 原始.包含("isError") == 真:
    返回 原始["isError"]
  如果 原始.包含("是否错误") == 真:
    返回 原始["是否错误"]
  返回 假

段落 造空结果(名字, 原因):
  返回 ["ok": 假, "名字": 名字, "是否错误": 真, "内容": "", "原因": 原因]

段落 归一结果(名字, 原始):
  如果 是空(原始) == 真:
    返回 造空结果(名字, "宿主返回空")
  如果 是字典(原始) == 假:
    返回 ["ok": 真, "名字": 名字, "是否错误": 假, "内容": 字符串(原始), "原因": ""]
  设 内容 为 取内容(原始)
  设 是否错误 为 取是否错误(原始)
  如果 是否错误 == 真:
    返回 ["ok": 假, "名字": 名字, "是否错误": 真, "内容": 内容, "原因": 内容]
  返回 ["ok": 真, "名字": 名字, "是否错误": 假, "内容": 内容, "原因": ""]

# ---------- 调用封装 ----------
段落 调用能力(名字, 参数):
  如果 宿主已装载() == 假:
    返回 造空结果(名字, "宿主未装载")
  设 清单 为 宿主表["列能力"]()
  如果 是列表(清单) == 假:
    返回 造空结果(名字, "宿主返回的能力清单不是列表")
  如果 清单.包含(名字) == 假:
    返回 造空结果(名字, "未知能力: " + 名字)
  设 原始 为 宿主表["调能力"](名字, 参数)
  返回 归一结果(名字, 原始)

# ---------- 模型可见工具 ----------
段落 列出能力模式():
  设 过滤字段 为 ["type": "string", "description": "只保留名字中含该子串的能力，可省略"]
  设 属性表 为 ["过滤": 过滤字段]
  设 必填 为 []
  返回 ["type": "object", "properties": 属性表, "required": 必填]

段落 列出能力处理(参数):
  设 清单 为 能力清单()
  如果 清单["ok"] == 假:
    返回 造工具结果("列能力失败: " + 清单["原因"], 真)
  设 名字表 为 清单["能力"]
  如果 参数.包含("过滤") == 真:
    设 过滤 为 参数["过滤"]
    如果 过滤 != "":
      设 收集表 为 []
      遍历 项 之 名字表:
        如果 子串位置(项, 过滤) >= 0:
          收集表.追加(项)
      设 名字表 为 收集表
  如果 长(名字表) == 0:
    返回 造工具结果("没有匹配的能力（共 " + 字符串(清单["数量"]) + " 项已注册）", 假)
  设 名字串 为 连接字符串(名字表, ", ")
  返回 造工具结果("共 " + 字符串(长(名字表)) + " 项能力: " + 名字串, 假)

段落 调用能力模式():
  设 名字字段 为 ["type": "string", "description": "要调用的能力名，须出现在能力清单中"]
  设 参数字段 为 ["type": "object", "description": "传给该能力的参数映射，可省略"]
  设 属性表 为 ["名字": 名字字段, "参数": 参数字段]
  设 必填 为 ["名字"]
  返回 ["type": "object", "properties": 属性表, "required": 必填]

段落 调用能力处理(参数):
  如果 参数.包含("名字") == 假:
    返回 造工具结果("缺少必填字段: 名字", 真)
  设 名字 为 参数["名字"]
  如果 名字 == "":
    返回 造工具结果("能力名不能为空", 真)
  设 入参 为 {}
  如果 参数.包含("参数") == 真:
    如果 是字典(参数["参数"]) == 真:
      设 入参 为 参数["参数"]
  设 结果 为 调用能力(名字, 入参)
  如果 结果["ok"] == 假:
    返回 造工具结果("调用失败 [" + 名字 + "]: " + 结果["原因"], 真)
  返回 造工具结果(结果["内容"], 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("列出能力", "列出宿主已注册的能力名（可按子串过滤）", 列出能力模式(), 列出能力处理))
  注册表.注册(造工具定义("调用能力", "按名字调用宿主能力并把返回结果归一化", 调用能力模式(), 调用能力处理))
  返回 真

导出 装载宿主
导出 卸载宿主
导出 宿主已装载
导出 能力清单
导出 有此能力
导出 取内容
导出 取是否错误
导出 归一结果
导出 调用能力
导出 挂载
