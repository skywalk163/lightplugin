# 测试_开发工具包.light —— P8 开发工具包（SDK 门面）的正例与反例
#
# 宿主注入式：列能力器 / 调能力器 全部是确定性 fake → 零网络、零进程、零墙上时钟。
# 断言失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。

从 开发工具包 导入 装载宿主, 卸载宿主, 宿主已装载, 能力清单, 有此能力, 归一结果, 调用能力, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言含于(大串, 子串, 标签):
  如果 包含(大串, 子串) == 假:
    抛出 新建 错误("断言含于失败 [" + 标签 + "]: 未含 " + 子串)

# ---- 假宿主：能力清单固定，调用按名字分派 ----
段落 假列能力():
  返回 ["网页抓取", "作业状态查询", "溢出写入", "回声", "空转", "会炸"]

段落 假调能力(名字, 参数):
  如果 名字 == "网页抓取":
    返回 ["content": "抓取完成: " + 参数["网址"], "isError": 假]
  如果 名字 == "会炸":
    返回 ["content": "宿主内部错误: 远端 500", "isError": 真]
  如果 名字 == "空转":
    返回 空
  返回 "纯字符串结果:" + 名字

段落 坏列能力():
  返回 "我不是列表"

段落 主:
  # ---- 1. 未装载宿主：能力发现软失败 ----
  断言为假(宿主已装载(), "初始应未装载宿主")
  设 空清单 为 能力清单()
  断言为假(空清单["ok"], "未装载时列能力应失败")
  断言相等(空清单["原因"], "宿主未装载", "未装载时原因")
  断言相等(空清单["数量"], 0, "未装载时数量为 0")

  # ---- 2. 未装载宿主：调用应失败（反例）----
  设 未装 为 调用能力("网页抓取", {})
  断言为假(未装["ok"], "未装载时调用应失败")
  断言相等(未装["原因"], "宿主未装载", "未装载时调用原因")

  # ---- 3. 装载宿主 ----
  断言为真(装载宿主(假列能力, 假调能力), "装载宿主应成功")
  断言为真(宿主已装载(), "装载后应判定已装载")

  # ---- 4. 能力发现 ----
  设 清单 为 能力清单()
  断言为真(清单["ok"], "列能力应成功")
  断言相等(清单["数量"], 6, "能力数量")
  断言为真(清单["能力"].包含("网页抓取"), "清单应含网页抓取")
  断言为真(清单["能力"].包含("作业状态查询"), "清单应含作业状态查询")
  断言为假(清单["能力"].包含("不存在的能力"), "清单不应含未注册能力")
  断言为真(有此能力("回声"), "有此能力 应命中已注册项")
  断言为假(有此能力("回声2"), "有此能力 对未注册项应为假")

  # ---- 5. 调用封装：字典返回 + isError=假 ----
  设 入参 为 ["网址": "https://example.com/p"]
  设 结果 为 调用能力("网页抓取", 入参)
  断言为真(结果["ok"], "正常调用应成功")
  断言为假(结果["是否错误"], "正常调用不应标记错误")
  断言相等(结果["内容"], "抓取完成: https://example.com/p", "调用内容应透传")
  断言相等(结果["名字"], "网页抓取", "调用结果应带能力名")

  # ---- 6. 调用封装：字典返回 + isError=真（反例）----
  设 炸了 为 调用能力("会炸", {})
  断言为假(炸了["ok"], "宿主报错时应归一为失败")
  断言为真(炸了["是否错误"], "宿主报错时应标记是否错误")
  断言相等(炸了["原因"], "宿主内部错误: 远端 500", "错误原因应取 content")

  # ---- 7. 调用封装：宿主返回空（反例）----
  设 空转 为 调用能力("空转", {})
  断言为假(空转["ok"], "宿主返回空应归一为失败")
  断言相等(空转["原因"], "宿主返回空", "空返回的原因")

  # ---- 8. 调用封装：宿主返回纯字符串 ----
  设 回声 为 调用能力("回声", {})
  断言为真(回声["ok"], "字符串返回应归一为成功")
  断言相等(回声["内容"], "纯字符串结果:回声", "字符串返回应被字符串化")

  # ---- 9. 调用封装：未知能力（反例）----
  设 未知 为 调用能力("压根没有", {})
  断言为假(未知["ok"], "未知能力应失败")
  断言相等(未知["原因"], "未知能力: 压根没有", "未知能力原因")

  # ---- 10. 归一结果：中文键 内容/是否错误 也要认 ----
  设 中式 为 ["内容": "中文键内容", "是否错误": 真]
  设 归一 为 归一结果("中式", 中式)
  断言为假(归一["ok"], "中文键 是否错误=真 应归一为失败")
  断言相等(归一["内容"], "中文键内容", "中文键 content 应被识别")

  # ---- 11. 反例：宿主返回的清单不是列表 ----
  装载宿主(坏列能力, 假调能力)
  设 坏清单 为 能力清单()
  断言为假(坏清单["ok"], "清单不是列表时应失败")
  断言相等(坏清单["原因"], "宿主返回的能力清单不是列表", "清单非法的原因")
  设 坏调用 为 调用能力("网页抓取", {})
  断言为假(坏调用["ok"], "清单非法时调用也应失败")
  装载宿主(假列能力, 假调能力)

  # ---- 12. 卸载宿主 ----
  断言为真(卸载宿主(), "卸载宿主应成功")
  断言为假(宿主已装载(), "卸载后应判定未装载")

  # ---- 13. 挂载进注册表并端到端执行 ----
  装载宿主(假列能力, 假调能力)
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("列出能力"), "列出能力应已注册")
  断言为真(注册表.登记表.包含("调用能力"), "调用能力应已注册")

  # 13a. 列出能力（全量）
  设 列定义 为 注册表.登记表["列出能力"]
  设 空参 为 {}
  设 列产出 为 列定义["execute"](空参)
  断言为假(列产出["isError"], "列出能力不应报错")
  断言含于(列产出["content"], "共 6 项能力", "列出能力应报出 6 项")
  断言含于(列产出["content"], "网页抓取", "列出能力应含网页抓取")

  # 13b. 列出能力（过滤）
  设 过滤参 为 ["过滤": "作业"]
  设 过滤产出 为 列定义["execute"](过滤参)
  断言为假(过滤产出["isError"], "过滤列出不应报错")
  断言含于(过滤产出["content"], "共 1 项能力", "过滤后应只剩 1 项")
  断言含于(过滤产出["content"], "作业状态查询", "过滤结果应含作业状态查询")

  # 13c. 调用能力（正例）
  设 调定义 为 注册表.登记表["调用能力"]
  设 调参 为 ["名字": "网页抓取", "参数": 入参]
  设 调产出 为 调定义["execute"](调参)
  断言为假(调产出["isError"], "调用已注册能力不应报错")
  断言相等(调产出["content"], "抓取完成: https://example.com/p", "调用内容应一致")

  # 13d. 调用能力（反例：未知能力）
  设 坏调参 为 ["名字": "压根没有"]
  设 坏调产出 为 调定义["execute"](坏调参)
  断言为真(坏调产出["isError"], "调用未知能力应报错")
  断言含于(坏调产出["content"], "未知能力", "未知能力报错信息")

  # 13e. 调用能力（反例：缺少必填字段 名字）
  设 缺参 为 ["参数": 入参]
  设 缺产出 为 调定义["execute"](缺参)
  断言为真(缺产出["isError"], "缺少名字字段应报错")
  断言含于(缺产出["content"], "缺少必填字段", "缺字段报错信息")

  # 13f. 调用能力（反例：空名字）
  设 空名参 为 ["名字": ""]
  设 空名产出 为 调定义["execute"](空名参)
  断言为真(空名产出["isError"], "空名字应报错")

  打印 "测试_开发工具包 全部通过"

主()
