# 测试_交互询问.light —— 交互询问 正例与反例
#
# 零真实 UI：问答全在内存表里，不阻塞、不等待用户输入。

从 交互询问 导入 提问核心, 回答核心, 待答核心, 取答核心, 最新已答号核心, 取出最新回答核心, 列出核心, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # 1. 提交两个问题
  设 n1 为 提问核心("用哪种数据库？")
  设 n2 为 提问核心("是否继续？")
  断言相等(n1, 1, "第一个问题编号为 1")
  断言相等(n2, 2, "第二个问题编号为 2")

  # 2. 待答列表
  断言相等(长(待答核心()), 2, "初始应有 2 条待答")
  断言相等(取出最新回答核心(), "", "尚未回答时取最新应为空串")

  # 3. 回答第一个
  断言为真(回答核心("1", "用 SQLite"), "回答编号 1 应成功")
  断言相等(长(待答核心()), 1, "回答后应剩 1 条待答")
  断言相等(取答核心("1"), "用 SQLite", "取回应为 用 SQLite")

  # 4. 未回答的问题取答为空串
  断言相等(取答核心("2"), "", "未回答的问题取答应为空串")
  断言相等(取答核心("999"), "", "不存在的问题取答应为空串")

  # 5. 最新已答号
  断言相等(最新已答号核心(), "1", "最新已答应是 1")
  断言相等(取出最新回答核心(), "用 SQLite", "取最新回答应为 用 SQLite")

  # 6. 回答第二个后，最新已答号推进
  断言为真(回答核心("2", "继续"), "回答编号 2 应成功")
  断言相等(最新已答号核心(), "2", "最新已答应推进到 2")
  断言相等(取出最新回答核心(), "继续", "取最新回答应为 继续")

  # 7. 列出全部（含已答与待答）
  设 行们 为 列出核心()
  断言相等(长(行们), 2, "列出应有 2 条")

  # 8. 反例：空问题内容
  断言相等(提问核心(""), -1, "空问题应返回 -1")

  # 9. 反例：空回答 / 不存在编号
  断言为假(回答核心("1", ""), "空回答应失败")
  断言为假(回答核心("999", "随便"), "回答不存在编号应失败")

  # 10. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("提问提交"), "提问提交 应注册")
  断言为真(注册表.登记表.包含("回答提交"), "回答提交 应注册")
  断言为真(注册表.登记表.包含("待答列出"), "待答列出 应注册")
  断言为真(注册表.登记表.包含("答案取出"), "答案取出 应注册")

  设 参 为 ["内容": "端到端问题"]
  设 产 为 注册表.登记表["提问提交"]["execute"](参)
  断言为假(产["isError"], "端到端提问不应报错")

  设 参2 为 ["编号": "3", "回答": "端到端回答"]
  设 产2 为 注册表.登记表["回答提交"]["execute"](参2)
  断言为假(产2["isError"], "端到端回答不应报错")

  设 空参 为 ["占位": "x"]
  设 出待 为 注册表.登记表["待答列出"]["execute"](空参)
  断言为假(出待["isError"], "待答列出不应报错")

  设 参3 为 ["编号": "3"]
  设 出答 为 注册表.登记表["答案取出"]["execute"](参3)
  断言为假(出答["isError"], "答案取出不应报错")

  # 11. 反例：空问题工具报错
  设 坏参 为 ["内容": ""]
  设 坏产 为 注册表.登记表["提问提交"]["execute"](坏参)
  断言为真(坏产["isError"], "空问题应报错")

  # 12. 反例：空回答工具报错
  设 坏参2 为 ["编号": "1", "回答": ""]
  设 坏产2 为 注册表.登记表["回答提交"]["execute"](坏参2)
  断言为真(坏产2["isError"], "空回答应报错")

  # 13. 反例：取不存在问题的答案应报错
  设 坏参3 为 ["编号": "999"]
  设 坏产3 为 注册表.登记表["答案取出"]["execute"](坏参3)
  断言为真(坏产3["isError"], "取不存在答案应报错")

  打印 "测试_交互询问 全部通过"

主()
