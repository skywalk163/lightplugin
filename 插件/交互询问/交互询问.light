# 交互询问.light —— 对标 dsh packages/interaction
#
# 设计：向用户提问的**双向**队列（id -> {内容, 回答, 已答}）。
# 提交问题 / 提交回答 / 列出待答 / 取出最新回答。零真实 UI、零阻塞等待。
# 与「反馈通道」区别：反馈是单向上报；本插件是「问—答」成对交互。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 问题表 为 {}                  # id -> {内容, 回答, 已答, 序}
设 下一号 为 1
设 持久写 为 空                  # 宿主注入：(全表快照)->真

段落 注入持久化(写):
  全局 持久写。
  持久写 为 写
  返回 真

段落 持久化():
  如果 持久写 != 空:
    持久写(问题表)
  返回 真

# ---------- 内核 ----------
段落 提问核心(内容):
  全局 下一号。
  如果 内容 == "":
    返回 -1
  设 id 为 字符串(下一号)
  设 记录 为 ["内容": 内容, "回答": "", "已答": 假, "序": 下一号]
  问题表[id] 为 记录
  下一号 为 下一号 + 1
  持久化()
  返回 下一号 - 1

段落 回答核心(编号, 回答):
  如果 问题表.包含(编号) == 假:
    返回 假
  如果 回答 == "":
    返回 假
  问题表[编号]["回答"] 为 回答
  问题表[编号]["已答"] 为 真
  持久化()
  返回 真

段落 待答核心():
  设 键们 为 字典键列表(问题表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 问题表[键]
    如果 项["已答"] == 假:
      结果.追加("[" + 键 + "] " + 项["内容"])
  返回 结果

段落 取答核心(编号):
  如果 问题表.包含(编号) == 假:
    返回 ""
  如果 问题表[编号]["已答"] == 假:
    返回 ""
  返回 问题表[编号]["回答"]

段落 最新已答号核心():
  设 最新 为 ""
  设 最新序 为 0
  设 键们 为 字典键列表(问题表)
  遍历 键 之 键们:
    设 项 为 问题表[键]
    如果 项["已答"] == 真 且 项["序"] > 最新序:
      最新序 为 项["序"]
      最新 为 键
  返回 最新

段落 取出最新回答核心():
  设 编号 为 最新已答号核心()
  如果 编号 == "":
    返回 ""
  返回 取答核心(编号)

段落 列出核心():
  设 键们 为 字典键列表(问题表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 问题表[键]
    设 行 为 "[" + 键 + "] " + 项["内容"]
    如果 项["已答"] == 真:
      行 为 行 + " => " + 项["回答"]
    否则:
      行 为 行 + " (待答)"
    结果.追加(行)
  返回 结果

# ---------- 工具 ----------
段落 提问模式():
  返回 ["type": "object",
        "properties": ["内容": ["type": "string", "description": "要向用户提出的问题"]],
        "required": ["内容"]]

段落 提问处理(参数):
  设 内容 为 参数["内容"]
  设 n 为 提问核心(内容)
  如果 n < 0:
    返回 造工具结果("问题内容不可为空", 真)
  返回 造工具结果("已提交问题 #" + 字符串(n) + "（等待回答）", 假)

段落 回答模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "要回答的问题编号"],
                       "回答": ["type": "string", "description": "用户给出的回答内容"]],
        "required": ["编号", "回答"]]

段落 回答处理(参数):
  设 编号 为 参数["编号"]
  设 回答 为 参数["回答"]
  如果 回答 == "":
    返回 造工具结果("回答内容不可为空", 真)
  如果 回答核心(编号, 回答) == 假:
    返回 造工具结果("问题不存在: " + 编号, 真)
  返回 造工具结果("问题 #" + 编号 + " 已记录回答", 假)

段落 待答模式():
  返回 ["type": "object", "properties": {}]

段落 待答处理(参数):
  设 行们 为 待答核心()
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(无待答问题)"
  返回 造工具结果(串, 假)

段落 取答模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "问题编号；留空=取最新一条已答"]]]

段落 取答处理(参数):
  设 编号 为 ""
  如果 参数.包含("编号"):
    编号 为 参数["编号"]
  设 回答 为 ""
  如果 编号 == "":
    回答 为 取出最新回答核心()
  否则:
    回答 为 取答核心(编号)
  如果 回答 == "":
    返回 造工具结果("暂无可用回答", 真)
  返回 造工具结果("回答: " + 回答, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("提问提交", "向用户提交一个问题（进入待答队列）", 提问模式(), 提问处理))
  注册表.注册(造工具定义("回答提交", "给指定问题编号提交回答", 回答模式(), 回答处理))
  注册表.注册(造工具定义("待答列出", "列出尚未回答的问题", 待答模式(), 待答处理))
  注册表.注册(造工具定义("答案取出", "取出指定问题（或最新一条）的回答", 取答模式(), 取答处理))
  返回 真

导出 注入持久化
导出 提问核心
导出 回答核心
导出 待答核心
导出 取答核心
导出 最新已答号核心
导出 取出最新回答核心
导出 列出核心
导出 挂载
