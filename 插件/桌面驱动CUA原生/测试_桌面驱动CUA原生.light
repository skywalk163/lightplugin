# 测试_桌面驱动CUA原生.light —— P6-4 桌面驱动CUA原生 的正例与反例

从 桌面驱动CUA原生 导入 翻译动作, 翻译序列, 渲染计划, 挂载
从 工具 导入 工具注册表
从 字符串处理 导入 子串位置

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 断言True_含(串, 子, 标签):
  如果 子串位置(串, 子) < 0:
    抛出 新建 错误("包含断言失败 [" + 标签 + "]: 未找到 " + 子)

段落 主:
  # ---- 1. 各桌面操作翻译（翻译动作返回 CUA 原生指令对象）----
  设 计划1 为 翻译动作(["类型": "截图"])
  断言True_含(计划1["type"], "screenshot", "截图 type 应为 screenshot")

  设 计划2 为 翻译动作(["类型": "点击", "x": 100, "y": 200])
  断言True_含(计划2["type"], "click", "点击 type 应为 click")
  断言相等(计划2["x"], 100, "点击 x 应为 100")

  设 计划3 为 翻译动作(["类型": "输入", "文本": "hello"])
  断言True_含(计划3["type"], "type", "输入 type 应为 type")
  断言True_含(计划3["text"], "hello", "输入 text 应为 hello")

  设 计划4 为 翻译动作(["类型": "按键", "键": "Enter"])
  断言True_含(计划4["type"], "keypress", "按键 type 应为 keypress")
  断言True_含(计划4["key"], "Enter", "按键 key 应为 Enter")

  设 计划5 为 翻译动作(["类型": "滚动", "量": 300])
  断言True_含(计划5["type"], "scroll", "滚动 type 应为 scroll")
  断言相等(计划5["scroll_amount"], 300, "滚动 scroll_amount 应为 300")

  设 计划6 为 翻译动作(["类型": "移动", "x": 10, "y": 20])
  断言True_含(计划6["type"], "move", "移动 type 应为 move")

  设 计划7 为 翻译动作(["类型": "瞎搞"])
  断言为真(计划7["跳过"] == 真, "未知动作应标跳过")

  # ---- 2. 翻译序列 ----
  设 序列 为 翻译序列([["类型": "截图"],
                      ["类型": "点击", "x": 100, "y": 200],
                      ["类型": "瞎搞"]])
  断言相等(长(序列), 3, "序列应含 3 条")
  断言为真(序列[2]["跳过"] == 真, "序列末条为跳过的未知动作")

  # ---- 3. 渲染计划 ----
  设 渲染 为 渲染计划(序列)
  断言相等(长(渲染), 3, "渲染应 3 行")

  # ---- 4. 挂载与工具 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("桌面驱动CUA原生"), "桌面驱动CUA原生 应注册")
  设 定义 为 注册表.登记表["桌面驱动CUA原生"]
  设 产出 为 定义["execute"](["动作": "翻译", "序列": [["类型": "截图"], ["类型": "点击", "x": 100, "y": 200]]])
  断言为假(产出["isError"], "翻译不应报错")
  设 参坏 为 ["动作": "瞎搞"]
  断言为真(定义["execute"](参坏)["isError"], "未知动作应报错")

  打印 "测试_桌面驱动CUA原生 全部通过"

主()
