# 测试_上下文压缩.light —— 上下文压缩 正例与反例
#
# 零真实 I/O：块列表是内存字典列表；token 计量默认退化为字符数，也可注入自定义计量器。

从 上下文压缩 导入 注入计量器, 登记核心, 块列表核心, 评估核心, 选保留块核心, 摘要核心, 列表包含, 挂载
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

# 定额计量桩：不管内容多长，一块恒算 2 个 token
段落 定额计量(内容):
  返回 2

段落 主:
  # 1. 造一批块（用默认字符数计量：每个块 10 字）
  设 块1 为 ["标识": "a", "内容": "一二三四五六七八九十"]
  设 块2 为 ["标识": "b", "内容": "甲乙丙丁戊己庚辛壬癸"]
  设 块3 为 ["标识": "c", "内容": "ABCDEFGHIJ"]
  设 块列表 为 [块1, 块2, 块3]

  # 2. 评估：总用量 30
  设 评 为 评估核心(块列表, 100)
  断言相等(评["块数"], 3, "块数应为 3")
  断言相等(评["总用量"], 30, "总用量应为 30")
  断言为假(评["超预算"], "预算 100 不应超")

  设 评2 为 评估核心(块列表, 20)
  断言为真(评2["超预算"], "预算 20 应超出")

  # 3. 旧优先：预算 20 → 保留前两块（前缀 10 / 20 / 30）
  设 保留旧 为 选保留块核心(块列表, 20, "旧优先")
  断言相等(长(保留旧), 2, "旧优先预算20应保留2块")
  断言为真(列表包含(保留旧, "a"), "旧优先应含 a")
  断言为真(列表包含(保留旧, "b"), "旧优先应含 b")
  断言为假(列表包含(保留旧, "c"), "旧优先不应含 c")

  # 4. 新优先：预算 20 → 保留后两块（后缀 30 / 20 / 10）
  设 保留新 为 选保留块核心(块列表, 20, "新优先")
  断言相等(长(保留新), 2, "新优先预算20应保留2块")
  断言为假(列表包含(保留新, "a"), "新优先不应含 a")
  断言为真(列表包含(保留新, "c"), "新优先应含 c")

  # 5. 预算极小：一块都放不下
  设 保留空 为 选保留块核心(块列表, 1, "旧优先")
  断言相等(长(保留空), 0, "预算1时应保留0块")

  # 6. 摘要：默认全部 + 截断
  设 摘要 为 摘要核心(块列表, [], 5)
  断言相等(长(摘要), 3, "空保留列表=全部块，应有 3 行")
  断言为真(长(摘要[0]) > 5, "摘要行应含标识与用量信息")

  # 7. 摘要：只保留指定块
  设 只要 为 ["b"]
  设 摘要2 为 摘要核心(块列表, 只要, 5)
  断言相等(长(摘要2), 1, "只保留 b 时应只有 1 行")

  # 8. 注入式计量器：改成「每块恒 2」的定额计量
  注入计量器(定额计量)
  设 评3 为 评估核心(块列表, 5)
  断言相等(评3["总用量"], 6, "注入定额计量后总用量应为 6")
  断言为真(评3["超预算"], "预算5 应超出")
  注入计量器(空)
  设 评4 为 评估核心(块列表, 100)
  断言相等(评4["总用量"], 30, "撤掉注入后应回到字符数计量 30")

  # 9. 状态表登记（宿主路径）
  设 n1 为 登记核心("登记块一")
  设 n2 为 登记核心("登记块二")
  断言为真(n1 > 0, "登记第一块应返回正编号")
  断言为真(n2 > n1, "登记第二块编号应递增")
  设 表列 为 块列表核心()
  断言相等(长(表列), 2, "块表应有 2 块")

  # 10. 反例：登记空内容
  断言相等(登记核心(""), -1, "空内容登记应返回 -1")

  # 11. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("压缩评估"), "压缩评估 应注册")
  断言为真(注册表.登记表.包含("压缩选块"), "压缩选块 应注册")
  断言为真(注册表.登记表.包含("压缩摘要"), "压缩摘要 应注册")

  设 端到端块 为 ["标识": "x", "内容": "hello world"]
  设 端到端列表 为 [端到端块]
  设 参 为 ["块列表": 端到端列表, "预算": 100]
  设 产 为 注册表.登记表["压缩评估"]["execute"](参)
  断言为假(产["isError"], "端到端评估不应报错")

  设 参2 为 ["块列表": 端到端列表, "预算": 100, "策略": "新优先"]
  设 产2 为 注册表.登记表["压缩选块"]["execute"](参2)
  断言为假(产2["isError"], "端到端选块不应报错")

  设 参3 为 ["块列表": 端到端列表, "上限": 5]
  设 产3 为 注册表.登记表["压缩摘要"]["execute"](参3)
  断言为假(产3["isError"], "端到端摘要不应报错")

  # 12. 反例：预算为 0 → 报错
  设 坏参 为 ["块列表": 端到端列表, "预算": 0]
  设 坏产 为 注册表.登记表["压缩评估"]["execute"](坏参)
  断言为真(坏产["isError"], "预算为0应报错")

  # 13. 反例：无块列表且块表为空 → 报错（用一个干净路径：传空列表）
  设 空列表 为 []
  设 坏参2 为 ["块列表": 空列表, "预算": 10]
  设 坏产2 为 注册表.登记表["压缩评估"]["execute"](坏参2)
  断言为真(坏产2["isError"], "空块列表应报错")

  打印 "测试_上下文压缩 全部通过"

主()
