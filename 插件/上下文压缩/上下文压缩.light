# 上下文压缩.light —— 对标 dsh packages/compaction
#
# 设计：压缩动作本身（与「上下文装配裁剪」互补：那是装配前的裁剪，这是压缩策略）。
#   输入：块列表（每项含 标识 与 内容 两个键）+ token 预算
#   输出：预算评估 / 保留块标识列表 / 摘要行列表
# token 计量由宿主注入的「计量器」提供，默认 空 → 退化为「字符数」计量。零真实 I/O。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 块表 为 {}                    # 标识 -> {内容, 序}（宿主可用登记核心维护）
设 下一号 为 1
设 计量器 为 空                  # 宿主注入：(内容)->token 数

段落 注入计量器(函数):
  全局 计量器。
  计量器 为 函数
  返回 真

段落 计量(内容):
  如果 计量器 != 空:
    返回 计量器(内容)
  返回 长(内容)

# ---------- 内核 ----------
段落 登记核心(内容):
  全局 下一号。
  如果 内容 == "":
    返回 -1
  设 id 为 字符串(下一号)
  设 记录 为 ["内容": 内容, "序": 下一号]
  块表[id] 为 记录
  下一号 为 下一号 + 1
  返回 下一号 - 1

段落 块列表核心():
  设 键们 为 字典键列表(块表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 块表[键]
    设 块 为 ["标识": 键, "内容": 项["内容"]]
    结果.追加(块)
  返回 结果

段落 取标识(块, 序):
  如果 块.包含("标识"):
    返回 块["标识"]
  返回 字符串(序)

段落 取内容(块):
  如果 块.包含("内容"):
    返回 块["内容"]
  返回 ""

段落 列表包含(列表, 值):
  设 找到 为 假
  遍历 项 之 列表:
    如果 项 == 值:
      找到 为 真
  返回 找到

段落 评估核心(块列表, 预算):
  设 总 为 0
  遍历 块 之 块列表:
    设 总 为 总 + 计量(取内容(块))
  设 超 为 假
  如果 总 > 预算:
    超 为 真
  设 结果 为 ["总用量": 总, "预算": 预算, "超预算": 超, "块数": 长(块列表)]
  返回 结果

段落 选保留块核心(块列表, 预算, 策略):
  设 用量列表 为 []
  设 标识列表 为 []
  设 序 为 1
  遍历 块 之 块列表:
    用量列表.追加(计量(取内容(块)))
    标识列表.追加(取标识(块, 序))
    设 序 为 序 + 1
  设 累计 为 []
  设 运行 为 0
  遍历 用 之 用量列表:
    设 运行 为 运行 + 用
    累计.追加(运行)
  设 保留 为 []
  设 位 为 0
  遍历 用2 之 用量列表:
    设 前缀 为 累计[位]
    设 后缀 为 运行 - 累计[位] + 用2
    设 判据 为 前缀
    如果 策略 == "新优先":
      判据 为 后缀
    如果 判据 <= 预算:
      保留.追加(标识列表[位])
    设 位 为 位 + 1
  返回 保留

段落 摘要核心(块列表, 保留, 上限):
  设 限 为 上限
  如果 限 <= 0:
    限 为 40
  设 结果 为 []
  设 序 为 1
  遍历 块 之 块列表:
    设 标识 为 取标识(块, 序)
    设 序 为 序 + 1
    如果 长(保留) == 0 或 列表包含(保留, 标识) == 真:
      设 内容 为 取内容(块)
      设 全长 为 长(内容)
      设 片段 为 内容
      如果 全长 > 限:
        片段 为 内容[0:限]
      设 行 为 标识 + ": " + 片段
      如果 全长 > 限:
        行 为 行 + " …(共" + 字符串(全长) + "字, 用量=" + 字符串(计量(内容)) + ")"
      否则:
        行 为 行 + " (用量=" + 字符串(计量(内容)) + ")"
      结果.追加(行)
  返回 结果

段落 取块列表(参数):
  # 显式传了「块列表」就以它为准（传空列表=真的没有块，不再回退）；
  # 没传时才回退到宿主登记的块表。
  如果 参数.包含("块列表"):
    返回 参数["块列表"]
  返回 块列表核心()

# ---------- 工具 ----------
段落 评估模式():
  返回 ["type": "object",
        "properties": ["块列表": ["type": "array", "description": "上下文块列表，每项含 标识 与 内容 两个键"],
                       "预算": ["type": "number", "description": "token 预算上限"]],
        "required": ["预算"]]

段落 评估处理(参数):
  设 块列表 为 取块列表(参数)
  如果 长(块列表) == 0:
    返回 造工具结果("块列表为空：请传入 块列表 参数", 真)
  设 预算 为 参数["预算"]
  如果 预算 <= 0:
    返回 造工具结果("预算必须为正数", 真)
  设 评 为 评估核心(块列表, 预算)
  设 串 为 "块数=" + 字符串(评["块数"]) + " 总用量=" + 字符串(评["总用量"]) + " 预算=" + 字符串(评["预算"])
  如果 评["超预算"] == 真:
    串 为 串 + " [超出预算]"
  否则:
    串 为 串 + " [预算内]"
  返回 造工具结果(串, 假)

段落 选块模式():
  返回 ["type": "object",
        "properties": ["块列表": ["type": "array", "description": "上下文块列表，每项含 标识 与 内容 两个键"],
                       "预算": ["type": "number", "description": "token 预算上限"],
                       "策略": ["type": "string", "description": "旧优先（保住早期块）/ 新优先（保住最近块）"]],
        "required": ["预算"]]

段落 选块处理(参数):
  设 块列表 为 取块列表(参数)
  如果 长(块列表) == 0:
    返回 造工具结果("块列表为空：请传入 块列表 参数", 真)
  设 预算 为 参数["预算"]
  如果 预算 <= 0:
    返回 造工具结果("预算必须为正数", 真)
  设 策略 为 "旧优先"
  如果 参数.包含("策略"):
    设 s 为 参数["策略"]
    如果 s != "":
      策略 为 s
  设 保留 为 选保留块核心(块列表, 预算, 策略)
  设 串 为 连接字符串(保留, ", ")
  如果 串 == "":
    串 为 "(预算内无法保留任何块)"
  返回 造工具结果("策略=" + 策略 + " 保留块: " + 串, 假)

段落 摘要模式():
  返回 ["type": "object",
        "properties": ["块列表": ["type": "array", "description": "上下文块列表，每项含 标识 与 内容 两个键"],
                       "保留": ["type": "array", "description": "要出现在摘要里的块标识列表；空=全部"],
                       "上限": ["type": "number", "description": "单块摘要截断字符数，默认 40"]]]

段落 摘要处理(参数):
  设 块列表 为 取块列表(参数)
  如果 长(块列表) == 0:
    返回 造工具结果("块列表为空：请传入 块列表 参数", 真)
  设 保留 为 []
  如果 参数.包含("保留"):
    保留 为 参数["保留"]
  设 上限 为 0
  如果 参数.包含("上限"):
    上限 为 参数["上限"]
  设 行们 为 摘要核心(块列表, 保留, 上限)
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(无摘要行)"
  返回 造工具结果(串, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("压缩评估", "评估上下文块列表的 token 用量是否超出预算", 评估模式(), 评估处理))
  注册表.注册(造工具定义("压缩选块", "按预算与策略选出应保留的上下文块标识", 选块模式(), 选块处理))
  注册表.注册(造工具定义("压缩摘要", "为指定（或全部）上下文块生成截断摘要", 摘要模式(), 摘要处理))
  返回 真

导出 注入计量器
导出 登记核心
导出 块列表核心
导出 评估核心
导出 选保留块核心
导出 摘要核心
导出 列表包含
导出 挂载
