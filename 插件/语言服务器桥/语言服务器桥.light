# 语言服务器桥.light —— 对标 dsh packages/lsp
#
# 设计：注入式 LSP 传输门面。初始化 / 发请求 / 收响应。
# 传输函数由宿主注入（默认 空 → 本地空响应桩），零真实进程、零 socket。
# 与 lightharness 内部 语言服务器.light 的区别：那是宿主内部实现，
# 本插件把它包成**模型可调用的工具**，不重实现协议栈。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 已初始化 为 假
设 当前根 为 ""
设 请求表 为 {}                  # 请求号 -> 响应字典
设 下一请求号 为 1
设 传输 为 空                    # 宿主注入：(方法, 参数字典)->响应字典

段落 注入传输(函数):
  全局 传输。
  传输 为 函数
  返回 真

# ---------- 内核 ----------
段落 初始化核心(根路径, 语言标识):
  全局 已初始化。
  全局 当前根。
  如果 根路径 == "":
    返回 假
  如果 传输 != 空:
    设 参 为 ["根路径": 根路径, "语言标识": 语言标识]
    设 响 为 传输("initialize", 参)
    如果 响 == 空:
      返回 假
  已初始化 为 真
  当前根 为 根路径
  返回 真

段落 发请求核心(方法, 参数字典):
  全局 下一请求号。
  如果 已初始化 == 假:
    返回 -1
  如果 方法 == "":
    返回 -1
  设 id 为 字符串(下一请求号)
  设 响 为 空
  如果 传输 != 空:
    响 为 传输(方法, 参数字典)
  如果 响 == 空:
    设 响 为 ["结果": "(本地空响应)"]
  请求表[id] 为 响
  下一请求号 为 下一请求号 + 1
  返回 下一请求号 - 1

段落 收响应核心(编号):
  如果 请求表.包含(编号) == 假:
    返回 ""
  设 响 为 请求表[编号]
  请求表.弹出(编号)
  如果 响.包含("结果"):
    返回 字符串(响["结果"])
  返回 字符串(响)

段落 状态核心():
  设 结果 为 ["已初始化": 已初始化, "根": 当前根, "待取响应数": 长(字典键列表(请求表))]
  返回 结果

# ---------- 工具 ----------
段落 初始化模式():
  返回 ["type": "object",
        "properties": ["根路径": ["type": "string", "description": "工作区根路径"],
                       "语言标识": ["type": "string", "description": "语言标识，如 light / python"]],
        "required": ["根路径"]]

段落 初始化处理(参数):
  设 根路径 为 参数["根路径"]
  设 语言标识 为 ""
  如果 参数.包含("语言标识"):
    语言标识 为 参数["语言标识"]
  如果 初始化核心(根路径, 语言标识) == 假:
    返回 造工具结果("LSP 初始化失败：根路径不可为空，或注入的传输返回了空响应", 真)
  返回 造工具结果("LSP 已初始化，根=" + 根路径 + " 语言=" + 语言标识, 假)

段落 发请求模式():
  返回 ["type": "object",
        "properties": ["方法": ["type": "string", "description": "LSP 方法名，如 textDocument/hover"],
                       "参数": ["type": "object", "description": "请求参数字典"]],
        "required": ["方法"]]

段落 发请求处理(参数):
  设 方法 为 参数["方法"]
  设 参数字典 为 {}
  如果 参数.包含("参数"):
    参数字典 为 参数["参数"]
  设 n 为 发请求核心(方法, 参数字典)
  如果 n < 0:
    返回 造工具结果("LSP 发请求失败：未初始化，或方法名为空", 真)
  返回 造工具结果("已发出 LSP 请求 #" + 字符串(n) + " (" + 方法 + ")", 假)

段落 收响应模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "要取回的 LSP 请求号"]],
        "required": ["编号"]]

段落 收响应处理(参数):
  设 编号 为 参数["编号"]
  设 内容 为 收响应核心(编号)
  如果 内容 == "":
    返回 造工具结果("无待取响应: " + 编号, 真)
  返回 造工具结果("响应 #" + 编号 + ": " + 内容, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("LSP初始化", "初始化语言服务器会话（走注入式传输）", 初始化模式(), 初始化处理))
  注册表.注册(造工具定义("LSP发请求", "向语言服务器发一个请求并暂存响应", 发请求模式(), 发请求处理))
  注册表.注册(造工具定义("LSP收响应", "取回（并消费）指定请求号的响应", 收响应模式(), 收响应处理))
  返回 真

导出 注入传输
导出 初始化核心
导出 发请求核心
导出 收响应核心
导出 状态核心
导出 挂载
