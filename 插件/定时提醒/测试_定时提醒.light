# 测试_定时提醒.light —— 定时提醒 正例与反例
#
# 零 wall-clock：宿主时钟由「注入时钟」替换成内存计数器，测试自己推进时间。

从 定时提醒 导入 注入时钟, 注册核心, 取消核心, 轮询到期核心, 列出核心, 挂载
从 工具 导入 工具注册表

# ---- 内存时钟桩 ----
设 假时刻 为 0

段落 假时钟():
  全局 假时刻。
  返回 假时刻

段落 推进(秒):
  全局 假时刻。
  假时刻 为 假时刻 + 秒
  返回 假时刻

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # 0. 注入内存时钟
  断言为真(注入时钟(假时钟), "注入时钟应返回真")
  断言相等(假时刻, 0, "初始时钟为 0")

  # 1. 注册两条提醒
  设 n1 为 注册核心("喝水", 10)
  设 n2 为 注册核心("开会", 20)
  断言相等(n1, 1, "第一条编号为 1")
  断言相等(n2, 2, "第二条编号为 2")

  # 2. 未到期不应命中
  设 命中0 为 轮询到期核心()
  断言相等(长(命中0), 0, "t=0 时无到期提醒")

  # 3. 推进到 t=10，第一条到期
  推进(10)
  设 命中1 为 轮询到期核心()
  断言相等(长(命中1), 1, "t=10 时应有 1 条到期")

  # 4. 已触发的不重复命中
  设 命中2 为 轮询到期核心()
  断言相等(长(命中2), 0, "已触发的提醒不应重复命中")

  # 5. 推进到 t=20，第二条到期
  推进(10)
  设 命中3 为 轮询到期核心()
  断言相等(长(命中3), 1, "t=20 时第二条到期")

  # 6. 列出
  设 行们 为 列出核心()
  断言相等(长(行们), 2, "列出应有 2 条")

  # 7. 反例：空内容
  断言相等(注册核心("", 5), -1, "空内容应返回 -1")

  # 8. 反例：取消不存在的编号
  断言为假(取消核心("999"), "取消不存在编号应失败")

  # 9. 取消已存在的
  断言为真(取消核心("1"), "取消编号 1 应成功")
  断言相等(长(列出核心()), 1, "取消后只剩 1 条")

  # 10. 挂载端到端
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("提醒注册"), "提醒注册 应注册")
  断言为真(注册表.登记表.包含("提醒取消"), "提醒取消 应注册")
  断言为真(注册表.登记表.包含("提醒列出"), "提醒列出 应注册")
  断言为真(注册表.登记表.包含("提醒触发"), "提醒触发 应注册")

  设 参 为 ["内容": "端到端提醒", "延迟秒": 5]
  设 产 为 注册表.登记表["提醒注册"]["execute"](参)
  断言为假(产["isError"], "端到端注册不应报错")

  # 11. 反例：空内容工具报错
  设 坏参 为 ["内容": "", "延迟秒": 5]
  设 坏产 为 注册表.登记表["提醒注册"]["execute"](坏参)
  断言为真(坏产["isError"], "空内容注册应报错")

  # 12. 反例：取消不存在的编号工具报错
  设 坏参2 为 ["编号": "999"]
  设 坏产2 为 注册表.登记表["提醒取消"]["execute"](坏参2)
  断言为真(坏产2["isError"], "取消不存在编号应报错")

  # 13. 列出与触发工具可用
  设 空参 为 ["占位": "x"]
  设 出列 为 注册表.登记表["提醒列出"]["execute"](空参)
  断言为假(出列["isError"], "提醒列出不应报错")
  设 出触 为 注册表.登记表["提醒触发"]["execute"](空参)
  断言为假(出触["isError"], "提醒触发不应报错（无到期也算正常）")

  打印 "测试_定时提醒 全部通过"

主()
