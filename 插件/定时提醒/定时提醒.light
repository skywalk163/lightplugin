# 定时提醒.light —— 对标 dsh packages/schedule
#
# 设计：注入式时钟。注册时记「到期时刻=当前时钟()+延迟」，
# 触发时由宿主驱动调用「轮询到期」，把到期项取出。零 wall-clock。

从 工具 导入 造工具定义, 造工具结果
从 内置核心字典 导入 字典键列表

设 表 为 {}                    # id -> {内容, 到期, 已触发}
设 下一号 为 1
设 当前时刻 为 0               # 由 注入时钟 驱动

段落 注入时钟(读取器):
  全局 当前时刻。
  当前时刻 为 读取器
  返回 真

段落 现在():
  如果 当前时刻 == 0:
    返回 0
  返回 当前时刻()

段落 注册核心(内容, 延迟秒):
  全局 下一号。
  如果 内容 == "":
    返回 -1
  设 id 为 字符串(下一号)
  设 到期 为 现在() + 延迟秒
  设 记录 为 ["内容": 内容, "到期": 到期, "已触发": 假]
  表[id] 为 记录
  下一号 为 下一号 + 1
  返回 下一号 - 1

段落 取消核心(id):
  如果 表.包含(id) == 假:
    返回 假
  表.弹出(id)
  返回 真

段落 轮询到期核心():
  设  now 为 现在()
  设 命中 为 []
  设 键们 为 字典键列表(表)
  遍历 键 之 键们:
    设 项 为 表[键]
    如果 项["已触发"] == 假 且 项["到期"] <= now:
      项["已触发"] 为 真
      命中.追加(键 + ": " + 项["内容"])
  返回 命中

段落 列出核心():
  设 键们 为 字典键列表(表)
  设 结果 为 []
  遍历 键 之 键们:
    设 项 为 表[键]
    设 状态 为 "未到期"
    如果 项["已触发"] == 真:
      状态 为 "已触发"
    结果.追加("[" + 键 + "] " + 项["内容"] + " 到期@" + 字符串(项["到期"]) + " " + 状态)
  返回 结果

# ---- 工具 ----
段落 注册模式():
  返回 ["type": "object",
        "properties": ["内容": ["type": "string", "description": "提醒内容"],
                       "延迟秒": ["type": "number", "description": "多少秒后触发"]],
        "required": ["内容", "延迟秒"]]

段落 注册处理(参数):
  设 n 为 注册核心(参数["内容"], 参数["延迟秒"])
  如果 n < 0:
    返回 造工具结果("提醒内容不可为空", 真)
  返回 造工具结果("已注册提醒 #" + 字符串(n) + "，" + 字符串(参数["延迟秒"]) + "秒后触发", 假)

段落 取消模式():
  返回 ["type": "object",
        "properties": ["编号": ["type": "string", "description": "提醒编号"]],
        "required": ["编号"]]

段落 取消处理(参数):
  如果 取消核心(参数["编号"]) == 假:
    返回 造工具结果("提醒不存在: " + 参数["编号"], 真)
  返回 造工具结果("已取消提醒 #" + 参数["编号"], 假)

段落 列出模式():
  返回 ["type": "object", "properties": {}]

段落 列出处理(参数):
  设 行们 为 列出核心()
  设 串 为 连接字符串(行们, "\n")
  如果 串 == "":
    串 为 "(空)"
  返回 造工具结果(串, 假)

段落 触发模式():
  返回 ["type": "object", "properties": {}]

段落 触发处理(参数):
  设 命中 为 轮询到期核心()
  设 串 为 连接字符串(命中, "\n")
  如果 串 == "":
    返回 造工具结果("当前无到期提醒", 假)
  返回 造工具结果("到期提醒:\n" + 串, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("提醒注册", "注册一个延时提醒", 注册模式(), 注册处理))
  注册表.注册(造工具定义("提醒取消", "取消指定提醒", 取消模式(), 取消处理))
  注册表.注册(造工具定义("提醒列出", "列出全部提醒", 列出模式(), 列出处理))
  注册表.注册(造工具定义("提醒触发", "轮询并取出到期提醒（由宿主时钟驱动）", 触发模式(), 触发处理))
  返回 真

导出 注入时钟
导出 注册核心
导出 取消核心
导出 轮询到期核心
导出 列出核心
导出 挂载
