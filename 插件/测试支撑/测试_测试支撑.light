# 测试_测试支撑.light —— P8 测试支撑（测试夹具）的正例与反例
#
# 全确定性：桩返回固定值，用例结果固定 → 零网络、零磁盘、零墙上时钟。
# 断言失败即 抛出 新建 错误(...)，绝不放宽、绝不 skip。

从 测试支撑 导入 断言相等, 断言为真, 断言为假, 断言包含, 检查相等, 检查为真, 检查为假, 检查包含, 登记桩, 有此桩, 调用桩, 桩命中次数, 清空桩, 桩数量, 登记用例, 用例名表, 用例数量, 清空用例, 算通过率, 运行用例表, 运行全部用例, 挂载
从 工具 导入 工具注册表

段落 校验相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 校验为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 校验为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 校验含于(大串, 子串, 标签):
  如果 包含(大串, 子串) == 假:
    抛出 新建 错误("断言含于失败 [" + 标签 + "]: 未含 " + 子串)

# ---- 用例：全部用非抛出的 检查* 系列 ----
段落 用例_加法():
  返回 检查相等(1 + 1, 2)

段落 用例_包含():
  返回 检查包含(["甲", "乙"], "甲")

段落 用例_必败():
  返回 检查相等(1, 2)

段落 用例_桩():
  返回 检查相等(调用桩("远端"), "桩返回值")

段落 用例_真假():
  返回 检查为真(真) 且 检查为假(假)

段落 主:
  # ---- 1. 抛出型断言集：相等 / 为真 / 为假 / 包含（正例，不抛即通过）----
  断言相等(1 + 1, 2, "加法")
  断言为真(真, "真")
  断言为假(假, "假")
  设 列表样本 为 ["甲", "乙"]
  设 映射样本 为 ["甲": 1]
  断言包含("甲乙丙", "乙", "字符串包含")
  断言包含(列表样本, "甲", "列表包含")
  断言包含(映射样本, "甲", "映射包含键")

  # ---- 2. 非抛出型 检查* 系列：返回真假，不中断 ----
  校验为真(检查相等(3, 3), "检查相等命中")
  校验为假(检查相等(3, 4), "检查相等不符应为假")
  校验为真(检查为真(真), "检查为真")
  校验为假(检查为真(假), "检查为真对假应为假")
  校验为真(检查为假(假), "检查为假")
  校验为假(检查为假(真), "检查为假对真应为假")
  设 数表 为 [1, 2]
  校验为真(检查包含("abc", "b"), "检查包含 字符串")
  校验为假(检查包含("abc", "z"), "检查包含 字符串不符")
  校验为真(检查包含(数表, 2), "检查包含 列表")
  校验为假(检查包含(数表, 9), "检查包含 列表不符")
  校验为假(检查包含(123, 1), "检查包含 对非容器应为假")

  # ---- 3. 桩登记与命中 ----
  清空桩()
  校验相等(桩数量(), 0, "清空后桩数量应为 0")
  校验为假(有此桩("远端"), "未登记时不应有此桩")
  校验相等(调用桩("远端"), 空, "未登记的桩调用应返回空")
  校验相等(桩命中次数("远端"), 0, "未登记的桩命中次数为 0")

  校验为真(登记桩("远端", "桩返回值"), "登记桩应成功")
  校验为真(有此桩("远端"), "登记后应有此桩")
  校验相等(桩数量(), 1, "桩数量应为 1")
  校验相等(调用桩("远端"), "桩返回值", "桩应返回登记值")
  校验相等(桩命中次数("远端"), 1, "首次调用命中数为 1")
  调用桩("远端")
  调用桩("远端")
  校验相等(桩命中次数("远端"), 3, "三次调用命中数为 3")

  登记桩("数字桩", 42)
  校验相等(调用桩("数字桩"), 42, "数字桩返回 42")
  设 表值 为 ["甲", "乙"]
  登记桩("表桩", 表值)
  校验相等(长(调用桩("表桩")), 2, "表桩返回两项")

  # ---- 4. 用例登记与统计 ----
  校验相等(用例数量(), 0, "初始用例数为 0")
  校验为真(登记用例("用例_加法", 用例_加法), "登记用例应成功")
  校验为真(登记用例("用例_包含", 用例_包含), "登记用例应成功")
  校验为真(登记用例("用例_必败", 用例_必败), "登记用例应成功")
  校验为真(登记用例("用例_桩", 用例_桩), "登记用例应成功")
  校验为真(登记用例("用例_真假", 用例_真假), "登记用例应成功")
  校验相等(用例数量(), 5, "用例数量应为 5")

  设 全部 为 运行全部用例()
  校验相等(全部["总数"], 5, "总数应为 5")
  校验相等(全部["通过"], 4, "含一条必败用例时通过应为 4")
  校验相等(全部["失败"], 1, "失败应为 1（用例_必败）")
  校验相等(全部["通过率"], 80, "4/5 的通过率应为 80")
  校验为假(全部["ok"], "有失败时 ok 应为假")
  校验相等(全部["失败名单"][0], "用例_必败", "失败名单应记下用例_必败")
  校验相等(长(全部["明细"]), 5, "明细应有 5 条")

  # ---- 4b. 只跑全过的子集 → 通过率 100 ----
  设 好人名单 为 ["用例_加法", "用例_包含", "用例_桩", "用例_真假"]
  设 全过 为 运行用例表(好人名单)
  校验相等(全过["总数"], 4, "子集总数应为 4")
  校验相等(全过["通过"], 4, "子集应全过")
  校验相等(全过["失败"], 0, "子集失败应为 0")
  校验相等(全过["通过率"], 100, "全过时通过率应为 100")
  校验为真(全过["ok"], "全过时 ok 应为真")
  校验相等(长(全过["失败名单"]), 0, "全过时失败名单应为空")

  # ---- 5. 反例：含失败用例的统计（失败被记录、不中断）----
  设 名单 为 ["用例_加法", "用例_必败", "用例_真假"]
  设 混跑 为 运行用例表(名单)
  校验相等(混跑["总数"], 3, "混跑总数应为 3")
  校验相等(混跑["通过"], 2, "混跑通过应为 2")
  校验相等(混跑["失败"], 1, "混跑失败应为 1")
  校验相等(混跑["通过率"], 66, "2/3 的通过率应为 66")
  校验为假(混跑["ok"], "有失败时 ok 应为假")
  校验相等(长(混跑["失败名单"]), 1, "失败名单应有 1 项")
  校验相等(混跑["失败名单"][0], "用例_必败", "失败名单应记录失败用例名")
  校验相等(长(混跑["明细"]), 3, "明细应仍有 3 条（失败不中断后续）")

  # ---- 6. 反例：未登记的用例名（记账为失败，不抛异常）----
  设 未登记名 为 ["用例_压根没有"]
  设 未登记跑 为 运行用例表(未登记名)
  校验相等(未登记跑["总数"], 1, "未登记用例也应计入总数")
  校验相等(未登记跑["失败"], 1, "未登记用例应计为失败")
  校验相等(未登记跑["通过率"], 0, "全失败时通过率为 0")
  校验相等(未登记跑["明细"][0], "用例_压根没有:未登记", "未登记用例的明细标记")

  # ---- 7. 反例：空用例表 ----
  设 空表 为 []
  设 空跑 为 运行用例表(空表)
  校验相等(空跑["总数"], 0, "空表总数为 0")
  校验为假(空跑["ok"], "空表不应判定为全过")
  校验相等(空跑["通过率"], 0, "空表通过率为 0")

  # ---- 8. 通过率边界 ----
  校验相等(算通过率(0, 0), 0, "0/0 的通过率应为 0")
  校验相等(算通过率(1, 1), 100, "1/1 应为 100")
  校验相等(算通过率(1, 2), 50, "1/2 应为 50")
  校验相等(算通过率(1, 3), 33, "1/3 应为 33（向下取整）")
  校验相等(算通过率(2, 3), 66, "2/3 应为 66（向下取整）")

  # ---- 9. 挂载进注册表并端到端执行 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  校验为真(注册表.登记表.包含("运行用例表"), "运行用例表应已注册")
  设 定义 为 注册表.登记表["运行用例表"]

  # 9a. 不传 用例 → 跑全部（含 1 条必败 → 工具应报错）
  设 空参 为 {}
  设 产出 为 定义["execute"](空参)
  校验为真(产出["isError"], "含失败用例时工具应报错")
  校验含于(产出["content"], "总数=5", "应报出总数 5")
  校验含于(产出["content"], "通过=4", "应报出通过 4")
  校验含于(产出["content"], "失败=1", "应报出失败 1")
  校验含于(产出["content"], "通过率=80%", "应报出通过率 80%")

  # 9a2. 指定全过子集 → 工具不报错
  设 好参 为 ["用例": ["用例_加法", "用例_真假"]]
  设 好产出 为 定义["execute"](好参)
  校验为假(好产出["isError"], "全过子集工具不应报错")
  校验含于(好产出["content"], "通过率=100%", "全过子集通过率应为 100%")

  # 9b. 指定含失败用例 → 应报错且点名失败用例
  设 失败参 为 ["用例": ["用例_加法", "用例_必败"]]
  设 失败产出 为 定义["execute"](失败参)
  校验为真(失败产出["isError"], "含失败用例时工具应报错")
  校验含于(失败产出["content"], "失败=1", "应报出失败 1")
  校验含于(失败产出["content"], "用例_必败", "应点名失败用例")

  # 9c. 反例：传了不存在的用例名
  设 缺参 为 ["用例": ["用例_压根没有"]]
  设 缺产出 为 定义["execute"](缺参)
  校验为真(缺产出["isError"], "未登记用例应报错")

  # 9d. 反例：清空全部用例后无可运行项
  清空用例()
  校验相等(用例数量(), 0, "清空后用例数应为 0")
  设 空产出 为 定义["execute"](空参)
  校验为真(空产出["isError"], "没有可运行用例时应报错")
  校验含于(空产出["content"], "没有可运行的用例", "空用例报错信息")

  打印 "测试_测试支撑 全部通过"

主()
