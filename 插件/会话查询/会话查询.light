# 会话查询.light —— 对标 dsh packages/session-query 的「会话检索」层
#
# 能力：按条件过滤（状态精确匹配 / 名字关键字包含）+ 分页 + 字段抽取。
#       会话源为「注入式」：默认读 会话管理.列出会话()，宿主/测试可注入任意会话列表。
#
# 依赖：会话管理（从 会话管理 导入 列出会话）——本插件只做检索投影，不触碰会话生命周期。
#
# 光明限制遵守（踩过的坑，勿删）：
#   L-047   字典/列表字面量不可直接作实参 → 先赋变量再传。
#   L-044   含「文本」的标识符会被词法拆名 → 本模块用 名字/状态/字段 避开。
#   L-165/166 段落内写模块级标量须先写『全局 X。』，否则静默变局部变量。
#   只用本仓已验证的 stdlib：长 / 包含 / 连接字符串 / 字符串()。

从 会话管理 导入 列出会话
从 工具 导入 造工具定义, 造工具结果

# ---------- 注入式会话源 ----------
设 会话源函数 为 空

段落 注入会话源(源函数):
  全局 会话源函数。
  会话源函数 为 源函数
  返回 真

段落 取值源():
  全局 会话源函数。
  如果 会话源函数 != 空:
    返回 会话源函数()
  返回 列出会话()

# ---------- 条件过滤 ----------
段落 过滤会话(源, 条件):
  设 结果 为 []
  遍历 每条 之 源:
    设 命中 为 真
    如果 条件.包含("状态") == 真 且 条件["状态"] != "":
      如果 每条.包含("状态") == 假 或 每条["状态"] != 条件["状态"]:
        设 命中 为 假
    如果 条件.包含("关键字") == 真 且 条件["关键字"] != "":
      如果 每条.包含("名字") == 假 或 包含(每条["名字"], 条件["关键字"]) == 假:
        设 命中 为 假
    如果 命中 == 真:
      结果.追加(每条)
  返回 结果

# ---------- 分页 ----------
段落 分页(表, 页码, 每页):
  如果 每页 <= 0:
    设 每页 为 10
  设 起点 为 (页码 - 1) * 每页
  如果 起点 < 0:
    设 起点 为 0
  设 终点 为 起点 + 每页
  如果 终点 > 长(表):
    设 终点 为 长(表)
  返回 表[起点:终点]

# ---------- 字段抽取 ----------
段落 抽取字段(表, 字段表):
  如果 长(字段表) == 0:
    返回 表
  # 注：变量不可命名为「出」——「出」作成员访问基名时解析失败（LP-D-013），改名 抽取表。
  设 抽取表 为 []
  遍历 每条 之 表:
    设 新项 为 {}
    遍历 字段 之 字段表:
      如果 每条.包含(字段) == 真:
        新项[字段] 为 每条[字段]
    抽取表.追加(新项)
  返回 抽取表

# ---------- 编排 ----------
段落 查询会话(条件, 页码, 每页, 字段表):
  设 源 为 取值源()
  设 过滤后 为 过滤会话(源, 条件)
  设 分页后 为 分页(过滤后, 页码, 每页)
  设 抽取后 为 抽取字段(分页后, 字段表)
  返回 抽取后

# ---------- 模型可见工具 ----------
段落 查询会话模式():
  返回 ["type": "object",
        "properties": ["状态": ["type": "string", "description": "按状态精确过滤，留空不限"],
                       "关键字": ["type": "string", "description": "按会话名字包含过滤，留空不限"],
                       "页码": ["type": "integer", "description": "分页页码，从 1 开始，缺省 1"],
                       "每页": ["type": "integer", "description": "每页条数，缺省 10"],
                       "字段": ["type": "array", "items": ["type": "string"], "description": "要抽取的字段名列表，如 [名字,状态]，留空返回整条"]],
        "required": []]

段落 查询会话处理(参数):
  设 条件 为 {}
  如果 参数.包含("状态") == 真:
    条件["状态"] 为 参数["状态"]
  如果 参数.包含("关键字") == 真:
    条件["关键字"] 为 参数["关键字"]
  设 页码 为 1
  如果 参数.包含("页码") == 真:
    设 页码 为 参数["页码"]
  设 每页 为 10
  如果 参数.包含("每页") == 真:
    设 每页 为 参数["每页"]
  设 字段表 为 []
  如果 参数.包含("字段") == 真:
    设 字段表 为 参数["字段"]
  设 源 为 取值源()
  设 过滤后 为 过滤会话(源, 条件)
  设 总数 为 长(过滤后)
  设 分页后 为 分页(过滤后, 页码, 每页)
  设 抽取后 为 抽取字段(分页后, 字段表)
  设 行们 为 []
  遍历 每条 之 抽取后:
    设 段们 为 []
    遍历 键 之 每条:
      段们.追加(键 + "=" + 字符串(每条[键]))
    行们.追加(连接字符串(段们, " "))
  设 正文 为 连接字符串(行们, "\n")
  如果 正文 == "":
    设 正文 为 "(无匹配会话)"
  设 计数行 为 "命中 " + 字符串(长(抽取后)) + " 条（过滤后共 " + 字符串(总数) + " 条）"
  返回 造工具结果(计数行 + "\n" + 正文, 假)

段落 挂载(注册表):
  注册表.注册(造工具定义("查询会话", "按条件过滤/分页/抽取字段检索会话", 查询会话模式(), 查询会话处理))
  返回 真

导出 注入会话源
导出 取值源
导出 过滤会话
导出 分页
导出 抽取字段
导出 查询会话
导出 挂载
