# 测试_会话查询.light —— 会话查询 的正例与反例
#
# 注入式会话源：测试自带确定性 fake 会话列表，断言条件过滤、分页、字段抽取、
# 编排端到端、空结果反例、分页越界。不依赖真实会话生命周期状态。

从 会话查询 导入 注入会话源, 过滤会话, 分页, 抽取字段, 查询会话, 挂载
从 工具 导入 工具注册表

# 假源直接在段落内构造：避免模块级/局部同名造成的 L-166 影子变量
段落 假源():
  设 数据 为 [
    ["编号": "SES-1", "名字": "主线", "状态": "活跃"],
    ["编号": "SES-2", "名字": "调研", "状态": "挂起"],
    ["编号": "SES-3", "名字": "主线B", "状态": "活跃"],
    ["编号": "SES-4", "名字": "归档", "状态": "挂起"]
  ]
  返回 数据

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 [" + 标签 + "]: 实际=" + 字符串(实际) + " 期望=" + 字符串(期望))

段落 断言为真(值, 标签):
  如果 值 != 真:
    抛出 新建 错误("断言为真失败 [" + 标签 + "]")

段落 断言为假(值, 标签):
  如果 值 != 假:
    抛出 新建 错误("断言为假失败 [" + 标签 + "]")

段落 主:
  # 注入确定性 fake 会话源
  注入会话源(假源)

  # ---- 1. 条件过滤：状态=活跃 → 2 条 ----
  设 条件1 为 ["状态": "活跃"]
  设 过滤1 为 过滤会话(假源(), 条件1)
  断言相等(长(过滤1), 2, "活跃态 2 条")

  # ---- 2. 关键字=主线 → SES-1, SES-3 ----
  设 条件2 为 ["关键字": "主线"]
  设 过滤2 为 过滤会话(假源(), 条件2)
  断言相等(长(过滤2), 2, "关键字 主线 命中 2 条")

  # ---- 3. 组合条件：状态=挂起 且 关键字=归档 → 1 条 ----
  设 条件3 为 ["状态": "挂起", "关键字": "归档"]
  设 过滤3 为 过滤会话(假源(), 条件3)
  断言相等(长(过滤3), 1, "组合条件命中 1 条")

  # ---- 4. 分页：每页=2 第1/2页 ----
  设 全 为 假源()
  设 页1 为 分页(全, 1, 2)
  设 页2 为 分页(全, 2, 2)
  断言相等(长(页1), 2, "第1页 2 条")
  断言相等(长(页2), 2, "第2页 2 条")
  断言相等(页1[0]["编号"], "SES-1", "第1页首项")
  断言相等(页2[0]["编号"], "SES-3", "第2页首项(续)")

  # ---- 5. 字段抽取：只取 名字 ----
  设 名字字段 为 ["名字"]
  设 抽 为 抽取字段(全, 名字字段)
  断言相等(抽[0]["名字"], "主线", "抽取名字")
  断言为假(抽[0].包含("状态"), "抽取后无状态字段")

  # ---- 6. 空字段表 → 整条 ----
  设 空字段 为 []
  设 抽全 为 抽取字段(全, 空字段)
  断言相等(长(抽全), 4, "空字段表返回整条")

  # ---- 7. 编排端到端（过滤+分页+抽取）----
  设 条件活跃 为 ["状态": "活跃"]
  设 空字段2 为 []
  设 结果 为 查询会话(条件活跃, 1, 10, 空字段2)
  断言相等(长(结果), 2, "编排过滤命中 2")

  # ---- 8. 注册 + execute 端到端 ----
  设 注册表 为 新建 工具注册表()
  挂载(注册表)
  断言为真(注册表.登记表.包含("查询会话"), "查询会话已注册")
  设 定义 为 注册表.登记表["查询会话"]
  设 查询参 为 ["状态": "活跃"]
  设 产出 为 定义["execute"](查询参)
  断言为假(产出["isError"], "查询不应报错")
  断言为真(包含(产出["content"], "主线"), "内容含主线")
  断言为真(包含(产出["content"], "SES-1"), "内容含编号")
  断言为真(包含(产出["content"], "命中 2 条"), "计数行正确")

  # ---- 9. 反例：空结果（状态不存在）→ 不报错，只提示无匹配 ----
  设 空条件 为 ["状态": "冷冻"]
  设 空结果 为 定义["execute"](空条件)
  断言为假(空结果["isError"], "空结果不应是错误")
  断言为真(包含(空结果["content"], "无匹配"), "空结果提示无匹配")

  # ---- 10. 反例：分页越界（第 99 页）----
  设 越界参 为 ["页码": 99, "每页": 2]
  设 越界 为 定义["execute"](越界参)
  断言为真(包含(越界["content"], "无匹配"), "越界页为空结果")

  打印 "测试_会话查询 全部通过"

主()
