{
  "repo": "lightplugin",
  "description": "用光明语言复刻 dsh (DeepSeek Harness) 插件能力，供 lightharness 加载",
  "created": "2026-09-26",
  "dsh_source": "G:\\github\\deepseek-harness\\packages（共 60 个包）",
  "lightharness_host": "G:\\dswork\\duan-light-merge\\lightharness",
  "hook_contract": {
    "module": "lightharness/src/工具.light",
    "exports": [
      "造工具模式(名字, 描述, 参数)",
      "造工具定义(名字, 描述, 参数, 执行函数, 策略=\"exclusive\", 准备=空, 收尾=空)",
      "造工具结果(内容, 是否错误, 结论=假)",
      "校验参数(模式, 参数)",
      "类 工具注册表"
    ],
    "cordis_module": "lightharness/src/toolcordis.light",
    "cordis_exports": [
      "绳构造注册(id, 描述, 方法, 输入字段, 输入模式, 输出模式)",
      "绳执行查询(注册, 请求方法, 输入)",
      "绳装配(宿主钩子)"
    ]
  },
  "selection_rule": "dsh 60 个真实包 - lightharness 已复刻项 × 使用频率 × 光明可实现性",
  "excluded_already_replicated": [
    "待办.light",
    "技能清单.light",
    "网页搜索.light",
    "计划模式.light",
    "目标折叠.light / 目标轮驱动.light",
    "定时.light / 重复提醒.light",
    "反馈.light / 附件反馈.light",
    "附件准入.light",
    "交付.light / 交付呈现.light",
    "语言服务器.light",
    "凭据.light",
    "审批.light",
    "预设.light / 预设深化.light",
    "真实HTTP客户端.light",
    "网络钩子GitHub.light",
    "office转PDF.light（偏：仅 Office→PDF）",
    "工具_读文件 / 工具_写文件 / 工具_搜索文件 / 工具_bash / 工具_路径安全",
    "文件系统工具 / 核心工具 / 宿主工具 / 团队工具 / 查询工具 / 时间工具 / 推理工具 / 交互工具 / 值工具"
