# 缺陷探针4：定位「语音输入打包」里 name '超限' is not defined 的真因
# 三种可能：A 裸标量赋值（不带 设）/ B 多行字符串拼接 / C 「超限」这个词本身

段落 探针A():
  设 甲 为 假
  如果 1 > 0:
    甲 为 真
  返回 甲

段落 探针B():
  # 行尾「+」续行 —— 已知会炸（LP-D-006），改为分步拼接作对照
  设 串 为 "a"
  设 串 为 串 + "b"
  设 串 为 串 + "c"
  返回 串

段落 探针F():
  # 括号内跨行（对照：应安全）
  设 表 为 ["甲": 1,
        "乙": 2]
  返回 表["乙"]

段落 探针C():
  设 超限 为 假
  如果 1 > 0:
    超限 为 真
  返回 超限

段落 探针D():
  设 乙 为 假
  如果 1 > 0:
    乙 为 真
  设 串2 为 "a"
  设 串2 为 串2 + "b"
  如果 乙 == 真:
    返回 "ok+" + 串2
  返回 "no"

段落 探针E():
  设 超限 为 假
  如果 1 > 0:
    超限 为 真
  设 串3 为 "x"
  设 串3 为 串3 + "y"
  如果 超限 == 真:
    返回 "ok+" + 串3
  返回 "no"

段落 主:
  打印 "A 裸赋值: " + 字符串(探针A())
  打印 "B 多行拼接: " + 探针B()
  打印 "C 超限裸赋值: " + 字符串(探针C())
  打印 "D 裸赋值+拼接+读: " + 探针D()
  打印 "E 超限+拼接+读: " + 探针E()
  打印 "F 括号内跨行: " + 字符串(探针F())

主()
