# ---- B. 模型可见的工具描述表：每条都要有 name/description/parameters ----
段落 查描述表(注册表):
  设 描述表 为 注册表.描述表()
  设 缺字段 为 0
  遍历 描述项 之 描述表:
    如果 描述项.包含("name") == 假 或 描述项.包含("description") == 假 或 描述项.包含("parameters") == 假:
      设 缺字段 为 缺字段 + 1
  打印 "模型可见描述表条数="
  打印 长(描述表)
  打印 "缺三要素的条数="
  打印 缺字段
  返回 缺字段

# ---- C. schema 结构体检：必须是 object 型且有 properties（不调校验器，避免无 try/catch 时崩）----
段落 查模式(注册表):
  设 名字表 为 注册表.名单()
  设 坏模式 为 0
  遍历 名字 之 名字表:
    设 模式 为 注册表.查找(名字)["parameters"]
    如果 type(模式) != dict:
      设 坏模式 为 坏模式 + 1
      打印 "  [坏模式] " 加上 名字 加上 " -> parameters 不是映射"
    否则:
      如果 模式.包含("type") == 假 或 模式["type"] != "object":
        设 坏模式 为 坏模式 + 1
        打印 "  [坏模式] " 加上 名字 加上 " -> type 不是 object"
      否则:
        如果 模式.包含("properties") == 假:
          设 坏模式 为 坏模式 + 1
          打印 "  [坏模式] " 加上 名字 加上 " -> 缺 properties"
        否则:
          # 2026-09-28 宿主冒烟实踩：有插件把 properties 写成**列表**而非映射，
          # 直接调 execute 完全看不出来，只有按 schema 造参时才会炸在 字典键列表()。
          如果 type(模式["properties"]) != dict:
            设 坏模式 为 坏模式 + 1
            打印 "  [坏模式] " 加上 名字 加上 " -> properties 不是映射（实际类型 " 加上 转字符串(type(模式["properties"])) 加上 "）"
  打印 "坏 schema 数="
  打印 坏模式
  返回 坏模式

# ---- D. 全覆盖派发：每个工具都用空参数走一次完整流水线 ----
#   有必填 → 宿主 Schema 校验应拦下（PARAM_SCHEMA_INVALID），证明校验真的生效且不会误执行；
#   无必填 → 真正派发执行，记录成败（多数因缺宿主注入而软失败，属预期）。
段落 全覆盖派发(注册表):
  设 名字表 为 注册表.名单()
  设 校验拦下 为 0
  设 执行成功 为 0
  设 执行失败 为 0
  设 空参 为 {}
  遍历 名字 之 名字表:
    设 结果 为 注册表.执行(名字, 空参)
    如果 结果["isError"] == 假:
      设 执行成功 为 执行成功 + 1
    否则:
      设 码 为 ""
      如果 结果.包含("error") 且 结果["error"] != 空:
        如果 type(结果["error"]) == dict 且 结果["error"].包含("代码"):
          设 码 为 结果["error"]["代码"]
      如果 码 == "PARAM_SCHEMA_INVALID":
        设 校验拦下 为 校验拦下 + 1
      否则:
        设 执行失败 为 执行失败 + 1
  打印 "[D] 宿主 Schema 校验拦下（缺必填）="
  打印 校验拦下
  打印 "[D] 空参仍可执行成功="
  打印 执行成功
  打印 "[D] 其余失败（多为待宿主注入）="
  打印 执行失败
  返回 执行成功 加上 校验拦下

# ---- E2. 合法派发：按每个工具自己的 schema 造出「符合 schema 的最小参数」再派发 ----
#   这一步才是「模型真的按 schema 传参时能不能跑通」的证明（D 阶段只能证明缺参会被拦）。
段落 造默认值(声明):
  设 型 为 ""
  如果 声明.包含("type"):
    设 型 为 声明["type"]
  如果 型 == "string":
    返回 "冒烟"
  如果 型 == "integer":
    返回 1
  如果 型 == "number":
    返回 1
  如果 型 == "boolean":
    返回 真
  如果 型 == "array":
    设 空表 为 []
    返回 空表
  如果 型 == "object":
    设 空映射 为 {}
    返回 空映射
  返回 "冒烟"

段落 造最小参数(模式):
  设 参数 为 {}
  如果 模式.包含("properties") == 假:
    返回 参数
  设 属性表 为 模式["properties"]
  如果 type(属性表) != dict:
    返回 参数
  设 键们 为 字典键列表(属性表)
  设 必填 为 []
  如果 模式.包含("required"):
    设 必填 为 模式["required"]
  遍历 键 之 键们:
    如果 长(必填) == 0 或 必填.包含(键):
      设 参数[键] 为 造默认值(属性表[键])
  返回 参数

段落 合法派发(注册表):
  设 名字表 为 注册表.名单()
  设 跳过表 为 [
    "运行Python脚本",
    "SSH执行",
    "打开终端",
    "写入终端",
    "读取终端",
    "关闭终端",
    "浏览器执行",
    "屏幕操作",
    "执行启动序列",
    "启动子进程",
    "等待子进程",
    "工作线程运行时",
    "工作线程打包",
    "语音转文字",
    "录音控制",
    "语音打包",
    "图片生成",
    "视频生成",
    "三维生成",
    "模型补全",
    "网页抓取",
    "文档大纲"
  ]
  设 派发 为 0
  设 跳过数 为 0
  设 成功 为 0
  设 校验拦 为 0
  设 其余失败 为 0
  遍历 名字 之 名字表:
    如果 跳过表.包含(名字):
      设 跳过数 为 跳过数 + 1
    否则:
      设 模式 为 注册表.查找(名字)["parameters"]
      设 参数 为 造最小参数(模式)
      设 结果 为 注册表.执行(名字, 参数)
      设 派发 为 派发 + 1
      如果 结果["isError"] == 假:
        设 成功 为 成功 + 1
      否则:
        设 码 为 ""
        如果 结果.包含("error") 且 结果["error"] != 空:
          如果 type(结果["error"]) == dict 且 结果["error"].包含("代码"):
            设 码 为 结果["error"]["代码"]
        如果 码 == "PARAM_SCHEMA_INVALID":
          设 校验拦 为 校验拦 + 1
          打印 "  [schema不符] " 加上 名字 加上 " -> 按自己的 schema 造参仍被拦"
        否则:
          设 其余失败 为 其余失败 + 1
          打印 "  [待注入] " 加上 名字 加上 " -> " 加上 码
  打印 "[E2] 合法派发工具数="
  打印 派发
  打印 "[E2] 其中执行成功="
  打印 成功
  打印 "[E2] schema 不符（实现与 schema 不一致）= "
  打印 校验拦
  打印 "[E2] 其余失败（待宿主注入）="
  打印 其余失败
  打印 "[E2] 显式跳过（有副作用/需外部资源）="
  打印 跳过数
  返回 校验拦

# ---- E. 定向用例：给正确参数，期望宿主流水线判定 isError == 假 ----
段落 定向用例(注册表):
  # 用例：风险判定
  设 用例参 为 ["命令": "ls -la", "路径": "/tmp", "网址": "https://example.com"]
  设 结果 为 注册表.执行("风险判定", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "风险判定 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  # 用例：判定类型
  设 用例参 为 ["值": 42]
  设 结果 为 注册表.执行("判定类型", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "判定类型 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  # 用例：上下文装配
  设 用例参 为 ["预算": 100]
  设 结果 为 注册表.执行("上下文装配", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "上下文装配 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  # 用例：沙箱裁决
  设 用例参 为 ["类别": "命令", "内容": "ls -la"]
  设 结果 为 注册表.执行("沙箱裁决", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "沙箱裁决 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  # 用例：解析命令行
  设 用例参 为 ["命令行": "ls -la \"a b\""]
  设 结果 为 注册表.执行("解析命令行", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "解析命令行 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  # 用例：规范化路径
  设 用例参 为 ["路径": "./a/../b/./c"]
  设 结果 为 注册表.执行("规范化路径", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "规范化路径 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  # 用例：合并字典
  设 基 为 ["甲": 1, "乙": 2]
  设 覆盖 为 ["乙": 9, "丙": 3]
  设 用例参 为 ["基": 基, "覆盖": 覆盖]
  设 结果 为 注册表.执行("合并字典", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "合并字典 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  # 用例：去重列表
  设 名单 为 ["甲", "乙", "甲", "丙"]
  设 用例参 为 ["列表": 名单]
  设 结果 为 注册表.执行("去重列表", 用例参)
  如果 结果["isError"] == 假:
    记通过()
  否则:
    设 说明 为 "去重列表 -> "
    如果 结果.包含("error") 且 结果["error"] != 空 且 type(结果["error"]) == dict 且 结果["error"].包含("消息"):
      设 说明 为 说明 加上 结果["error"]["消息"]
    否则:
      设 说明 为 说明 加上 转字符串(结果["content"])
    记失败(说明)
  返回 真

# ---- F. 异常路径：未知工具应被宿主判为 TOOL_NOT_FOUND（而不是抛异常/静默）----
段落 异常路径(注册表):
  设 空参 为 {}
  设 结果 为 注册表.执行("绝无此工具", 空参)
  如果 结果["isError"] == 真:
    如果 type(结果["error"]) == dict 且 结果["error"].包含("代码"):
      如果 结果["error"]["代码"] == "TOOL_NOT_FOUND":
        记通过()
        返回 真
  记失败("未知工具未返回 TOOL_NOT_FOUND")
  返回 真

# ---- G. 宿主执行统计：注册表.汇总统计() 应随调用增长 ----
段落 查统计(注册表):
  设 汇总 为 注册表.汇总统计()
  打印 "宿主执行统计 总调用="
  打印 汇总["总调用"]
  打印 "宿主执行统计 总成功="
  打印 汇总["总成功"]
  返回 汇总["总调用"]

段落 主:
  设 注册表 为 统一挂载()
  设 名字表 为 注册表.名单()
  打印 "===== lightplugin × lightharness 宿主冒烟 ====="
  打印 "挂载插件数="
  打印 74
  打印 "注册表工具数="
  打印 长(名字表)

  设 缺字段 为 查描述表(注册表)
  如果 缺字段 == 0:
    记通过()
  否则:
    记失败("模型可见描述表有 " 加上 转字符串(缺字段) 加上 " 条缺三要素")

  设 坏模式 为 查模式(注册表)
  如果 坏模式 == 0:
    记通过()
  否则:
    记失败("坏 schema " 加上 转字符串(坏模式) 加上 " 个")

  设 派发数 为 全覆盖派发(注册表)
  打印 "[D] 参与派发的工具数="
  打印 派发数

  设 校验拦 为 合法派发(注册表)
  如果 校验拦 == 0:
    记通过()
  否则:
    记失败("有 " 加上 转字符串(校验拦) 加上 " 个工具按自己的 schema 造参仍被校验拦下（实现与 schema 不符）")

  定向用例(注册表)
  异常路径(注册表)
  查统计(注册表)

  打印 "===== 冒烟结论 ====="
  打印 "断言通过="
  打印 通过
  打印 "断言失败="
  打印 失败
  如果 失败 == 0:
    打印 "[ok] 宿主运行时冒烟全通过"
  否则:
    打印 "[红] 宿主运行时冒烟有失败，见上方 [失败] 明细"
  打印 "宿主冒烟结束"

主()
